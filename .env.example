# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
# See docs/registrations.md for where to obtain each one.

# --- Required for Phase 1 (data ingestion) ---
# https://data.moenv.gov.tw  → register → API key arrives by email
MOENV_API_KEY=

# https://opendata.cwa.gov.tw  → login → 「API授權碼」→ 取得授權碼
CWA_API_KEY=

# --- Required for Phase 4+ (ERA5 boundary layer height, winds) ---
# https://cds.climate.copernicus.eu  → profile → API token
# The cdsapi library also reads ~/.cdsapirc; these are the equivalent env vars.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# --- Required for Phase 6 (Sentinel-5P, MODIS AOD) ---
# https://code.earthengine.google.com  → register a Cloud project (free, needs approval)
GEE_PROJECT_ID=

# --- Required for publishing ---
# https://huggingface.co/settings/tokens  (needs "write" scope)
HF_TOKEN=
HF_NAMESPACE=

# --- Pipeline behaviour ---
TWAIR_DATA_DIR=data
TWAIR_LOG_LEVEL=INFO
# Politeness: minimum seconds between requests to the same host.
TWAIR_MIN_REQUEST_INTERVAL=1.0
TWAIR_USER_AGENT=airlens-tw/0.1 (research; +https://github.com/kuotunyu/air-quality)
