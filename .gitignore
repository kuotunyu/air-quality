# --- data (never committed; lives on HuggingFace / regenerated by the pipeline) ---
# Anchored to the repo root on purpose: a bare `data/` also matches
# `web/public/data/`, which silently kept the entire website export out of git.
/data/
!/data/.gitkeep

# --- secrets ---
.env
.env.local
*.key
credentials.json
.config/earthengine/
.cdsapirc

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# --- node / astro ---
node_modules/
web/dist/
web/.astro/
.DS_Store

# --- L1 exports (station-day Parquet, ~55 MB) ---
# L0 and the story payloads are committed: the site cannot render without them
# and they are small. L1 is regenerated by `twair export web` and served from a
# data host, so keeping it in git would only add tens of megabytes per rebuild.
web/public/data/l1/

# --- generated site output (built by CI, not committed by hand) ---
docs/report/

# --- notebooks ---
.ipynb_checkpoints/

# --- original graduation project source PDF ---
# Contains author names. Decide explicitly before publishing (see docs/legal.md).
懸浮微粒.pdf
