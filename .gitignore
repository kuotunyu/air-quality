# --- data (never committed; lives on HuggingFace / regenerated by the pipeline) ---
# Anchored to the repo root on purpose: a bare `data/` also matches
# `web/public/data/`, which silently kept the entire website export out of git.
/data/
!/data/.gitkeep

# --- secrets ---
.env
.env.local
*.key
credentials.json
.config/earthengine/
.cdsapirc

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# --- node / astro ---
node_modules/
web/dist/
web/.astro/
.DS_Store

# --- L1 exports (station-day Parquet, ~55 MB for all 21 measurands) ---
# L0 and the story payloads are committed: the site cannot render without them
# and they are small. Most of L1 is not, because committing 55 MB on every
# re-export would dominate the repository.
#
# The exception is PM2.5 and PM10 (6.5 MB together). Chapter 6 queries whatever
# L1 files the site actually serves, and with none of them it has nothing to
# query — so the two measurands the whole project is about travel with it. The
# rest come from `uv run twair export web`.
web/public/data/l1/*
!web/public/data/l1/pm25.parquet
!web/public/data/l1/pm10.parquet

# --- generated site output (built by CI, not committed by hand) ---
docs/report/

# --- notebooks ---
.ipynb_checkpoints/

# --- original graduation project source PDF ---
# Contains author names. Decide explicitly before publishing (see docs/legal.md).
懸浮微粒.pdf

# --- HuggingFace Space bundle: source committed, artefacts not ---
# `uv run twair export space` rebuilds these from the store in a few minutes.
# Same call as L1: 14 MB of regenerable output does not belong in history, and
# the Space is its own git repo when it is pushed. app.py, requirements.txt
# and README.md ARE committed — they are written, not generated.
/spaces/forecast/model/
/spaces/forecast/data/
