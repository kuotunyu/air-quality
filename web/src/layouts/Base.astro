---
import "../styles/global.css";
import {
  generatedAt,
  gitSha,
  hourlyObservationsFull,
  hourlyObservationsShort,
  recordSpan,
  stations,
} from "../lib/data";
import { CHAPTERS, chapterLabel, chapterNumeral, href } from "../lib/chapters";
import { repoCommit, repoUrl } from "../lib/repo";
import FigureTools from "../components/FigureTools.astro";
import PlotReadout from "../components/PlotReadout.astro";

interface Props {
  title: string;
  description: string;
  /**
   * Set on a page that is served at addresses other than its own.
   *
   * Only the 404 page sets it. That file answers every unmatched path under the
   * site, so a canonical link on it would name one URL — `/404/` — that nothing
   * is ever served at, and an `og:url` that unfurls to a page the reader did not
   * ask for. A page that cannot state its own address should not state one.
   */
  unaddressed?: boolean;
}

const { title, description, unaddressed = false } = Astro.props;

/*
 * Which chapter is open, so the nav can say so.
 *
 * `Astro.url.pathname` carries the configured base on a project site, so the
 * comparison is made on the last segment rather than on the whole path — that
 * way it is right both at `/trend` locally and at `/air-quality/trend` on
 * Pages, which is the mismatch that only shows up in production.
 */
const segment = Astro.url.pathname.replace(/\/+$/, "").split("/").pop() ?? "";
const here = CHAPTERS.find((c) => c.slug === segment) ?? null;

/*
 * Absolute URLs, for the things that only work absolute.
 *
 * A canonical link and an `og:image` are read by machines that have no page to
 * resolve a relative path against, so both have to carry the origin. `Astro.site`
 * is the configured one; the fallback keeps a local preview from throwing.
 *
 * The path carries the trailing slash, because that is the one Pages answers
 * with 200 — it 301s the bare form. The first version of this emitted the bare
 * form for all eleven routes, so every canonical link and `og:url` on the site
 * named the spelling the host redirects away from, which is the exact failure a
 * canonical link exists to prevent.
 */
const origin = Astro.site ?? new URL("/", Astro.url);
// With the trailing slash, which is the spelling Pages serves and 301s towards.
const path = `${Astro.url.pathname.replace(/\/+$/, "")}/`;
const canonical = new URL(path, origin).href;
const base = import.meta.env.BASE_URL.replace(/\/*$/, "/");
const socialCard = new URL(`${base}og.png`, origin).href;

/*
 * The favicon, in the palette the site actually uses.
 *
 * It was a cyan disc (#22d3ee) on near-black (#0b0e13) — both from the palette
 * this project had two rebuilds ago, and neither is a token any more. What it
 * shows now is the concentration ramp itself, low to high, which is the one idea
 * the whole document is built on and the only mark that still means something at
 * 16px. Two versions, because a near-white field vanishes into light browser
 * chrome and a near-black one vanishes into dark.
 */
const icon = (field: string, ramp: string[]) =>
  "data:image/svg+xml," +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">` +
      `<rect width="32" height="32" rx="7" fill="${field}"/>` +
      ramp
        .map((c, i) => `<rect x="6" y="${6 + i * 5}" width="20" height="5" fill="${c}"/>`)
        .join("") +
      `</svg>`,
  );
const iconLight = icon("#ebedef", ["#5d88b8", "#4a7647", "#783c2e", "#5e0d4e"]);
const iconDark = icon("#232527", ["#267bbe", "#5ea28b", "#dea07b", "#f6b8e3"]);
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Light first, which is what `global.css` declares and what this document
        decided its reading situation is. This said `dark light` — a leftover from
        when dark was the default, and it disagreed with the stylesheet. */}
    <meta name="color-scheme" content="light dark" />

    {/*
      The colour a phone paints its own chrome with, one per theme.
      
      Without it the browser picks white on Android and the address bar sits a
      shade off the page in light and glaringly off it in dark. These are the
      composited values of `--bg` in each theme, written as hex because a
      `theme-color` is parsed
      by the browser's UI rather than by its CSS engine, and not every one of
      those understands oklch yet. The hex values are what the page actually
      composites to, read back from `getComputedStyle` rather than converted by
      hand — the first attempt converted the wrong lightness and came out
      #f3f6fa against the page's real #f1f6fb.
    */}
    <meta name="theme-color" content="#f1f6fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14181b" media="(prefers-color-scheme: dark)" />

    {
      unaddressed ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <link rel="canonical" href={canonical} />
      )
    }

    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!unaddressed && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="台灣空氣品質的長期重新分析" />
    <meta property="og:locale" content="zh_TW" />
    {/* A link to this document in a chat app used to unfurl as a bare line of
        text, because there was no image to unfurl. */}
    <meta property="og:image" content={socialCard} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`台灣空氣品質的長期重新分析：${recordSpan.first}–${recordSpan.last}，${stations.length} 個測站，${hourlyObservationsShort}筆逐時觀測`}
    />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={iconLight} media="(prefers-color-scheme: light)" />
    <link rel="icon" href={iconDark} media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" type="application/xml" href={href("sitemap.xml")} />
  </head>
  <body>
    <a href="#main" class="skip">跳到主要內容</a>

    {/*
      A rail, not a dropdown.

      The chapter list has now been a squeezed row of ten links, then a menu
      behind a button. Both had the same defect from opposite directions: the row
      could not give ten destinations a readable size, and the menu could give
      them one but only to a reader who thought to go looking. A rail resolves it
      by not being a control at all — the ten chapters are simply on the page,
      with the current one marked, so there is nothing to discover and nothing to
      open.

      The checkbox is the whole mobile mechanism, and it is deliberate: no
      script, so the rail works when JavaScript does not, which PRODUCT.md
      requires. Below 80rem it is a drawer with a labelled button; above, the
      button is gone and the list is just there.
    */}
    <input id="rail" type="checkbox" class="rail-switch" />

    <div class="shell">
      <header class="rail">
        <div class="rail-top">
          <a class="brand" href={href()}>air-<span>quality</span></a>
          <label class="rail-shut" for="rail" aria-label="收起章節">
            <span aria-hidden="true">✕</span>
          </label>
        </div>

        <nav aria-label="章節">
          <ol>
            {
              CHAPTERS.map((c) => (
                <li>
                  <a
                    href={href(c.slug)}
                    aria-current={here?.slug === c.slug ? "page" : undefined}
                  >
                    <span class="rail-n" aria-hidden="true">{chapterNumeral(c.n)}</span>
                    <span class="rail-t">{c.title}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        {/* Reading progress, on the rail's own edge rather than across the top.
            Driven by a scroll timeline, so there is no listener to keep in sync;
            where the timeline is unsupported the bar simply stays at zero
            height, which is a line nobody notices rather than a broken control. */}
        <div class="progress" aria-hidden="true"></div>
      </header>

      {/* Dismisses the drawer by tapping away from it. A label, so it needs no
          script either. */}
      <label class="rail-veil" for="rail" aria-hidden="true"></label>

      <div class="column">
        <div class="handle">
          <label class="rail-open" for="rail">
            <span class="rail-open-bars" aria-hidden="true"></span>
            章節
          </label>
          <p class="handle-at">
            {
              here ? (
                <>
                  <span class="handle-n">{chapterLabel(here.n)}</span>
                  <span class="handle-t">{here.nav}</span>
                </>
              ) : (
                <span class="handle-t">台灣空氣品質再分析</span>
              )
            }
          </p>
        </div>

        <main id="main">
          <slot />
        </main>

        <footer>
          <div class="page">
            {/*
              The claim carries the link, and the sha carries its own.

              This paragraph asserted 「管線與分析全部開源」 and printed a commit
              hash, and no page on the site linked to the repository — a reader
              was shown a sha and told the work was open with no way to reach
              either. The two links go to different places on purpose: the claim
              goes to the source, the sha goes to the commit the DATA was
              exported at, which is usually older than the code rendering the
              page around it.
            */}
            <p class="mono">
              資料：環境部空氣品質監測網 {recordSpan.first}–{recordSpan.last} 逐時觀測，{hourlyObservationsFull} 筆。
              管線與分析<a href={repoUrl}>全部開源</a>。
            </p>
            {/*
              "資料匯出於", not "匯出於". The commit is the one the *data layers*
              were exported at, and the page is rebuilt on every push — so on any
              given day this sha is usually older than the code that rendered the
              page around it. Unqualified, it reads as the build's provenance and
              quietly overstates what is being traced.
            */}
            <p class="mono dim">
              資料匯出於 {generatedAt.slice(0, 10)}
              {gitSha ? <>{" · "}<a href={repoCommit(gitSha)}>{gitSha}</a></> : ""}
            </p>
          </div>
        </footer>
      </div>
    </div>

    {/* Adds 放大 and 下載 PNG to every figure, and holds the dialog the first
        one opens into. Outside `.shell` because a `<dialog>` in the top layer
        belongs to the document rather than to the column it was opened from. */}
    <FigureTools />

    <PlotReadout />
    <style>
      /* ── the shell ──────────────────────────────────────────────────────── */

      .shell {
        display: grid;
        min-height: 100vh;
      }

      /*
       * 80rem, and the number is the whole decision.
       *
       * The rail is a fixed 321–327px taken out of the same row as the reading
       * column, so switching it on makes the column NARROWER. At 62rem it did
       * that at the worst possible place: measured on `/trend`, a window going
       * from 990 to 992 took the column from 896px to 577 — two pixels wider,
       * 319px of reading width gone, a 36% drop — and it did not climb back to
       * 896 until about 1355.
       *
       * The obvious fix is to wait until the rail is free, and it is the wrong
       * one. Measured by rendering each width twice, once with the rail and once
       * with it forced off: the two columns agree only at **1460px**, because
       * the column is space-limited until it reaches its 42-character measure.
       * At 1440 the rail costs 3.8px. Moving the breakpoint to 1460 would take
       * the table of contents away from every 1440 screen to buy four pixels.
       *
       * So the question is not when the rail is free, it is how much column the
       * rail is worth. Measured cost, and what the column is left with:
       *
       *     1024   987 → 605   −38%   26 CJK characters
       *     1152   987 → 718   −27%   31
       *     1280   987 → 836   −15%   36
       *     1366   987 → 911    −8%   39
       *     1440   987 → 983    −0.4% 42
       *
       * A table of contents is worth three characters. It is not worth sixteen.
       * 80rem is where the column keeps 36 — inside the 30–45 band this site
       * sets prose in — and it is a round number in the same unit the other
       * breakpoints use. Below it every reader gets the full measure and the
       * sticky chapter bar, which reaches any chapter in one tap and names the
       * current one; above it they get the list standing open. The worst
       * discontinuity anywhere on the curve is now 151px instead of 319.
       *
       * `rem` in a media query is always 16px, so this is 1280 and does not move
       * with the fluid root — see the note on the axis thinning tiers in
       * global.css for the bug that rule prevents.
       *
       * The rail width itself is a clamp rather than a guess: never so narrow
       * that a chapter title wraps to three lines, never so wide that it
       * competes with the column it serves.
       */
      @media (min-width: 80rem) {
        .shell {
          /*
           * The floor is what decides whether a chapter title wraps, and a
           * wrapped title is what pushed the rail past the fold.
           *
           * Measured at 1366x768 with the larger type: the six nine-character
           * titles need 203px of label and were given 170, so every one of them
           * ran to two lines and the rail grew to 934px inside a 768px window —
           * on `/data` the current-chapter marker, which is the one thing the
           * rail exists to do, sat 114px below the fold. Unwrapped the rail
           * measures 607px and needs no scrolling at all.
           *
           * 13.9rem is the width the widest label needs plus the numeral column,
           * the gap and both paddings — solved, not rounded up by eye.
           */
          grid-template-columns: clamp(13.9rem, 17vw, 15.5rem) minmax(0, 1fr);
        }
      }

      .rail {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        padding: var(--space-4) var(--space-3) var(--space-5);
        background: var(--bg-sunken);
        border-right: 1px solid var(--line-soft);
      }

      @media (min-width: 80rem) {
        .rail {
          /* Sticky, and its own scroller: ten chapters fit, but an eleventh
             should scroll the rail rather than the page. */
          position: sticky;
          top: 0;
          max-height: 100vh;
          overflow-y: auto;
        }
      }

      .rail-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
      }

      .brand {
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text);
        text-decoration: none;
        white-space: nowrap;
        font-size: var(--text-base);
      }

      .brand span {
        color: var(--text-faint);
        font-weight: 500;
      }

      /* ── the chapter list ───────────────────────────────────────────────── */

      .rail nav ol {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 1px;
      }

      .rail nav a {
        display: grid;
        grid-template-columns: 1.35em minmax(0, 1fr);
        gap: 0 0.6rem;
        align-items: baseline;
        padding: 0.5rem 0.6rem;
        border-radius: calc(var(--radius) - 4px);
        text-decoration: none;
        color: var(--text-muted);
        font-size: var(--text-sm);
        line-height: 1.45;
        transition:
          background-color 160ms cubic-bezier(0.22, 1, 0.36, 1),
          color 160ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .rail nav a:hover,
      .rail nav a:focus-visible {
        background: var(--bg-raised);
        color: var(--text);
      }

      .rail-n {
        color: var(--text-faint);
        text-align: center;
      }

      /*
       * The chapter being read. Marked three ways on purpose — ink, weight and a
       * bar on the leading edge — because it is the only thing in the rail that
       * has to be findable without being read.
       *
       * The bar is an inset `box-shadow`, not `border-left`. A coloured left
       * border is the accent every generated interface reaches for, and it also
       * squares off one side of a rounded row; an inset shadow sits inside the
       * row shape instead of replacing part of it.
       */
      .rail nav a[aria-current="page"] {
        background: var(--bg-raised);
        color: var(--text);
        font-weight: 650;
        box-shadow: inset 0.18rem 0 0 0 var(--accent);
      }

      .rail nav a[aria-current="page"] .rail-n {
        color: var(--accent);
      }

      /* ── reading progress, on the rail edge ─────────────────────────────── */

      .progress {
        position: absolute;
        right: -1px;
        top: 0;
        width: 2px;
        height: 0;
        background: var(--accent);
        transform-origin: top;
      }

      @supports (animation-timeline: scroll()) {
        .progress {
          height: 100%;
          transform: scaleY(0);
          animation: read linear;
          animation-timeline: scroll(root block);
        }
      }

      @keyframes read {
        to {
          transform: scaleY(1);
        }
      }

      /* Below the rail breakpoint the rail is a drawer, so a bar down its edge
         would be reporting progress on something that is not on screen. */
      @media (max-width: 79.999rem) {
        .progress {
          display: none;
        }
      }

      /* ── the mobile drawer ──────────────────────────────────────────────── */

      /* Off-screen rather than `display: none`, so it stays operable by keyboard
         and appears in the accessibility tree exactly once. */
      /*
       * Off-screen rather than `display: none`, and NOT `aria-hidden`: a
       * `<label>` is not focusable, so hiding the checkbox from the keyboard left
       * the drawer with no keyboard route at all. The `<label for>` gives it its
       * accessible name, and the focus ring is drawn on the label the reader can
       * actually see.
       */
      .rail-switch {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        margin: 0;
      }

      .rail-switch:focus-visible ~ .shell .rail-open {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      /* The column has to be allowed to shrink, or a wide table inside it sets
         the grid track and pushes the whole page sideways. */
      .column {
        min-width: 0;
      }

      .handle {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: 0.55rem clamp(1.15rem, 4vw, 2.75rem);
        border-bottom: 1px solid var(--line-soft);
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(10px);
        position: sticky;
        top: 0;
        z-index: var(--z-sticky);
      }

      .rail-open {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        min-height: 2.4rem;
        padding: 0 0.8rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--bg-raised);
        color: var(--text);
        font-size: var(--text-sm);
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        flex: none;
      }

      .rail-open:hover {
        border-color: var(--rule);
        background: var(--bg-sunken);
      }

      /* Three rules drawn rather than typed: a glyph would inherit the font
         metrics and never sit on the centre of the label beside it. */
      .rail-open-bars {
        width: 0.85em;
        height: 0.62em;
        flex: none;
        border-top: 2px solid currentColor;
        border-bottom: 2px solid currentColor;
        position: relative;
      }

      .rail-open-bars::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: calc(50% - 1px);
        border-top: 2px solid currentColor;
      }

      .handle-at {
        margin: 0;
        min-width: 0;
        display: flex;
        align-items: baseline;
        gap: 0.5em;
        overflow: hidden;
      }

      .handle-n {
        font-size: var(--text-sm);
        color: var(--text-faint);
        white-space: nowrap;
      }

      .handle-t {
        font-weight: 650;
        color: var(--text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .rail-shut,
      .rail-veil {
        display: none;
      }

      @media (max-width: 79.999rem) {
        /*
         * Off-canvas AND out of the tab order while it is closed.
         *
         * `transform` moves the drawer out of sight but leaves its eleven links
         * focusable, so a keyboard or switch-access reader tabbing from the top
         * of a phone page lost the focus ring for eleven consecutive presses
         * with nothing on screen to explain it. `visibility: hidden` removes
         * them; the delayed transition means the drawer stays visible for the
         * whole 260ms slide out, and becomes visible instantly on the way in.
         */
        .rail {
          visibility: hidden;
          transition:
            transform 260ms cubic-bezier(0.16, 1, 0.3, 1),
            visibility 0s linear 260ms;
          position: fixed;
          inset: 0 auto 0 0;
          z-index: var(--z-overlay);
          width: min(19rem, 84vw);
          border-right: 1px solid var(--line);
          transform: translateX(-100%);
          overflow-y: auto;
        }

        .rail-switch:checked ~ .shell .rail {
          transform: translateX(0);
          visibility: visible;
          transition:
            transform 260ms cubic-bezier(0.16, 1, 0.3, 1),
            visibility 0s;
        }

        .rail-shut {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          width: 2.2rem;
          height: 2.2rem;
          margin-right: -0.4rem;
          border-radius: var(--radius);
          color: var(--text-muted);
          cursor: pointer;
          font-size: var(--text-base);
        }

        .rail-shut:hover {
          background: var(--bg-raised);
          color: var(--text);
        }

        .rail-switch:checked ~ .shell .rail-veil {
          display: block;
          position: fixed;
          inset: 0;
          z-index: calc(var(--z-overlay) - 1);
          background: oklch(0 0 0 / 0.42);
        }

        /* Titles can be full length in a drawer: it is 19rem wide there, not 13. */
        .rail nav a {
          font-size: var(--text-base);
          padding: 0.6rem 0.7rem;
        }
      }

      /* Above the breakpoint the rail is simply present, so every control whose
         only job is to reveal it has nothing left to do. */
      @media (min-width: 80rem) {
        .handle {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .rail,
        .rail nav a {
          transition: none;
        }
      }

      footer {
        border-top: 1px solid var(--line-soft);
        padding: 2.5rem 0 4rem;
        color: var(--text-faint);
        font-size: var(--text-sm);
      }
      footer p {
        margin: 0 0 0.4rem;
        /* Not `none`. Unbounded, the provenance line ran the full 1,145px
           column at about 50 characters — the longest measure on the page, in
           the smallest type on it. It is prose, so it reads at the same width
           as prose. */
        max-width: var(--measure);
      }
      footer .dim {
        /* No alpha. `--text-faint` is already tuned to clear 4.5:1 against the
           page; knocking 30% off it composited to 3.10, and this line carries
           the export time and the commit the figures came from — the one thing
           on the page a reader might need to quote. */
        color: var(--text-faint);
      }
    </style>
  </body>
</html>
