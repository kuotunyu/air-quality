---
import "../styles/global.css";
import { generatedAt, gitSha } from "../lib/data";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const sections = [
  { id: "hero", label: "全台" },
  { id: "trend", label: "趨勢" },
  { id: "yours", label: "測站統計" },
  { id: "sources", label: "污染來向" },
  { id: "detection", label: "偵測極限" },
  { id: "forecast", label: "預測技巧" },
  { id: "health", label: "健康負擔" },
  { id: "mistakes", label: "方法學對照" },
  { id: "explore", label: "資料查詢" },
  { id: "data", label: "資料" },
];
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230b0e13'/%3E%3Ccircle cx='16' cy='16' r='7' fill='%2322d3ee'/%3E%3C/svg%3E" />
  </head>
  <body>
    <a href="#hero" class="visually-hidden">跳到主要內容</a>

    <nav class="topbar" aria-label="章節">
      <div class="topbar-inner page">
        <a class="brand" href={base || "/"}>air-<span>quality</span></a>
        <ul>
          {
            sections.map((s) => (
              <li>
                <a href={`#${s.id}`}>{s.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="progress" aria-hidden="true"></div>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <div class="page">
        <p class="mono">
          資料：環境部空氣品質監測網 1982–2025 逐時觀測，341,442,552 筆。
          管線與分析全部開源。
        </p>
        {/*
          "資料匯出於", not "匯出於". The commit is the one the *data layers*
          were exported at, and the page is rebuilt on every push — so on any
          given day this sha is usually older than the code that rendered the
          page around it. Unqualified, it reads as the build's provenance and
          quietly overstates what is being traced.
        */}
        <p class="mono dim">
          資料匯出於 {generatedAt.slice(0, 10)}
          {gitSha ? ` · ${gitSha}` : ""}
        </p>
      </div>
    </footer>

    <style>
      .topbar {
        position: sticky;
        top: 0;
        z-index: 50;
        backdrop-filter: blur(12px);
        background: color-mix(in srgb, var(--bg) 86%, transparent);
        border-bottom: 1px solid var(--line-soft);
      }

      /*
       * Reading progress, drawn on the bar the reader is already looking at.
       *
       * This document is about thirty screens deep, and the honest answer to
       * "why does this feel long" is that it is long — nine chapters and ten
       * thousand characters. What it was missing is any way to tell how much of
       * that is left, which is the difference between a long read and an
       * endless one.
       *
       * Driven by a scroll-progress timeline, so there is no scroll listener
       * and nothing to keep in sync; where the timeline is unsupported the rule
       * simply never applies and the bar stays at zero width, which is a line
       * nobody notices rather than a broken control.
       */
      .progress {
        position: absolute;
        left: 0;
        bottom: -1px;
        height: 2px;
        width: 0;
        background: var(--accent);
        transform-origin: left;
      }

      @supports (animation-timeline: scroll()) {
        .progress {
          width: 100%;
          transform: scaleX(0);
          animation: read linear;
          animation-timeline: scroll(root block);
        }
      }

      @keyframes read {
        to {
          transform: scaleX(1);
        }
      }

      /* The bar reports position rather than drawing attention, and it is
         driven by scrolling rather than by time — but honour the preference
         anyway and let it jump instead of glide. */
      @media (prefers-reduced-motion: reduce) {
        .progress {
          transition: none;
        }
      }
      .topbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        height: 3.2rem;
      }
      .brand {
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text);
        text-decoration: none;
        white-space: nowrap;
      }
      .brand span {
        color: var(--text-faint);
        font-weight: 500;
      }
      .topbar ul {
        display: flex;
        gap: 1.1rem;
        list-style: none;
        margin: 0;
        padding: 0;
        overflow-x: auto;
        scrollbar-width: none;
        /* Without this the flex item refuses to shrink below its content and
           the nav pushes the page sideways on a phone. */
        min-width: 0;
      }
      .topbar ul::-webkit-scrollbar {
        display: none;
      }
      .topbar a {
        color: var(--text-muted);
        text-decoration: none;
        font-size: var(--text-sm);
        white-space: nowrap;
      }
      .topbar a:hover {
        color: var(--text);
      }
      footer {
        border-top: 1px solid var(--line-soft);
        padding: 2.5rem 0 4rem;
        color: var(--text-faint);
        font-size: var(--text-sm);
      }
      footer p {
        margin: 0 0 0.4rem;
        /* Not `none`. Unbounded, the provenance line ran the full 1,145px
           column at about 50 characters — the longest measure on the page, in
           the smallest type on it. It is prose, so it reads at the same width
           as prose. */
        max-width: var(--measure);
      }
      footer .dim {
        /* No alpha. `--text-faint` is already tuned to clear 4.5:1 against the
           page; knocking 30% off it composited to 3.10, and this line carries
           the export time and the commit the figures came from — the one thing
           on the page a reader might need to quote. */
        color: var(--text-faint);
      }
    </style>
  </body>
</html>
