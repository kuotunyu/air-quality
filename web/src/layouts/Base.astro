---
import "../styles/global.css";
import { generatedAt, gitSha } from "../lib/data";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const sections = [
  { id: "hero", label: "全台" },
  { id: "trend", label: "趨勢" },
  { id: "yours", label: "你住的地方" },
  { id: "detection", label: "偵測極限" },
  { id: "mistakes", label: "方法學對照" },
  { id: "explore", label: "自己查" },
  { id: "data", label: "資料" },
];
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230b0e13'/%3E%3Ccircle cx='16' cy='16' r='7' fill='%2322d3ee'/%3E%3C/svg%3E" />
  </head>
  <body>
    <a href="#hero" class="visually-hidden">跳到主要內容</a>

    <nav class="topbar" aria-label="章節">
      <div class="topbar-inner page">
        <a class="brand" href={base || "/"}>AirLens <span>Taiwan</span></a>
        <ul>
          {
            sections.map((s) => (
              <li>
                <a href={`#${s.id}`}>{s.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <div class="page">
        <p class="mono">
          資料：環境部空氣品質監測網 1982–2025 逐時觀測，341,442,552 筆。
          管線與分析全部開源。
        </p>
        <p class="mono dim">
          匯出於 {generatedAt.slice(0, 10)}
          {gitSha ? ` · ${gitSha}` : ""}
        </p>
      </div>
    </footer>

    <style>
      .topbar {
        position: sticky;
        top: 0;
        z-index: 50;
        backdrop-filter: blur(12px);
        background: color-mix(in srgb, var(--bg) 86%, transparent);
        border-bottom: 1px solid var(--line-soft);
      }
      .topbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        height: 3.2rem;
      }
      .brand {
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text);
        text-decoration: none;
        white-space: nowrap;
      }
      .brand span {
        color: var(--text-faint);
        font-weight: 500;
      }
      .topbar ul {
        display: flex;
        gap: 1.1rem;
        list-style: none;
        margin: 0;
        padding: 0;
        overflow-x: auto;
        scrollbar-width: none;
        /* Without this the flex item refuses to shrink below its content and
           the nav pushes the page sideways on a phone. */
        min-width: 0;
      }
      .topbar ul::-webkit-scrollbar {
        display: none;
      }
      .topbar a {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        white-space: nowrap;
      }
      .topbar a:hover {
        color: var(--text);
      }
      footer {
        border-top: 1px solid var(--line-soft);
        padding: 2.5rem 0 4rem;
        color: var(--text-faint);
        font-size: 0.82rem;
      }
      footer p {
        margin: 0 0 0.4rem;
        max-width: none;
      }
      footer .dim {
        color: color-mix(in srgb, var(--text-faint) 70%, transparent);
      }
    </style>
  </body>
</html>
