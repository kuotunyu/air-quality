---
import "../styles/global.css";
import { generatedAt, gitSha } from "../lib/data";
import { CHAPTERS, chapterLabel, href, neighbours } from "../lib/chapters";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

/*
 * Which chapter is open, so the nav can say so.
 *
 * `Astro.url.pathname` carries the configured base on a project site, so the
 * comparison is made on the last segment rather than on the whole path — that
 * way it is right both at `/trend` locally and at `/air-quality/trend` on
 * Pages, which is the mismatch that only shows up in production.
 */
const segment = Astro.url.pathname.replace(/\/+$/, "").split("/").pop() ?? "";
const here = CHAPTERS.find((c) => c.slug === segment) ?? null;

/*
 * The two moves a reader in a ten-part document actually wants, resolved here so
 * the bar can offer them without anyone opening a menu to find them.
 *
 * On the entry page there is no previous chapter and "next" is where the document
 * starts, which is why `next` falls back to the first chapter rather than to
 * nothing: an entry page whose forward control is missing gives the reader no
 * button to press.
 */
const step = here ? neighbours(here.slug) : { prev: null, next: CHAPTERS[0] };
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230b0e13'/%3E%3Ccircle cx='16' cy='16' r='7' fill='%2322d3ee'/%3E%3C/svg%3E" />
  </head>
  <body>
    <a href="#main" class="visually-hidden">跳到主要內容</a>

    <nav class="topbar" aria-label="章節">
      <div class="topbar-inner page">
        <a class="brand" href={href()}>air-<span>quality</span></a>

        {/*
          Where you are IS the control that shows where else you could go.

          The previous version put the chapter title in the bar as plain text and
          a separate 目錄 button beside it, and the objection was the right one:
          nothing suggests that a reader should go looking in a menu. So the
          label and the trigger are now one thing. Clicking where you are to see
          the other places you could be is the instinct people already have —
          it is how a breadcrumb, a file path and a tab strip all behave.

          The chevron points DOWN when closed. It pointed right, inherited from
          the site's disclosure styling, and a right-pointing chevron on a
          navigation control reads as "go" rather than "opens".
        */}
        <details class="menu">
          <summary>
            {
              here ? (
                <>
                  <span class="at-n">{chapterLabel(here.n)}</span>
                  <span class="at-t">{here.nav}</span>
                </>
              ) : (
                <span class="at-t">全部 {CHAPTERS.length} 章</span>
              )
            }
          </summary>

          <div class="menu-panel">
            <ol>
              {
                CHAPTERS.map((c) => (
                  <li>
                    <a
                      href={href(c.slug)}
                      aria-current={here?.slug === c.slug ? "page" : undefined}
                    >
                      <span class="menu-n">{chapterLabel(c.n)}</span>
                      <span class="menu-t">{c.title}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </div>
        </details>

        {/*
          And the move most readers want, spelled out rather than hidden.

          A labelled forward control needs no discovery at all: 「下一章」 is not
          a thing anyone has to work out. Back is icon-only because it is the
          rarer move and the label would cost the forward one its words on a
          narrow screen. Both name their destination to a screen reader.
        */}
        <div class="steps">
          {
            step.prev && (
              <a
                class="step-btn"
                href={href(step.prev.slug)}
                aria-label={`前一章：${step.prev.title}`}
                title={`前一章：${step.prev.title}`}
              >
                <span class="step-arrow" aria-hidden="true">←</span>
              </a>
            )
          }
          {
            step.next && (
              <a
                class="step-btn is-next"
                href={href(step.next.slug)}
                aria-label={`${here ? "下一章" : "開始讀"}：${step.next.title}`}
                title={`${here ? "下一章" : "開始讀"}：${step.next.title}`}
              >
                <span class="step-word">{here ? "下一章" : "開始讀"}</span>
                <span class="step-arrow" aria-hidden="true">→</span>
              </a>
            )
          }
        </div>
      </div>
      <div class="progress" aria-hidden="true"></div>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="page">
        <p class="mono">
          資料：環境部空氣品質監測網 1982–2025 逐時觀測，341,442,552 筆。
          管線與分析全部開源。
        </p>
        {/*
          "資料匯出於", not "匯出於". The commit is the one the *data layers*
          were exported at, and the page is rebuilt on every push — so on any
          given day this sha is usually older than the code that rendered the
          page around it. Unqualified, it reads as the build's provenance and
          quietly overstates what is being traced.
        */}
        <p class="mono dim">
          資料匯出於 {generatedAt.slice(0, 10)}
          {gitSha ? ` · ${gitSha}` : ""}
        </p>
      </div>
    </footer>

    <style>
      .topbar {
        position: sticky;
        top: 0;
        z-index: 50;
        backdrop-filter: blur(12px);
        background: color-mix(in srgb, var(--bg) 86%, transparent);
        border-bottom: 1px solid var(--line-soft);
      }

      /*
       * Reading progress, drawn on the bar the reader is already looking at.
       *
       * Per chapter now, not per document. When this was one 42-screen page the
       * bar was answering "how much of the whole thing is left"; with a route
       * per chapter it answers "how much of this chapter is left", which is the
       * question a reader on a 5-screen page actually has. The chapter's own
       * prev/next footer answers the other one.
       *
       * Driven by a scroll-progress timeline, so there is no scroll listener
       * and nothing to keep in sync; where the timeline is unsupported the rule
       * simply never applies and the bar stays at zero width, which is a line
       * nobody notices rather than a broken control.
       */
      .progress {
        position: absolute;
        left: 0;
        bottom: -1px;
        height: 2px;
        width: 0;
        background: var(--accent);
        transform-origin: left;
      }

      @supports (animation-timeline: scroll()) {
        .progress {
          width: 100%;
          transform: scaleX(0);
          animation: read linear;
          animation-timeline: scroll(root block);
        }
      }

      @keyframes read {
        to {
          transform: scaleX(1);
        }
      }

      /* The bar reports position rather than drawing attention, and it is
         driven by scrolling rather than by time — but honour the preference
         anyway and let it jump instead of glide. */
      @media (prefers-reduced-motion: reduce) {
        .progress {
          transition: none;
        }
      }
      .topbar-inner {
        display: flex;
        align-items: center;
        gap: clamp(0.9rem, 2.5vw, 2rem);
        /* Room for a 44px target with air around it. The bar was 3.2rem holding
           a 25px text run. */
        min-height: 3.4rem;
        /* The panel below anchors to this, so it has to be the containing block —
           and nothing here may clip, or the menu is cut off the way the old
           scrolling strip cut off its own links. */
        position: relative;
      }

      .brand {
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text);
        text-decoration: none;
        white-space: nowrap;
        font-size: var(--text-base);
      }

      .brand span {
        color: var(--text-faint);
        font-weight: 500;
      }

      /* ── where you are, and it is the menu trigger ────────────────────── */

      /*
       * The chapter label lives inside the `<summary>` now, so the styling that
       * used to sit on a separate `.whereami` paragraph belongs to the button.
       */
      .at-n {
        font-size: var(--text-sm);
        color: var(--text-faint);
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
        font-weight: 400;
      }

      .at-t {
        font-size: var(--text-lg);
        font-weight: 650;
        letter-spacing: -0.012em;
        color: var(--text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
      }

      /* ── the contents menu ────────────────────────────────────────────────── */

      /*
       * The site's own `<details>` styling already is a bordered raised box with
       * a chevron that rotates when it opens, so this reuses it rather than
       * building a second one — which also means the menu and the chapters'
       * disclosures stay recognisably the same control.
       *
       * What has to be undone is the parts that assume a full-width block: the
       * vertical margin (which added 42px to a sticky bar), and the bottom border
       * an open summary grows to meet content directly beneath it. This panel
       * floats, so there is nothing beneath the summary to meet.
       */
      .menu {
        margin: 0;
        /* Takes the slack, so the forward control stays pinned right whatever
           the chapter is called. */
        margin-right: auto;
        min-width: 0;
        position: relative;
      }

      .menu > summary {
        /* Was `--text-sm` at `--space-2` padding: a 34px control. The measured
           complaint was that nothing in the bar looked clickable, and a 44px box
           at body size is the answer to it. */
        min-height: 2.45rem;
        padding: 0 0.8rem;
        font-size: var(--text-base);
        color: var(--text);
        gap: 0.55em;
        align-items: baseline;
      }

      /* Baseline-aligned text needs the chevron pulled back onto the centre. */
      .menu > summary::before {
        align-self: center;
        order: 2;
        margin-left: 0.15em;
      }

      /*
       * Down when closed, up when open. The site's disclosure rule points this
       * chevron right at rest, which is correct for "expands downward into the
       * flow" and wrong for a control in a navigation bar, where a right-pointing
       * arrow means "takes you somewhere".
       */
      .menu > summary::before {
        transform: rotate(45deg);
      }

      .menu[open] > summary::before {
        transform: rotate(-135deg);
      }

      .menu[open] > summary {
        border-bottom: 0;
        border-radius: var(--radius);
      }

      .menu > summary:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .menu-panel {
        position: absolute;
        top: calc(100% + 0.5rem);
        /*
         * Opens rightward from the trigger's left edge, not leftward from its
         * right. The trigger moved to the left of the bar when it absorbed the
         * chapter label, and a panel anchored `right: 0` then hangs off the left
         * of the screen — measured at 375px it started at -163px. Anchoring left
         * and clamping the width to the viewport is the version that cannot do
         * that at any width.
         */
        left: 0;
        z-index: var(--z-overlay);
        width: min(24rem, calc(100vw - 2rem));
        max-height: min(70vh, 34rem);
        overflow-y: auto;
        background: var(--bg-raised);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        /* A defined shadow, not a border plus a wide soft glow: the panel needs
           to sit above the page, and 10px of blur says so without haze. */
        box-shadow: 0 6px 10px oklch(0 0 0 / 0.09);
      }

      .menu-panel ol {
        margin: 0;
        padding: 0.35rem;
        list-style: none;
      }

      .menu-panel a {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: baseline;
        gap: 0 0.7rem;
        /* Every row is a comfortable target rather than a line of text that
           happens to be a link. */
        padding: 0.6rem 0.7rem;
        border-radius: calc(var(--radius) - 4px);
        text-decoration: none;
        color: var(--text);
      }

      .menu-panel a:hover,
      .menu-panel a:focus-visible {
        background: var(--bg-sunken);
      }

      .menu-n {
        font-size: var(--text-sm);
        color: var(--text-faint);
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
      }

      .menu-t {
        font-size: var(--text-base);
      }

      /* The chapter you are on, marked in the list as well as in the bar. */
      .menu-panel a[aria-current="page"] {
        background: var(--tint-neutral);
      }

      .menu-panel a[aria-current="page"] .menu-t {
        font-weight: 650;
      }

      .menu-panel a[aria-current="page"] .menu-n {
        color: var(--accent);
      }

      /* ── forward and back ─────────────────────────────────────────────── */

      .steps {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex: none;
      }

      .step-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4em;
        min-height: 2.45rem;
        padding: 0 0.7rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--bg-raised);
        color: var(--text-muted);
        text-decoration: none;
        font-size: var(--text-sm);
        font-weight: 600;
        white-space: nowrap;
        transition:
          border-color 180ms cubic-bezier(0.22, 1, 0.36, 1),
          background-color 180ms cubic-bezier(0.22, 1, 0.36, 1),
          color 180ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .step-btn:hover,
      .step-btn:focus-visible {
        border-color: var(--rule);
        background: var(--bg-sunken);
        color: var(--text);
      }

      /* The forward move is the one most readers want, so it is the one with
         words on it. */
      .step-btn.is-next {
        color: var(--text);
      }

      .step-arrow {
        font-size: var(--text-base);
        line-height: 1;
      }

      /* Below 34rem the label would push the chapter title to an ellipsis of two
         characters. The arrow alone still says which way it goes, and the
         accessible name keeps the destination. */
      @media (max-width: 34rem) {
        .step-word {
          position: absolute;
          width: 1px;
          height: 1px;
          overflow: hidden;
          clip-path: inset(50%);
          white-space: nowrap;
        }
        .step-btn {
          padding: 0 0.55rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .step-btn {
          transition: none;
        }
      }

      /* Below this the chapter title and a bordered button cannot share the row
         with the brand without one of them truncating to nothing. The brand is
         the thing a reader can afford to lose: they know what site they are on. */
      @media (max-width: 26rem) {
        .brand {
          display: none;
        }
      }

      footer {
        border-top: 1px solid var(--line-soft);
        padding: 2.5rem 0 4rem;
        color: var(--text-faint);
        font-size: var(--text-sm);
      }
      footer p {
        margin: 0 0 0.4rem;
        /* Not `none`. Unbounded, the provenance line ran the full 1,145px
           column at about 50 characters — the longest measure on the page, in
           the smallest type on it. It is prose, so it reads at the same width
           as prose. */
        max-width: var(--measure);
      }
      footer .dim {
        /* No alpha. `--text-faint` is already tuned to clear 4.5:1 against the
           page; knocking 30% off it composited to 3.10, and this line carries
           the export time and the commit the figures came from — the one thing
           on the page a reader might need to quote. */
        color: var(--text-faint);
      }
    </style>
  </body>
</html>
