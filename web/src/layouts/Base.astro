---
import "../styles/global.css";
import { generatedAt, gitSha } from "../lib/data";
import { CHAPTERS, href } from "../lib/chapters";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

/*
 * Which chapter is open, so the nav can say so.
 *
 * `Astro.url.pathname` carries the configured base on a project site, so the
 * comparison is made on the last segment rather than on the whole path — that
 * way it is right both at `/trend` locally and at `/air-quality/trend` on
 * Pages, which is the mismatch that only shows up in production.
 */
const segment = Astro.url.pathname.replace(/\/+$/, "").split("/").pop() ?? "";
const current = CHAPTERS.find((c) => c.slug === segment)?.slug ?? null;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230b0e13'/%3E%3Ccircle cx='16' cy='16' r='7' fill='%2322d3ee'/%3E%3C/svg%3E" />
  </head>
  <body>
    <a href="#main" class="visually-hidden">跳到主要內容</a>

    <nav class="topbar" aria-label="章節">
      <div class="topbar-inner page">
        <a class="brand" href={base || "/"}>air-<span>quality</span></a>
        <ul>
          {
            CHAPTERS.map((c) => (
              <li>
                <a
                  href={href(c.slug)}
                  aria-current={current === c.slug ? "page" : undefined}
                >
                  {c.nav}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="progress" aria-hidden="true"></div>
    </nav>

    {/*
      Bring the open chapter into view in the nav strip.

      With ten routes the bar is wider than a phone and scrolls horizontally, so
      on 第八章 the marked item sits off-screen to the right and the navigation
      shows the reader everything except where they are. Four lines, no
      dependency, and `instant` because this is not a transition the reader
      asked for — it is the bar being drawn in the right place to begin with.

      Without JavaScript the strip simply starts at the left, which is the
      behaviour it had before. Nothing here gates content on script.
    */}
    <script is:inline>
      (() => {
        const strip = document.querySelector(".topbar ul");
        const here = document.querySelector('.topbar a[aria-current="page"]');
        if (!strip || !here) return;
        // Set scrollLeft on the strip rather than calling scrollIntoView: that
        // method is free to scroll any ancestor, including the document, and the
        // one thing this must not do is move the page the reader just opened.
        //
        // Measured from bounding rects, not `offsetLeft`. `.topbar` is sticky,
        // which makes it a positioned ancestor, so `offsetLeft` is the distance
        // from the BAR — brand and page padding included — rather than from the
        // scroller. Using it centred 趨勢 at scrollLeft 36 when the right answer
        // was 0, and left 方法學對照 cut off at the edge.
        const strip_rect = strip.getBoundingClientRect();
        const here_rect = here.getBoundingClientRect();
        strip.scrollLeft +=
          here_rect.left - strip_rect.left - (strip_rect.width - here_rect.width) / 2;
      })();
    </script>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="page">
        <p class="mono">
          資料：環境部空氣品質監測網 1982–2025 逐時觀測，341,442,552 筆。
          管線與分析全部開源。
        </p>
        {/*
          "資料匯出於", not "匯出於". The commit is the one the *data layers*
          were exported at, and the page is rebuilt on every push — so on any
          given day this sha is usually older than the code that rendered the
          page around it. Unqualified, it reads as the build's provenance and
          quietly overstates what is being traced.
        */}
        <p class="mono dim">
          資料匯出於 {generatedAt.slice(0, 10)}
          {gitSha ? ` · ${gitSha}` : ""}
        </p>
      </div>
    </footer>

    <style>
      .topbar {
        position: sticky;
        top: 0;
        z-index: 50;
        backdrop-filter: blur(12px);
        background: color-mix(in srgb, var(--bg) 86%, transparent);
        border-bottom: 1px solid var(--line-soft);
      }

      /*
       * Reading progress, drawn on the bar the reader is already looking at.
       *
       * Per chapter now, not per document. When this was one 42-screen page the
       * bar was answering "how much of the whole thing is left"; with a route
       * per chapter it answers "how much of this chapter is left", which is the
       * question a reader on a 5-screen page actually has. The chapter's own
       * prev/next footer answers the other one.
       *
       * Driven by a scroll-progress timeline, so there is no scroll listener
       * and nothing to keep in sync; where the timeline is unsupported the rule
       * simply never applies and the bar stays at zero width, which is a line
       * nobody notices rather than a broken control.
       */
      .progress {
        position: absolute;
        left: 0;
        bottom: -1px;
        height: 2px;
        width: 0;
        background: var(--accent);
        transform-origin: left;
      }

      @supports (animation-timeline: scroll()) {
        .progress {
          width: 100%;
          transform: scaleX(0);
          animation: read linear;
          animation-timeline: scroll(root block);
        }
      }

      @keyframes read {
        to {
          transform: scaleX(1);
        }
      }

      /* The bar reports position rather than drawing attention, and it is
         driven by scrolling rather than by time — but honour the preference
         anyway and let it jump instead of glide. */
      @media (prefers-reduced-motion: reduce) {
        .progress {
          transition: none;
        }
      }
      .topbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        height: 3.2rem;
      }
      .brand {
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text);
        text-decoration: none;
        white-space: nowrap;
      }
      .brand span {
        color: var(--text-faint);
        font-weight: 500;
      }
      .topbar ul {
        display: flex;
        gap: 1.1rem;
        list-style: none;
        margin: 0;
        padding: 0;
        overflow-x: auto;
        scrollbar-width: none;
        /* Without this the flex item refuses to shrink below its content and
           the nav pushes the page sideways on a phone. */
        min-width: 0;
      }
      .topbar ul::-webkit-scrollbar {
        display: none;
      }
      .topbar a {
        color: var(--text-muted);
        text-decoration: none;
        font-size: var(--text-sm);
        white-space: nowrap;
      }
      .topbar a:hover {
        color: var(--text);
      }
      /* The nav went from eleven in-page anchors to eleven links to other pages,
         and a list of links to elsewhere has to say which one is here — otherwise
         the reader's own position is the one thing the navigation does not tell
         them. Weight and ink, plus an underline that sits on the bar's own edge
         rather than under the word, so the marker cannot be mistaken for a hover
         state. */
      .topbar a[aria-current="page"] {
        color: var(--text);
        font-weight: 650;
      }
      .topbar a[aria-current="page"]::after {
        content: "";
        display: block;
        height: 2px;
        margin-top: 0.42rem;
        background: var(--accent);
      }
      footer {
        border-top: 1px solid var(--line-soft);
        padding: 2.5rem 0 4rem;
        color: var(--text-faint);
        font-size: var(--text-sm);
      }
      footer p {
        margin: 0 0 0.4rem;
        /* Not `none`. Unbounded, the provenance line ran the full 1,145px
           column at about 50 characters — the longest measure on the page, in
           the smallest type on it. It is prose, so it reads at the same width
           as prose. */
        max-width: var(--measure);
      }
      footer .dim {
        /* No alpha. `--text-faint` is already tuned to clear 4.5:1 against the
           page; knocking 30% off it composited to 3.10, and this line carries
           the export time and the commit the figures came from — the one thing
           on the page a reader might need to quote. */
        color: var(--text-faint);
      }
    </style>
  </body>
</html>
