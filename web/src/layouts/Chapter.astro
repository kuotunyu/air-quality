---
/**
 * One chapter, one page.
 *
 * Everything a chapter page needs beyond its own content: the title in the tab,
 * and the footer that says where you are in a ten-part document and where to go
 * next. The chapter's own `<section>` still carries its marker and heading, so a
 * chapter component is unchanged by being routed — that is the point of doing
 * the split this way rather than rewriting ten components.
 *
 * The prev/next pair is not decoration. A sequential document read one page at a
 * time has to answer "what comes after this" without sending the reader back to
 * an index, and it is the only affordance that makes ten routes feel like one
 * document rather than ten pages that happen to share a stylesheet.
 */
import Base from "./Base.astro";
import { CHAPTERS, chapterBySlug, chapterLabel, href, neighbours } from "../lib/chapters";

interface Props {
  slug: string;
  /** Overrides the registry's `claim` for the page description when a chapter
   *  wants a longer one. Most do not. */
  description?: string;
}

const { slug, description } = Astro.props;
const chapter = chapterBySlug(slug);
const { prev, next } = neighbours(slug);
const position = !prev ? "first" : !next ? "last" : "middle";
---

<Base
  title={`${chapterLabel(chapter.n)}　${chapter.title} — air-quality`}
  description={description ?? chapter.claim}
>
  <slot />

  <nav
    class="chapter-nav page"
    aria-label="章節導覽"
    data-chapter-position={position}
  >
    <div class="chapter-nav-panel">
      <div class="chapter-nav-head">
        <span
          class="chapter-progress"
          data-chapter-progress
          aria-label={`目前是第 ${chapter.n} 章，共 ${CHAPTERS.length} 章`}
        >
          {chapter.n} / {CHAPTERS.length}
        </span>
        <a class="chapter-index-link" href={href()} data-dir="up">全部章節</a>
      </div>

      <div class="chapter-nav-actions">
        {
          prev && (
            <a class="step" href={href(prev.slug)} data-dir="prev">
              <span class="step-arrow" aria-hidden="true">←</span>
              <span class="step-copy">
                <span class="step-role">上一章 · {chapterLabel(prev.n)}</span>
                <span class="step-title">{prev.title}</span>
              </span>
            </a>
          )
        }

        {
          next && (
            <a class="step" href={href(next.slug)} data-dir="next">
              <span class="step-copy">
                <span class="step-role">下一章 · {chapterLabel(next.n)}</span>
                <span class="step-title">{next.title}</span>
              </span>
              <span class="step-arrow" aria-hidden="true">→</span>
            </a>
          )
        }
      </div>
    </div>
  </nav>
</Base>

<style>
  .chapter-nav {
    padding-block: var(--space-3);
  }

  /* 2026-09-02 — a panel: a surface without a line around it, the rule the
     concept diagrams settled on. A raised card with a border is what a figure
     or a disclosure gets; the chapter's navigation is furniture, and it sits in
     the page's recess. */
  .chapter-nav-panel {
    border: 0;
    border-radius: var(--radius);
    background: var(--bg-sunken);
  }

  .chapter-nav-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 44px;
    padding-inline: var(--space-3) var(--space-2);
    border-bottom: 1px solid var(--line-soft);
  }

  .chapter-progress {
    color: var(--text-faint);
    font-family: var(--font-numeric);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .chapter-index-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 650;
    text-decoration: none;
    transition:
      background-color 160ms cubic-bezier(0.22, 1, 0.36, 1),
      color 160ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .chapter-index-link:hover,
  .chapter-index-link:focus-visible {
    color: var(--accent);
    background: var(--tint-neutral);
  }

  .chapter-nav-actions {
    display: grid;
  }

  /* Two neighbours share the row only when a chapter has both of them. At the
     two endpoints the one real action owns the row instead of leaving a blank
     column where a fake 「序／跋」 item used to sit. */
  @media (min-width: 46rem) {
    .chapter-nav[data-chapter-position="middle"] .chapter-nav-actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .chapter-nav[data-chapter-position="middle"] .step + .step {
      border-top: 0;
      border-left: 1px solid var(--line-soft);
    }

    .chapter-nav[data-chapter-position="middle"] .step:first-child {
      border-end-start-radius: calc(var(--radius) - 1px);
    }

    .chapter-nav[data-chapter-position="middle"] .step:last-child {
      border-end-start-radius: 0;
      border-end-end-radius: calc(var(--radius) - 1px);
    }
  }

  .step {
    display: grid;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    min-height: 76px;
    padding: var(--space-2) var(--space-3);
    color: var(--text);
    text-decoration: none;
    transition:
      background-color 160ms cubic-bezier(0.22, 1, 0.36, 1),
      color 160ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .step[data-dir="prev"] {
    grid-template-columns: auto minmax(0, 1fr);
  }

  .step[data-dir="next"] {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .step + .step {
    border-top: 1px solid var(--line-soft);
  }

  .step:only-child,
  .step:last-child {
    border-end-start-radius: calc(var(--radius) - 1px);
    border-end-end-radius: calc(var(--radius) - 1px);
  }

  .step-copy {
    display: grid;
    min-width: 0;
    gap: 0.15rem;
  }

  .step[data-dir="next"] .step-copy {
    justify-items: end;
    text-align: right;
  }

  .step-arrow {
    color: var(--text-faint);
    font-family: var(--font-numeric);
    font-size: var(--text-lg);
    line-height: 1;
    transition: color 160ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .step-role {
    font-size: var(--text-sm);
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .step-title {
    font-size: var(--text-lg);
    font-weight: 650;
    letter-spacing: -0.01em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .step:hover,
  .step:focus-visible {
    background: var(--tint-neutral);
  }

  .step:hover :is(.step-title, .step-arrow),
  .step:focus-visible :is(.step-title, .step-arrow) {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .chapter-index-link,
    .step,
    .step-arrow {
      transition: none;
    }
  }
</style>
