---
import { chapterBySlug, chapterLabel } from "../lib/chapters";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const chapter = chapterBySlug(slug);
---

<header class="chapter-intro">
  <p class="eyebrow">{chapterLabel(chapter.n)}</p>
  <h1>{chapter.title}</h1>
  <div class="chapter-thesis">
    <slot />
  </div>
  {Astro.slots.has("reading-map") && <slot name="reading-map" />}
</header>
