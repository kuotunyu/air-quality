---
/**
 * Chapter 7 — a method against a better method.
 *
 * The comparison is between two ways of doing the analysis, never between
 * people. Every chart here is computed from the raw data by this project.
 * See docs/legal.md.
 *
 * Every number on this page comes from `story/pitfalls.json` (pitfalls 01-06)
 * or `story/imputation.json` (07), both copied verbatim from the M3 and M11
 * evidence tables. Nothing is retyped, so the chapter cannot drift away from
 * the analysis it describes.
 */
import { pitfallTables, imputationEvidence } from "../lib/data";
import { axisNumber, linePath, linear, markInk, n, nFixed, padded, smoothPath, ticks, xLabelBucket, yGutter } from "../lib/chart";
import { compass, SYNTHETIC_DATA } from "../lib/labels";
import ChapterIntro from "./ChapterIntro.astro";
import EvidenceFigure from "./EvidenceFigure.astro";

type Row = Record<string, any>;
const t = (name: string) => (pitfallTables[name] ?? []) as Row[];

// --- 1. the diurnal cycle a monthly mean cannot see -------------------------
const diurnal = t("diurnal_diurnal");
const weekly = t("diurnal_weekly");
const variance = t("diurnal_variance");
/* `station_month` is the aggregation the baseline performs — one value per
   station per month, 7,269 in this store over the same window. `monthly_mean`
   additionally pools every station into one national series, which is a second
   and separate loss. This paragraph used to quote the pooled figure while
   naming the per-station aggregation, charging it with losing variance it kept:
   20.3% where the per-station aggregation retains 40.3%. The difference is
   almost exactly the between-station variance. */
const retained = (variance.find((r) => r.scale === "station_month")?.variance_retained ?? 0) as number;
const pooledRetained = (variance.find((r) => r.scale === "monthly_mean")?.variance_retained ?? 0) as number;
const hourlySd = (variance.find((r) => r.scale === "hourly")?.sd ?? 0) as number;
const monthlySd = (variance.find((r) => r.scale === "station_month")?.sd ?? 0) as number;
const pooledSd = (variance.find((r) => r.scale === "monthly_mean")?.sd ?? 0) as number;

const diurnalValues = diurnal.map((r) => r.mean as number);
const diurnalPeak = diurnal.reduce((a, b) => (a.mean > b.mean ? a : b), diurnal[0]);
const diurnalTrough = diurnal.reduce((a, b) => (a.mean < b.mean ? a : b), diurnal[0]);

// --- 2. the PM10 leak -------------------------------------------------------
const leak = t("leakage_price");
const withPm10 = leak.find((r) => r.feature_set === "full_with_pm10");
const withoutPm10 = leak.find((r) => r.feature_set === "full");
const leakShare = leak.find((r) => r.feature_set === "leak_share_of_r2");

// --- 3. wind direction ------------------------------------------------------
const windEncoding = t("wind_linear_model_encoding");
const sinCos = windEncoding.find((r) => r.encoding === "sin_cos");
const bySector = t("wind_by_sector");
const sectorHigh = bySector.reduce((a, b) => (a.mean > b.mean ? a : b), bySector[0]);
const sectorLow = bySector.reduce((a, b) => (a.mean < b.mean ? a : b), bySector[0]);
const windSummary = Object.fromEntries(
  t("wind_summary").map((r) => [r.measure as string, r.value as number]),
);

// --- 4. the normality test --------------------------------------------------
const normality = t("normality_by_sample_size");

// --- 5. collinearity --------------------------------------------------------
const stability = t("collinearity_stability");
const collinearR2 = t("collinearity_r_squared");

// --- 6. in-sample vs out-of-sample -----------------------------------------
const validation = t("validation_in_vs_out_of_sample");
const inSample = validation.find((r) => r.evaluated_on === "in_sample");
const outSample = validation.find((r) => r.evaluated_on === "out_of_sample");
const optimism = validation.find((r) => r.evaluated_on === "optimism_r2");

// --- 7. the one sentence about missing values -------------------------------
const gapBuckets = imputationEvidence.buckets;
const pooledBy = Object.fromEntries(imputationEvidence.pooled.map((r) => [r.strategy, r]));
const gapDist = Object.fromEntries(imputationEvidence.distribution.map((r) => [r.gap_bucket, r]));

// A series is null where its strategy declined to answer, and `linePath`
// breaks at nulls — so interpolation's line simply stops at its 3-hour limit
// rather than being drawn flat across gaps it never touched.
// Three gap-filling strategies are three KINDS, so they wear the categorical
// set. They used to be c3, c2, c1 — three ADJACENT steps of the concentration
// ramp, which is both a false statement (a strategy is not a μg/m³ bin) and the
// closest three colours the ramp had to offer: worst pair dE00 9.7, against
// 34.1 now. Dashes carry the same distinction a second time, so the three are
// still three in greyscale, in print, and to a reader who sees no hue at all.
const GAP_SERIES = [
  { key: "interpolate", label: "線性內插", colour: "var(--k0)", dash: undefined },
  { key: "iterative", label: "多變量疊代", colour: "var(--k1)", dash: "7 4" },
  { key: "neighbor", label: "鄰近測站（有缺陷的做法）", colour: "var(--k2)", dash: "2 3" },
].map((series) => {
  const values = gapBuckets.map(
    (bucket) =>
      imputationEvidence.by_gap.find(
        (row) => row.strategy === series.key && row.gap_bucket === bucket,
      )?.mae ?? null,
  );
  let lastIndex = -1;
  values.forEach((value, index) => {
    if (value != null) lastIndex = index;
  });
  return { ...series, values, lastIndex, lastValue: values[lastIndex] ?? null };
});

const gapValues = GAP_SERIES.flatMap((s) => s.values).filter((v): v is number => v != null);
const gDomain = padded(gapValues, { zero: true });
const gx = (index: number) => (100 / (gapBuckets.length - 1)) * index;
const gy = linear(gDomain, [100, 0]);
const gTicks = ticks(gDomain[0], gDomain[1], 4);

/*
 * 1 is Monday.
 *
 * The column printed the bare integers 1–7, and nothing on the page said which
 * end was which — on a table whose claim is that the weekday effect is small,
 * "small compared to what" needs the reader to know whether 6 and 7 are the
 * weekend. `pitfalls.py` groups by Polars' `dt.weekday()`, which is ISO;
 * confirmed against a known Monday rather than taken from the docs:
 * 2026-08-03 is a Monday and returns 1, 2026-08-09 is a Sunday and returns 7.
 */
const WEEKDAY_NAMES = ["週一", "週二", "週三", "週四", "週五", "週六", "週日"];

const METHOD_CASES = [
  { number: "01", id: "method-case-01", title: "月平均抹掉了六成的變異" },
  { number: "02", id: "method-case-02", title: "拿 PM10 預測 PM2.5" },
  { number: "03", id: "method-case-03", title: "把風向當成 0 到 360 的普通數字" },
  { number: "04", id: "method-case-04", title: "把及格標準調低，好讓資料通過檢定" },
  { number: "05", id: "method-case-05", title: "NO + NO₂ = NOx，三個一起放進模型" },
  { number: "06", id: "method-case-06", title: "只用模型學過的資料評斷它" },
  { number: "07", id: "method-case-07", title: "用一句話處理掉所有缺漏值" },
] as const;

// --- small inline chart for the diurnal cycle -------------------------------
const dDomain = padded(diurnalValues, { zero: false });
const dx = linear([0, 23], [0, 100]);
const dy = linear(dDomain, [100, 0]);
const dMean = diurnalValues.reduce((a, b) => a + b, 0) / diurnalValues.length;
const dTicks = ticks(dDomain[0], dDomain[1], 4);
---

<section id="methods" class="page">
  <ChapterIntro slug="methods">
  <p class="lede">
    這一章的對照組是一組常見但有缺陷的分析做法。
    下面反覆出現的 PM10 與 PM2.5 是兩種粒徑—10 微米以下與 2.5 微米以下。
  </p>
  </ChapterIntro>

  <nav
    class="method-case-index"
    data-method-case-index
    aria-labelledby="method-case-index-title"
  >
    <h2 id="method-case-index-title">七個案例索引</h2>
    <ol>
      {METHOD_CASES.map((entry) => (
        <li>
          <a data-method-case-link data-case={entry.number} href={`#${entry.id}`}>
            <span class="num" aria-hidden="true">{entry.number}</span>
            <span>{entry.title}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <!-- ─── 錯誤一 ─── -->
  <article class="mistake" id={METHOD_CASES[0].id} data-method-case={METHOD_CASES[0].number}>
    <h2><span class="num" aria-hidden="true">{METHOD_CASES[0].number}</span> <span>{METHOD_CASES[0].title}</span></h2>

    <p>
      被丟掉的是什麼？下圖是日內節律，一個看得見、也最容易說明的成分。
    </p>

    <div class="two-up">
      <EvidenceFigure number="8.1" title="月平均隱藏了多少逐時變異？" primary>
        <div class="chart">
          <div
            class="plot"
            data-readout
            style={`--plot-ar:36;--plot-min:220px;--plot-max:320px;--y-w:${yGutter(dTicks.map((t) => n(t, 0)))}px;--y-lo:${dDomain[0]};--y-hi:${dDomain[1]}`}
          >
            <script
              type="application/json"
              class="plot-readout-data"
              is:inline
              set:html={JSON.stringify({
              x: diurnalValues.map((_, h) => `${h} 時`),
              unit: "PM2.5 μg/m³",
              places: 1,
              series: [
                {
                  label: "日內平均",
                  colour: "var(--k0)",
                  ink: markInk("var(--k0)"),
                  values: diurnalValues,
                },
              ],
            })}
            />

            <div class="plot-y">
              {dTicks.map((tick) => <span style={`top:${n(dy(tick), 3)}%`}>{axisNumber(n(tick, 0))}</span>)}
            </div>

            <div class="plot-area" data-primary-plot>
              <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                {
                  dTicks.map((tick) => (
                    <line
                      x1="0"
                      x2="100"
                      y1={n(dy(tick), 3)}
                      y2={n(dy(tick), 3)}
                      class="plot-grid"
                      vector-effect="non-scaling-stroke"
                    />
                  ))
                }
                <line
                  x1="0"
                  x2="100"
                  y1={n(dy(dMean), 3)}
                  y2={n(dy(dMean), 3)}
                  stroke="var(--text-faint)"
                  stroke-width="1.5"
                  stroke-dasharray="5 4"
                  vector-effect="non-scaling-stroke"
                />
                <path
                  d={linePath(diurnalValues, (i) => dx(i), (v) => dy(v))}
                  class="plot-line"
                  stroke="var(--k0)"
                  vector-effect="non-scaling-stroke"
                />
              </svg>

              <span class="plot-note" style={`top:${n(dy(dMean), 3)}%;color:var(--text-faint)`}>
                月平均看到的只有這條線
              </span>
            </div>

            <div class="plot-x" data-n={5} data-tw={xLabelBucket(["0 時", "6 時", "12 時", "18 時", "23 時"])}>
              {[0, 6, 12, 18, 23].map((hour) => <span style={`left:${n(dx(hour), 3)}%`}>{hour}時</span>)}
            </div>
          </div>
        </div>
        <Fragment slot="caption">
          2010–2017 年逐時 PM2.5 的日內平均。峰值在 {diurnalPeak.hour} 時
          （{n(diurnalPeak.mean)} μg/m³），谷底在 {diurnalTrough.hour} 時
          （{n(diurnalTrough.mean)} μg/m³）。月平均把整條曲線壓成一個點。
        </Fragment>
      </EvidenceFigure>

      <div class="verdict">
        <div class="stat">
          <span class="stat-value" style="color:var(--c5-ink)">{n(retained * 100, 1)}%</span>
          <span class="stat-label">月平均保留的變異比例</span>
          <span class="stat-note">
            標準差 {n(hourlySd)} → {n(monthlySd)} μg/m³
          </span>
        </div>
      </div>
    </div>

    <p>
      基準的方法是：取 2010–2017 年的月平均、12 個解釋變數、
      Pearson 相關、逐步剔除的 OLS。這在當時是標準做法。
      本專案把它實際配適出來，面板是 6,771 個站月、72 個測站—
      這個數字是量出來的，不是引用來的。
    </p>

    <p>
      下面每一張圖、每一個數字都是本專案用原始資料算出來的。
      要比較的只有方法選擇：每一項都用同一份資料做兩次，
      一次用有缺陷的做法，一次用修正後的做法，然後看結論差多少。
    </p>

    <p>
      先說結論：有些選擇無關痛癢，有些讓整個模型的解釋力高估了三分之一。
      這些做法是整個世代的環境統計慣例，跟誰粗心無關—
      同一批做法在那個時期的期刊論文裡到處都是。
    </p>

    <div class="note">
      <strong>兩邊必須跑在同一批列上。</strong>
      有缺陷的那一版是實際配適出來的基準模型，不是描述—
      它的係數、VIF 與共線性病理都完整保存在管線的基準模型產物裡。
      沒有這一步，後面所有「修正之後結論不同」的宣稱都無從驗證。
    </div>

    <p>
      2010–2017 年逐時 PM2.5 的標準差是 {n(hourlySd)} μg/m³。
      壓成「每站每月一個值」之後只剩 {n(monthlySd)} μg/m³—
      變異保留了 {n(retained * 100, 1)}%。
      在月平均上配適的模型無論怎麼調，能解釋的上限就是這剩下的四成。
    </p>

    <p class="small">
      這裡要小心一件事，我們自己先弄錯過：如果再把各站併成單一的全台月序列，
      保留率會掉到 {n(pooledRetained * 100, 1)}%（標準差 {n(pooledSd)} μg/m³）。
      那個數字曾經是本節的標題，但它不是這個基準做的事—
      基準保留了測站維度（這段期間的站月聚合共有 7,269 筆，實際配適的面板是其中的 6,771 筆）。
      兩者的差額幾乎剛好是測站之間的變異：
      逐時變異中，月份解釋 {n(pooledRetained * 100, 1)}%，「測站 × 月份」解釋 {n(retained * 100, 1)}%。
      把後面那 20 個百分點也算到「月平均」頭上，是把空間的損失記在時間帳上。
    </p>

    <div class="note">
      <strong>把話說準：日夜節律只是被丟掉的一小部分。</strong>
      日內振幅是 {n(diurnalPeak.mean - diurnalTrough.mean)} μg/m³，
      相對於 {n(hourlySd)} 的整體標準差並不大。
      消失的大宗是逐日到綜觀尺度的變化—
      境外傳輸的高濃度事件、鋒面過境、逆溫累積。
      一個 40 μg/m³ 的污染日和一個 10 μg/m³ 的乾淨日落在同一個月，
      月平均只留下 25，兩者都不見了。
      日內節律容易說明、容易繪製，但它不是主要的損失來源，這裡不把它當成主要證據。
    </div>

    {
      weekly.length > 0 && (
        <details>
          <summary>週間變化（月平均同樣看不到）</summary>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>星期</th>
                  <th class="num">PM2.5 平均</th>
                  <th class="num">小時數</th>
                </tr>
              </thead>
              <tbody>
                {weekly.map((row) => (
                  <tr>
                    <td>{WEEKDAY_NAMES[(row.weekday as number) - 1] ?? row.weekday}</td>
                    <td class="num">{n(row.mean)}</td>
                    <td class="num">{(row.n as number).toLocaleString()}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      )
    }
  </article>

  <!-- ─── 錯誤二 ─── -->
  <article class="mistake" id={METHOD_CASES[1].id} data-method-case={METHOD_CASES[1].number}>
    <h2><span class="num" aria-hidden="true">{METHOD_CASES[1].number}</span> <span>{METHOD_CASES[1].title}</span></h2>

    <p>
      這個基準裡最顯著的變數是 PM10。
      問題是 <strong>PM2.5 在定義上就是 PM10 的一部分</strong>—
      PM10 是直徑 10 微米以下的顆粒，PM2.5 是 2.5 微米以下的，後者被前者包含。
      這等於把答案的一部分放進題目。
    </p>

    <p>
      要量化它的代價，只需要把同一個模型跑兩次：一次讓 PM10 進去，一次不讓。
    </p>

    <div class="compare">
      <div class="card">
        <span class="tag bad">含 PM10（有缺陷的做法）</span>
        <span class="stat-value">{n(withPm10?.r2 as number, 3)}</span>
        <span class="stat-label">R²</span>
        <span class="stat-note">RMSE {n(withPm10?.rmse as number, 2)}</span>
      </div>
      <div class="arrow" aria-hidden="true">→</div>
      <div class="card">
        <span class="tag good">不含 PM10</span>
        <span class="stat-value">{n(withoutPm10?.r2 as number, 3)}</span>
        <span class="stat-label">R²</span>
        <span class="stat-note">RMSE {n(withoutPm10?.rmse as number, 2)}</span>
      </div>
    </div>

    <div class="note caveat">
      {n((leakShare?.r2 as number) * 100, 1)}% —
      含 PM10 的模型有三分之一的解釋力，來自這個定義上的重疊。
      那個顯著性所支撐的就是這一部分。
    </div>
  </article>

  <!-- ─── 錯誤三 ─── -->
  <article class="mistake" id={METHOD_CASES[2].id} data-method-case={METHOD_CASES[2].number}>
    <h2><span class="num" aria-hidden="true">{METHOD_CASES[2].number}</span> <span>{METHOD_CASES[2].title}</span></h2>

    <p>
      風向是圓形變數：359° 和 1° 相差 2 度，不是 358 度。
      把 WD_HR 直接丟進相關分析與迴歸，會得到很小的相關係數，
      於是結論寫成「風向與 PM2.5 無相關」。這個基準算出的是
      {" "}{n(windSummary.pearson_r_with_raw_bearing, 3)}，數量級一致。
    </p>

    <p>
      但把同一份資料按 30° 分組，最高的 {compass(sectorHigh?.sector as number)}
      是 {n(sectorHigh?.mean as number)} μg/m³，最低的
      {" "}{compass(sectorLow?.sector as number)} 是 {n(sectorLow?.mean as number)} μg/m³—
      相差 {n(windSummary.sector_mean_range)} μg/m³，
      是整體平均的 {n(windSummary.sector_range_as_pct_of_mean, 0)}%。
      方向依賴一直都在，是線性相關係數看不見它。
    </p>

    <p class="small">
      風向採氣象慣例，指的是風來的方向。
      濃度最高的幾個扇區集中在西北到北，正是東北季風把大陸沿海的空氣
      沿著台灣海峽帶下來的方向；最低的在南方。
      這個模式一個線性係數表達不出來，因為它不是單調的。
    </p>

    <details>
      <summary>各扇區的濃度與樣本數</summary>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>編碼方式</th>
              <th class="num">項數</th>
              <th class="num">R²</th>
              <th class="num">相對於原始方位角</th>
            </tr>
          </thead>
          <tbody>
            {
              windEncoding.map((row) => (
                <tr class={row.encoding === "raw_bearing" ? "row-bad" : ""}>
                  <td>
                    {row.encoding === "raw_bearing"
                      ? "原始方位角（有缺陷的做法）"
                      : row.encoding === "sin_cos"
                        ? "sin/cos"
                        : "sin/cos + u/v 分量"}
                  </td>
                  <td class="num">{row.n_terms}</td>
                  <td class="num">{nFixed(row.r_squared as number, 4)}</td>
                  <td class="num">{nFixed(row.r2_relative_to_raw_bearing as number, 2)}×</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </details>

    <div class="note">
      <p>
        <strong>但這裡有個我原本猜錯的地方。</strong>
        在 LightGBM 這類樹模型裡，原始方位角的表現反而略好
        （R² 0.537 對 0.524）—樹可以反覆切分同一個變數，
        把 0–360 切成任意多段，跨越 0°/360° 的不連續幾乎沒有代價。
      </p>
      <p>
        所以「sin/cos 編碼比較好」這句話必須帶著適用範圍：
        在線性模型裡它是 {n(sinCos?.r2_relative_to_raw_bearing as number, 2)} 倍，
        而這個基準用的正是線性模型（Pearson、OLS）。
        在樹模型裡它不重要。這個區分是我跑完才知道的，不是一開始就知道。
      </p>
    </div>
  </article>

  <!-- ─── 錯誤四 ─── -->
  <article class="mistake" id={METHOD_CASES[3].id} data-method-case={METHOD_CASES[3].number}>
    <h2><span class="num" aria-hidden="true">{METHOD_CASES[3].number}</span> <span>{METHOD_CASES[3].title}</span></h2>

    <p>
      常見的做法是先跑 Kolmogorov–Smirnov 檢定，看到 p 值全部是 .000，
      然後把顯著水準從 0.05 調到 0.01，宣稱「不拒絕常態假設」。
    </p>

    <p>
      這裡有兩個獨立的問題。第一個是算術：
      p &lt; 0.001 在 α = 0.01 之下同樣被拒絕。調低 α 也無法使它不被拒絕。
    </p>

    <p>
      第二個更根本：<strong>樣本夠大時，常態檢定必然顯著</strong>。
      下表是用已知真相的合成資料做的—
      一組真的來自常態分布，一組有輕微偏態。
    </p>

    <details>
      <summary>合成資料上的常態檢定：樣本數如何決定 p 值</summary>
      <div class="table-wrap">
        <table class="dense">
          <thead>
            <tr>
              <th>樣本數</th>
              <th>資料真相</th>
              <th class="num">偏態</th>
              <th class="num">p 值</th>
              <th>α=0.05 判定</th>
            </tr>
          </thead>
          <tbody>
            {
              normality.map((row) => (
                <tr>
                  <td class="num">{(row.n as number).toLocaleString()}</td>
                  <td>{SYNTHETIC_DATA[row.data as string] ?? row.data}</td>
                  <td class="num">{nFixed(row.skewness as number, 3)}</td>
                  <td class="num">
                    {(row.p_value as number) < 0.0001 ? "< .0001" : nFixed(row.p_value as number, 4)}
                  </td>
                  <td class={row["rejected_at_0.05"] ? "bad" : "good"}>
                    {row["rejected_at_0.05"] ? "拒絕常態" : "不拒絕"}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </details>

    <p class="small">
      真常態的資料在任何樣本數下都不被拒絕；輕微偏態的資料在 N=100 時「通過」了，
      N ≥ 1,000 時全部被拒絕。<strong>同一份資料，答案取決於抽取的樣本數。</strong>
      月平均面板的 N 是數千量級，檢定拒絕是必然的，那個 p 值沒有告訴你任何
      關於分布形狀的事。
    </p>

    <p class="small">
      常見的處理方式是把拒絕標準從 α=0.05 降到 0.01。
      那對這個問題無效—大樣本下 p 值遠小於 0.001，
      在 0.01 之下同樣被拒絕。改變的是門檻，不是資料的分布形狀。
    </p>
  </article>

  <!-- ─── 錯誤五 ─── -->
  <article class="mistake" id={METHOD_CASES[4].id} data-method-case={METHOD_CASES[4].number}>
    <h2><span class="num" aria-hidden="true">{METHOD_CASES[4].number}</span> <span>{METHOD_CASES[4].title}</span></h2>

    <p>
      NOx = NO + NO₂ 是一個恆等式。三個變數同時進入線性模型，
      設計矩陣接近奇異，個別係數在數值上是任意的。
      逐步剔除會來回震盪，原因就在這裡。
    </p>

    <p>
      這個基準的 VIF 是 7,764 / 25,377 / 53,452。
      VIF 超過 10 通常就被視為嚴重共線性。
    </p>

    <details>
      <summary>各係數在 1,000 次重抽樣下的分布</summary>
      <div class="table-wrap">
        <table class="dense">
          <thead>
            <tr>
              <th>係數</th>
              <th class="num">平均</th>
              <th class="num">標準差</th>
              <th class="num">最小</th>
              <th class="num">最大</th>
              <th class="num">變異係數</th>
              <th class="num">為正的比例</th>
            </tr>
          </thead>
          <tbody>
            {
              stability.map((row) => (
                <tr>
                  <td>{row.term}</td>
                  <td class="num">{nFixed(row.mean as number, 3)}</td>
                  <td class="num">{nFixed(row.sd as number, 3)}</td>
                  <td class="num">{nFixed(row.min as number, 3)}</td>
                  <td class="num">{nFixed(row.max as number, 3)}</td>
                  <td class="num">{nFixed(row.coefficient_of_variation as number, 2)}</td>
                  <td class="num">{n((row.share_positive as number) * 100, 0)}%</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </details>

    <p class="small">
      重抽樣之下，同一個係數可以是正的也可以是負的。
      {
        collinearR2.length > 0 && (
          <>
            而整體 R² 幾乎不動（
            {collinearR2.map((r) => `${r.measure} ${n(r.value as number, 4)}`).join("、")}
            ）—<strong>模型整體有解釋力，個別係數沒有意義</strong>。
          </>
        )
      }
      逐項解讀那些係數的方向與大小，是在解讀雜訊。
    </p>
  </article>

  <!-- ─── 錯誤六 ─── -->
  <article class="mistake" id={METHOD_CASES[5].id} data-method-case={METHOD_CASES[5].number}>
    <h2><span class="num" aria-hidden="true">{METHOD_CASES[5].number}</span> <span>{METHOD_CASES[5].title}</span></h2>

    <p>
      沒有留測試集時，模型只能在訓練資料上評估，用 AIC/BIC 比較。
      這兩個指標會懲罰參數數量，但<strong>看不到樣本外的表現</strong>。
    </p>

    <div class="compare">
      <div class="card">
        <span class="tag bad">樣本內</span>
        <span class="stat-value">{n(inSample?.r2 as number, 3)}</span>
        <span class="stat-label">R²</span>
        <span class="stat-note">N = {(inSample?.n as number)?.toLocaleString()}</span>
      </div>
      <div class="arrow" aria-hidden="true">→</div>
      <div class="card">
        <span class="tag good">樣本外</span>
        <span class="stat-value">{n(outSample?.r2 as number, 3)}</span>
        <span class="stat-label">R²</span>
        <span class="stat-note">N = {(outSample?.n as number)?.toLocaleString()}</span>
      </div>
    </div>

    <div class="note caveat">
      落差 {n(optimism?.r2 as number, 3)} 的 R²，
      就是樣本內評估看不到的樂觀偏誤。<strong>評估方式本身會系統性高估</strong>，
      模型並沒有失效。
    </div>
  </article>

  <!-- ─── 錯誤七 ─── -->
  <article class="mistake" id={METHOD_CASES[6].id} data-method-case={METHOD_CASES[6].number}>
    <h2><span class="num" aria-hidden="true">{METHOD_CASES[6].number}</span> <span>{METHOD_CASES[6].title}</span></h2>

    <p>
      缺漏值常常被一句話處理掉：<strong>「以鄰近測站之資料代替」</strong>。
      沒有數量、沒有誤差估計、沒有敏感度分析，也沒有說哪一站借給了哪一站。
      批評這句話很容易，所以這裡改成把它標上價格—
      同樣的做法實作出來，跟另外三種並排跑在同一批資料上。
    </p>

    <div class="note">
      <strong>先問「缺漏長什麼形狀」，因為它決定了一切。</strong>
      {imputationEvidence.stations_measured} 個測站、{imputationEvidence.period} 年：
      單小時的缺口佔全部缺口的{" "}
      {n(gapDist["1h"].share_of_gaps * 100, 1)}%，
      但只佔缺失時數的 {n(gapDist["1h"].share_of_missing_hours * 100, 1)}%；
      超過 48 小時的缺口只有 {gapDist[">48h"].gaps} 次（佔
      {" "}{n(gapDist[">48h"].share_of_gaps * 100, 1)}%），
      卻佔了缺失時數的 {n(gapDist[">48h"].share_of_missing_hours * 100, 1)}%。
      「缺了多少」有兩個答案而且方向相反—所以一個不附缺口長度分布的填補率，等於沒有說明。
    </div>

    <EvidenceFigure number="8.2" title="不同補值方法對不同缺口長度付出什麼代價？">
      <div class="chart">
        {/*
          The fifth chart to move its series names out of a right-hand gutter.
          
          `labelGutter` sized that column to 「鄰近測站（有缺陷的做法）」: measured at a
          1000px viewport the keys took 256px while the plot they labelled had
          236px, and the x axis thinned from five bucket names to two — so the
          point where 線性內插 stops, and the 3-hour limit beside it, both sat over
          unlabelled positions. That break is the entire argument of this section.
          A 390px phone did better than a 1000px laptop.
        */}
        <ul class="chart-key">
          {GAP_SERIES.map((series) => (
            <li style={`--mark:${series.colour};--mark-ink:${markInk(series.colour)}`}>
              <svg class="key-mark" viewBox="0 0 22 8" aria-hidden="true">
                <line x1="1" y1="4" x2="21" y2="4" stroke={series.colour} stroke-width="2.5"
                  stroke-linecap="round" stroke-dasharray={series.dash} />
              </svg>
              <span>{series.label}</span>
            </li>
          ))}
        </ul>
        <div
          class="plot"
          data-readout
          style={`--plot-ar:40;--plot-min:240px;--plot-max:380px;--y-w:${yGutter(gTicks.map((t) => n(t, 0)))}px;--y-lo:${gDomain[0]};--y-hi:${gDomain[1]}`}
        >
            <script
              type="application/json"
              class="plot-readout-data"
              is:inline
              set:html={JSON.stringify({
            x: gapBuckets.map(String),
            unit: "平均絕對誤差 μg/m³",
            places: 2,
            series: GAP_SERIES.map((series) => ({
              label: series.label,
              colour: series.colour,
              ink: markInk(series.colour),
              dash: series.dash,
              values: series.values,
            })),
          })}
            />

          <div class="plot-y">
            {gTicks.map((tick) => <span style={`top:${n(gy(tick), 3)}%`}>{axisNumber(n(tick, 0))}</span>)}
          </div>

          <div class="plot-area">
            <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
              {
                gTicks.map((tick) => (
                  <line
                    x1="0"
                    x2="100"
                    y1={n(gy(tick), 3)}
                    y2={n(gy(tick), 3)}
                    class="plot-grid"
                    vector-effect="non-scaling-stroke"
                  />
                ))
              }
              <line
                x1={n(gx(1.5), 3)}
                x2={n(gx(1.5), 3)}
                y1="0"
                y2="100"
                stroke="var(--text-faint)"
                stroke-width="1.5"
                stroke-dasharray="4 4"
                vector-effect="non-scaling-stroke"
              />
              {
                GAP_SERIES.map((series) => (
                  <path
                    d={smoothPath(series.values, (i) => gx(i), (v) => gy(v))}
                    class="plot-line"
                    stroke={series.colour}
                    stroke-dasharray={series.dash}
                    vector-effect="non-scaling-stroke"
                  />
                ))
              }
            </svg>

            {/* Two lines by construction rather than by accident. Left to wrap
                inside `max-width: 8em`, the break landed inside the value and
                the label read 「內插的上限：3 小」/「時」 — a measurement split
                across a line ending. The wrap point is now the colon. */}
            <span class="plot-note limit" style={`left:${n(gx(1.5), 3)}%`}>
              內插的上限<br />3 小時
            </span>

            {
              GAP_SERIES.map((series) =>
                series.values.map((value, index) =>
                  value == null ? null : (
                    <span
                      class="plot-pt"
                      style={`left:${n(gx(index), 3)}%;top:${n(gy(value), 3)}%;color:${series.colour}`}
                      title={`${series.label} · ${gapBuckets[index]}: ${n(value, 2)}`}
                    />
                  ),
                ),
              )
            }
          </div>


          <div class="plot-x" data-n={gapBuckets.length} data-tw={xLabelBucket(gapBuckets)}>
            {gapBuckets.map((bucket, index) => <span style={`left:${n(gx(index), 3)}%`}>{bucket}</span>)}
          </div>
        </div>
      </div>
      <Fragment slot="caption">
        平均絕對誤差（μg/m³），依被隱藏的缺口長度分。做法是把
        {" "}{imputationEvidence.hidden.toLocaleString()} 筆真的存在的讀數藏起來，
        叫每個策略猜回來，再跟實際值比對。
        隱藏的洞是成串的，長度抽自這批資料自己量到的缺口分布—
        隨機遮蔽單一格會把每個洞都變成 1 小時，而那正是線性內插不可能失敗的情況。
      </Fragment>
    </EvidenceFigure>

    <div class="compare">
      <div class="card">
        <span class="tag good">線性內插</span>
        <span class="stat-value">{n(pooledBy.interpolate?.mae as number, 2)}</span>
        <span class="stat-label">μg/m³ 平均絕對誤差</span>
        <span class="stat-note">
          只答 {n((pooledBy.interpolate?.recovery_rate as number) * 100, 0)}%，其餘拒答
        </span>
      </div>
      <div class="arrow" aria-hidden="true">vs</div>
      <div class="card">
        <span class="tag bad">有缺陷的做法</span>
        <span class="stat-value">{n(pooledBy.neighbor?.mae as number, 2)}</span>
        <span class="stat-label">μg/m³ 平均絕對誤差</span>
        <span class="stat-note">
          答了 {n((pooledBy.neighbor?.recovery_rate as number) * 100, 0)}%
        </span>
      </div>
    </div>

    <div class="note caveat">
      <p>
        <strong>兩件只有分桶才看得到的事。</strong>
        第一，在完全相同的單小時缺口上，內插的誤差是
        {" "}{n(GAP_SERIES[0].values[0] as number, 2)}、鄰站法是
        {" "}{n(GAP_SERIES[2].values[0] as number, 2)}—
        最簡單的情況下差了 {n((GAP_SERIES[2].values[0] as number) / (GAP_SERIES[0].values[0] as number), 1)} 倍。
        從 30 公里外借一個值，比把前後兩小時連成一條直線還差。
      </p>
      <p>
        第二，那條紅線相當平緩。缺口從 2–3 小時拉長到超過 48 小時（20 倍），
        鄰站法的誤差只從 {n(GAP_SERIES[2].values[1] as number, 2)} 升到
        {" "}{n(GAP_SERIES[2].values[4] as number, 2)}。
        平緩看起來像穩健，<strong>實際上量到的是這個方法的盲點</strong>—它代表這個方法不知道問題有多難：
        它會用同樣的自信填一次三週停機和一個一小時缺口，
        而輸出裡沒有任何欄位區分這兩者。<strong>內插的行為相反：誤差隨缺口成長，然後它停下來。</strong>
      </p>
    </div>

    <div class="note">
      <strong>有一個數字被算出來、然後被刪掉了。</strong>
      「換一種填補法，最後的結論會不會變？」在四種填補下重跑同一個模型，
      會得到四個不同的 R²，看起來可以直接讀—不能。
      填補唯一改變的是不填就用不了的那些列，
      所以每個策略是在不同的測試集上被評分的。
      要問得成立，得在策略之間固定評分集合、只讓訓練集合變動。
      <strong>一個有混淆的數字比沒有數字更糟</strong>，所以這裡沒有那個數字。
    </div>
  </article>

  <!-- ─── 誠實的收尾 ─── -->
  <article class="mistake epilogue">
    <h2>兩項經全量資料否證的原始主張</h2>

    <p>
      動手分析之前，我列了 11 項缺陷。跑完全量資料之後，其中兩項被自己的資料否證，
      這裡照樣列出來—只留對自己有利的檢查結果，就是另一種形式的同樣毛病。
    </p>

    <div class="grid grid-2">
      <div class="card">
        <h3>風向哨兵碼</h3>
        <p class="small">
          我原本主張 2010–2017 年的風向資料被 888（無風）與 999（儀器故障）污染。
          全量掃描結果：這些代碼只出現在 1993–2004 年，
          <strong>2010–2017 年出現次數為零</strong>。
          那段期間的資料沒有這個問題，是我過度推論。
        </p>
      </div>
      <div class="card">
        <h3>無效值保留率分世代</h3>
        <p class="small">
          我原本以為舊格式一律保留原值、新格式一律丟棄。
          實測：1997 與 2001 年的保留率是 0.000，1998 年 0.340，
          <strong>而這些都是「舊格式」年份</strong>。
          慣例是逐年變的，不能從世代推論。
        </p>
      </div>
    </div>
  </article>

</section>

