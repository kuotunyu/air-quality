---
/**
 * Chapter 7 — a method against a better method.
 *
 * The comparison is between two ways of doing the analysis, never between
 * people. No author or supervisor of the 2018 project is named anywhere, and
 * none of its figures is reproduced — every chart here is recomputed from the
 * raw data. See docs/legal.md.
 *
 * Every number on this page comes from `story/pitfalls.json` (pitfalls 01-06)
 * or `story/imputation.json` (07), both copied verbatim from the M3 and M11
 * evidence tables. Nothing is retyped, so the chapter cannot drift away from
 * the analysis it describes.
 */
import { pitfallTables, replicationRows, imputationEvidence } from "../lib/data";
import { linePath, linear, markInk, n, nFixed, padded, smoothPath, ticks, xLabelBucket, yGutter } from "../lib/chart";
import { compass, SYNTHETIC_DATA } from "../lib/labels";
import ChapterIntro from "./ChapterIntro.astro";

type Row = Record<string, any>;
const t = (name: string) => (pitfallTables[name] ?? []) as Row[];

// --- 1. the diurnal cycle a monthly mean cannot see -------------------------
const diurnal = t("diurnal_diurnal");
const weekly = t("diurnal_weekly");
const variance = t("diurnal_variance");
/* `station_month` is the aggregation the 2018 project performed — one value per
   station per month, N = 7,286 in its own report and 7,269 in this store over
   the same window. `monthly_mean` additionally pools all 78 stations into one
   national series, which is a second and separate loss. This paragraph used to
   quote the pooled figure while naming the original's aggregation, charging it
   with losing variance it kept: 20.3% where its own aggregation retains 40.3%.
   The difference is almost exactly the between-station variance. */
const retained = (variance.find((r) => r.scale === "station_month")?.variance_retained ?? 0) as number;
const pooledRetained = (variance.find((r) => r.scale === "monthly_mean")?.variance_retained ?? 0) as number;
const hourlySd = (variance.find((r) => r.scale === "hourly")?.sd ?? 0) as number;
const monthlySd = (variance.find((r) => r.scale === "station_month")?.sd ?? 0) as number;
const pooledSd = (variance.find((r) => r.scale === "monthly_mean")?.sd ?? 0) as number;

const diurnalValues = diurnal.map((r) => r.mean as number);
const diurnalPeak = diurnal.reduce((a, b) => (a.mean > b.mean ? a : b), diurnal[0]);
const diurnalTrough = diurnal.reduce((a, b) => (a.mean < b.mean ? a : b), diurnal[0]);

// --- 2. the PM10 leak -------------------------------------------------------
const leak = t("leakage_price");
const withPm10 = leak.find((r) => r.feature_set === "full_with_pm10");
const withoutPm10 = leak.find((r) => r.feature_set === "full");
const leakShare = leak.find((r) => r.feature_set === "leak_share_of_r2");

// --- 3. wind direction ------------------------------------------------------
const windEncoding = t("wind_linear_model_encoding");
const sinCos = windEncoding.find((r) => r.encoding === "sin_cos");
const bySector = t("wind_by_sector");
const sectorHigh = bySector.reduce((a, b) => (a.mean > b.mean ? a : b), bySector[0]);
const sectorLow = bySector.reduce((a, b) => (a.mean < b.mean ? a : b), bySector[0]);
const windSummary = Object.fromEntries(
  t("wind_summary").map((r) => [r.measure as string, r.value as number]),
);

// --- 4. the normality test --------------------------------------------------
const normality = t("normality_by_sample_size");
const published = t("normality_published_table");

// --- 5. collinearity --------------------------------------------------------
const stability = t("collinearity_stability");
const collinearR2 = t("collinearity_r_squared");

// --- 6. in-sample vs out-of-sample -----------------------------------------
const validation = t("validation_in_vs_out_of_sample");
const inSample = validation.find((r) => r.evaluated_on === "in_sample");
const outSample = validation.find((r) => r.evaluated_on === "out_of_sample");
const optimism = validation.find((r) => r.evaluated_on === "optimism_r2");

// --- 7. the one sentence about missing values -------------------------------
const gapBuckets = imputationEvidence.buckets;
const pooledBy = Object.fromEntries(imputationEvidence.pooled.map((r) => [r.strategy, r]));
const gapDist = Object.fromEntries(imputationEvidence.distribution.map((r) => [r.gap_bucket, r]));

// A series is null where its strategy declined to answer, and `linePath`
// breaks at nulls — so interpolation's line simply stops at its 3-hour limit
// rather than being drawn flat across gaps it never touched.
// Three gap-filling strategies are three KINDS, so they wear the categorical
// set. They used to be c3, c2, c1 — three ADJACENT steps of the concentration
// ramp, which is both a false statement (a strategy is not a μg/m³ bin) and the
// closest three colours the ramp had to offer: worst pair dE00 9.7, against
// 34.1 now. Dashes carry the same distinction a second time, so the three are
// still three in greyscale, in print, and to a reader who sees no hue at all.
const GAP_SERIES = [
  { key: "interpolate", label: "線性內插", colour: "var(--k0)", dash: undefined },
  { key: "iterative", label: "多變量疊代", colour: "var(--k1)", dash: "7 4" },
  { key: "neighbor", label: "鄰近測站（當年做法）", colour: "var(--k2)", dash: "2 3" },
].map((series) => {
  const values = gapBuckets.map(
    (bucket) =>
      imputationEvidence.by_gap.find(
        (row) => row.strategy === series.key && row.gap_bucket === bucket,
      )?.mae ?? null,
  );
  let lastIndex = -1;
  values.forEach((value, index) => {
    if (value != null) lastIndex = index;
  });
  return { ...series, values, lastIndex, lastValue: values[lastIndex] ?? null };
});

const gapValues = GAP_SERIES.flatMap((s) => s.values).filter((v): v is number => v != null);
const gDomain = padded(gapValues, { zero: true });
const gx = (index: number) => (100 / (gapBuckets.length - 1)) * index;
const gy = linear(gDomain, [100, 0]);
const gTicks = ticks(gDomain[0], gDomain[1], 4);
// The replication table, filtered to the comparisons worth showing.
const keyCoefficients = replicationRows.filter(
  (r) => r.kind === "correlation" && r.published_2018 != null,
);

/*
 * 1 is Monday.
 *
 * The column printed the bare integers 1–7, and nothing on the page said which
 * end was which — on a table whose claim is that the weekday effect is small,
 * "small compared to what" needs the reader to know whether 6 and 7 are the
 * weekend. `pitfalls.py` groups by Polars' `dt.weekday()`, which is ISO;
 * confirmed against a known Monday rather than taken from the docs:
 * 2026-08-03 is a Monday and returns 1, 2026-08-09 is a Sunday and returns 7.
 */
const WEEKDAY_NAMES = ["週一", "週二", "週三", "週四", "週五", "週六", "週日"];

// --- small inline chart for the diurnal cycle -------------------------------
const dDomain = padded(diurnalValues, { zero: false });
const dx = linear([0, 23], [0, 100]);
const dy = linear(dDomain, [100, 0]);
const dMean = diurnalValues.reduce((a, b) => a + b, 0) / diurnalValues.length;
const dTicks = ticks(dDomain[0], dDomain[1], 4);
---

<section id="methods" class="page">
  <ChapterIntro slug="methods">
  <p class="lede">
    這一章的對照組是一份 2018 年的大學畢業專題。它的方法是：
    取 2010–2017 年的<strong>月平均</strong>、12 個解釋變數、Pearson 相關、
    逐步剔除的 OLS，再加一個 AR(1) 混合模型，N = 7,286。
    在當時的大學部水準是合格的。
  </p>
  </ChapterIntro>

  <p>
    這裡不談那份報告的作者是誰，也不重製它的任何圖表——
    下面每一張圖、每一個數字都是本專案用原始資料重新算出來的。
    要比較的只有<strong>方法選擇</strong>：每一項都用同一份資料做兩次，
    一次照當年的做法，一次照現在的做法，然後看結論差多少。
  </p>

  <p>
    先說結論：有些選擇無關痛癢，有些讓整個模型的解釋力高估了三分之一。
    這些不是誰特別粗心，而是<strong>整個世代的環境統計慣例</strong>——
    同一批做法在當年的期刊論文裡到處都是。
  </p>

  <div class="note">
    <strong>先證明能重現，再說它錯。</strong>
    復刻 2018 年的流程，13 個敘述統計中 10 個誤差在 2% 以內，
    PM10 的相關係數復刻為 0.8893（原文 0.8865）。
    共線性病理也完全重現。沒有這一步，後面所有「我改進了」的宣稱都沒有基準。
  </div>

  <!-- ─── 錯誤一 ─── -->
  <article class="mistake">
    <h2><span class="num">01</span> 月平均抹掉了六成的變異</h2>

    <p>
      2010–2017 年逐時 PM2.5 的標準差是 {n(hourlySd)} μg/m³。
      壓成原專題用的「每站每月一個值」之後只剩 {n(monthlySd)} μg/m³——
      變異保留了 <strong>{n(retained * 100, 1)}%</strong>。
      當年的模型無論怎麼調，能解釋的上限就是這剩下的四成。
    </p>

    <p class="small">
      這裡要小心一件事，我們自己先弄錯過：如果再把各站併成單一的全台月序列，
      保留率會掉到 {n(pooledRetained * 100, 1)}%（標準差 {n(pooledSd)} μg/m³）。
      那個數字曾經是本節的標題，但它不是原專題做的事——
      原專題保留了測站維度（N = 7,286，本站同期資料為 7,269）。
      兩者的差額幾乎剛好是<strong>測站之間</strong>的變異：
      逐時變異中，月份解釋 20.1%，「測站 × 月份」解釋 40.2%。
      把後面那 20 個百分點也算到「月平均」頭上，是把空間的損失記在時間帳上。
    </p>

    <p>
      被丟掉的是什麼？下圖是日內節律，一個看得見、也最容易說明的成分。
    </p>

    <div class="two-up">
      <figure>
        <div class="chart">
          <div
            class="plot"
            data-readout
            style={`--plot-ar:36;--plot-min:220px;--plot-max:320px;--y-w:${yGutter(dTicks.map((t) => n(t, 0)))}px;--y-lo:${dDomain[0]};--y-hi:${dDomain[1]}`}
          >
            <script
              type="application/json"
              class="plot-readout-data"
              is:inline
              set:html={JSON.stringify({
              x: diurnalValues.map((_, h) => `${h} 時`),
              unit: "PM2.5 μg/m³",
              places: 1,
              series: [
                {
                  label: "日內平均",
                  colour: "var(--k0)",
                  ink: markInk("var(--k0)"),
                  values: diurnalValues,
                },
              ],
            })}
            />

            <div class="plot-y">
              {dTicks.map((tick) => <span style={`top:${n(dy(tick), 3)}%`}>{n(tick, 0)}</span>)}
            </div>

            <div class="plot-area">
              <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                {
                  dTicks.map((tick) => (
                    <line
                      x1="0"
                      x2="100"
                      y1={n(dy(tick), 3)}
                      y2={n(dy(tick), 3)}
                      class="plot-grid"
                      vector-effect="non-scaling-stroke"
                    />
                  ))
                }
                <line
                  x1="0"
                  x2="100"
                  y1={n(dy(dMean), 3)}
                  y2={n(dy(dMean), 3)}
                  stroke="var(--text-faint)"
                  stroke-width="1.5"
                  stroke-dasharray="5 4"
                  vector-effect="non-scaling-stroke"
                />
                <path
                  d={linePath(diurnalValues, (i) => dx(i), (v) => dy(v))}
                  class="plot-line"
                  stroke="var(--c3)"
                  vector-effect="non-scaling-stroke"
                />
              </svg>

              <span class="plot-note" style={`top:${n(dy(dMean), 3)}%;color:var(--text-faint)`}>
                月平均看到的只有這條線
              </span>
            </div>

            <div class="plot-x" data-n={5} data-tw={xLabelBucket(["0 時", "6 時", "12 時", "18 時", "23 時"])}>
              {[0, 6, 12, 18, 23].map((hour) => <span style={`left:${n(dx(hour), 3)}%`}>{hour}時</span>)}
            </div>
          </div>
        </div>
        <figcaption>
          2010–2017 年逐時 PM2.5 的日內平均。峰值在 {diurnalPeak.hour} 時
          （{n(diurnalPeak.mean)} μg/m³），谷底在 {diurnalTrough.hour} 時
          （{n(diurnalTrough.mean)} μg/m³）。月平均把整條曲線壓成一個點。
        </figcaption>
      </figure>

      <div class="verdict">
        <div class="stat">
          <span class="stat-value" style="color:var(--c5-ink)">{n(retained * 100, 1)}%</span>
          <span class="stat-label">月平均保留的變異比例</span>
          <span class="stat-note">
            標準差 {n(hourlySd)} → {n(monthlySd)} μg/m³
          </span>
        </div>
      </div>
    </div>

    <div class="note">
      <strong>把話說準：日夜節律只是被丟掉的一小部分。</strong>
      日內振幅是 {n(diurnalPeak.mean - diurnalTrough.mean)} μg/m³，
      相對於 {n(hourlySd)} 的整體標準差並不大。
      消失的大宗是<strong>逐日到綜觀尺度</strong>的變化——
      境外傳輸的高濃度事件、鋒面過境、逆溫累積。
      一個 40 μg/m³ 的污染日和一個 10 μg/m³ 的乾淨日落在同一個月，
      月平均只留下 25，兩者都不見了。
      日內節律容易說明、容易繪製，但它不是主要的損失來源，這裡不把它當成主要證據。
    </div>

    {
      weekly.length > 0 && (
        <details>
          <summary>週間變化（月平均同樣看不到）</summary>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>星期</th>
                  <th class="num">PM2.5 平均</th>
                  <th class="num">小時數</th>
                </tr>
              </thead>
              <tbody>
                {weekly.map((row) => (
                  <tr>
                    <td>{WEEKDAY_NAMES[(row.weekday as number) - 1] ?? row.weekday}</td>
                    <td class="num">{n(row.mean)}</td>
                    <td class="num">{(row.n as number).toLocaleString()}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      )
    }
  </article>

  <!-- ─── 錯誤二 ─── -->
  <article class="mistake">
    <h2><span class="num">02</span> 拿 PM10 預測 PM2.5</h2>

    <p>
      當年模型裡最顯著的變數是 PM10，β = 0.413、t = 92.75。
      問題是 <strong>PM2.5 在定義上就是 PM10 的一部分</strong>——
      PM10 是直徑 10 微米以下的顆粒，PM2.5 是 2.5 微米以下的，後者被前者包含。
      這不是預測，是把答案的一部分放進題目。
    </p>

    <p>
      要量化它的代價，只需要把同一個模型跑兩次：一次讓 PM10 進去，一次不讓。
    </p>

    <div class="compare">
      <div class="card">
        <span class="tag bad">含 PM10（當年的做法）</span>
        <span class="stat-value">{n(withPm10?.r2 as number, 3)}</span>
        <span class="stat-label">R²</span>
        <span class="stat-note">RMSE {n(withPm10?.rmse as number, 2)}</span>
      </div>
      <div class="arrow" aria-hidden="true">→</div>
      <div class="card">
        <span class="tag good">不含 PM10</span>
        <span class="stat-value">{n(withoutPm10?.r2 as number, 3)}</span>
        <span class="stat-label">R²</span>
        <span class="stat-note">RMSE {n(withoutPm10?.rmse as number, 2)}</span>
      </div>
    </div>

    <div class="note caveat">
      <strong>{n((leakShare?.r2 as number) * 100, 1)}%</strong> ——
      含 PM10 的模型有三分之一的解釋力，來自這個定義上的重疊。
      當年 t = 92.75 所支撐的就是這一部分。
    </div>
  </article>

  <!-- ─── 錯誤三 ─── -->
  <article class="mistake">
    <h2><span class="num">03</span> 把風向當成 0 到 360 的普通數字</h2>

    <p>
      風向是<strong>圓形變數</strong>：359° 和 1° 相差 2 度，不是 358 度。
      當年把 WD_HR 直接丟進相關分析與迴歸，得到相關係數 0.089，
      結論寫「風向與 PM2.5 無相關」。本專案復刻出
      {" "}{n(windSummary.pearson_r_with_raw_bearing, 3)}，數量級一致。
    </p>

    <p>
      但把同一份資料按 30° 分組，最高的 {compass(sectorHigh?.sector as number)}
      是 {n(sectorHigh?.mean as number)} μg/m³，最低的
      {" "}{compass(sectorLow?.sector as number)} 是 {n(sectorLow?.mean as number)} μg/m³——
      相差 {n(windSummary.sector_mean_range)} μg/m³，
      是整體平均的 {n(windSummary.sector_range_as_pct_of_mean, 0)}%。
      方向依賴一直都在，是線性相關係數看不見它。
    </p>

    <p class="small">
      風向採氣象慣例，指的是風<strong>來的方向</strong>。
      濃度最高的幾個扇區集中在西北到北，正是東北季風把大陸沿海的空氣
      沿著台灣海峽帶下來的方向；最低的在南方。
      這個模式一個線性係數表達不出來，因為它不是單調的。
    </p>

    <details>
      <summary>各扇區的濃度與樣本數</summary>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>編碼方式</th>
              <th class="num">項數</th>
              <th class="num">R²</th>
              <th class="num">相對於原始方位角</th>
            </tr>
          </thead>
          <tbody>
            {
              windEncoding.map((row) => (
                <tr class={row.encoding === "raw_bearing" ? "row-bad" : ""}>
                  <td>
                    {row.encoding === "raw_bearing"
                      ? "原始方位角（當年的做法）"
                      : row.encoding === "sin_cos"
                        ? "sin/cos"
                        : "sin/cos + u/v 分量"}
                  </td>
                  <td class="num">{row.n_terms}</td>
                  <td class="num">{nFixed(row.r_squared as number, 4)}</td>
                  <td class="num">{nFixed(row.r2_relative_to_raw_bearing as number, 2)}×</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </details>

    <div class="note">
      <p>
        <strong>但這裡有個我原本猜錯的地方。</strong>
        在 LightGBM 這類樹模型裡，原始方位角的表現<strong>反而略好</strong>
        （R² 0.537 對 0.524）——樹可以反覆切分同一個變數，
        把 0–360 切成任意多段，跨越 0°/360° 的不連續幾乎沒有代價。
      </p>
      <p>
        所以「sin/cos 編碼比較好」這句話必須帶著適用範圍：
        在<strong>線性模型</strong>裡它是 {n(sinCos?.r2_relative_to_raw_bearing as number, 2)} 倍，
        而當年用的正是線性模型（Pearson、OLS、線性混合模型）。
        在樹模型裡它不重要。這個區分是我跑完才知道的，不是一開始就知道。
      </p>
    </div>
  </article>

  <!-- ─── 錯誤四 ─── -->
  <article class="mistake">
    <h2><span class="num">04</span> 用常態檢定證明資料常態</h2>

    <p>
      當年做了 Kolmogorov–Smirnov 檢定，13 個變數的 p 值全部是 .000，
      然後把顯著水準從 0.05 調到 0.01，宣稱「不拒絕常態假設」。
    </p>

    <p>
      這裡有兩個獨立的問題。第一個是<strong>算術</strong>：
      p &lt; 0.001 在 α = 0.01 之下同樣被拒絕。調低 α 也無法使它不被拒絕。
    </p>

    <p>
      第二個更根本：<strong>樣本夠大時，常態檢定必然顯著</strong>。
      下表是用<strong>已知真相</strong>的合成資料做的——
      一組真的來自常態分布，一組有輕微偏態。
    </p>

    <details>
      <summary>合成資料上的常態檢定：樣本數如何決定 p 值</summary>
      <div class="table-wrap">
        <table class="dense">
          <thead>
            <tr>
              <th>樣本數</th>
              <th>資料真相</th>
              <th class="num">偏態</th>
              <th class="num">p 值</th>
              <th>α=0.05 判定</th>
            </tr>
          </thead>
          <tbody>
            {
              normality.map((row) => (
                <tr>
                  <td class="num">{(row.n as number).toLocaleString()}</td>
                  <td>{SYNTHETIC_DATA[row.data as string] ?? row.data}</td>
                  <td class="num">{nFixed(row.skewness as number, 3)}</td>
                  <td class="num">
                    {(row.p_value as number) < 0.0001 ? "< .0001" : nFixed(row.p_value as number, 4)}
                  </td>
                  <td class={row["rejected_at_0.05"] ? "bad" : "good"}>
                    {row["rejected_at_0.05"] ? "拒絕常態" : "不拒絕"}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </details>

    <p class="small">
      真常態的資料在任何樣本數下都不被拒絕；輕微偏態的資料在 N=100 時「通過」了，
      N ≥ 1,000 時全部被拒絕。<strong>同一份資料，答案取決於抽取的樣本數。</strong>
      當年 N = 7,286，檢定拒絕是必然的，那個 .000 沒有告訴你任何關於分布形狀的事。
    </p>

    <details>
      <summary>原文那張表的 13 個變數（p 值全為 .000）</summary>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
