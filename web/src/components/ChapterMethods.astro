  /* The "interpolation stops here" marker labels a column, not a row, so it
     anchors beside its own vertical line instead of at the plot's right edge. */
  /*
   * The diurnal note goes to the plot's empty LEFT, not its right.
   *
   * `.plot-note` anchors right by default, and on this figure the curve is at its
   * highest on the right — so the olive line ran straight through the glyphs of
   * 「月平均看到的只有這條線」 at every width. Scanning the label's own box for
   * curve-coloured pixels: 167 of them across 107 distinct columns at 1440, 160
   * at 1000.
   *
   * The curve stays below the mean rule until about hour 7, so the note's own y
   * band is clear on the left for 179px of a 556px plot at 1440 and 159px of 492px
   * at 1000 — both 32%, which is what the cap is. It wraps upward into empty plot
   * (the base rule already translates -100%), and the measured headroom above the
   * mean rule is 81px to the next gridline alone.
   *
   * `:not(.limit)` leaves the gap chart's own column-anchored note alone.
   */
  .plot-note:not(.limit) {
    right: auto;
    left: 0;
    text-align: left;
    max-width: 32%;
  }

  .plot-note.limit {
    top: 0;
    right: auto;
    margin-left: 0.4em;
    transform: none;
    color: var(--text-faint);
    text-align: left;
    /* Anchored to a column rather than to the plot's right edge, so unlike the
       other notes it has nothing bounding it — and at 265px it ran 139px past
       the figure. It breaks where the markup says instead. */
    max-width: 8em;
    white-space: nowrap;
  }
