---
/**
 * Chapter 2 — one station at a time.
 *
 * Lifted out of `pages/index.astro` unchanged when the document became ten
 * routes.
 */
import StationPicker from "./StationPicker.astro";
import ChapterIntro from "./ChapterIntro.astro";
import { cards, guidelines } from "../lib/data";
---

<section id="stations" class="page">
  <ChapterIntro slug="stations">
  <p class="lede">
    選定測站後，顯示該站最近一個「資料完整到可以比較」的年份。
    已停用的測站顯示的是停用前最後一個完整年份。
  </p>
  </ChapterIntro>

  <StationPicker cards={cards} guidelines={guidelines} />
</section>
