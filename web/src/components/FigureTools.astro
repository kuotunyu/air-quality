---
/**
 * Two controls under every figure: open it larger, and take it away as a PNG.
 *
 * Injected by script rather than written into each figure, for two reasons.
 * The first is that neither control has any meaning without JavaScript — a
 * `<dialog>` that cannot be opened and a canvas that cannot be drawn — and this
 * site's rule is that the document reads with script off. Markup that renders
 * two dead buttons in that case is worse than no markup. The second is that the
 * figures are in eight different components; a rule that finds them by shape
 * cannot be forgotten when a ninth is written.
 *
 * ## Why the PNG is not a serialised `<svg>`
 *
 * A chart here is deliberately two layers — SVG marks stretched over a
 * normalised grid, with every label, guide note and data point as positioned
 * HTML on top (see the note above `.plot` in `global.css`). Serialising the
 * `<svg>` alone would export the lines and nothing that says what they are: no
 * axis, no legend, no units, and stretched by a `preserveAspectRatio="none"`
 * that only makes sense against the box the browser laid out.
 *
 * So the export takes the whole figure — both layers and the caption — through
 * `<foreignObject>`, which is the one way to hand a laid-out DOM subtree to a
 * raster. That costs an inlined copy of the stylesheet, because an SVG loaded
 * as an image is a separate document and reaches nothing from this one. It buys
 * a PNG that is the figure, including the breaks: a null still renders as a hole
 * because it is the same `linePath` output, not a re-draw that could bridge one.
 */
---

<dialog class="fig-zoom" aria-label="放大檢視">
  <div class="fig-zoom-head">
    <p class="fig-zoom-name"></p>
    <button type="button" class="fig-shut">關閉</button>
  </div>
  <div class="fig-zoom-body"></div>
</dialog>

<p class="fig-say visually-hidden" role="status" aria-live="polite"></p>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(".fig-zoom");
  const stage = dialog?.querySelector<HTMLElement>(".fig-zoom-body");
  const plate = dialog?.querySelector<HTMLElement>(".fig-zoom-name");
  const shut = dialog?.querySelector<HTMLButtonElement>(".fig-shut");
  const say = document.querySelector<HTMLElement>(".fig-say");

  /*
   * What counts as a figure.
   *
   * Every `<figure>` in the document, plus the entry map — which is not one,
   * because it is a cell of the hero's grid and a `<figure>`'s own margins
   * would move it. Marking it by class costs one selector and no layout.
   */
  const ROOTS = "main figure, main .map-wrap";

  /* The least a trend plot may be, in the dialog as on the page: the lower end
     of the 320–520px band `check_site_quality.mjs` holds figure 1.1 to. */
  const MIN_PLOT_H = 320;

  /*
   * Everything runs inside one function taking the four elements as arguments,
   * rather than under an `if` that has already proved them non-null. A function
   * declaration is hoisted, so the compiler cannot know it runs only after the
   * check — narrowing does not reach into it, and each of the four read as
   * possibly null at every use. Parameters carry the proof instead.
   */
  function start(
    dialog: HTMLDialogElement,
    stage: HTMLElement,
    plate: HTMLElement,
    shut: HTMLButtonElement,
    say: HTMLElement,
  ) {
    /** Move the figure into the dialog, and remember how to put it back. */
    let held: {
      root: HTMLElement;
      slot: HTMLElement;
      /* Parked in the dialog head while open; put back before the figure is. */
      tools: HTMLElement | null;
      plots: { el: HTMLElement; height: string }[];
      /* Whoever opened it, so the keyboard has somewhere to come back to. */
      opener: HTMLElement | null;
    } | null = null;

    function equip(root: HTMLElement, index: number) {
      const name = figureName(root, index);

      const tools = document.createElement("div");
      tools.className = "fig-tools";

      const bigger = control("放大", name);
      bigger.dataset.figAct = "zoom";
      bigger.addEventListener("click", () => open(root, name, bigger));

      // Keep the face concise beside 放大. The accessible name still states
      // the PNG format and the figure identity before a reader activates it.
      const png = control("下載", name, "下載 PNG");
      png.addEventListener("click", () => save(root, png, index));

      tools.append(bigger, png);
      /*
       * 2026-08-03 — the entry map's interpretation and provenance now precede
       * its enhanced controls in the same order as the static page. The map
       * names one external mount; ordinary figures still append their toolbar.
       */
      const mount = root.dataset.figureToolsMount
        ? document.getElementById(root.dataset.figureToolsMount)
        : root;
      (mount ?? root).append(tools);
    }

    function control(label: string, name: string, spoken = label): HTMLButtonElement {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "fig-tool";
      button.textContent = label;
      /*
       * A page carries up to three of these, and「放大」three times over is a
       * list of identical controls to anyone reading the buttons rather than
       * the page. The label says which figure it acts on.
       */
      button.setAttribute("aria-label", `${spoken}：${name}`);
      return button;
    }

    /** A short name for a figure, taken from what it already says. */
    function figureName(root: HTMLElement, index: number): string {
      const caption = root.querySelector("figcaption")?.textContent ?? "";
      const described =
        root.querySelector("svg[aria-label]")?.getAttribute("aria-label") ?? "";
      const source = (caption || described).replace(/\s+/g, " ").trim();
      if (!source) return `圖 ${index + 1}`;
      /*
       * The first sentence, and only a full stop ends one.
       *
       * Breaking at any punctuation was tried and it cut a caption reading
       *「61 個測站、2008–2025 年，兩條線都出自同一批列。」down to「61 個測站」,
       * which names no figure on this site. These captions open by saying what
       * the figure is, so the sentence is the label and the comma is inside it.
       */
      const stop = source.indexOf("。");
      const head = stop > 0 ? source.slice(0, stop) : source;
      return head.length > 28 ? `${head.slice(0, 28)}…` : head;
    }

    // ── 放大 ────────────────────────────────────────────────────────────────

    /*
     * The figure is MOVED into the dialog, not copied.
     *
     * Two of these figures are driven by scripts that reach their parts with
     * `getElementById` — the CBPF picker and the entry map. A clone would put a
     * second element with each of those ids in the document, and the control
     * that used to work would start addressing whichever copy came first.
     * Moving keeps every id unique and every listener attached, at the price of
     * a placeholder holding the gap in the page.
     */
    function open(root: HTMLElement, name: string, opener: HTMLElement | null) {
      if (held) return;
      const slot = document.createElement("div");
      slot.className = "fig-parked";
      slot.style.height = `${root.getBoundingClientRect().height}px`;
      root.replaceWith(slot);
      stage.replaceChildren(root);
      plate.textContent = name;
      /*
       * The figure's toolbar joins the dialog's own controls while it is open.
       *
       * 放大 is hidden in here — it would reopen what is open — so the row is
       * one button holding 45px of the stage, and the stage is what this dialog
       * is short of: at 1600x900 it has 682px of content height for figures that
       * want 700 and more. Beside 關閉 it costs the figure nothing and sits where
       * a reader already looks for this dialog's controls.
       *
       * Moved rather than positioned: `.fig-tools` lives in `.fig-zoom-body`,
       * which is the head's SIBLING, so no `position: relative` on the head can
       * make it the containing block — tried, and the toolbar landed on top of
       * 關閉 at every size.
       */
      const tools = root.querySelector<HTMLElement>(".fig-tools");
      if (tools && shut) shut.before(tools);
      dialog.showModal();
      held = { root, slot, tools, plots: grow(root), opener };
    }

    /*
     * Give the marks the room the dialog just bought.
     *
     * `--plot-h` overrides a chart's height; everything else is a percentage of
     * the box, so a wider box already redraws at the new width and the x axis
     * un-thins itself (see the container queries on `.plot-x`). Height has to be
     * asked for. The factor is measured after the move, so it is the real ratio
     * rather than a guess.
     *
     * It used to be floored at 1, on the argument that the control says 放大.
     * That kept the promise about the plot and broke it about the figure:
     * measured at 1600x900, where the dialog's stage is 739px tall, all three of
     * chapter 1's figures came out taller than it — 900, 810 and 1144 — so
     * 放大 handed the reader a scrollbar and the same plot they already had.
     * A reader who asks to see a figure whole should get it whole.
     *
     * So the factor fits rather than only enlarges, and `MIN_PLOT_H` stops it
     * fitting a plot into uselessness: 320px is the floor `check_site_quality`
     * already holds figure 1.1's plot to on the page, so it is the same number
     * this site has already decided is the least a trend plot can be. A figure
     * that still does not fit at that floor scrolls, and says so by scrolling.
     *
     * The height is read off `.plot-area` rather than out of `--plot-h`.
     * `--plot-h` is now unset on every chart on the site — a plot derives its
     * height from its own width — so `getPropertyValue` returned "" and the
     * multiply produced NaN. Measuring the laid-out box works whichever way the
     * height was arrived at, which is the property that stops this breaking the
     * next time the sizing rule changes.
     */
    function grow(root: HTMLElement) {
      const plots = Array.from(root.querySelectorAll<HTMLElement>(".plot"));
      const kept = plots.map((el) => ({
        el,
        height: el.style.getPropertyValue("--plot-h"),
      }));
      /*
       * Measured on `.plot-area`, because that is what `--plot-h` sets.
       *
       * It used to divide by the height of `.plot`, which is the drawing box
       * plus the x axis and the band reserved above it for the unit label. The
       * factor was therefore applied to a smaller box than it had been solved
       * for, and the figure came up short of fitting by exactly the chrome the
       * two measurements differ by — 80px on figure 1.1 at 1600x900, 163 on
       * 1.3. Solving and applying against the same box makes the new figure
       * height `rest + room`, which is the stage.
       */
      const areas = plots
        .map((el) => el.querySelector<HTMLElement>(".plot-area"))
        .filter((el): el is HTMLElement => el != null);
      const marks = areas.reduce(
        (sum, el) => sum + el.getBoundingClientRect().height,
        0,
      );
      if (marks <= 0) return kept;

      /*
       * The stage's CONTENT height, not its `clientHeight`.
       *
       * `clientHeight` includes padding, and this stage carries 22px above and
       * 35.2px below. Solving against it fitted the figure to the padding box
       * and left the padding itself overflowing: figure and stage both measured
       * 739px and the scrollbar was still 57px long, which is exactly the two
       * paddings.
       */
      const stageStyle = getComputedStyle(stage);
      const stageRoom = stage.clientHeight -
        parseFloat(stageStyle.paddingTop || "0") -
        parseFloat(stageStyle.paddingBottom || "0");
      const rest = root.getBoundingClientRect().height - marks;
      const room = stageRoom - rest;
      const factor = Math.min(room / marks, 3);
      kept.forEach(({ el }) => {
        const area = el.querySelector<HTMLElement>(".plot-area");
        const now = area?.getBoundingClientRect().height ?? 0;
        if (now > 0) {
          const target = Math.max(Math.round(now * factor), MIN_PLOT_H);
          el.style.setProperty("--plot-h", `${target}px`);
        }
      });
      return kept;
    }

    /*
     * Put the figure back where it came from. Safe to call twice.
     *
     * Idempotent because it is called from three places, and it is called from
     * three places rather than only from the `close` event because that event
     * cannot be relied on to arrive. Measured: with no visible viewport,
     * `dialog.open` went false while `close` never fired — the same
     * viewport-less condition recorded in the note above `@keyframes enter`,
     * and here it would have left the figure inside a shut dialog with a
     * placeholder standing in for it on the page. The two paths a reader can
     * actually take now restore on the spot and wait for nothing; the event
     * stays for Escape, which the platform owns.
     */
    function restore() {
      if (!held) return;
      const { root, slot, tools, plots, opener } = held;
      held = null;
      plots.forEach(({ el, height }) => {
        if (height) el.style.setProperty("--plot-h", height);
        else el.style.removeProperty("--plot-h");
      });
      /* Back into the figure before it goes back into the page, so the toolbar
         travels with it and `opener?.focus()` below still finds its button. */
      if (tools) root.append(tools);
      slot.replaceWith(root);
      /*
       * Back to the button that opened it.
       *
       * A modal takes focus on `showModal`, and closing one hands it back only
       * if something asks. Measured: after 放大 and then 關閉, `activeElement`
       * was `<body>` — so a reader working by keyboard was returned to the top
       * of the document, several chapters above the figure they had just been
       * looking at. The button is inside `root`, which has only just been put
       * back, so this has to happen after the `replaceWith` above.
       */
      opener?.focus();
    }

    shut.addEventListener("click", () => {
      dialog.close();
      restore();
    });

    // Clicking the scrim closes it. The dialog's own box is the only child that
    // can be the target, so anything landing on the element itself is outside.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        dialog.close();
        restore();
      }
    });

    dialog.addEventListener("close", restore);

    // ── 下載 PNG ────────────────────────────────────────────────────────────

    let sheets: string | null = null;

    /** Every rule in the document, because the export document has none. */
    function stylesheetText(): string {
      if (sheets !== null) return sheets;
      let css = "";
      for (const sheet of Array.from(document.styleSheets)) {
        try {
          for (const rule of Array.from(sheet.cssRules)) css += `${rule.cssText}\n`;
        } catch {
          // A cross-origin sheet cannot be read through the CSSOM. This site
          // loads none; if one ever appears the export loses its rules rather
          // than throwing away the whole figure.
        }
      }
      sheets = css;
      return css;
    }

    /*
     * The theme the reader is actually in, as literal values.
     *
     * Media queries inside an SVG loaded as an image are evaluated against the
     * image, which has no reader and no system preference — so
     * `prefers-color-scheme` answers light there whatever the page is showing.
     * Resolving every custom property against the live document and emitting
     * them last pins the export to what is on the screen.
     */
    function pinnedTheme(css: string): string {
      const root = getComputedStyle(document.documentElement);
      const names = new Set(css.match(/--[\w-]+/g) ?? []);
      let out = "";
      for (const name of names) {
        const value = root.getPropertyValue(name);
        if (value) out += `${name}:${value};`;
      }
      return out;
    }

    // The serialised figure is parsed as XML, where these two are markup.
    const esc = (text: string) =>
      text.replace(/&/g, "&amp;").replace(/</g, "&lt;");

    async function render(root: HTMLElement): Promise<HTMLCanvasElement> {
      const box = root.getBoundingClientRect();
      // Enough that the card's own border is not the edge of the file.
      const pad = 18;

      /*
       * The controls are dropped from the copy, so their height has to come off
       * the frame too — measured, the first version left 42px of empty
       * background along the bottom of every export.
       *
       * Nothing else moves, and that is why the toolbar is appended last rather
       * than inserted before the caption: removing a trailing element changes
       * no other element's position, so the copy lays out identically to what
       * is on the screen.
       */
      /* 2026-08-03 — the entry map's toolbar has an external reading-order
         mount, so its root frame already excludes that toolbar from the image. */
      const tools = root.querySelector<HTMLElement>(".fig-tools");
      /* 2026-08-03 — the reserved readout dock is transient too. Its outer
         block size must leave the export frame with the same tight ending as
         the clone after the dock is removed, rather than a dock-sized field. */
      const outerBlockSize = (element: HTMLElement) => {
        const style = getComputedStyle(element);
        return (
          element.getBoundingClientRect().height +
          parseFloat(style.marginTop || "0") +
          parseFloat(style.marginBottom || "0")
        );
      };
      const shed =
        (tools ? outerBlockSize(tools) : 0) +
        Array.from(root.querySelectorAll<HTMLElement>(".readout-dock")).reduce(
          (total, dock) => total + outerBlockSize(dock),
          0,
        );
      const inner = Math.max(box.height - shed, 1);

      const w = Math.ceil(box.width) + pad * 2;
      const h = Math.ceil(inner) + pad * 2;
      // Two at minimum, so the file survives being placed at half its size in
      // something else; the reader's own ratio when that is higher.
      const scale = Math.min(Math.max(window.devicePixelRatio || 1, 2), 3);

      const copy = root.cloneNode(true) as HTMLElement;
      /*
       * Two things the copy must not carry.
       *
       * `.fig-tools` because a sheet of paper — or a PNG — opens no dialogs.
       * And the readout's JSON payload, because the export is a `<foreignObject>`
       * inside an SVG *image*: it is a separate document with no UA stylesheet,
       * so the `display: none` a browser gives `<script>` for free does not
       * apply and the whole series would print as a wall of numbers across the
       * figure. Its crosshair and panel go too — they are a pointer's state, and
       * a still image has no pointer.
       */
      copy
        .querySelectorAll(
          ".fig-tools, .plot-readout-data, .readout-dock, .readout-rule, .readout-dot, .readout-panel, .readout-say",
        )
        .forEach((el) => el.remove());
      copy.style.margin = "0";

      /*
       * The switches are pinned to what the reader actually left them at.
       *
       * `cloneNode` copies attributes, and a checkbox the reader has clicked
       * has a `checked` PROPERTY that no longer matches its `checked`
       * attribute. The export is serialised with `XMLSerializer`, which writes
       * attributes — so a figure filtered down to two zones on screen came out
       * of 下載 with all eight drawn and all eight pills lit, because the
       * generated `:has(… :not(:checked))` rules found every box checked in the
       * copy. The image has to be the figure that was on the screen.
       *
       * Walked in parallel over both trees rather than matched by `id`: the
       * clone is not in the document, so `getElementById` cannot reach it, and
       * a clone of a subtree containing duplicate ids would resolve the wrong
       * one anyway.
       */
      const liveBoxes = root.querySelectorAll<HTMLInputElement>("input[type=checkbox]");
      const copiedBoxes = copy.querySelectorAll<HTMLInputElement>("input[type=checkbox]");
      liveBoxes.forEach((box, i) => {
        const twin = copiedBoxes[i];
        if (!twin) return;
        if (box.checked) twin.setAttribute("checked", "");
        else twin.removeAttribute("checked");
      });

      const host = document.createElement("div");
      host.setAttribute("xmlns", "http://www.w3.org/1999/xhtml");
      host.append(copy);

      const css = stylesheetText();
      const field =
        getComputedStyle(document.body).backgroundColor ||
        getComputedStyle(document.documentElement).backgroundColor;

      /*
       * Animations are switched off in the copy, not left to run.
       *
       * The entrance animation carries `backwards` fill, and the note above
       * `@keyframes enter` records what that does where no clock advances: the
       * `from` state is held indefinitely. That was made harmless on this site
       * by animating position only — so an export would be legible but seven
       * pixels out of place. Off is exact.
       */
      const svg =
        `<svg xmlns="http://www.w3.org/2000/svg" width="${w * scale}" height="${h * scale}" viewBox="0 0 ${w} ${h}">` +
        `<style>${esc(css)}\n:root{${esc(pinnedTheme(css))}}\n` +
        `*,*::before,*::after{animation:none!important;transition:none!important}</style>` +
        `<rect width="100%" height="100%" fill="${field}"/>` +
        `<foreignObject x="${pad}" y="${pad}" width="${box.width}" height="${inner}">` +
        new XMLSerializer().serializeToString(host) +
        `</foreignObject></svg>`;

      const image = new Image();
      await new Promise<void>((resolve, reject) => {
        image.onload = () => resolve();
        image.onerror = () => reject(new Error("圖像無法算繪"));
        image.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
      });

      const canvas = document.createElement("canvas");
      canvas.width = Math.round(w * scale);
      canvas.height = Math.round(h * scale);
      const ctx = canvas.getContext("2d");
      if (!ctx) throw new Error("沒有 2d context");
      ctx.drawImage(image, 0, 0, canvas.width, canvas.height);
      return canvas;
    }

    /*
     * Where it came from, in the name.
     *
     * These files get dropped into other documents, and by then the only thing
     * left saying which chapter a chart is from is its filename. The page comes
     * off the path with the deployment's base removed, so it is `trend` both at
     * `/trend` locally and at `/air-quality/trend` on Pages.
     */
    const BASE = import.meta.env.BASE_URL.replace(/\/*$/, "/");

    function filename(index: number): string {
      const page =
        location.pathname.slice(BASE.length).replace(/\/+$/, "") || "index";
      return `air-quality-${page}-${index + 1}.png`;
    }

    async function save(
      root: HTMLElement,
      button: HTMLButtonElement,
      index: number,
    ) {
      const settled = button.textContent ?? "下載";
      button.disabled = true;
      button.textContent = "產生中…";
      try {
        const canvas = await render(root);
        const blob = await new Promise<Blob | null>((resolve) =>
          canvas.toBlob(resolve, "image/png"),
        );
        if (!blob) throw new Error("canvas 沒有回傳 blob");

        const name = filename(index);
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = name;
        link.click();
        // The click hands the blob over asynchronously, so the handle is
        // released on a timer rather than on the next line.
        setTimeout(() => URL.revokeObjectURL(url), 10_000);

        say.textContent = `已產生 ${name}，${canvas.width}×${canvas.height}`;
      } catch (error) {
        // Said out loud rather than only in the console: the button was pressed
        // and something has to answer it.
        button.textContent = "無法產生";
        say.textContent = "這張圖無法輸出成 PNG";
        console.error(error);
        setTimeout(() => {
          button.textContent = settled;
        }, 4000);
        return;
      } finally {
        button.disabled = false;
      }
      button.textContent = settled;
    }

    // Last, so every handler above exists before anything can be pressed.
    Array.from(document.querySelectorAll<HTMLElement>(ROOTS)).forEach(equip);
  }

  if (dialog && stage && plate && shut && say) {
    start(dialog, stage, plate, shut, say);
  }
</script>
