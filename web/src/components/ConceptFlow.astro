---
/*
 * Five variants, because the chapters hold five logical shapes.
 *
 * One component rendered every diagram as the same four cards and an arrow,
 * and the owner noticed: 「怎麼圖解都長差不多?」. The honest answer is that
 * five of the seven ARE sequences, and a flowchart is the right form for a
 * sequence — uniformity there is coherence. But two were never sequences:
 *
 * - `boundary`: chapter 9's subject is a trust edge — two downloads cross into
 *   the reader's browser and nothing crosses out. A context diagram draws the
 *   edge; the steps inside it sit inside a drawn zone, and the connector into
 *   step 2 is the crossing.
 *
 * A `fork` variant lived here too, drawing a step's options as branches off a
 * spine. Chapter 7 was its only caller and its branches repeated figure 7.1's
 * own legend, so the content went and the variant went with it — a form with
 * nothing to hold is CSS nobody renders and therefore nobody checks.
 *
 * The remaining one keeps this component's DOM contract — an ordered list a screen reader
 * hears as a sequence — because the reading ORDER is still sequential even
 * where the geometry is not.
 */
export type ConceptVariant = "process" | "timeline" | "layers" | "boundary";
export type ConceptTone = "neutral" | "cool" | "warm" | "boundary";

export interface ConceptOption {
  title: string;
  detail?: string;
}

export interface ConceptStep {
  label: string;
  title: string;
  detail: string;
  tone?: ConceptTone;
  options?: readonly ConceptOption[];
}

interface Props {
  title: string;
  summary: string;
  steps: readonly ConceptStep[];
  variant?: ConceptVariant;
  /** boundary only: the zone label. Steps 2..N are drawn inside the zone. */
  boundaryLabel?: string;
}

const { title, summary, steps, variant = "process", boundaryLabel } = Astro.props;

if (variant === "boundary" && !boundaryLabel) {
  throw new Error("ConceptFlow boundary variant requires a boundaryLabel");
}

if (steps.length < 3 || steps.length > 5) {
  throw new Error(`ConceptFlow requires 3–5 steps; received ${steps.length}`);
}

const number = (index: number) => String(index + 1).padStart(2, "0");
---

<figure
  class="concept-flow"
  data-concept-diagram
  data-variant={variant}
  style={`--concept-columns:${steps.length}`}
>
  <figcaption>
    <strong data-concept-title>{title}</strong>
    <span data-concept-summary>{summary}</span>
  </figcaption>

  <ol
    role="list"
    data-boundary-label={variant === "boundary" ? boundaryLabel : undefined}
    style={variant === "boundary" ? `--concept-zone-end:${steps.length + 1}` : undefined}
  >
    {
      steps.map((step, index) => (
        <li data-concept-step data-tone={step.tone ?? "neutral"}>
          <span class="concept-index" aria-hidden="true">{number(index)}</span>
          <span class="concept-label" data-concept-label>{step.label}</span>
          <strong class="concept-title" data-concept-step-title>{step.title}</strong>
          <p data-concept-detail>{step.detail}</p>
          {step.options?.length ? (
            <ul aria-label={`${step.title}的選項`}>
              {step.options.map((option) => (
                <li>
                  <strong>{option.title}</strong>
                  {option.detail && <span>{option.detail}</span>}
                </li>
              ))}
            </ul>
          ) : null}
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .concept-flow {
    --concept-mark: var(--diagram-neutral);
    /* 2026-09-02 — `relative` for the toolbar's corner; one column, because
       the toolbar no longer takes the first one. */
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: var(--space-3);
    max-width: none;
    /*
     * `margin-block`, never the `margin` shorthand.
     *
     * The shorthand also sets the inline margins, and the page's bleed is half
     * width and half negative inline margin. This rule compiles to
     * `.concept-flow[data-astro-cid-…]`, which ties the global rule's
     * specificity and is injected after it — so the width half applied, the
     * margin half did not, and the diagram grew to the RIGHT only. Measured the
     * moment the bleed was extended to these figures: 1244px starting at x=207
     * against a 1440px viewport, and the document scrolled sideways by 25px.
     *
     * `global.css` carries the same warning about the same trap on the rule
     * above; this is the second component to walk into it.
     */
    margin-block: var(--space-4) var(--space-5);
    /*
     * One frame, not two.
     *
     * The panel and every card inside it each carried a border, a tint and a
     * radius, so a four-step diagram drew five boxes and the reader's eye had
     * to discard four of them to find the content. The panel keeps the frame
     * because it bleeds wider than the prose and needs an edge; the cards give
     * theirs up and separate by surface instead — `--bg-raised` on
     * `--bg-sunken` is a measured step of 0.05 in lightness, which is a
     * boundary without a line.
     */
    padding: var(--space-4) var(--space-3) var(--space-3);
    /*
     * A surface, without a line around it as well.
     *
     * A background and a border both say 「this is one region」, and saying it
     * twice is the same double-marking the cards were just relieved of.
     * `--bg-sunken` against the page's `--bg` is a step of 0.032 in lightness
     * — enough to read as a panel, which is all the border was doing.
     *
     * The radius is larger than the cards', not equal to it. Concentric
     * corners at the same radius read as a mistake because the outer curve has
     * to travel further to turn the same corner; +4px is the padding-matched
     * value that makes the two look like one nested pair.
     */
    border: 0;
    border-radius: calc(var(--radius) + 4px);
    background: var(--bg-sunken);
  }

  /* FigureTools is injected after hydration and therefore has no Astro scope
     attribute. Keep it in normal flow so zoom/export height accounting remains
     exact, but visually order it first on the diagram's left reading edge. */
  /* 2026-09-02 — supersedes the left-edge placement above: the toolbar sits in
     the panel's top-right corner, where every evidence figure keeps its own,
     out of flow so the caption row costs nothing. The zoom dialog parks the
     toolbar in its own header while open, so this position is only ever
     measured against the panel. */
  .concept-flow > :global(.fig-tools) {
    position: absolute;
    top: var(--space-4);
    right: var(--space-3);
    margin: 0;
  }

  .concept-flow > figcaption {
    display: grid;
    grid-column: 1;
    grid-row: 1;
    gap: 0.32rem;
    max-width: none;
    margin: 0;
    /* 9.5rem holds the 175px toolbar plus a gap at the site's 22px root. A
       margin, not padding, and declared after the `margin: 0` above: the gate
       measures the caption's BOX against the toolbar and requires 8–64px
       between them, and padding sits inside the box — the first draft used
       padding, the second put the margin before the shorthand that resets it,
       and both times every diagram reported the toolbar overlapping a caption
       no ink came near. */
    margin-inline-end: 9.5rem;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .concept-flow > figcaption strong {
    color: var(--text);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.25;
    text-wrap: balance;
  }

  .concept-flow > figcaption span {
    text-wrap: pretty;
  }

  .concept-flow > ol {
    display: grid;
    grid-column: 1 / -1;
    grid-row: 2;
    grid-template-columns: repeat(var(--concept-columns), minmax(0, 1fr));
    /*
     * Four named rows so the cards can share them.
     *
     * Every card was its own grid, so its rows were sized by its own content
     * and nothing lined up across the row: measured on /trend, the detail
     * paragraphs started 29px apart because two titles wrapped to a second
     * line and two did not. Worse, it was guaranteed rather than incidental —
     * the boundary tone prefixes its label with 「界線 · 」, so on all seven
     * diagrams exactly one label ran to two lines while its neighbours ran to
     * one.
     *
     * With `subgrid` on the cards, the label row is as tall as the tallest
     * label and every title and detail begins on the same line, whatever the
     * text does.
     */
    gap: var(--space-3);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  :global(.concept-flow:not(:has(> .fig-tools))) > figcaption {
    margin-inline-end: 0;
  }

  .concept-flow[data-variant="layers"] > ol {
    grid-template-columns: minmax(0, 1fr);
  }

  /*
   * Cards share the list's rows, so the same parts line up across the row.
   *
   * Each card used to be its own grid sized by its own content, and nothing
   * lined up: measured on /trend, the detail paragraphs began 29px apart
   * because two titles wrapped to a second line and two did not. It was
   * guaranteed rather than incidental — the boundary tone prefixes its label
   * with 「界線 · 」, so on all seven diagrams exactly one label ran to two
   * lines while its neighbours ran to one.
   *
   * Scoped to the multi-column case on purpose. `layers` is a single column and
   * the narrow layout collapses to one, and four cards each spanning four
   * tracks inside one column would need sixteen: the explicit `1fr` would fall
   * to the first card and stretch it alone.
   */
  @media (min-width: 48.0625rem) {
    .concept-flow:not([data-variant="layers"]) > ol {
      grid-template-rows: auto auto auto 1fr;
    }

    .concept-flow:not([data-variant="layers"]) > ol > [data-concept-step] {
      grid-row: span 4;
      grid-template-rows: subgrid;
    }
  }

  [data-concept-step] {
    --step-mark: var(--diagram-neutral);
    --step-surface: color-mix(in oklab, var(--step-mark) 8%, var(--bg-raised));
    position: relative;
    display: grid;
    /* 2rem, not 2.25: the boundary label is the longest on every diagram and
       needed 175px on one line against 174px of track. Six pixels off a
       decorative, aria-hidden circle buys it, and buys back the second label
       row that subgrid would otherwise charge to all four cards. */
    grid-template-columns: 2rem minmax(0, 1fr);
    align-content: start;
    gap: 0.3rem var(--space-2);
    min-width: 0;
    /*
     * Symmetric, and `--space-2` on the inline axis.
     *
     * Horizontal padding is paid eight times across a four-column row and
     * every pixel of it comes out of a line that holds about eleven Chinese
     * characters at 1440 and eight at 1280 — the measurement an earlier round
     * raised from eight by giving these figures the page bleed. The vertical
     * axis can afford `--space-3` now that the card has no border crowding its
     * content.
     */
    padding: var(--space-3) var(--space-2);
    /*
     * Transparent, not absent: `box-sizing` is border-box, so a bordered card
     * among borderless ones would be 2px narrower in its content box and one
     * of four columns would set its text on a different measure. The boundary
     * card below only changes this border's colour and style.
     */
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: var(--step-surface);
  }

  /*
   * The role lives in the marker, not in the surface.
   *
   * Every card used to be washed with its own tone at 8%. Two of the four
   * roles are greys — neutral is `--rule`, and 8% of a grey on an off-white is
   * nothing — so a scheme with four levels rendered as two coloured cards and
   * two blank ones, which reads as decoration that ran out rather than as a
   * scale. The tone now carries at full strength in two small places, the
   * disc's ring and the label, and every card takes the same surface. Four
   * roles, four visible markers.
   */
  [data-concept-step] {
    --step-surface: var(--bg-raised);
    --step-ink: var(--text-faint);
  }

  [data-tone="cool"] {
    --step-mark: var(--diagram-cool);
    --step-ink: var(--k0-ink);
  }

  [data-tone="warm"] {
    --step-mark: var(--diagram-warm);
    --step-ink: var(--k1-ink);
  }

  /*
   * The boundary step is a different kind of step, so it is marked by kind.
   *
   * It was a fourth hue, and it did not read as one: `--diagram-warm` is
   * oklch(0.595 0.147 50) and `--diagram-boundary` oklch(0.49 0.13 34) — **16
   * degrees of hue apart** at comparable chroma, which at an 8% tint left cards
   * three and four looking like the same colour on every diagram that uses
   * both.
   *
   * Adding a fifth hue would only move the collision. This card does not
   * continue the sequence, it says where the sequence stops being supported —
   * so it drops the tint the three steps share and takes a dashed rule instead.
   * A broken line reads as a limit rather than as another stage, and it tells
   * the two apart by something other than a hue nobody can name.
   */
  [data-tone="boundary"] {
    --step-mark: var(--diagram-boundary);
    /*
     * Grey, and that is the same decision one level further on.
     *
     * An earlier round took the boundary card off its own hue because
     * `--diagram-warm` and `--diagram-boundary` sit 16 degrees apart and read
     * as one colour; it is marked by KIND instead — a dashed outline and the
     * 「界線 · 」 prefix. Colouring its label would walk that back, and the
     * measurement says so too: `--editorial-accent` has no dark-theme value,
     * so as reading ink it lands at Lc 19.4 against a floor of 60. The card
     * that carries the most marks needs no more.
     */
    --step-ink: var(--text-faint);
    /* The only card that keeps an outline, now that the others have given
       theirs up — and it is dashed and unfilled, so the difference reads as
       「this one is not part of the solid sequence」 rather than as one more
       hue. */
    --step-surface: transparent;
    border-color: color-mix(in oklab, var(--diagram-boundary) 45%, var(--line));
    border-style: dashed;
  }

  /*
   * The connector belongs at the markers' height.
   *
   * It sat at 50% of the card, which on a 290px card put a process arrow in
   * the middle of a paragraph — it read as punctuation between two blocks of
   * text rather than as a link between two steps. Anchored to the disc's
   * centre instead (`--space-3` of padding plus half of the 2rem disc), the
   * four discs and the three arrows now form one horizontal line, which is
   * the line a reader follows.
   *
   * Still a glyph, deliberately. Forced-colors mode forces `background-color`,
   * so an arrow drawn as a shape would vanish for exactly the readers who need
   * it most; a glyph is painted with `color`, which forced-colors maps to
   * CanvasText — and the gate checks that mapping.
   */
  .concept-flow > ol > [data-concept-step]:not(:last-child)::after {
    content: "→";
    position: absolute;
    z-index: 1;
    inset-inline-end: calc(var(--space-3) * -0.5);
    inset-block-start: calc(var(--space-3) + 1rem);
    color: var(--rule);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1;
    transform: translate(50%, -50%);
  }

  .concept-flow[data-variant="layers"] > ol > [data-concept-step]:not(:last-child)::after {
    content: "↓";
    inset-inline-end: auto;
    inset-block-start: auto;
    inset-inline-start: 1.45rem;
    inset-block-end: calc(var(--space-3) * -0.5);
    transform: translate(-50%, 50%);
  }

  .concept-index {
    display: grid;
    grid-row: 1;
    place-items: center;
    width: 2rem;
    height: 2rem;
    /* 2px, not 1: with the card's own border gone this ring is the diagram's
       structural mark, and a hairline reads as a hint rather than a station on
       a line. The number stays `--text` on `--bg-raised` — a filled disc would
       need white on `--k0`, which measures Lc 35 in the dark theme. */
    border: 2px solid var(--step-mark);
    border-radius: 50%;
    color: var(--text);
    background: var(--bg-raised);
    font-size: var(--text-xs);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .concept-label {
    align-self: center;
    /* The role's own ink. `--k0-ink`/`--k1-ink` are the measured reading
       weights of the same two marks, so the label names the role in the colour
       the disc draws it in without inventing a hue or a contrast. */
    color: var(--step-ink);
    font-size: var(--text-xs);
    font-weight: 700;
    /* Tracking was 0.05em, which on a nine-character CJK label costs 11px —
       exactly the margin between one line and two. Latin small labels earn
       tracking; 中文 does not need it to read as a label when it already has
       the weight and the colour. */
    line-height: 1.2;
  }

  [data-tone="boundary"] .concept-label::before {
    content: "界線 · ";
  }

  .concept-title {
    grid-column: 1 / -1;
    min-width: 0;
    color: var(--text);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: 1.3;
  }

  [data-concept-detail] {
    grid-column: 1 / -1;
    margin: var(--space-1) 0 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  [data-concept-step] > ul {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 7rem), 1fr));
    gap: var(--space-1);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  [data-concept-step] > ul > li {
    display: grid;
    gap: 0.12rem;
    min-width: 0;
    padding: var(--space-1) var(--space-2);
    border-inline-start: 2px solid var(--step-mark);
    background: color-mix(in oklab, var(--step-mark) 5%, var(--bg-raised));
    font-size: var(--text-xs);
    line-height: 1.4;
  }

  [data-concept-step] > ul span {
    color: var(--text-muted);
  }

  /*
   * Boundary: the subject is a trust edge, so the edge is drawn.
   *
   * A dashed zone encloses steps 2..N — the work that stays inside the
   * reader's browser — and step 1 sits outside it, so the 1→2 connector is the
   * one crossing: the download. The zone is the ol's own ::before placed into
   * the same grid tracks as the cards (pseudo-elements of a grid container are
   * grid items), inflated by a negative margin so the cards keep their size.
   * The label takes an implicit row of its own below the zone rather than
   * absolute positioning, so it can never overlap a card at any width.
   */
  .concept-flow[data-variant="boundary"] > ol {
    position: relative;
  }

  /*
   * Absolutely positioned, and that is load-bearing. A grid pseudo-element
   * placed with grid-column/row OCCUPIES those cells for auto-placement, so a
   * zone drawn as a normal grid item shoved cards 2–4 into implicit rows below
   * itself — an 803px diagram with an empty box where the cards belonged, and
   * the gate could not see it because the displaced cards were still visible,
   * ordered and unclipped. An absolutely positioned grid child still takes its
   * grid area as containing block but occupies nothing, which is exactly a
   * drawn overlay's contract. The negative inset is the inflation the margin
   * used to provide.
   */
  .concept-flow[data-variant="boundary"] > ol::before {
    content: "";
    position: absolute;
    z-index: 0;
    grid-column: 2 / -1;
    grid-row: 1 / -1;
    inset: calc(var(--space-2) * -1);
    border: 2px dashed color-mix(in oklab, var(--diagram-boundary) 60%, var(--line));
    border-radius: calc(var(--radius) + 4px);
    pointer-events: none;
  }

  .concept-flow[data-variant="boundary"] > ol::after {
    content: attr(data-boundary-label);
    grid-column: 2 / -1;
    grid-row: 5;
    justify-self: center;
    margin-block-start: calc(var(--space-2) * -0.5);
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1.4;
    text-align: center;
    text-wrap: balance;
  }


  @media (max-width: 48rem) {
    .concept-flow {
      grid-template-columns: minmax(0, 1fr);
      margin-block: var(--space-3) var(--space-4);
      padding: var(--space-2);
    }

    /* 2026-09-02 — below the tablet boundary the toolbar returns to the flow,
       under the steps and right-aligned, as an evidence figure's does. */
    .concept-flow > :global(.fig-tools) {
      position: static;
      grid-column: 1;
      grid-row: 3;
      justify-content: flex-end;
      margin-block-start: var(--space-2);
    }

    .concept-flow > figcaption {
      grid-column: 1;
      grid-row: 1;
      margin-inline-end: 0;
    }

    .concept-flow > ol {
      grid-column: 1;
      grid-row: 2;
      grid-template-columns: minmax(0, 1fr);
    }

    .concept-flow > ol > [data-concept-step]:not(:last-child)::after {
      content: "↓";
      inset-inline-end: auto;
      inset-block-start: auto;
      inset-inline-start: 1.45rem;
      inset-block-end: calc(var(--space-3) * -0.5);
      transform: translate(-50%, 50%);
    }

    /* One column: the zone wraps the rows of steps 2..N instead of columns.
       `--concept-zone-end` is the step count + 1, set inline, because a grid
       line cannot be computed in CSS. */
    .concept-flow[data-variant="boundary"] > ol::before {
      grid-column: 1;
      grid-row: 2 / var(--concept-zone-end, 5);
    }

    .concept-flow[data-variant="boundary"] > ol::after {
      grid-column: 1;
      grid-row: var(--concept-zone-end, 5);
    }
  }

  @media (forced-colors: active) {
    .concept-flow {
      --concept-forced-colors: active;
    }

    .concept-flow[data-variant="boundary"] > ol::before {
      border-color: CanvasText;
    }

    .concept-flow[data-variant="boundary"] > ol::after {
      color: CanvasText;
    }

    .concept-flow,
    [data-concept-step],
    .concept-index,
    [data-concept-step] > ul > li {
      border-color: CanvasText;
      background: Canvas;
    }

    .concept-flow > ol > [data-concept-step]:not(:last-child)::after,
    .concept-index,
    .concept-label,
    .concept-title,
    [data-concept-detail],
    [data-concept-step] > ul span {
      color: CanvasText;
    }
  }

  @media print {
    .concept-flow {
      --concept-print: ready;
      break-inside: avoid;
      background: transparent;
    }

    [data-concept-step],
    .concept-index,
    [data-concept-step] > ul > li {
      break-inside: avoid;
      background: transparent;
    }
  }
</style>
