---
/*
 * Five variants, because the chapters hold five logical shapes.
 *
 * One component rendered every diagram as the same four cards and an arrow,
 * and the owner noticed: 「怎麼圖解都長差不多?」. The honest answer is that
 * five of the seven ARE sequences, and a flowchart is the right form for a
 * sequence — uniformity there is coherence. But two were never sequences:
 *
 * - `boundary`: chapter 9's subject is a trust edge — two downloads cross into
 *   the reader's browser and nothing crosses out. A context diagram draws the
 *   edge; the steps inside it sit inside a drawn zone, and the connector into
 *   step 2 is the crossing.
 *
 * A `fork` variant lived here too, drawing a step's options as branches off a
 * spine. Chapter 7 was its only caller and its branches repeated figure 7.1's
 * own legend, so the content went and the variant went with it — a form with
 * nothing to hold is CSS nobody renders and therefore nobody checks.
 *
 * The remaining one keeps this component's DOM contract — an ordered list a screen reader
 * hears as a sequence — because the reading ORDER is still sequential even
 * where the geometry is not.
 *
 * ── 2026-09-02 — supersedes the paragraph above about uniformity ──────────
 *
 * The owner looked at the seven rendered diagrams and asked the question the
 * comment had answered too easily: could the site's diagrams be better looking,
 * and could each chapter use a form that fits what it argues? Six of the seven
 * were the identical four-card row. Coherence was real, but it was carried by
 * the CARD — a raised surface, a ring disc, an arrow — and a card says nothing
 * about the argument inside it. So the card and the disc are gone, and what
 * they carried has moved:
 *
 * - **The plate.** Every diagram is now a monograph's ruled figure: a Plex
 *   numeral on a short heavy toned baseline running into a long light hairline
 *   that continues into both gutters and breaks where the connector sits. That
 *   rule is the coherence the cards used to provide, and it costs no surface,
 *   so the screen state and the print state are finally the same drawing.
 * - **The strip.** Above each column, one optional drawing, and it is the only
 *   thing allowed to differ between chapters: narrowing brackets on /trend/, a
 *   cloud ringed and then cut on /space/, a ladder that turns dashed where the
 *   evidence stops on /sources/, two lanes meeting one band on /detection/, one
 *   concentration axis gaining a cut on /health/, two wires crossing an edge
 *   with a stopped return track on /explore/, one month at three densities on
 *   /data/. The drawings live in `web/src/lib/concept-vignettes.ts`, whose
 *   header carries the rules they obey; the one this file enforces is that
 *   every word beside a drawing is an HTML span, never SVG text.
 * - **Tone follows the page's own figure.** Where a chapter's chart has already
 *   given `--k0`/`--k1` a meaning, the plate takes the same assignment rather
 *   than the one the sequence would suggest. The same hue two hundred pixels
 *   apart with two meanings is the trap this redesign was most at risk of.
 * - **Dashed means the claim stops here**, on all seven plates: the boundary
 *   step's baseline and head rule, the unreached rungs, the return track that
 *   carries nothing, the edge beyond which this project does not go. No plate
 *   inverts it.
 *
 * The four variant names are unchanged and no route changed its own. `timeline`
 * finally has geometry — two lanes and a join — rather than being a name with
 * no CSS behind it.
 */
import type { StripLabel } from "../lib/concept-vignettes";

export type ConceptVariant = "process" | "timeline" | "layers" | "boundary";
export type ConceptTone = "neutral" | "cool" | "warm" | "boundary";

export interface ConceptOption {
  title: string;
  detail?: string;
}

export interface ConceptStep {
  label: string;
  title: string;
  detail: string;
  tone?: ConceptTone;
  options?: readonly ConceptOption[];
  /** An SVG string from `concept-vignettes.ts`. All steps carry one, or none do. */
  figure?: string;
  /** Words for the strip, placed in the strip's own coordinates. */
  labels?: readonly StripLabel[];
  /** `timeline`: where this step's connector sits, as a fraction of the strip. */
  lane?: number;
  /** `timeline`: draw 「∥」 rather than 「→」 — the same procedure, another input. */
  join?: "same";
  /** `layers`: the rule that folds this layer into the next, drawn on the connector. */
  fold?: string;
  /** `process`: a dashed limit down this card's leading edge. */
  stop?: string;
  /** `boundary`: this step's connector crosses the zone edge, so it is drawn heavier. */
  crossing?: boolean;
}

interface Props {
  title: string;
  summary: string;
  steps: readonly ConceptStep[];
  variant?: ConceptVariant;
  /** The strip row's height, e.g. `"5.2rem"`. Required when any step draws. */
  figureHeight?: string;
  /** `boundary` only: the zone's label and the steps it encloses (1-based, inclusive). */
  boundary?: { label: string; from: number; to: number };
  /** `layers` only: the publication edge is drawn in this step's foot (1-based). */
  edgeAfter?: number;
  edgeLabel?: string;
}

const {
  title,
  summary,
  steps,
  variant = "process",
  figureHeight,
  boundary,
  edgeAfter,
  edgeLabel,
} = Astro.props;

if (variant === "boundary" && !boundary) {
  throw new Error("ConceptFlow boundary variant requires a boundary zone");
}

if (steps.length < 3 || steps.length > 5) {
  throw new Error(`ConceptFlow requires 3–5 steps; received ${steps.length}`);
}

/*
 * A drawing row is complete or absent, and the build says so rather than the
 * gate. `check_site_quality.mjs` fails a page whose strips outnumber nothing
 * and undernumber its steps, because a gap in the row is a drawing that failed
 * to render; catching it here names the caller instead of the route.
 */
const drawn = steps.filter((step) => step.figure).length;
if (drawn && drawn !== steps.length) {
  throw new Error(`ConceptFlow draws ${drawn} of ${steps.length} steps; draw all or none`);
}
if (drawn && !figureHeight) {
  throw new Error("ConceptFlow needs a figureHeight when its steps draw");
}

/* `timeline` is two lanes and a join; without the strips it is `process` under
   another name, which is what it was for as long as it had no CSS. */
if (variant === "timeline" && !drawn) {
  throw new Error("ConceptFlow timeline is two lanes; its steps must draw them");
}

/*
 * `attr()` on a pseudo-element resolves an absent attribute to the empty
 * string, which would draw 「↓ 」 — a connector the gate can see and a reader
 * cannot read. All the folds or none of them, for the same reason the drawing
 * row is all or none; a layers diagram with no folds keeps the bare arrow.
 */
const folded = steps.slice(0, -1).filter((step) => step.fold).length;
if (folded && folded !== steps.length - 1) {
  throw new Error(`ConceptFlow names ${folded} of ${steps.length - 1} folds; name all or none`);
}

if ((edgeAfter === undefined) !== (edgeLabel === undefined)) {
  throw new Error("ConceptFlow edgeAfter and edgeLabel are set together");
}

const number = (index: number) => String(index + 1).padStart(2, "0");

/*
 * A label's box is capped so it can never leave its card: the cap is the room
 * that remains between the label's anchor and the far edge of the content box.
 * A long label wraps inside that room rather than crossing into the gutter,
 * which is the property `stepOverflowCount` measures on every route and width.
 */
const labelStyle = (label: StripLabel): string => {
  const x = label.x / 100;
  const anchor = label.anchor ?? "start";
  const room = anchor === "start" ? 1 - x : anchor === "end" ? x : 2 * Math.min(x, 1 - x);
  const parts = [
    `--lx:${x}`,
    `--ly:${label.y / 40}`,
    `--lw:${Math.round(room * 1000) / 1000}`,
  ];
  if (anchor === "middle") parts.push("--ltx:-50%");
  if (label.vertical === "bottom") parts.push("--lty:-100%");
  return `${parts.join(";")};`;
};

const figureStyle = [
  `--concept-columns:${steps.length}`,
  figureHeight ? `--concept-figure-h:${figureHeight}` : "",
]
  .filter(Boolean)
  .join(";");

const listStyle = [
  variant === "boundary" && boundary
    ? `--concept-zone-start:${boundary.from};--concept-zone-end:${boundary.to + 1}`
    : "",
  edgeAfter
    ? `--concept-edge-row:${edgeAfter};--concept-edge-row-end:${edgeAfter + 1}`
    : "",
]
  .filter(Boolean)
  .join(";");
---

<figure
  class="concept-flow"
  data-concept-diagram
  data-variant={variant}
  style={figureStyle}
>
  <figcaption>
    <span class="concept-kind">圖解</span>
    <strong data-concept-title>{title}</strong>
    <span data-concept-summary>{summary}</span>
  </figcaption>

  <ol
    role="list"
    data-boundary-label={variant === "boundary" ? boundary?.label : undefined}
    data-edge-label={edgeLabel}
    style={listStyle || undefined}
  >
    {
      steps.map((step, index) => (
        <li
          data-concept-step
          data-tone={step.tone ?? "neutral"}
          data-join={step.join}
          data-concept-crossing={step.crossing ? "" : undefined}
          data-concept-edge={edgeAfter === index + 1 ? "" : undefined}
          data-fold={step.fold}
          style={step.lane === undefined ? undefined : `--concept-lane:${step.lane}`}
        >
          {step.figure && <Fragment set:html={step.figure} />}
          {step.labels?.map((label) => (
            <span
              class="concept-figure-label"
              data-anchor={label.anchor === "end" ? "end" : undefined}
              data-ink={label.ink}
              style={labelStyle(label)}
            >
              {label.text}
            </span>
          ))}
          {step.stop && <span class="concept-stop">{step.stop}</span>}
          <span class="concept-head" aria-hidden="true">
            <span class="concept-index">{number(index)}</span>
          </span>
          <span class="concept-label" data-concept-label>{step.label}</span>
          <strong class="concept-title" data-concept-step-title>{step.title}</strong>
          <p data-concept-detail>{step.detail}</p>
          {step.options?.length ? (
            <ul aria-label={`${step.title}的選項`}>
              {step.options.map((option) => (
                <li>
                  <strong>{option.title}</strong>
                  {option.detail && <span>{option.detail}</span>}
                </li>
              ))}
            </ul>
          ) : null}
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .concept-flow {
    --concept-mark: var(--diagram-neutral);
    /* 2026-09-02 — `relative` for the toolbar's corner; one column, because
       the toolbar no longer takes the first one. */
    position: relative;
    /* 2026-09-02 — a plate without a strip declares a zero-height drawing row,
       so the same six rows serve every diagram and nothing moves on the plates
       that do not draw. The head's height is a token rather than a measurement
       because the connector is placed against it: the rule is at
       `--concept-head-h` minus its own hairline, on every card of every plate,
       whatever the label under it does. */
    --concept-figure-h: 0px;
    --concept-head-h: 1.55rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: var(--space-3);
    max-width: none;
    /*
     * `margin-block`, never the `margin` shorthand.
     *
     * The shorthand also sets the inline margins, and the page's bleed is half
     * width and half negative inline margin. This rule compiles to
     * `.concept-flow[data-astro-cid-…]`, which ties the global rule's
     * specificity and is injected after it — so the width half applied, the
     * margin half did not, and the diagram grew to the RIGHT only. Measured the
     * moment the bleed was extended to these figures: 1244px starting at x=207
     * against a 1440px viewport, and the document scrolled sideways by 25px.
     *
     * `global.css` carries the same warning about the same trap on the rule
     * above; this is the second component to walk into it.
     */
    margin-block: var(--space-4) var(--space-5);
    /*
     * One frame, not two.
     *
     * The panel and every card inside it each carried a border, a tint and a
     * radius, so a four-step diagram drew five boxes and the reader's eye had
     * to discard four of them to find the content. The panel keeps the frame
     * because it bleeds wider than the prose and needs an edge; the cards give
     * theirs up and separate by surface instead — `--bg-raised` on
     * `--bg-sunken` is a measured step of 0.05 in lightness, which is a
     * boundary without a line.
     */
    padding: var(--space-4) var(--space-3) var(--space-3);
    /*
     * A surface, without a line around it as well.
     *
     * A background and a border both say 「this is one region」, and saying it
     * twice is the same double-marking the cards were just relieved of.
     * `--bg-sunken` against the page's `--bg` is a step of 0.032 in lightness
     * — enough to read as a panel, which is all the border was doing.
     *
     * The radius is larger than the cards', not equal to it. Concentric
     * corners at the same radius read as a mistake because the outer curve has
     * to travel further to turn the same corner; +4px is the padding-matched
     * value that makes the two look like one nested pair.
     */
    border: 0;
    border-radius: calc(var(--radius) + 4px);
    background: var(--bg-sunken);
  }

  /* FigureTools is injected after hydration and therefore has no Astro scope
     attribute. Keep it in normal flow so zoom/export height accounting remains
     exact, but visually order it first on the diagram's left reading edge. */
  /* 2026-09-02 — supersedes the left-edge placement above: the toolbar sits in
     the panel's top-right corner, where every evidence figure keeps its own,
     out of flow so the caption row costs nothing. The zoom dialog parks the
     toolbar in its own header while open, so this position is only ever
     measured against the panel. */
  .concept-flow > :global(.fig-tools) {
    position: absolute;
    top: var(--space-4);
    right: var(--space-3);
    margin: 0;
  }

  .concept-flow > figcaption {
    display: grid;
    grid-column: 1;
    grid-row: 1;
    gap: 0.32rem;
    max-width: none;
    margin: 0;
    /* 9.5rem holds the 175px toolbar plus a gap at the site's 22px root. A
       margin, not padding, and declared after the `margin: 0` above: the gate
       measures the caption's BOX against the toolbar and requires 8–64px
       between them, and padding sits inside the box — the first draft used
       padding, the second put the margin before the shorthand that resets it,
       and both times every diagram reported the toolbar overlapping a caption
       no ink came near. */
    margin-inline-end: 9.5rem;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  /*
   * 2026-09-02 — the series mark the numbered figures have and this one lacks.
   *
   * An evidence figure opens 「圖 1.1」 and a reader learns from that alone what
   * kind of thing they are looking at. A concept diagram had no such mark, so
   * it read as one more chart whose numbers were missing. 「圖解」 says what it
   * is: a drawing of the method, with nothing measured in it.
   */
  .concept-flow > figcaption .concept-kind {
    color: var(--text-faint);
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1.2;
  }

  .concept-flow > figcaption strong {
    color: var(--text);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.25;
    text-wrap: balance;
  }

  .concept-flow > figcaption span {
    text-wrap: pretty;
  }

  .concept-flow > ol {
    display: grid;
    grid-column: 1 / -1;
    grid-row: 2;
    grid-template-columns: repeat(var(--concept-columns), minmax(0, 1fr));
    /*
     * Four named rows so the cards can share them.
     *
     * Every card was its own grid, so its rows were sized by its own content
     * and nothing lined up across the row: measured on /trend, the detail
     * paragraphs started 29px apart because two titles wrapped to a second
     * line and two did not. Worse, it was guaranteed rather than incidental —
     * the boundary tone prefixes its label with 「界線 · 」, so on all seven
     * diagrams exactly one label ran to two lines while its neighbours ran to
     * one.
     *
     * With `subgrid` on the cards, the label row is as tall as the tallest
     * label and every title and detail begins on the same line, whatever the
     * text does.
     */
    gap: var(--space-3);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  :global(.concept-flow:not(:has(> .fig-tools))) > figcaption {
    margin-inline-end: 0;
  }

  .concept-flow[data-variant="layers"] > ol {
    grid-template-columns: minmax(0, 1fr);
    /* 2026-09-02 — the fold rule is set on the connector between two layers, so
       the gap between cards has to hold two lines of it. */
    row-gap: var(--space-5);
  }

  /*
   * Cards share the list's rows, so the same parts line up across the row.
   *
   * Each card used to be its own grid sized by its own content, and nothing
   * lined up: measured on /trend, the detail paragraphs began 29px apart
   * because two titles wrapped to a second line and two did not. It was
   * guaranteed rather than incidental — the boundary tone prefixes its label
   * with 「界線 · 」, so on all seven diagrams exactly one label ran to two
   * lines while its neighbours ran to one.
   *
   * Scoped to the multi-column case on purpose. `layers` is a single column and
   * the narrow layout collapses to one, and four cards each spanning four
   * tracks inside one column would need sixteen: the explicit `1fr` would fall
   * to the first card and stretch it alone.
   */
  /* 2026-09-02 — six rows now, not four: the drawing strip took the first and
     the role label left the head for its own. The head's track is the token the
     connector is placed against, so it is sized here rather than by content. */
  @media (min-width: 48.0625rem) {
    .concept-flow:not([data-variant="layers"]) > ol {
      grid-template-rows:
        var(--concept-figure-h) var(--concept-head-h) auto auto auto 1fr;
    }

    .concept-flow:not([data-variant="layers"]) > ol > [data-concept-step] {
      grid-row: span 6;
      grid-template-rows: subgrid;
    }

    .concept-flow:not([data-variant="layers"]) :global(.concept-figure) {
      grid-row: 1;
    }

    .concept-flow:not([data-variant="layers"]) .concept-head {
      grid-row: 2;
    }

    .concept-flow:not([data-variant="layers"]) .concept-label {
      grid-row: 3;
    }

    .concept-flow:not([data-variant="layers"]) .concept-title {
      grid-row: 4;
    }

    .concept-flow:not([data-variant="layers"]) [data-concept-detail] {
      grid-row: 5;
    }

    .concept-flow:not([data-variant="layers"]) [data-concept-step] > ul {
      grid-row: 6;
    }
  }

  [data-concept-step] {
    --step-mark: var(--diagram-neutral);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: 0.3rem 0;
    min-width: 0;
    /*
     * Symmetric, and `--space-2` on the inline axis.
     *
     * Horizontal padding is paid eight times across a four-column row and
     * every pixel of it comes out of a line that holds about eleven Chinese
     * characters at 1440 and eight at 1280 — the measurement an earlier round
     * raised from eight by giving these figures the page bleed. The vertical
     * axis can afford `--space-3` now that the card has no border crowding its
     * content.
     */
    padding: var(--space-3) var(--space-2);
    /*
     * Transparent, not absent: `box-sizing` is border-box, so a bordered card
     * among borderless ones would be 2px narrower in its content box and one
     * of four columns would set its text on a different measure. The boundary
     * card below only changes this border's colour and style.
     */
    /* 2026-09-02 — supersedes the border and the surface above. The card is
       gone: the columns are separated by the gutter and by the ruled head, and
       the boundary step is marked by the kind of its rule rather than by an
       outline. This also makes the screen state identical to the print state,
       which the print gate has required of the steps from the beginning. */
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  /*
   * The role lives in the marker, not in the surface.
   *
   * Every card used to be washed with its own tone at 8%. Two of the four
   * roles are greys — neutral is `--rule`, and 8% of a grey on an off-white is
   * nothing — so a scheme with four levels rendered as two coloured cards and
   * two blank ones, which reads as decoration that ran out rather than as a
   * scale. The tone now carries at full strength in two small places, the
   * disc's ring and the label, and every card takes the same surface. Four
   * roles, four visible markers.
   */
  /* 2026-09-02 — three places now: the numeral's baseline, the role label, and
     whatever the strip draws in the role's own colour. Still never a surface. */
  [data-concept-step] {
    --step-ink: var(--text-faint);
  }

  [data-tone="cool"] {
    --step-mark: var(--diagram-cool);
    --step-ink: var(--k0-ink);
  }

  [data-tone="warm"] {
    --step-mark: var(--diagram-warm);
    --step-ink: var(--k1-ink);
  }

  /*
   * The boundary step is a different kind of step, so it is marked by kind.
   *
   * It was a fourth hue, and it did not read as one: `--diagram-warm` is
   * oklch(0.595 0.147 50) and `--diagram-boundary` oklch(0.49 0.13 34) — **16
   * degrees of hue apart** at comparable chroma, which at an 8% tint left cards
   * three and four looking like the same colour on every diagram that uses
   * both.
   *
   * Adding a fifth hue would only move the collision. This card does not
   * continue the sequence, it says where the sequence stops being supported —
   * so it drops the tint the three steps share and takes a dashed rule instead.
   * A broken line reads as a limit rather than as another stage, and it tells
   * the two apart by something other than a hue nobody can name.
   */
  [data-tone="boundary"] {
    --step-mark: var(--diagram-boundary);
    /*
     * Grey, and that is the same decision one level further on.
     *
     * An earlier round took the boundary card off its own hue because
     * `--diagram-warm` and `--diagram-boundary` sit 16 degrees apart and read
     * as one colour; it is marked by KIND instead — a dashed outline and the
     * 「界線 · 」 prefix. Colouring its label would walk that back, and the
     * measurement says so too: `--editorial-accent` has no dark-theme value,
     * so as reading ink it lands at Lc 19.4 against a floor of 60. The card
     * that carries the most marks needs no more.
     */
    --step-ink: var(--text-faint);
  }

  /* 2026-09-02 — the dashed outline the card used to carry has become a dashed
     rule: the numeral's baseline and the head's hairline, including the parts
     that run into the gutters. Same meaning, one line instead of a box. */
  /* One side each, and never both. `border-*-style` on a side whose width was
     never set resolves that width to `medium`, so naming the top style here as
     well drew a 3px dashed rule across the top of the boundary card — measured
     on /trend/ at 1440, 49px above the rule it was supposed to be. */
  [data-tone="boundary"] .concept-index,
  [data-tone="boundary"] .concept-head {
    border-block-end-style: dashed;
  }

  [data-tone="boundary"] .concept-head::before,
  [data-tone="boundary"] .concept-head::after {
    border-top-style: dashed;
  }

  /*
   * The connector belongs at the markers' height.
   *
   * It sat at 50% of the card, which on a 290px card put a process arrow in
   * the middle of a paragraph — it read as punctuation between two blocks of
   * text rather than as a link between two steps. Anchored to the disc's
   * centre instead (`--space-3` of padding plus half of the 2rem disc), the
   * four discs and the three arrows now form one horizontal line, which is
   * the line a reader follows.
   *
   * Still a glyph, deliberately. Forced-colors mode forces `background-color`,
   * so an arrow drawn as a shape would vanish for exactly the readers who need
   * it most; a glyph is painted with `color`, which forced-colors maps to
   * CanvasText — and the gate checks that mapping.
   */
  /* 2026-09-02 — the height is now the head rule's, which is the line the
     reader is already following across the row. `--text-base` rather than
     `--text-lg`: the rule carries the continuity, so the glyph only has to
     carry the direction. It is set in `--font-numeric` because 「∥」 exists in
     Noto Sans TC and not in IBM Plex Sans, and that stack falls through in
     exactly that order. */
  .concept-flow > ol > [data-concept-step]:not(:last-child)::after {
    content: "→";
    position: absolute;
    z-index: 1;
    inset-inline-end: calc(var(--space-3) * -0.5);
    inset-block-start: calc(
      var(--space-3) + var(--concept-figure-h) + var(--concept-head-h) - 1px
    );
    color: var(--rule);
    font-family: var(--font-numeric);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1;
    transform: translate(50%, -50%);
  }

  /* Two arms of one procedure, not two stages of one sequence. */
  .concept-flow > ol > [data-join="same"]:not(:last-child)::after {
    content: "∥";
  }

  /* The two connectors that cross the drawn edge carry the reader's whole
     question on /explore/, so they are ink rather than rule. */
  .concept-flow > ol > [data-concept-crossing]:not(:last-child)::after {
    color: var(--text);
  }

  .concept-flow[data-variant="layers"] > ol > [data-concept-step]:not(:last-child)::after {
    content: "↓";
    inset-inline-end: auto;
    inset-block-start: auto;
    inset-inline-start: 1.45rem;
