---
export type ConceptVariant = "process" | "timeline" | "layers";
export type ConceptTone = "neutral" | "cool" | "warm" | "boundary";

export interface ConceptOption {
  title: string;
  detail?: string;
}

export interface ConceptStep {
  label: string;
  title: string;
  detail: string;
  tone?: ConceptTone;
  options?: readonly ConceptOption[];
}

interface Props {
  title: string;
  summary: string;
  steps: readonly ConceptStep[];
  variant?: ConceptVariant;
}

const { title, summary, steps, variant = "process" } = Astro.props;

if (steps.length < 3 || steps.length > 5) {
  throw new Error(`ConceptFlow requires 3–5 steps; received ${steps.length}`);
}

const number = (index: number) => String(index + 1).padStart(2, "0");
---

<figure
  class="concept-flow"
  data-concept-diagram
  data-variant={variant}
  style={`--concept-columns:${steps.length}`}
>
  <figcaption>
    <strong data-concept-title>{title}</strong>
    <span data-concept-summary>{summary}</span>
  </figcaption>

  <ol role="list">
    {
      steps.map((step, index) => (
        <li data-concept-step data-tone={step.tone ?? "neutral"}>
          <span class="concept-index" aria-hidden="true">{number(index)}</span>
          <span class="concept-label" data-concept-label>{step.label}</span>
          <strong class="concept-title" data-concept-step-title>{step.title}</strong>
          <p data-concept-detail>{step.detail}</p>
          {step.options?.length ? (
            <ul aria-label={`${step.title}的選項`}>
              {step.options.map((option) => (
                <li>
                  <strong>{option.title}</strong>
                  {option.detail && <span>{option.detail}</span>}
                </li>
              ))}
            </ul>
          ) : null}
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .concept-flow {
    --concept-mark: var(--diagram-neutral);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-3);
    max-width: none;
    margin: var(--space-4) 0 var(--space-5);
    padding: var(--space-3);
    border: 1px solid color-mix(in oklab, var(--concept-mark) 34%, var(--line));
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--concept-mark) 4%, var(--bg-sunken));
  }

  /* FigureTools is injected after hydration and therefore has no Astro scope
     attribute. Keep it in normal flow so zoom/export height accounting remains
     exact, but visually order it first on the diagram's left reading edge. */
  .concept-flow > :global(.fig-tools) {
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    justify-self: start;
    justify-content: flex-start;
    margin: 0;
  }

  .concept-flow > figcaption {
    display: grid;
    grid-column: 2;
    grid-row: 1;
    gap: 0.32rem;
    max-width: none;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .concept-flow > figcaption strong {
    color: var(--text);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.25;
    text-wrap: balance;
  }

  .concept-flow > figcaption span {
    text-wrap: pretty;
  }

  .concept-flow > ol {
    display: grid;
    grid-column: 1 / -1;
    grid-row: 2;
    grid-template-columns: repeat(var(--concept-columns), minmax(0, 1fr));
    gap: var(--space-3);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  :global(.concept-flow:not(:has(> .fig-tools))) > figcaption {
    grid-column: 1 / -1;
  }

  .concept-flow[data-variant="layers"] > ol {
    grid-template-columns: minmax(0, 1fr);
  }

  [data-concept-step] {
    --step-mark: var(--diagram-neutral);
    --step-surface: color-mix(in oklab, var(--step-mark) 8%, var(--bg-raised));
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    align-content: start;
    gap: 0.22rem var(--space-2);
    min-width: 0;
    padding: var(--space-3);
    border: 1px solid color-mix(in oklab, var(--step-mark) 46%, var(--line));
    border-block-start-width: 3px;
    border-radius: var(--radius);
    background: var(--step-surface);
  }

  [data-tone="cool"] {
    --step-mark: var(--diagram-cool);
  }

  [data-tone="warm"] {
    --step-mark: var(--diagram-warm);
  }

  [data-tone="boundary"] {
    --step-mark: var(--diagram-boundary);
  }

  .concept-flow > ol > [data-concept-step]:not(:last-child)::after {
    content: "→";
    position: absolute;
    z-index: 1;
    inset-inline-end: calc(var(--space-3) * -0.5);
    inset-block-start: 50%;
    color: var(--rule);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1;
    transform: translate(50%, -50%);
  }

  .concept-flow[data-variant="layers"] > ol > [data-concept-step]:not(:last-child)::after {
    content: "↓";
    inset-inline-end: auto;
    inset-block-start: auto;
    inset-inline-start: 1.45rem;
    inset-block-end: calc(var(--space-3) * -0.5);
    transform: translate(-50%, 50%);
  }

  .concept-index {
    display: grid;
    grid-row: 1;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--step-mark);
    border-radius: 50%;
    color: var(--text);
    background: var(--bg-raised);
    font-size: var(--text-xs);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .concept-label {
    align-self: center;
    color: var(--text-faint);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.2;
  }

  [data-tone="boundary"] .concept-label::before {
    content: "界線 · ";
  }

  .concept-title {
    grid-column: 1 / -1;
    min-width: 0;
    color: var(--text);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: 1.3;
  }

  [data-concept-detail] {
    grid-column: 1 / -1;
    margin: var(--space-1) 0 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  [data-concept-step] > ul {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 7rem), 1fr));
    gap: var(--space-1);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  [data-concept-step] > ul > li {
    display: grid;
    gap: 0.12rem;
    min-width: 0;
    padding: var(--space-1) var(--space-2);
    border-inline-start: 2px solid var(--step-mark);
    background: color-mix(in oklab, var(--step-mark) 5%, var(--bg-raised));
    font-size: var(--text-xs);
    line-height: 1.4;
  }

  [data-concept-step] > ul span {
    color: var(--text-muted);
  }

  @media (max-width: 48rem) {
    .concept-flow {
      grid-template-columns: minmax(0, 1fr);
      margin-block: var(--space-3) var(--space-4);
      padding: var(--space-2);
    }

    .concept-flow > :global(.fig-tools) {
      grid-column: 1;
      grid-row: 1;
      margin-block-end: var(--space-2);
    }

    .concept-flow > figcaption {
      grid-column: 1;
      grid-row: 2;
    }

    .concept-flow > ol {
      grid-column: 1;
      grid-row: 3;
      grid-template-columns: minmax(0, 1fr);
    }

    :global(.concept-flow:not(:has(> .fig-tools))) > figcaption {
      grid-row: 1;
    }

    :global(.concept-flow:not(:has(> .fig-tools))) > ol {
      grid-row: 2;
    }

    .concept-flow > ol > [data-concept-step]:not(:last-child)::after {
      content: "↓";
      inset-inline-end: auto;
      inset-block-start: auto;
      inset-inline-start: 1.45rem;
      inset-block-end: calc(var(--space-3) * -0.5);
      transform: translate(-50%, 50%);
    }
  }

  @media (forced-colors: active) {
    .concept-flow {
      --concept-forced-colors: active;
    }

    .concept-flow,
    [data-concept-step],
    .concept-index,
    [data-concept-step] > ul > li {
      border-color: CanvasText;
      background: Canvas;
    }

    .concept-flow > ol > [data-concept-step]:not(:last-child)::after,
    .concept-index,
    .concept-label,
    .concept-title,
    [data-concept-detail],
    [data-concept-step] > ul span {
      color: CanvasText;
    }
  }

  @media print {
    .concept-flow {
      --concept-print: ready;
      break-inside: avoid;
      background: transparent;
    }

    [data-concept-step],
    .concept-index,
    [data-concept-step] > ul > li {
      break-inside: avoid;
      background: transparent;
    }
  }
</style>
