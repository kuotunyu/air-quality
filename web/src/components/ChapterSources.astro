---
/**
 * Chapter 3 — where the bad hours arrive from.
 *
 * A CBPF polar plot: one annular sector per (wind direction, wind speed) bin,
 * shaded by the probability that the hour was in the top quartile.
 *
 * The geometry is identical for every station, so it is rendered once and the
 * client swaps fills when the reader picks a different one. That keeps the
 * chart in the HTML — it works, labelled and shaded, before any JavaScript
 * runs — while 74 stations cost 68 KB of data rather than 74 SVGs.
 *
 * A bin with fewer than 20 hours has no fill at all, and is hatched instead.
 * "Rarely windy from there" must not look like "clean when windy from there".
 */
import sourcesData from "../../public/data/story/sources.json";
import { bearingName, compass, SIGNATURE } from "../lib/labels";
import { n } from "../lib/chart";
import { groupByCountyNorthToSouth } from "../lib/data";

const data = sourcesData as {
  explains: string;
  percentile: number;
  min_bin_count: number;
  null_means: string;
  cannot_say: string;
  sectors: number[];
  speed_bins: string[];
  signature_counts: Record<string, number>;
  median_calm_fraction: number;
  n_suppressed_bins: number;
  stations: Record<
    string,
    {
      threshold: number;
      calm_fraction: number;
      resultant: number;
      peak_sector: number | null;
      peak_speed: string | null;
      signature: string;
      county?: string | null;
      airzone?: string | null;
      probability: (number | null)[][];
      n: number[][];
    }
  >;
};

// Name order put 二林（彰化）, 三義（苗栗）and 土城（新北）in consecutive rows —
// three counties and 300 km in three rows. Grouped and ordered geographically
// instead; see `groupByCountyNorthToSouth`.
const names = Object.keys(data.stations);
const grouped = groupByCountyNorthToSouth(names, (name) => name);
const initial = names.includes("富貴角") ? "富貴角" : names[0];

const SIZE = 420;
const CX = SIZE / 2;
const CY = SIZE / 2;
const R_INNER = 34;
/*
 * The disc gives up a little radius so its bearings have somewhere to stand.
 *
 * `R_OUTER` was 186 of a 420 box — 0.443 of the half-width — against labels
 * centred at 0.455, so the ring's outer edge and the label's centre were 5px
 * apart and half of every bearing was printed ON the outermost data ring. A
 * compass rose needs a clear annulus; at 176 and 0.478 there is one, measured
 * at about 15px of clearance at the largest size the disc is drawn.
 */
const R_OUTER = 176;
// Where the compass labels sit, as a fraction of the box. They are HTML now,
// positioned over the square rather than drawn inside it.
const LABEL_R = 0.478;

const nSectors = data.sectors.length;
const nRings = data.speed_bins.length;
const sweep = 360 / nSectors;
const ringWidth = (R_OUTER - R_INNER) / nRings;

/** One annular sector, as an SVG path. Angles are compass bearings. */
function cell(sectorIndex: number, ringIndex: number): string {
  const a0 = ((data.sectors[sectorIndex] - 90) * Math.PI) / 180;
  const a1 = ((data.sectors[sectorIndex] + sweep - 90) * Math.PI) / 180;
  const r0 = R_INNER + ringIndex * ringWidth;
  const r1 = r0 + ringWidth;

  const p = (r: number, a: number) => `${(CX + r * Math.cos(a)).toFixed(2)} ${(CY + r * Math.sin(a)).toFixed(2)}`;
  return [
    `M${p(r0, a0)}`,
    `A${r0} ${r0} 0 0 1 ${p(r0, a1)}`,
    `L${p(r1, a1)}`,
    `A${r1} ${r1} 0 0 0 ${p(r1, a0)}`,
    "Z",
  ].join(" ");
}

// Seven steps from "rarely high" to "usually high". The ramp is the site's, so
// the map, the trend lines and this plot all mean the same thing by a colour.
const RAMP = ["--c0", "--c1", "--c2", "--c3", "--c4", "--c5", "--c6"];
const BREAKS = [0.1, 0.2, 0.3, 0.45, 0.6, 0.75];

function fillFor(p: number | null): string {
  if (p == null) return "none";
  let i = 0;
  while (i < BREAKS.length && p >= BREAKS[i]) i += 1;
  return `var(${RAMP[i]})`;
}

const cells = data.sectors.flatMap((sector, si) =>
  data.speed_bins.map((speed, ri) => ({
    key: `${si}-${ri}`,
    d: cell(si, ri),
    sector,
    speed,
  })),
);

const start = data.stations[initial];
const counts = data.signature_counts;

const legend = BREAKS.map((b, i) => ({
  colour: `var(${RAMP[i]})`,
  label: i === 0 ? `< ${b}` : `${BREAKS[i - 1]}–${b}`,
})).concat([{ colour: `var(${RAMP[RAMP.length - 1]})`, label: `≥ ${BREAKS[BREAKS.length - 1]}` }]);
---

<section id="sources" class="page">
  <p class="eyebrow">第四章</p>
  <h1>污染來向與風速條件</h1>

  <p class="lede">{data.explains}</p>

  <p>
    這張圖叫 CBPF。角度是<strong>風吹來的方位</strong>，半徑是<strong>風速</strong>——
    圓心附近是微風，外圈是強風。每一格的顏色是：風從這個方位、以這個速度吹來時，
    該小時的 PM2.5 落在最高四分之一的機率。
  </p>

  {/*
    Without a script this figure is one station, so the menu is withdrawn and
    the station is named instead.

    What shipped was a `<select>` of 74 options, server-rendered and inert: a
    reader without JavaScript arrowed to 永和, the control agreed, and all six
    readouts — threshold 16.0, peak 0° 北, resultant 0.228, calm 3.0%, and the
    signature badge 21px to the right of the menu — went on describing 富貴角.
    That is the worst case for this chapter in particular: 富貴角 is a northern
    cape, transport-dominated, about as unlike an inland basin station as the
    register gets, and the chapter's whole claim is that these signatures differ
    by station.

    `<noscript>` with a `<style>`, the same shape as chapter 2's, for the same
    reasons: no layout shift, no second copy of the station list, and the
    parser rather than a hydration step decides. What it cannot do is show all
    74 the way chapter 2 shows all 79 — there is one grid here, not 74 cards —
    so the honest substitute is to say which one it is.
  */}
  {/*
    Selectors are anchored on `#sources`, and that is specificity arithmetic
    rather than decoration.

    A `<style>` inside `<noscript>` is raw HTML and is NOT scoped by Astro,
    while the component's own `.picker-row` is compiled to
    `.picker-row[data-astro-cid-kgeyh5bl]` — (0,2,0) against (0,1,0). The first
    version of this block lost that comparison and changed nothing at all;
    measured with scripts disabled, `.picker-row` was still `flex`. Chapter 2's
    equivalent happened to win only because `.picker .controls` ties on weight
    and a body rule beats a hoisted head rule on order, which is not a thing to
    rely on twice. The chapter's own `id` is guaranteed by `chapters.ts` — it is
    the anchor other chapters link to — so (1,1,0) is both stable and cheap.
  */}
  <noscript>
    <style>
      #sources .picker-row {
        display: none;
      }
      #sources .cbpf-nojs {
        display: block;
      }
    </style>
  </noscript>

  <p class="note cbpf-nojs">
    這張圖的測站選單需要 JavaScript。目前顯示的是<strong>{initial}</strong>（{SIGNATURE[start.signature] ?? start.signature}）。
    每個測站的 CBPF 與下方所有數字都可以從
    <code>twair analyze m7</code> 重算。
  </p>

  <div class="picker-row">
    <label>
      測站
      <select id="cbpf-station">
        {
          grouped.map((group) => (
            <optgroup label={group.label}>
              {group.items.map((name) => (
                /* The county is the group's own label now, so the option is
                   just the station. */
                <option value={name} selected={name === initial}>
                  {name}
                </option>
              ))}
            </optgroup>
          ))
        }
      </select>
    </label>
    <span id="cbpf-signature" class="badge">{SIGNATURE[start.signature] ?? start.signature}</span>
  </div>

  {/*
    A figure, because it was already claiming to be one.

    The caption below is a `<figcaption>`, and its parent measured as
    `section.page` — a `<figcaption>` outside a `<figure>` is not valid HTML,
    and `aria-labelledby` was pointing an `<svg role="img">` at a caption the
    accessibility tree had no reason to associate with it. The station picker
    stays outside: it is a control on the figure, not part of it, and a
    `<select>` has no business inside an exported image.
  */}
  <figure>
    <div class="plot-row">
      <div class="chart polar">
        <div class="polar-box">
        <svg viewBox={`0 0 ${SIZE} ${SIZE}`} role="img" aria-labelledby="cbpf-caption">
          <defs>
            <pattern id="cbpf-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <line x1="0" y1="0" x2="0" y2="6" class="hatch-line" />
            </pattern>
          </defs>
          {
            cells.map((c) => (
              <path
                d={c.d}
                class="cell"
                data-key={c.key}
                fill={fillFor(start.probability[data.sectors.indexOf(c.sector)][data.speed_bins.indexOf(c.speed)])}
              >
                {/*
                  The same sentence the change handler writes, built here too.
                  
                  The server-rendered title said only 「0° 北 · 0.5-1.5 m/s」 —
                  bearing and speed, no probability and no hour count — because
                  the probability was written in by the select's change handler.
                  So the DEFAULT station, the one every reader sees first, was
                  the one station whose cells could not be interrogated, and a
                  suppressed cell could not say how few hours were behind it.
                */}
                <title>
                  {compass(c.sector)} · {c.speed.replace("-", "–")} m/s —{" "}
                  {(() => {
                    const si = data.sectors.indexOf(c.sector);
                    const ri = data.speed_bins.indexOf(c.speed);
                    const p = start.probability[si][ri];
                    const hours = start.n[si][ri];
                    return p == null
                      ? `時數不足（${hours} 小時）`
                      : `機率 ${p}（${hours} 小時）`;
                  })()}
                </title>
              </path>
            ))
          }
          <circle cx={CX} cy={CY} r={R_INNER - 2} class="hub" />
        </svg>

        {
          data.sectors.map((s) => {
            /*
             * The wedge's MIDPOINT, not its edge.
             *
             * `cell()` draws sector s from s to s + sweep, so an angle of s is the
             * wedge's counter-clockwise boundary — the radial gridline between two
             * wedges. Measured at 1440, 「北」 sat at exactly the disc's centre x,
             * which is the divider between the 330–360° wedge and the 0–30° one,
             * with a hatched cell on one side and a filled cell on the other. Every
             * one of the twelve labels named the line beside its wedge rather than
             * the wedge.
             */
            const a = ((s + sweep / 2 - 90) * Math.PI) / 180;
            return (
              <span
                class="bearing"
                style={`left:${(50 + LABEL_R * 100 * Math.cos(a)).toFixed(2)}%;top:${(50 + LABEL_R * 100 * Math.sin(a)).toFixed(2)}%`}
              >
                {bearingName(s)}
              </span>
            );
          })
        }

        </div>

        {/*
          The radial axis, which the figure did not have.

          Twelve bearing labels ringed the disc and NOTHING said what the six
          rings were, so half the encoding — the half the surrounding prose
          argues from, since 「近處的污染源只有在風弱時才顯現」 is a statement
          about radius — was unreadable. Ring boundaries are 25px apart at the
          largest this disc gets, which is narrower than the type, so the scale
          is laid out straight instead of curved: same six steps, same order,
          centre on the left.
        */}
        <ol class="radial-scale" aria-label="半徑：風速 m/s">
          <li class="radial-hub">圓心</li>
          {data.speed_bins.map((b) => <li>{b.replace("-", "–")}</li>)}
        </ol>
        {/*
          「風速分組」, not 「風速」.
          
          Measured along a ray at 1440, the ring boundaries sit at r = 36, 61, 86,
          111, 136, 161 and 185 — six bands of 25px each — while the speeds they
          carry span 1, 1, 1.5, 2, 2 m/s and then an unbounded 8+. Equal widths
          for unequal ranges is a category axis, not a proportional one, and
          saying 「半徑＝風速」 invited the reader to read distance as speed.
        */}
        <p class="radial-unit">半徑＝風速分組（各環等寬，區間不等）</p>

        {/*
          A sequential scale, drawn as one.

          It was seven detached chips plus a hatch chip in a 190px column, so it
          wrapped to eight rows and stood 509px tall — taller than the disc it
          explained, and shaped like eight categories when the thing it encodes
          is one ordered quantity. A ramp is a bar with its breaks under it, and
          it belongs beside the disc rather than in the readout column, because
          the readout column is 190px and the disc is 440.
        */}
        <div class="ramp">
          <p class="ramp-title">顏色＝高值機率</p>
          <div class="ramp-bar" role="img" aria-label={`機率色階，分界 ${BREAKS.join("、")}`}>
            {legend.map((l) => <span style={`background:${l.colour}`} />)}
          </div>
          <div class="ramp-ticks" aria-hidden="true">
            {BREAKS.map((b, i) => (
              <span style={`left:${(((i + 1) / legend.length) * 100).toFixed(3)}%`}>{b}</span>
            ))}
          </div>
          <p class="ramp-foot">
            <span class="swatch hatched" />時數不足（&lt; {data.min_bin_count} 小時）：不予報告
          </p>
        </div>
      </div>

      <div class="readout">
        <div class="stat">
          <span class="stat-value" id="cbpf-threshold">{start.threshold.toFixed(1)}</span>
          <span class="stat-label">高值門檻 μg/m³</span>
          <span class="stat-note">該站自己的第 {n(data.percentile, 0)} 百分位</span>
        </div>
        <div class="stat">
          <span class="stat-value" id="cbpf-peak">
            {start.peak_sector == null ? "—" : compass(start.peak_sector)}
          </span>
          <span class="stat-label">機率最高的方位</span>
          <span class="stat-note" id="cbpf-peak-speed">風速 {start.peak_speed} m/s</span>
        </div>
        <div class="stat">
          <span class="stat-value" id="cbpf-resultant">{start.resultant.toFixed(3)}</span>
          <span class="stat-label">方向集中度</span>
          <span class="stat-note">0 = 四面八方；1 = 只有一個方位</span>
        </div>
        {/*
          Out of the disc, into the readout.

          It was printed inside the white hub, and the hub scales with the SVG
          while the number is HTML at a fixed size — so the two only agreed at one
          width. Measured at 375: the hub circle is 46px across and 「3.0%」 is
          51px, and because the value sits below the circle's centre the chord at
          its own line is about 40px, leaving roughly 11px of the number lying on
          the 0.5–1.5 m/s ring, which is 21px wide there.

          The two obvious repairs are both blocked. Scaling the label with the box
          shrinks chart type at exactly the widths where it is already smallest,
          and chart type sizes are the owner's decision. Growing the hub to fit
          the number means growing `R_INNER`, which IS the radius where the first
          speed ring begins — the white centre would eat the 0.5–1.5 ring and the
          radial scale's 「圓心 › 0.5–1.5 › …」 would stop being true. Nothing is
          lost by moving it: the radial scale already names the centre, and this
          column already holds the figure's other three scalars.
        */}
        <div class="stat">
          <span class="stat-value" id="cbpf-calm">{(start.calm_fraction * 100).toFixed(1)}%</span>
          <span class="stat-label">靜風時數佔比</span>
          <span class="stat-note">沒有風就沒有方位，上不了極座標圖</span>
        </div>
      </div>
    </div>

    {/*
      The caption names the station, and it is the only place that can.

      Three readers were getting an unnamed figure. The `<svg role="img">` above
      is `aria-labelledby="cbpf-caption"`, so a screen reader hears this text as
      the image's name — and it did not say which station. FigureTools exports
      the whole figure INCLUDING this caption as a PNG, so every image taken off
      this page was a polar plot of nobody. And the drafting note above says the
      picker deliberately sits outside the figure, which is right, but it left
      nothing inside naming the subject.

      `#cbpf-where` is updated by the same handler that redraws the grid, so the
      three cannot drift.
    */}
    <figcaption id="cbpf-caption">
      <strong id="cbpf-where">{initial}</strong>的 CBPF 極座標圖。<strong
        >沒有填色的格子代表該格觀測不足 {data.min_bin_count} 小時，機率不予報告</strong
      >——那是「不知道」，不是「乾淨」。
      全部測站合計有 {data.n_suppressed_bins} 格因此被扣住。
    </figcaption>
  </figure>

  <h2>近源與遠源的風速特徵</h2>

  <p>
    這就是要用二維而不是傳統風花圖的原因。近處的污染源只有在<strong>風弱</strong>時才顯現，
    風一大就吹散了——圖上是<strong>靠近圓心</strong>的亮塊。
    遠處的污染源要有風才送得到，所以顯現在<strong>強風</strong>時——圖上是<strong>靠近外圈</strong>的亮塊。
    一維的風花圖會把兩者畫在同一個角度上，說不出距離。
  </p>

  <div class="grid grid-3">
    <div class="card stat">
      <span class="stat-value">{counts.local}</span>
      <span class="stat-label">本地型（尖峰在低風速）</span>
    </div>
    <div class="card stat">
      <span class="stat-value">{counts.mixed}</span>
      <span class="stat-label">中間型</span>
    </div>
    <div class="card stat">
      <span class="stat-value" style="color:var(--c1-ink)">{counts.transport}</span>
      <span class="stat-label">傳輸型（尖峰在強風）</span>
    </div>
  </div>

  <div class="note">
    <strong>傳輸型的 7 站裡，有 4 站是地理極端點或離島</strong>——
    富貴角（本島最北端岬角）、馬公、金門、恆春（最南端）。
    那正是幾乎沒有本地污染源的地方，所以它們的高值時數只能是風送來的。
    這個方法並不知道任何測站的位置，是資料自己指出來的。
  </div>

  <div class="note">
    <strong>靜風時數被排除，但沒有被忽略。</strong>
    沒有風就沒有方位，那些小時上不了極座標圖——但停滯正是污染累積的時候。
    全台靜風時數的中位數佔比是 {n(data.median_calm_fraction * 100, 1)}%，
    列在每張圖旁邊的讀數欄裡。<strong>圖上沒有，不代表問題沒有。</strong>
  </div>

  <div class="note caveat">
    <strong>這張圖說不出來的事：{data.cannot_say}</strong>
  </div>
</section>

<script type="application/json" id="cbpf-data" is:inline set:html={JSON.stringify({
  sectors: data.sectors,
  speed_bins: data.speed_bins,
  breaks: BREAKS,
  ramp: RAMP,
  stations: data.stations,
})} />

<script>
  const node = document.getElementById("cbpf-data");
  if (node?.textContent) {
    const d = JSON.parse(node.textContent) as {
      sectors: number[];
      speed_bins: string[];
      breaks: number[];
      ramp: string[];
      stations: Record<string, any>;
    };

    const SIGNATURE: Record<string, string> = {
      transport: "傳輸型",
      local: "本地型",
      mixed: "中間型",
    };

    const COMPASS: Record<number, string> = {
      0: "北", 30: "北北東", 60: "東北東", 90: "東", 120: "東南東", 150: "南南東",
      180: "南", 210: "南南西", 240: "西南西", 270: "西", 300: "西北西", 330: "北北西",
    };
    const bearing = (deg: number) => `${deg}° ${COMPASS[deg] ?? ""}`.trim();

    function fill(p: number | null): string {
      if (p == null) return "none";
      let i = 0;
      while (i < d.breaks.length && p >= d.breaks[i]) i += 1;
      return `var(${d.ramp[i]})`;
    }

    const select = document.getElementById("cbpf-station") as HTMLSelectElement;
    const set = (id: string, text: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    };

    select?.addEventListener("change", () => {
      const s = d.stations[select.value];
      if (!s) return;

      d.sectors.forEach((_, si) =>
        d.speed_bins.forEach((_, ri) => {
          const path = document.querySelector<SVGPathElement>(`path[data-key="${si}-${ri}"]`);
          if (!path) return;
          const p = s.probability[si][ri];
          path.setAttribute("fill", fill(p));
          const title = path.querySelector("title");
          if (title) {
            // The count travels with the probability: a bin with no fill and
            // 3 hours behind it is unknown, not clean.
            const hours = s.n[si][ri];
            /* Same en dash the server render and the radial scale use. The
               data ships 「0.5-1.5」 with a hyphen, so a station picked from the
               menu was writing a range with a different dash from the one the
               first station arrived with. */
            title.textContent =
              `${bearing(d.sectors[si])} · ${d.speed_bins[ri].replace("-", "–")} m/s — ` +
              (p == null ? `時數不足（${hours} 小時）` : `機率 ${p}（${hours} 小時）`);
          }
        }),
      );

      // The caption is the figure's accessible name and travels into the PNG
      // export, so it moves with the grid or it is worse than no name at all.
      set("cbpf-where", select.value);
      set("cbpf-threshold", s.threshold.toFixed(1));
      set("cbpf-peak", s.peak_sector == null ? "—" : bearing(s.peak_sector));
      set("cbpf-peak-speed", `風速 ${s.peak_speed} m/s`);
      set("cbpf-resultant", s.resultant.toFixed(3));
      set("cbpf-calm", `${(s.calm_fraction * 100).toFixed(1)}%`);

      const badge = document.getElementById("cbpf-signature");
      if (badge) {
        badge.textContent = SIGNATURE[s.signature] ?? s.signature;
        badge.dataset.signature = s.signature;
      }
    });
  }
</script>

<style>
  /* Hidden here, revealed by the `<noscript>` above — never rendered and then
     removed, so a reader with JavaScript never sees a flash of it. */
  .cbpf-nojs {
    display: none;
  }

  .picker-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin: 1.4rem 0 0.6rem;
  }
  .picker-row label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .badge {
    font-family: var(--font-numeric);
    font-size: var(--text-xs);
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--text-muted);
  }
  .plot-row {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  /*
