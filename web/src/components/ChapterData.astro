---
/**
 * Chapter 10 — what is published, under what licence, and why nothing is filled.
 *
 * Lifted out of `pages/index.astro` unchanged when the document became ten
 * routes.
 *
 * It made three promises and kept two. This docstring said 「under what
 * licence」 and the entry page's index says 「三層資料的內容、授權，以及這個專案
 * 為什麼不補值」 — and the rendered section was 610 characters containing the
 * word 授權 exactly zero times, along with no CC BY, no MIT, and no link to the
 * repository. Two headings now, because a chapter that answers three questions
 * should show three answers, and the licence is one of them.
 *
 * The chapter then spent a while looking purposeless, and the reason turned
 * out to be measurable. Three of its passages appear on exactly one of the
 * eleven built pages — 「這個專案不補值」, the 萬里 publication conflict, and
 * 環境部's own caveat that beta-ray hourly PM2.5 is for warning reference only
 * — and every one of them qualifies numbers the reader met chapters earlier.
 * Nothing linked here. Not one chapter. So the limits that govern the whole
 * site sat at the bottom of a page with no inbound path, under an opening list
 * that spent two of its four entries sending the reader somewhere else.
 *
 * The opening register now states those three limits instead of routing, they
 * are placed above the download table rather than below the licence, and
 * chapters 1 and 7 link at the two that bear on what they show. Reading order
 * within them is by scope: every line on the site, then every PM2.5 aggregate,
 * then one station.
 *
 * The rights below are transcribed from LICENSE, LICENSE-DATA and
 * docs/legal.md, not restated from memory. One thing is deliberately NOT copied
 * from README.md: it credits 「環境部與交通部中央氣象署」, but README.md's own
 * source table marks the CWA feed ⬜ 尚未取得 — every meteorological variable
 * used here comes from the air-quality stations' own instruments. Crediting a
 * source the work never used is worse than crediting none.
 *
 * ── 2026-09-02 — the download section is gone ────────────────────────────
 *
 * The 下載 heading, the two supporting links, the schema list and the
 * 21-row table of L0 JSON and L1 Parquet links were the owner's decision to
 * remove: a reader of this site gets data through chapter 9's in-browser
 * query and its CSV export, and a file-by-file download list was a second
 * doorway to the same files that nobody was asked for. The files themselves
 * are still served — chapter 9 reads the L1 Parquet and every chart reads the
 * L0 JSON — so the Pages register and the manifest are unchanged; only the
 * links left. The chapter is now the register of layers, the limits and the
 * licence, and its name says so. The paragraph above about placing the limits
 * 「above the download table」 describes the layout this section had then.
 */
import { hourlyObservationsShort, layerBytes, mb, publishedL1Codes } from "../lib/data";
import { repoFile } from "../lib/repo";
import ChapterIntro from "./ChapterIntro.astro";
import ConceptFlow from "./ConceptFlow.astro";
import { dataPlate } from "../lib/concept-vignettes";

import meta from "../../public/data/meta.json";

interface PublicationConflictRecord {
  station_name: string;
  effective_from: string;
  source_url: string;
  pollutant: string;
  rows_at_or_after_event: number;
  numeric_rows_at_or_after_event: number;
  null_rows_at_or_after_event: number;
  last_post_event_ts: string | null;
}

interface PublicationConflictSummary {
  status: "available" | "unavailable";
  records?: PublicationConflictRecord[];
  reason?: string;
}

const publicationConflicts = (meta as { station_publication_conflicts?: PublicationConflictSummary })
  .station_publication_conflicts;
const wanliPm25Conflict =
  publicationConflicts?.status === "available"
    ? publicationConflicts.records?.find(
        (record) => record.station_name === "萬里" && record.pollutant === "PM2.5",
      )
    : undefined;
const integer = new Intl.NumberFormat("zh-TW");
const zhDate = (value: string) => {
  const [year, month, day] = value.slice(0, 10).split("-").map(Number);
  return `${year} 年 ${month} 月 ${day} 日`;
};

/* One month at three resolutions. */
const dataConcept = dataPlate();

---

<section id="data" class="page">
  <ChapterIntro slug="data">
  <p class="lede">
    所有數字都可以獨立重算。原始資料來自環境部空氣品質監測網公開的年度逐時檔，
    管線、品管規則、分析程式全部開源。
  </p>
  </ChapterIntro>

  <div class="primary-register task-register" data-primary-evidence data-data-task-register>
    <h2>引用這裡的數字之前</h2>
    <ol>
      <li><a href="#gaps"><strong>缺的值就讓它缺</strong></a><span>檔案裡的 null 不是零，聚合之前要先把它排除。</span></li>
      <li><a href="#hourly-pm25"><strong>逐時 PM2.5 帶著官方但書</strong></a><span>引用日均或年均時，一併帶上環境部對這個量測方法的保留。</span></li>
      <li><a href="#wanli"><strong>萬里測站有一項未解的來源歧異</strong></a><span>用到 2025 年的萬里資料時，要知道那些值是在什麼情況下留下來的。</span></li>
    </ol>
  </div>

  {/*
    Three layers, one month, three resolutions: a hatch nobody publishes, a run
    of day cells with one withheld for coverage, and a single month cell. The
    arrows carry the fold rules, because 「↓」 alone between L2 and L1 says only
    that one is above the other, and the rule that turns hours into a day is
    the whole content of that step.

    The fourth step, 讀者使用, is gone. It repeated the register below — which
    lists the three layers by the reader who wants each — and this figure's
    subject is the derivation, which ends at L0. The register runs in the
    opposite order for the opposite reason, so the summary now says so.

    The publication edge is drawn in L2's own foot rather than as a card
    border: L2 already carries a dashed head as the mark of its kind, and the
    boundary is a fact about what lies below it.
  */}
  <ConceptFlow
    title="資料從逐時觀測走到網站圖表"
    summary="三層資料保留不同時間尺度；由上而下是推導方向，下方的三層登錄以讀者的選擇順序排列。發布邊界與用途一起標示，避免把未發布的重建層誤認成下載承諾。"
    variant="layers"
    figureHeight="2.2rem"
    edgeAfter={1}
    edgeLabel="發布邊界：以上不轉散布，以下由 Pages 發布"
    steps={[
      {
        label: "L2 · 站-時",
        title: "完整逐時觀測與品管旗標",
        detail: "不轉散布；以公開原始檔與專案的匯入、建置管線獨立重建。",
        tone: "boundary",
        fold: "逐時併成日：有效小時達門檻才算一日",
        ...dataConcept[0],
      },
      {
        label: "L1 · 站-日",
        title: "供查詢與桌面分析的日資料",
        detail: `Pages 目前發布 ${publishedL1Codes.join("、")}；其餘測項可由本機管線產生。`,
        tone: "warm",
        fold: "日併成月：有效天數比例達門檻才算一月",
        ...dataConcept[1],
      },
      {
        label: "L0 · 站-月",
        title: "供快速查值與網站圖表的月資料",
        detail: "每個測項一個 JSON，保留月均值與有效天數。",
        tone: "cool",
        ...dataConcept[2],
      },
    ]}
  />

  <div class="primary-register">
    <h2>三層資料</h2>

    <dl class="layers" data-data-layer-register>
      <dt data-data-layer="L0">
        <span data-data-layer-term>L0 站-月</span>
        <span class="layer-use" data-data-layer-use>閱讀者 · 快速查值與網站圖表</span>
      </dt>
      <dd data-data-layer-description="L0">每個測項一個 JSON，含月均值與該月的有效天數。網站直接讀這一層。</dd>

      <dt data-data-layer="L1">
        <span data-data-layer-term>L1 站-日</span>
        <span class="layer-use" data-data-layer-use>分析者 · 逐日查詢與桌面分析</span>
      </dt>
      <dd data-data-layer-description="L1">
        Pages 目前發布 {publishedL1Codes.join("、")} 的 Parquet，共 {mb(layerBytes.l1)}；
        其餘測項可由本機管線產生。
      </dd>

      <dt data-data-layer="L2">
        <span data-data-layer-term>L2 站-時</span>
        <span class="layer-use" data-data-layer-use>重現者 · 逐時稽核與管線重建</span>
      </dt>
      <dd id="rebuild" data-data-layer-description="L2">
        {hourlyObservationsShort}筆完整逐時觀測，含每一筆的品管旗標。<strong>不發布</strong>—只發衍生產物與完整管線，跑一次匯入與建置即可獨立重建。
      </dd>
    </dl>
  </div>

  <h2>使用限制</h2>

  <div class="note caveat" id="gaps">
    <strong>關於缺值。</strong>
    這個專案不補值。無效值標記但不刪除、超出物理範圍的值保留原數字以供檢視、
    覆蓋率不足的聚合直接<strong>不給平均值</strong>—寧可留一個洞，
    也不給一個有偏誤的數字。網站上每條線的中斷都是真的中斷。
  </div>

  <div class="note caveat" id="hourly-pm25">
    <strong>逐時 PM2.5 的官方但書。</strong>
    環境部 ReadMe 載明：PM2.5 自動監測（貝他射線衰減法）的小時值僅供預警參考，
    不宜直接與 24 小時空氣品質標準比較。本站的日均、年均由小時值聚合而來，
    引用時請一併理解這個限制。
  </div>

  <details class="publication-disagreement" id="wanli" data-publication-disagreement>
    <summary>萬里測站：官方停測公告與年度封存值不一致</summary>
    <div class="publication-disagreement-body" data-publication-disagreement-body>
      {wanliPm25Conflict ? (
        <>
          <p>
            <a href={wanliPm25Conflict.source_url}>環境部公告</a>記載萬里測站自
            <time datetime={wanliPm25Conflict.effective_from}>{zhDate(wanliPm25Conflict.effective_from)}</time>
            起停止更新；但同一機關發布的 2025 年度封存檔，在該時間點之後仍有
            {" "}{integer.format(wanliPm25Conflict.rows_at_or_after_event)} 筆 PM2.5 列，
            其中 {integer.format(wanliPm25Conflict.numeric_rows_at_or_after_event)} 筆有數值、
            {integer.format(wanliPm25Conflict.null_rows_at_or_after_event)} 筆保留為 null，
            最晚到 {wanliPm25Conflict.last_post_event_ts?.replace("T", " ")}。
          </p>
          <p>
            <strong>這是未解的來源歧異。</strong>
            本專案按來源原樣保留並報告，沒有判定這些值有效或無效，也沒有因此改寫、刪除或補值。
          </p>
        </>
      ) : (
        <p>
          本次靜態匯出沒有可用的萬里測站公告後比對結果；這代表證據未提供，不能顯示零筆或替來源下判斷。
        </p>
      )}
    </div>
  </details>

  <h2>授權與再散布</h2>

  {/*
    Same `.layers` list, because these are the same kind of statement: a short
    term and a description that has to be readable. Reusing it also keeps the
    two halves of the chapter visually parallel — what you get, then what you
    may do with it.
  */}
  <dl class="layers">
    <dt>程式碼</dt>
    <dd>
      <a href={repoFile("LICENSE")}>MIT</a>—管線、品管規則、分析與這個網站本身。
    </dd>

    <dt>資料衍生物</dt>
    <dd>
      <a href={repoFile("LICENSE-DATA")}>CC BY 4.0</a>—上面的 L0 與 L1、
      本站所有圖表與報告。使用時請一併註明「中華民國環境部」。
    </dd>

    <dt>原始觀測</dt>
    <dd>
      權利仍屬中華民國環境部，本專案不主張任何權利。
      地圖的縣市界線來自內政部國土測繪中心，依政府資料開放授權條款第 1 版。
    </dd>
  </dl>

  <div class="note">
    <strong>L2 不發布，理由不是檔案太大。</strong>
    環境部有兩份授權敘述，對「逐時原始值的完整複本可否轉散布」互相矛盾。
    這個專案<strong>繞過這個矛盾而不是解決它</strong>：只發衍生統計產物與完整管線—任一種讀法都不算轉載，而管線公開就代表資料實質上仍然可得。
    查證過程與兩份敘述的原文留在<a href={repoFile("docs/legal.md")}>授權說明</a>裡。
  </div>

</section>

<style>
/*
 * Term beside description, hairline between rows. The term column sizes to
 * its content so the descriptions all start on one line, and they are capped
 * at the page measure like every other paragraph rather than stretching to
 * whatever the column happens to be.
 */
.layers {
  display: grid;
  gap: 0 var(--space-4);
  margin: var(--space-4) 0;
}
@media (min-width: 40rem) {
  .layers {
    grid-template-columns: auto minmax(0, var(--measure));
  }
}
.layers dt {
  font-weight: 650;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  padding: var(--space-3) 0;
  border-top: 1px solid var(--line-soft);
}
.layers dt > span {
  display: block;
}
.layer-use {
  margin-block-start: var(--space-1);
  color: var(--text-muted);
  font-size: var(--text-sm);
  font-weight: 450;
  line-height: 1.35;
  white-space: normal;
  text-wrap: pretty;
}
.layers dd {
  margin: 0;
  color: var(--text-muted);
  padding: var(--space-3) 0;
  border-top: 1px solid var(--line-soft);
  text-wrap: pretty;
}

.task-register ol {
  display: grid;
  gap: var(--space-3);
  margin: var(--space-4) 0 0;
  padding: 0;
  list-style: none;
}
.task-register li {
  display: grid;
  gap: var(--space-1);
}
.task-register li span {
  color: var(--text-muted);
}
/* On one column the term and its description are one row, so only the term
   carries the rule. */
@media (max-width: 39.999rem) {
  .layers dd {
    border-top: 0;
    padding-top: 0;
  }
}

/* Chapter 1 and chapter 7 link straight at these three, and the site header
   would otherwise cover whichever one the reader arrived for. */
#gaps,
#hourly-pm25,
#wanli {
  scroll-margin-top: 5rem;
}

.publication-disagreement-body {
  max-width: var(--measure);
  padding: var(--space-3) var(--space-4) var(--space-4);
}

.publication-disagreement-body p {
  margin: 0;
}

.publication-disagreement-body p + p {
  margin-top: var(--space-3);
}
</style>
