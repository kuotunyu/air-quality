        from is a four-category axis, so the x labels thinned to 「1h」 and
        「48h」 and the two horizons in between went unnamed.
      */}
      <ul class="chart-key">
        {sarSeries.map((s) => (
          <li style={`--mark:${s.colour};--mark-ink:${markInk(s.colour)}`}>
            <svg class="key-mark" viewBox="0 0 22 8" aria-hidden="true">
              <line x1="1" y1="4" x2="21" y2="4" stroke={s.colour} stroke-width="2.5"
                stroke-linecap="round" stroke-dasharray={DASH[s.key]} />
            </svg>
            <span>{s.label}</span>
          </li>
        ))}
      </ul>
      <div
        class="plot"
        data-readout
        style={`--plot-ar:42;--plot-min:250px;--plot-max:400px;--y-w:${yGutter(sarTicks.map((t) => n(t, 0)))}px;--y-lo:${ySar.domain[0]};--y-hi:${ySar.domain[1]}`}
      >
    <script
      type="application/json"
      class="plot-readout-data"
      is:inline
      set:html={JSON.stringify({
        x: sar.horizons.map((h) => `${h.horizon}h`),
        unit: "RMSE μg/m³",
        places: 2,
        series: sarSeries.map((s) => ({
          label: s.label,
          colour: s.colour,
          ink: markInk(s.colour),
