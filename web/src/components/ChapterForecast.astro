---
/**
 * Chapter 5 — how far ahead this is worth doing.
 *
 * The pair to chapter 4. That one measures how small an effect the method can
 * still see looking backwards; this one measures how far forward it stays
 * worth anything. Both are chapters about a limit, measured rather than
 * asserted.
 *
 * Two figures, concrete before abstract. The RMSE panel first, because µg/m³
 * needs no explanation and the whole argument is already visible in it: the
 * climatology line is flat, and persistence crosses it. Only then the same
 * data as three scores, which is where the contradiction lives.
 */
import forecast from "../../public/data/story/forecast.json";
import { sarimaEvidence } from "../lib/data";
import { axisNumber, linear, markInk, n, ticks, xLabelBucket, yGutter } from "../lib/chart";
import ChapterIntro from "./ChapterIntro.astro";
import EvidenceFigure from "./EvidenceFigure.astro";

const horizons = forecast.horizons as {
  horizon: number;
  n: number;
  stations: number;
  splits: number;
  model_r2: number;
  skill_persistence: number;
  skill_persistence_worst: number;
  skill_climatology: number;
  skill_climatology_worst: number;
  splits_not_beating_persistence: number;
  model_rmse: number;
  persistence_rmse: number;
  climatology_rmse: number;
  band_nominal: number;
  band_half_width: number;
  band_coverage: number;
  band_coverage_worst: number;
  band_splits_below_nominal: number;
  band_model_rmse: number;
  per_split: {
    split: string;
    skill_persistence: number;
    skill_climatology: number;
    model_r2: number;
    band_half_width: number;
    band_coverage: number;
  }[];
}[];

const reading = forecast.reading as { claim: string; detail: string }[];
const READING_KEYS = ["r2-skill", "two-baselines", "split-instability", "shared-feature-bug"] as const;
const baselines = forecast.baselines as {
  name: string;
  label: string;
  what: string;
  why: string;
}[];

// Horizons are spaced evenly rather than by their hour value. They are four
// chosen questions, not samples of a continuous function, and a linear axis
// would crowd 1 and 6 into the left margin for no gain.
// Percent of the plot box, not pixels: the box has no width until the browser
// lays it out. Labels are HTML over the same box, so they never inherit the
// stretch that the marks do.
/*
 * Where one split sits inside its horizon's cloud — in PIXELS, not percent.
 *
 * The band used to be 3.2% of the plot width, and a mark is 6px wide with a
 * 1.25px ring on each side. A percentage band against a pixel mark means the
 * spacing collapses as the page narrows, and the figure's stated purpose is to
 * let four marks be four marks. Measured, pitch against the 8.5px a mark
 * occupies:
 *
 *     1280   plot 935px   pitch 9.97px   +1.47px clear
 *      768   plot 553px   pitch 5.89px   −2.61px, marks touch
 *      375   plot 214px   pitch 2.28px   −6.22px, 88 overlapping pairs
 *
 * It worked above a plot width of 797px and nowhere else — one of the three
 * widths `check_site_quality.mjs` renders, and not the one a reader arriving
 * from a message is on. A pitch in pixels holds at every width, and 10px is
 * what 1280 already drew, so the desktop rendering is the one being kept.
 */
const FOLD_PITCH = 10;
const spreadPx = (k: number, count: number) =>
  count > 1 ? (k - (count - 1) / 2) * FOLD_PITCH : 0;

/*
 * The categorical scale is inset so no cloud crosses the frame.
 *
 * Spreading the four splits about each horizon is right; doing it at x = 0 and
 * x = 100 puts half of each end cloud outside the box. Measured at 1440 on
 * figure 2: the 1h marks landed at −13.2, −4.4, +4.4 and +13.2px from the plot's
 * left edge and the 48h marks at 809.6 to 836.0 against an 822.8px plot — 12 of
 * the 48 marks with their centres outside the plotting rectangle, two of four
 * splits for all three series at both ends.
 *
 * Half a band plus half a mark is 15 + 4.25 = 19.25px, and the narrowest plot
 * this site is checked at is 214px, so the inset has to be at least 9.0% to
 * hold a pixel band. 10% carries it with room. That is wider than the 1.6% it
 * replaces and it costs drawing width — at 1280 the lines span 767px instead of
 * 905px — but the inset has to be a percentage: `xAt` places the SVG line as
 * well as the marks, an SVG `viewBox` cannot take a pixel clamp, and a line
 * whose endpoint parts company with its own cloud is worse than a shorter line.
 *
 * All three figures on this page share it deliberately. They share an x axis of
 * the same four horizons, so an inset sized for one and not the others would
 * put the same tick in three places down one page.
 */
const X_INSET = 10;
const xAt = (index: number) =>
  horizons.length === 1
    ? 50
    : X_INSET + (index / (horizons.length - 1)) * (100 - 2 * X_INSET);

const path = (values: number[], y: (v: number) => number) =>
  values.map((v, i) => `${i ? "L" : "M"}${n(xAt(i), 2)} ${n(y(v), 2)}`).join(" ");


// --- Figure 1: error in µg/m³ -------------------------------------------
const rmseAll = horizons.flatMap((h) => [h.model_rmse, h.persistence_rmse, h.climatology_rmse]);
const yRmse = linear([0, Math.max(...rmseAll) * 1.12], [100, 0]);
const rmseTicks = ticks(0, Math.max(...rmseAll) * 1.12, 4);

const rmseSeries = [
  {
    key: "model",
    label: "模型",
    colour: "var(--k0)",
    values: horizons.map((h) => h.model_rmse),
  },
  {
    key: "persistence",
    label: "persistence",
    colour: "var(--k1)",
    values: horizons.map((h) => h.persistence_rmse),
  },
  {
    key: "climatology",
    label: "climatology",
    colour: "var(--k2)",
    values: horizons.map((h) => h.climatology_rmse),
  },
];

// --- Figure 2: the same runs, as three scores ---------------------------
const metricAll = horizons.flatMap((h) => [
  h.model_r2,
  h.skill_persistence,
  h.skill_climatology,
  ...h.per_split.flatMap((s) => [s.skill_persistence, s.skill_climatology]),
]);
const yMetric = linear([Math.min(-0.2, Math.min(...metricAll) - 0.05), 1], [100, 0]);
const metricTicks = ticks(Math.min(-0.2, Math.min(...metricAll) - 0.05), 1, 5);

const metricSeries = [
  {
    key: "r2",
    /*
     * `--k0`, not `--text-faint`. R² is one of the three protagonists of this
     * figure — the chapter's finding is that it falls fourfold while skill
     * rises — and it was wearing the token the axis labels and the page's
     * disabled text wear. Design principle 1 is that the only thing on the page
     * carrying chroma is the DATA; a series painted in the interface's own grey
     * inverts it, and reads as chrome that wandered into the plot. It takes the
     * same `--k0` that names the model on the other two figures of this chapter,
     * which is also what that series is.
     */
    label: "R²",
    colour: "var(--k0)",
    values: horizons.map((h) => h.model_r2),
    splits: horizons.map((h) => h.per_split.map((s) => s.model_r2)),
  },
  {
    key: "sp",
    label: "vs persistence",
    colour: "var(--k1)",
    values: horizons.map((h) => h.skill_persistence),
    splits: horizons.map((h) => h.per_split.map((s) => s.skill_persistence)),
  },
  {
    key: "sc",
    label: "vs climatology",
    colour: "var(--k2)",
    values: horizons.map((h) => h.skill_climatology),
    splits: horizons.map((h) => h.per_split.map((s) => s.skill_climatology)),
  },
];

/*
 * A second channel for the same distinction.
 *
 * The three baselines are told apart by hue, and hue is the channel a
 * greyscale print, a projector and ~8% of men have least of. `model` stays
 * solid because it is the subject of all three figures; the two references
 * dash. `R2` keeps its own neutral and its own pattern for the same reason it
 * keeps its own colour — it is not a baseline.
 */
const DASH: Record<string, string | undefined> = {
  model: undefined,
  persistence: "7 4",
  climatology: "2 3",
  r2: undefined,
  sp: "7 4",
  sc: "2 3",
};

// --- the model usually set aside as impractical ---------------------------
// Its own panel, its own scale, and deliberately not sharing an axis with the
// two above: these are six stations at 72-hour origins, not the 74-station rows
// the model figures come from. See `sarimaEvidence.not_comparable`.
const sar = sarimaEvidence;
// Same inset as `xAt`, so the two panels of this chapter share a frame rule.
const sarX = (index: number) =>
  sar.horizons.length === 1
    ? 50
    : X_INSET + (index / (sar.horizons.length - 1)) * (100 - 2 * X_INSET);

const sarSeries = [
  {
    key: "sarima",
    label: "SARIMA",
    colour: "var(--k0)",
    values: sar.horizons.map((h) => h.sarima_rmse),
  },
  {
    key: "persistence",
    label: "persistence",
    colour: "var(--k1)",
    values: sar.horizons.map((h) => h.persistence_rmse),
  },
  {
    key: "climatology",
    label: "climatology",
    colour: "var(--k2)",
    values: sar.horizons.map((h) => h.climatology_rmse),
  },
];

const sarAll = sarSeries.flatMap((s) => s.values);
const ySar = linear([0, Math.max(...sarAll) * 1.12], [100, 0]);
const sarTicks = ticks(0, Math.max(...sarAll) * 1.12, 4);
const sarPath = (values: number[]) =>
  values.map((v, i) => `${i ? "L" : "M"}${n(sarX(i), 2)} ${n(ySar(v), 2)}`).join(" ");
// The one-hour row is the finding, so it is named rather than left to the eye.
const sarOneHour = sar.horizons.find((h) => h.horizon === 1);
const sarWins = sar.horizons.filter((h) => h.margin > 0);

const worst = horizons.find((h) => h.splits_not_beating_persistence > 0);
const last = horizons[horizons.length - 1];
const first = horizons[0];
const totalRows = horizons.reduce((sum, h) => Math.max(sum, h.n), 0);
/* Read, not written. This sentence said 「74 站」 as a literal while every other
   number around it came from the payload — and the count moved when the
   station-boundary leak in features/lags.py was fixed, because a station's
   first 167 hours stopped being filled with the previous station's week. */
const totalStations = horizons.reduce((most, h) => Math.max(most, h.stations), 0);
---

<section id="forecast" class="page">
  <ChapterIntro slug="forecast">
  <p class="lede">
    這一章量的是往前看能走多遠還算有用。
  </p>
  </ChapterIntro>

  <EvidenceFigure number="6.1" title="各預測期距的誤差如何變化？" primary>
    <div class="chart">
      {/*
        Named above the plot rather than at the ends of the lines. The gutter was
        sized by `labelGutter` to 「vs climatology」 and took up to 23% of the
        plot while standing about 85% empty — and the plot it took the width
        from is a four-category axis, so the x labels thinned to 「1h」 and
        「48h」 and the two horizons in between went unnamed.
      */}
      <ul class="chart-key">
        {rmseSeries.map((s) => (
          <li style={`--mark:${s.colour};--mark-ink:${markInk(s.colour)}`}>
            <svg class="key-mark" viewBox="0 0 22 8" aria-hidden="true">
              <line x1="1" y1="4" x2="21" y2="4" stroke={s.colour} stroke-width="2.5"
                stroke-linecap="round" stroke-dasharray={DASH[s.key]} />
            </svg>
            <span>{s.label}</span>
          </li>
        ))}
      </ul>
      <div
        class="plot"
        data-readout
        style={`--plot-ar:42;--plot-min:250px;--plot-max:400px;--y-w:${yGutter(rmseTicks.map((t) => n(t, 0)))}px;--y-lo:${yRmse.domain[0]};--y-hi:${yRmse.domain[1]}`}
      >
    <script
      type="application/json"
      class="plot-readout-data"
      is:inline
      set:html={JSON.stringify({
        x: horizons.map((h) => `${h.horizon}h`),
        unit: "RMSE μg/m³",
        places: 2,
        series: rmseSeries.map((s) => ({
          label: s.label,
          colour: s.colour,
          ink: markInk(s.colour),
          dash: DASH[s.key],
          values: s.values,
        })),
      })}
    />

        <div class="plot-y">
          {rmseTicks.map((t) => <span style={`top:${n(yRmse(t), 3)}%`}>{axisNumber(n(t, 0))}</span>)}
        </div>

        <div class="plot-area" data-primary-plot>
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {
              rmseTicks.map((t) => (
                <line
                  x1="0"
                  x2="100"
                  y1={n(yRmse(t), 3)}
                  y2={n(yRmse(t), 3)}
                  class="plot-grid"
                  vector-effect="non-scaling-stroke"
                />
              ))
            }
            <line x1="0" x2="100" y1="100" y2="100" class="plot-axis" vector-effect="non-scaling-stroke" />
            {
              rmseSeries.map((s) => (
                <path
                  d={path(s.values, yRmse)}
                  class="plot-line"
                  stroke={s.colour}
                  stroke-dasharray={DASH[s.key]}
                  vector-effect="non-scaling-stroke"
                />
              ))
            }
          </svg>

          {
            rmseSeries.map((s) =>
              s.values.map((v, i) => (
                <span
                  class="plot-pt"
                  style={`left:${n(xAt(i), 3)}%;top:${n(yRmse(v), 3)}%;color:${s.colour}`}
                  title={`${s.label} @ ${horizons[i].horizon}h: ${n(v, 2)} μg/m³`}
                />
              )),
            )
          }
        </div>

        <div class="plot-x" data-n={horizons.length} data-tw={xLabelBucket(horizons.map((h) => `${h.horizon}h`))}>
          {horizons.map((h, i) => <span style={`left:${n(xAt(i), 3)}%`}>{h.horizon}h</span>)}
        </div>
      </div>
    </div>
    <Fragment slot="caption">
      均方根誤差（RMSE），越低越好。兩條基準線都是規則不是模型：
      <strong>persistence 說「下一小時就跟現在一樣」</strong>，
      <strong>climatology 那條是平的</strong>—
      它根本不看今天發生什麼事，所以期距對它毫無影響，
      因此它是這張圖裡唯一固定不動的參考線。
    </Fragment>
  </EvidenceFigure>

  <nav
    class="forecast-decision-sheet"
    aria-labelledby="forecast-decision-title"
    data-forecast-decision-sheet
  >
    <h2 id="forecast-decision-title">三步決定這個預測還值不值得用</h2>
    <ol role="list">
      <li data-forecast-decision="error">
        <a href="#evidence-6-1-title">
          <span class="forecast-decision-index" aria-hidden="true">01</span>
          <strong>誤差</strong>
          <p>先看圖 6.1：模型、persistence 與 climatology 的 RMSE 隨期距如何變化。</p>
        </a>
      </li>
      <li data-forecast-decision="skill">
        <a href="#evidence-6-2-title">
          <span class="forecast-decision-index" aria-hidden="true">02</span>
          <strong>基準優勢</strong>
          <p>再看圖 6.2：同一批預測相對 persistence 與 climatology 還剩多少優勢。</p>
        </a>
      </li>
      <li data-forecast-decision="cost">
        <a href="#forecast-cost">
          <span class="forecast-decision-index" aria-hidden="true">03</span>
          <strong>計算代價</strong>
          <p>最後看成本表與圖 6.3：額外計算是否換得可用的準確度。</p>
        </a>
      </li>
    </ol>
  </nav>

  <p>
    上一章量的是回頭看能分辨多小的效應。兩章問的是同一種問題：
    這個方法在什麼地方停止提供資訊？
  </p>

  <p>
    做法是給模型 PM2.5 自己的歷史—落後 1、2、3、6、12、24、48、168 小時的值，
    滾動平均與最大值，還有變化率—然後問它 h 小時之後會是多少。
    驗證用 rolling-origin：<strong>過去訓練、未來測試，切點往前走</strong>。
    隨機切分會讓模型用星期二預測星期一，那是沒有預報員做得到的事。
    {n(totalRows / 1e4, 0)} 萬列測試資料，{totalStations} 站，2015–2025。
  </p>

  <h2>均方根誤差（μg/m³）</h2>

  <div class="note">
    <strong>關鍵是那個交叉點。</strong>
    persistence 從 {n(first.persistence_rmse, 2)} 一路爬到 {n(last.persistence_rmse, 2)} μg/m³，
    在 24 到 48 小時之間<strong>穿過了 climatology</strong>。
    也就是說到了兩天後，「跟現在一樣」的誤差已經大於「這站這個月這個小時的平均」。
    而模型在 48 小時是 {n(last.model_rmse, 2)}，只比 climatology 的
    {" "}{n(last.climatology_rmse, 2)} 略低。
  </div>

  <h2>同一批結果的三個無單位指標</h2>

  <p>
    R² 和 skill 都是無單位的比例，1 是完美、0 是「跟被比較的東西一樣」，
    所以三個可以畫在同一根軸上。畫在同一根軸上，它們的矛盾就變成一個形狀。
  </p>

  <EvidenceFigure number="6.2" title="模型相對兩條基準線何時失去優勢？">
    <div class="chart">
      {/*
        Named above the plot rather than at the ends of the lines. The gutter was
        sized by `labelGutter` to 「vs climatology」 and took up to 23% of the
        plot while standing about 85% empty — and the plot it took the width
        from is a four-category axis, so the x labels thinned to 「1h」 and
        「48h」 and the two horizons in between went unnamed.
      */}
      <ul class="chart-key">
        {metricSeries.map((s) => (
          <li style={`--mark:${s.colour};--mark-ink:${markInk(s.colour)}`}>
            <svg class="key-mark" viewBox="0 0 22 8" aria-hidden="true">
              <line x1="1" y1="4" x2="21" y2="4" stroke={s.colour} stroke-width="2.5"
                stroke-linecap="round" stroke-dasharray={DASH[s.key]} />
            </svg>
            <span>{s.label}</span>
          </li>
        ))}
      </ul>
      <div
        class="plot"
        data-readout
        style={`--plot-ar:42;--plot-min:250px;--plot-max:400px;--y-w:${yGutter(metricTicks.map((t) => n(t, 1)))}px;--y-lo:${yMetric.domain[0]};--y-hi:${yMetric.domain[1]}`}
      >
    <script
      type="application/json"
      class="plot-readout-data"
      is:inline
      set:html={JSON.stringify({
        x: horizons.map((h) => `${h.horizon}h`),
        unit: "四個分割的平均",
        places: 3,
        series: metricSeries.map((s) => ({
          label: s.label,
          colour: s.colour,
          ink: markInk(s.colour),
          dash: DASH[s.key],
          values: s.values,
        })),
      })}
    />

        <div class="plot-y">
          {metricTicks.map((t) => <span style={`top:${n(yMetric(t), 3)}%`}>{axisNumber(n(t, 1))}</span>)}
        </div>

        <div class="plot-area">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {
              metricTicks.map((t) => (
                <line
                  x1="0"
                  x2="100"
                  y1={n(yMetric(t), 3)}
                  y2={n(yMetric(t), 3)}
                  class={Math.abs(t) < 1e-9 ? "plot-axis" : "plot-grid"}
                  vector-effect="non-scaling-stroke"
                />
              ))
            }
            {
              metricSeries.map((s) => (
                <path
                  d={path(s.values, yMetric)}
                  class="plot-line"
                  stroke={s.colour}
                  stroke-dasharray={DASH[s.key]}
                  vector-effect="non-scaling-stroke"
                />
              ))
            }
          </svg>

          {
            /*
             * The per-split values, spread instead of stacked.
             *
             * Every split was drawn at exactly its horizon's x, so four marks
             * 5px across sat on one point and composited into a single blob —
             * and this cloud is the chapter's headline caveat, the thing that
             * says the four folds do not agree. Spreading them across a band
             * narrower than the gap between horizons keeps x meaning the
             * horizon while letting four marks be four marks. The order is the
             * split's own, so the same fold lands in the same place in every
             * series and the build is deterministic.
             */
            metricSeries.map((s) =>
              s.splits.map((values, i) =>
                values.map((v, k) => (
                  <span
                    class="plot-pt fold"
                    style={`left:calc(${n(xAt(i), 3)}% + ${n(spreadPx(k, values.length), 2)}px);top:${n(yMetric(v), 3)}%;color:${s.colour}`}
                    title={`${s.label} @ ${horizons[i].horizon}h・分割 ${k + 1}：${n(v, 3)}`}
                  />
                )),
              ),
            )
          }
          {
            metricSeries.map((s) =>
              s.values.map((v, i) => (
                <span
                  class="plot-pt"
                  style={`left:${n(xAt(i), 3)}%;top:${n(yMetric(v), 3)}%;color:${s.colour}`}
                  title={`${s.label} @ ${horizons[i].horizon}h: ${n(v, 3)}`}
                />
              )),
            )
          }
        </div>

        <div class="plot-x" data-n={horizons.length} data-tw={xLabelBucket(horizons.map((h) => `${h.horizon}h`))}>
          {horizons.map((h, i) => <span style={`left:${n(xAt(i), 3)}%`}>{h.horizon}h</span>)}
        </div>
      </div>
    </div>
    <Fragment slot="caption">
      粗線是四個分割的平均，<strong>小點是每一個分割各自的值</strong>。
      三條線來自同一批模型、同一批預測。
    </Fragment>
  </EvidenceFigure>

  <div class="forecast-band" data-forecast-reading-band>
    {
      reading.map((r, index) => (
        <section data-forecast-reading={READING_KEYS[index]}>
          <h2>{r.claim}</h2>
          <p class="small">{r.detail}</p>
        </section>
      ))
    }
  </div>

  <h2>為何需要兩條基準線</h2>

  <div class="forecast-band" data-forecast-baseline-band>
    {
      baselines.map((b) => (
        <section data-forecast-baseline={b.name}>
          <h2>
            {b.name} <span class="dim">{b.label}</span>
          </h2>
          <p class="small">{b.what}</p>
          <p class="small dim">{b.why}</p>
        </section>
      ))
    }
  </div>

  <div class="table-wrap">
    <table class="dense">
      <thead>
        <tr>
          <th>期距</th>
          <th class="num">R²</th>
          <th class="num">vs persistence</th>
          <th class="num">最差分割</th>
          <th class="num">vs climatology</th>
          <th class="num">模型 RMSE</th>
        </tr>
      </thead>
      <tbody>
        {
          horizons.map((h) => (
            <tr>
              <td>{h.horizon} 小時</td>
              <td class="num dim">{n(h.model_r2, 3)}</td>
              <td class="num strong">{n(h.skill_persistence, 3)}</td>
              <td class={`num ${h.skill_persistence_worst <= 0 ? "worse" : "dim"}`}>
                {n(h.skill_persistence_worst, 3)}
              </td>
              <td class="num">{n(h.skill_climatology, 3)}</td>
              <td class="num dim">{n(h.model_rmse, 2)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {
    worst && (
      <div class="note caveat">
        <p>
          <strong>那一欄「最差分割」是後來才加的，因為第一版少了它。</strong>
          程式印出來的摘要是「4/4 期距贏過 persistence」—對四個平均值而言是真的。
          但 16 個「期距 × 分割」格子裡有一個是
          <strong>{n(worst.skill_persistence_worst, 3)}</strong>
          （{worst.horizon} 小時、<code>rolling_1</code>）。rolling_1 是訓練資料最少的分割，
          因為 rolling-origin 給第一個分割最短的歷史。
        </p>
        <p>
          這跟這一章反覆講的「R² 藏掉一個爛模型」是同一個錯，只是高了一層。
          所以現在每個平均值旁邊都掛著它最差的分割，而且有測試釘住這件事。
        </p>
      </div>
    )
  }

  <h2>預測區間，以及它實際接住了多少</h2>

  <p>
    點預測不會說它有多確定。這裡的區間用 <strong>split conformal</strong> 產生：
    在每個切分裡，模型只用訓練期的前 80% 擬合，剩下最靠近測試期的一段拿來量
    絕對殘差，取修正後的分位數當半寬。
    <strong>校準集取尾段而不是隨機抽</strong>—共形假設校準與測試可交換，
    而逐時 PM2.5 不是；隨機抽會讓 2025 年的區間有一部分校準在 2016 年上。
  </p>

  {/* Wrapped, like the two tables below it. Five columns of Chinese headers
      took the page 243px sideways at 375px before this — measured by
      `check_site_quality.mjs`, which is why it is a scroller and not a guess. */}
  <div class="table-wrap">
  <table class="data-table">
    <caption>
      名目 {n(horizons[0]?.band_nominal * 100, 0)}% 的區間，以及它在留出測試期實際接住的比例。
      「最差分割」和「低於名目」與平均並列，理由和技能分數那裡一樣。
    </caption>
    <thead>
      <tr>
        <th scope="col">期距</th>
        <th scope="col" class="num">半寬 μg/m³</th>
        <th scope="col" class="num">實測覆蓋率</th>
        <th scope="col" class="num">最差分割</th>
        <th scope="col" class="num">低於名目</th>
      </tr>
    </thead>
    <tbody>
      {horizons.map((h) => (
        <tr>
          <th scope="row">{h.horizon} 小時</th>
          <td class="num">±{n(h.band_half_width, 2)}</td>
          <td class="num">{n(h.band_coverage * 100, 1)}%</td>
          <td class="num">{n(h.band_coverage_worst * 100, 1)}%</td>
          <td class="num">{h.band_splits_below_nominal} / {h.splits}</td>
        </tr>
      ))}
    </tbody>
  </table>
  </div>

  <div class="note caveat">
    <strong>這個保證在這筆資料上不成立，而且不是隨機地不成立。</strong>
    <p>
      共形的有限樣本保證是<em>邊際的</em>，並且建立在可交換性上。
      四個期距的平均覆蓋率都在名目之上，但<strong>每一個期距都恰好有一個分割低於名目</strong>，
      而且每次都是同一個：<code>rolling_3</code>，四次都落在 76% 到 78% 之間。
    </p>
    <p>
      機制是量得出來的。<code>rolling_3</code> 校準在 2021-08 到 2023-01，
      測試在 2023-01 到 2024-07；它的半寬相對於自己面對的誤差是四個分割裡最窄的
      （半寬÷RMSE 約 1.05，其餘三個是 1.21 到 1.28）。
      <strong>校準期比測試期安靜，所以區間校得太窄。</strong>
      這裡不宣稱原因—那需要另一項分析—只報告它一致地發生。
    </p>
    <p>
      區間是繞著<strong>用 80% 訓練資料擬合的模型</strong>校準的，不是上面表格裡的頭條模型。
      兩者的 RMSE 相近（例如 24 小時是 {n(horizons.find((h) => h.horizon === 24)?.band_model_rmse ?? 0, 2)} 對
      {" "}{n(horizons.find((h) => h.horizon === 24)?.model_rmse ?? 0, 2)}），
      所以這個區間可以讀成描述這一章報告的預測；這個對照也逐次寫進 payload，
      因為區間若掛在一個明顯較差的模型上，它描述的就是別的東西。
    </p>
  </div>

  <h2>洩漏防護與驗證</h2>

  <p class="small">{forecast.leakage_note}</p>

  <p class="small">
    <strong>測試用的序列值就是自己的小時編號</strong>，所以位移錯方向會表現成一個
    精確的算術事實，而不是一個「好得可疑」的分數。
    另外在真實資料上查過一次：沒有任何特徵在超過 30% 的列上等於目標值，
    相關係數的排序也符合物理預期
    （lag1 0.938 &gt; mean3 0.911 &gt; max3 0.897 &gt; lag2 0.885），
    沒有任何一個可疑地接近 1。
  </p>

  <h2 id="forecast-cost">被跳過的那個模型</h2>

  <p class="lede">
    SARIMA 常被以「太麻煩、不實用」為由略過。這個結論本身站得住，
    問題在於它通常不附任何數字—那句話可以是工程判斷，
    也可以是個人偏好，讀者無法分辨是哪一種。
    一個附了秒數的表格只能是前者。
  </p>

  <p>
    所以這裡量兩件互相獨立的事：那個不便值多少，
    以及它買到了什麼。
    固定階數 {sar.order}、{sar.stations} 個測站 × {sar.splits} 個 rolling-origin 分割、
    每 {sar.origin_stride_hours} 小時一個預測原點。
    {sar.fits.converged}/{sar.fits.total} 次擬合全部收斂，
    中位數 {sar.fits.median_seconds} 秒、{sar.fits.median_observed.toLocaleString()} 個有效觀測點。
  </p>

  <h3>一、那個不便，定價</h3>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>序列長度</th>
          <th class="num">自動選階</th>
          <th class="num">固定階數</th>
          <th class="num">倍數</th>
        </tr>
      </thead>
      <tbody>
        {
          sar.selection_cost.map((row) => (
            <tr>
              <td class="num">{row.points.toLocaleString()} 點</td>
              <td class="num">{n(row.auto_seconds, 2)} s</td>
              <td class="num">{n(row.fixed_seconds, 2)} s</td>
              <td class="num strong">{n(row.multiple, 1)}×</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="note">
    <strong>倍數會隨資料量長大，這比一個定值更嚴重。</strong>
    {sar.why_multiple_grows}
    所以「它不方便」<strong>這件事是對的</strong>。
  </div>

  <h3>二、那個不便，買到了什麼</h3>

  <EvidenceFigure number="6.3" title="自動搜尋買到的準確度足以抵銷成本嗎？">
    <div class="chart">
      {/*
        Named above the plot rather than at the ends of the lines. The gutter was
