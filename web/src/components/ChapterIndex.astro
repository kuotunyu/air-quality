---
/**
 * The ten chapters as a list of rows, with what each one settles.
 *
 * Extracted when the 404 page needed the same list. Copying the markup would
 * have made a second copy of a thing this repository has already been bitten by
 * twice: chapter names lived in two places and drifted on three of the ten
 * chapters (see `scripts/check_chapter_titles.py`). A list of chapters that
 * exists twice would drift the same way, and no gate would see it, because both
 * copies would be reading the same registry and printing different CSS.
 *
 * The list is a numbered one because the document is a sequence — the numbers
 * carry the reading order, which is information the reader needs. (Numbered
 * markers as decoration on unordered sections would be scaffolding; these are
 * an actual ordinal.)
 *
 * Rows rather than cards. Ten cards in a grid would give every chapter the same
 * weight and the same shape, and would put each claim in a column about
 * fourteen Chinese characters wide. A row lets the claim have the page's own
 * measure, which is the width it was written for.
 */
import { CHAPTER_GROUPS, chapterLabel, href } from "../lib/chapters";
---

<div class="toc-groups">
  {
    CHAPTER_GROUPS.map((group) => (
      <section class="toc-group" data-chapter-group>
        <h3 class="toc-group-label">{group.label}</h3>
        <ol class="toc" start={group.chapters[0]?.n}>
          {group.chapters.map((c) => (
            <li>
              <a href={href(c.slug)} data-chapter-index-link>
                <span class="toc-n">{chapterLabel(c.n)}</span>
                <span class="toc-body">
                  <span class="toc-title">{c.title}</span>
                  <span class="toc-claim">{c.claim}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .toc-groups {
    margin: var(--space-5) 0 var(--space-4);
  }

  .toc-group + .toc-group {
    margin-top: var(--space-5);
  }

  .toc-group-label {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-faint);
  }

  .toc {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: none;
  }

  .toc li {
    border-top: 1px solid var(--line-soft);
  }

  .toc li:last-child {
    border-bottom: 1px solid var(--line-soft);
  }

  .toc a {
    display: grid;
    gap: 0.1rem var(--space-4);
    padding: var(--space-3) var(--space-2);
    margin-inline: calc(-1 * var(--space-2));
    text-decoration: none;
    color: var(--text);
    transition: background-color 160ms ease;
  }

  /* The chapter number sizes to its own content and the title column takes the
     rest, so every title starts on one vertical line down the list. */
  @media (min-width: 34rem) {
    .toc a {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .toc-n {
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--text-faint);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .toc-body {
    display: grid;
    gap: 0.2rem;
    max-width: var(--measure);
  }

  .toc-title {
    font-size: var(--text-lg);
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .toc-claim {
    color: var(--text-muted);
    text-align: start;
    line-break: strict;
  }

  /* The whole row is the target, so the hover has to be on the row: an underline
     under the title alone would suggest only the title is clickable. */
  .toc a:hover,
  .toc a:focus-visible {
    background: var(--tint-neutral);
  }

  .toc a:hover :is(.toc-title, .toc-n),
  .toc a:focus-visible :is(.toc-title, .toc-n) {
    color: var(--accent);
  }
</style>
