---
/**
 * Chapter 6 — the health number and the assumption inside it.
 *
 * The third chapter in a row about a limit, and the first where the signal
 * wins. Chapter 4 found the method could not resolve the policy effects it
 * was pointed at; chapter 5 found the forecast decays to climatology by two
 * days. Here the improvement is real at every assumption — and the *level*
 * still is not, because the counterfactual is never stated when a figure like
 * this is quoted.
 *
 * The chart is four lines that never cross and never converge. They are the
 * same data under four counterfactuals, and the gap between the top and
 * bottom is what a single headline number silently picks one of.
 *
 * No death counts anywhere, deliberately. See the module docstring in
 * analysis/health.py: a count needs a population this project does not have,
 * and that term would dominate the error while reading as the solid part.
 */
import health from "../../public/data/story/health.json";
import { axisNumber, linear, markInk, n, ticks, xLabelBucket, yearTicks, yGutter } from "../lib/chart";
import ChapterIntro from "./ChapterIntro.astro";
import ConceptFlow from "./ConceptFlow.astro";
import EvidenceFigure from "./EvidenceFigure.astro";

const series = health.series as {
  name: string;
  label: string;
  value: number;
  why: string;
  years: number[];
  paf: number[];
}[];

const headline = health.headline as {
  first_year: number;
  last_year: number;
  first_share: number;
  last_share: number;
  first_range: number[];
  last_range: number[];
};

const panel = health.panel as {
  start_year: number;
  stations: number;
  station_years: number;
  why: string;
};

const functions = health.functions as {
  name: string;
  rr_per_10: number;
  rr_per_10_low: number;
  rr_per_10_high: number;
  outcome: string;
  source: string;
  source_url: string;
  caveat: string;
}[];

const extrapolation = health.extrapolation as {
  ceiling_ugm3: number;
  share_above: number;
  why: string;
};

const notReported = health.not_reported as { deaths: string; exposure: string };

const years = health.years as number[];
const spreadShare = health.spread_share as number[];

/*
 * Which two assumptions the headline range actually spans.
 *
 * The sentence below used to name them by hand as 「2.4 還是 5.9」 and call them
 * 「同一份 published TMREL 區間的兩端」. Both of its numbers are interpolated from
 * `headline.last_range`, and the upper one is not 2.4: `analysis/health.py`
 * builds that range as min/max of `paf_median` across ALL the counterfactuals,
 * so its top is the zero-exposure assumption — which `conf/health.yaml` itself
 * describes as 「almost certainly wrong at the bottom of the range where the
 * epidemiology has no observations」. 2.4 gives 7.7%, next to a sentence standing
 * beside 9.4%.
 *
 * The claim was wrong in a way no prose gate could catch, because both numbers
 * were correct and only the sentence about them was false. So it is derived now
 * rather than corrected: adding or removing a counterfactual moves the range,
 * and the sentence follows it.
 *
 * A range end that matches no series throws, because the alternative is prose
 * that describes an assumption nobody made.
 */
const lastIndex = years.indexOf(headline.last_year);
const rangeEnds = headline.last_range.map((target) => {
  const found = series.find((s) => Math.abs(s.paf[lastIndex] - target) < 5e-5);
  if (!found) {
    throw new Error(
      `health.json: no counterfactual gives PAF ${target} in ${headline.last_year}`,
    );
  }
  return found;
});

/*
 * How wide the headline range is at each end of the record.
 *
 * The sentence below said 「大約 3.6 到 4.2 個百分點」 by hand, next to a paragraph
 * whose own figures are interpolated. It is the arithmetic of the two ranges the
 * chapter already prints — first_range and last_range — so it is computed here
 * rather than remembered, and the 「大約」 goes with it: a derived number does not
 * need hedging.
 */
const rangeWidths = [headline.first_range, headline.last_range].map(
  ([low, high]) => (high - low) * 100,
);

const allPaf = series.flatMap((s) => s.paf);
const yPaf = linear([0, Math.max(...allPaf) * 1.1], [100, 0]);
const xYear = linear([Math.min(...years), Math.max(...years)], [0, 100]);
const pafTicks = ticks(0, Math.max(...allPaf) * 1.1, 5);
// Round intervals rather than sampled indices — see `yearTicks`. This axis read
// 2006, 2008, 2011, 2013, 2016, 2018, 2020, 2023, 2025 before.
const xTickYears = yearTicks(years);

// Darkest for the strictest counterfactual (0), lightest for the most lenient
// (5.9). The ordering is the point: a reader should see that "how much is
// attributable" is a stack of choices, not a measurement.
//
// Spread across the ramp rather than taken from the middle of it. These four
// were c5/c4/c3/c2 — four ADJACENT members of a sequential scale used as four
// categories, which is the one thing a sequential scale is worst at. Adjacent
// members are adjacent because they are meant to look similar; the closest pair
// here measured dE00 11.1 in normal vision and 8.2 under deuteranopia, on a
// chart whose whole argument is that you can see the four lines diverge.
//
// Every other step doubles the lightness gap (0.093 rather than 0.0465) and
// keeps the same low-to-high ordering, so nothing about the reading changes —
// the four are simply four now. Closest pair, measured: dE00 25.7 in normal
// vision and 9.1 under deuteranopia (light theme); 29.4 and 18.6 in dark.
const COLOURS = ["var(--c6)", "var(--c4)", "var(--c2)", "var(--c0)"];

// Every other chart on the site that had its series drawn from the ramp moved
// to the categorical set `--k0`..`--k3`, because a method or a baseline is not
// a concentration. This one did NOT, and the comment above is why: these four
// ARE ordered, and the ordering is the argument. Swapping in four unordered
// hues would have thrown that away to fix a number.
//
// The number still wanted fixing. dE00 9.1 under deuteranopia was the weakest
// pair on the site, on a four-line chart whose point is watching lines
// diverge. So the distinction is carried a second time, in a channel that
// survives losing hue entirely — including in greyscale and in print.
const DASHES = [undefined, "7 4", "2 3", "10 3 2 3"];

const path = (values: number[], xs: number[]) =>
  values.map((v, i) => `${i ? "L" : "M"}${n(xYear(xs[i]), 2)} ${n(yPaf(v), 2)}`).join(" ");

// The second panel: the same spread as a share of the estimate it sits on.
const yShare = linear([0, Math.max(...spreadShare) * 1.15], [100, 0]);
const shareTicks = ticks(0, Math.max(...spreadShare) * 1.15, 4);
const sharePath = spreadShare
  .map((v, i) => `${i ? "L" : "M"}${n(xYear(years[i]), 2)} ${n(yShare(v), 2)}`)
  .join(" ");

const fn = functions[0];

/*
 * Which language a data string is in.
 *
 * Several of these fields quote the literature and come back in English —
 * `outcome`, `source` and `caveat` on the exposure-response function, `why` on
 * the panel — while others in the same shape come back in Chinese. So it cannot
 * be written into the markup; it has to be asked of the string.
 *
 * It buys two things. A screen reader switches voice instead of reading English
 * with Chinese phonetics, and the stylesheet stops justifying it: the site's own
 * note on justification says Latin has to stretch word spaces and that is why
 * English is usually left-aligned, and the citation was the one block on the
 * site that proved it — four lines of stretched English at 934px.
 */
const langOf = (s: string | null | undefined) =>
  s && !/[㐀-鿿]/.test(s) ? "en" : undefined;
---

<section id="health" class="page">
  <ChapterIntro slug="health">
  {/*
    健康負擔與它的假設 — the name the rail, the index, the browser tab and both
    footer steps already use. This h1 read 健康負擔估計的假設敏感度, so a reader
    met one name in four places and a different one on arrival.

    Both are in register and both name the quantity rather than a conclusion, so
    the tie went to the shorter: twelve characters wrap the 206px rail label to
    two lines and this would be the only two-line entry among ten, while nine
    characters is exactly one line. Pinned by `scripts/check_chapter_titles.py`,
    because chapter 5 had this same defect, it was fixed by hand, and it came
    back here and on chapter 4 with nothing watching.
  */}
  <p class="lede">
    「空污每年造成 N 人死亡」這種句子裡藏著三個選擇：用哪條暴露反應函數、
    以什麼濃度作為比較基準、以及誰暴露在裡面。
  </p>
  </ChapterIntro>

  <ol class="health-ledger" aria-label="本章三項假設" data-health-assumption-ledger>
    <li data-health-assumption="counterfactual">
      <strong>比較基準</strong>
      <p>圖 7.1 與圖 7.2 量化四種反事實濃度造成的差異。</p>
    </li>
    <li data-health-assumption="response">
      <strong>暴露反應函數</strong>
      <p>本章只採用一條具可追溯來源的函數；適用範圍與外推界線在後文公開。</p>
    </li>
    <li data-health-assumption="population">
      <strong>暴露人口</strong>
      <p>本專案沒有人口與個人暴露資料，因此不報死亡人數，也不把測站中位數稱為誰的暴露。</p>
    </li>
  </ol>

  <EvidenceFigure number="7.1" title="比較基準如何改變可歸因比例？" primary>
    <div class="chart">
      {/*
        The four counterfactuals, named above the plot rather than at the ends
        of their own lines.

        The end labels were a right-hand gutter sized by `labelGutter` to the
        longest of them, 「5 μg/m³（WHO 2021）」 — measured, `--key-w` resolved to
        266px, so on a 1000px viewport the names of the four lines took more
        width than the four lines did. Above the plot the same four names cost
        one wrapped row and no drawing area, and the dash each one is drawn with
        travels with it.
      */}
      <ul class="chart-key">
        {series.map((s, i) => (
          <li style={`--mark:${COLOURS[i % COLOURS.length]};--mark-ink:${markInk(COLOURS[i % COLOURS.length])}`}>
            <svg class="key-mark" viewBox="0 0 22 8" aria-hidden="true">
              <line x1="1" y1="4" x2="21" y2="4" stroke={COLOURS[i % COLOURS.length]}
                stroke-width="2.5" stroke-linecap="round" stroke-dasharray={DASHES[i % DASHES.length]} />
            </svg>
            <span>{s.label}</span>
          </li>
        ))}
      </ul>
      <div
        class="plot"
        data-readout
        style={`--plot-ar:44;--plot-min:250px;--plot-max:420px;--y-w:${yGutter(pafTicks.map((t) => `${n(t * 100, 0)}%`))}px;--y-lo:${yPaf.domain[0]};--y-hi:${yPaf.domain[1]}`}
      >
    <script
      type="application/json"
      class="plot-readout-data"
      is:inline
      set:html={JSON.stringify({
        x: years.map(String),
        unit: "可歸因比例",
        places: 1,
        scale: 100,
        suffix: "%",
        series: series.map((s, i) => ({
          label: s.label,
          colour: COLOURS[i % COLOURS.length],
          ink: markInk(COLOURS[i % COLOURS.length]),
          dash: DASHES[i % DASHES.length],
          values: s.paf,
        })),
      })}
    />

        <div class="plot-y">
          {pafTicks.map((t) => <span style={`top:${n(yPaf(t), 3)}%`}>{axisNumber(n(t * 100, 0))}%</span>)}
        </div>

        <div class="plot-area" data-primary-plot>
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {
              pafTicks.map((t) => (
                <line
                  x1="0"
                  x2="100"
                  y1={n(yPaf(t), 3)}
                  y2={n(yPaf(t), 3)}
                  class="plot-grid"
                  vector-effect="non-scaling-stroke"
                />
              ))
            }
            <line x1="0" x2="100" y1="100" y2="100" class="plot-axis" vector-effect="non-scaling-stroke" />
            {
              series.map((s, i) => (
                <path
                  d={path(s.paf, s.years)}
                  class="plot-line"
                  stroke={COLOURS[i % COLOURS.length]}
                  stroke-dasharray={DASHES[i % DASHES.length]}
                  vector-effect="non-scaling-stroke"
                />
              ))
            }
          </svg>
        </div>

        <div class="plot-x" data-n={xTickYears.length} data-tw={xLabelBucket(xTickYears)}>
          {xTickYears.map((y) => <span style={`left:${n(xYear(y), 3)}%`}>{y}</span>)}
        </div>
      </div>
    </div>
    <Fragment slot="caption">
      可歸因比例，{panel.stations} 個固定測站、{panel.start_year}–{
        years[years.length - 1]
      } 年。四條線是<strong>同一批濃度資料</strong>，只差在以哪個濃度作為比較基準。
      標籤上的數字就是那個基準。
    </Fragment>
  </EvidenceFigure>

  <ConceptFlow
    title="同一批濃度如何變成一段可歸因比例"
    summary="資料沒有改變；改變的是比較基準。網站因此報告一段範圍，而不是把其中一個假設包裝成唯一答案。"
    steps={[
      {
        label: "觀測",
        title: "固定測站的年均濃度",
        detail: "同一批濃度序列是四種估計共同的起點。",
      },
      {
        label: "反事實選擇",
        title: "指定拿哪個濃度作為比較基準",
        detail: "基準不是資料自己決定的，而是估計之前必須公開的假設。",
        tone: "cool",
        options: series.map((item) => ({
          title: `${n(item.value, 1)} μg/m³`,
          detail: item.label,
        })),
      },
      {
        label: "估計",
        title: "套用暴露反應函數，得到比例範圍",
        detail: "下降幅度可以跨基準比較；當前年份的絕對水準對基準較敏感。",
        tone: "warm",
      },
      {
        label: "可報告範圍",
        title: "不延伸成死亡人數或個人暴露",
        detail: "本專案沒有人口、基礎死亡率與人口加權暴露，不能補出這兩種結論。",
        tone: "boundary",
      },
    ]}
  />

  <p>
    第三個，這個專案沒有資料回答。函數這裡固定用一條，來源與適用界線公開在下方；
    這一章逐年量化的是<strong>比較基準的選擇把答案推動多少</strong>。
  </p>

  <p>
    報的是可歸因比例（attributable fraction），不是人數。
    比例只需要濃度和一條反應函數；人數還要乘上人口與基礎死亡率，
    而這個專案只有測站觀測，沒有人口資料。
    那一項會是誤差最大的來源，卻剛好看起來像整句話裡最紮實的部分。
  </p>

  <div class="note">
    <p><code>{health.formula}</code></p>
    <p>反事實濃度就是「以什麼濃度作為比較基準」。它幾乎從來不會跟著結論一起被說明。</p>
  </div>

  <h2>四種反事實濃度下的可歸因比例</h2>

  <div class="health-band" data-health-reading-band>
    <section data-health-reading="robust">
      <h2>下降幅度對比較基準穩健</h2>
      <p class="small">
        {headline.first_year} 年是 {n(headline.first_range[0] * 100, 1)}–{
          n(headline.first_range[1] * 100, 1)
        }%，{headline.last_year} 年是 {n(headline.last_range[0] * 100, 1)}–{
          n(headline.last_range[1] * 100, 1)
        }%。<strong>無論選哪個基準，都下降了大約一半到三分之二。</strong>
        這一點跟第五章的政策效應不一樣—那裡的訊號被方法的噪音蓋過去，這裡沒有。
      </p>
    </section>
    <section data-health-reading="sensitive">
      <h2>當前水準對比較基準敏感</h2>
      <p class="small">
        {headline.last_year} 年的答案是 {n(headline.last_range[0] * 100, 1)}% 還是
        {" "}{n(headline.last_range[1] * 100, 1)}%，
        <strong>差了將近一倍</strong>，而唯一的差別是把 {rangeEnds[0].value} 還是
        {" "}{rangeEnds[1].value} μg/m³ 當作比較基準—這是上圖 {series.length} 條
        假設線的兩個極端，落差來自方法選擇，不是來自資料。
      </p>
    </section>
  </div>

  <h2>假設佔估計值的比重隨濃度下降而上升</h2>

  <p>
    上面那個範圍的絕對寬度幾乎沒動（{n(rangeWidths[0], 1)} 到
    {" "}{n(rangeWidths[1], 1)} 個百分點）。
    但它佔估計值的比例幾乎翻了三倍。
  </p>

  <EvidenceFigure number="7.2" title="比較基準造成的落差佔估計值多少？">
    <div class="chart">
      <div
        class="plot"
        data-readout
        style={`--plot-ar:38;--plot-min:230px;--plot-max:360px;--y-w:${yGutter(shareTicks.map((t) => `${n(t * 100, 0)}%`))}px;--y-lo:${yShare.domain[0]};--y-hi:${yShare.domain[1]}`}
      >
    <script
      type="application/json"
      class="plot-readout-data"
      is:inline
      set:html={JSON.stringify({
        x: years.map(String),
        unit: "四種假設的落差",
        places: 1,
        scale: 100,
        suffix: "%",
        series: [
          {
            label: "落差佔估計值的比例",
            colour: "var(--k1)",
            ink: markInk("var(--k1)"),
            values: spreadShare,
          },
        ],
      })}
    />

        <div class="plot-y">
          {shareTicks.map((t) => <span style={`top:${n(yShare(t), 3)}%`}>{axisNumber(n(t * 100, 0))}%</span>)}
        </div>

        <div class="plot-area">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {
              shareTicks.map((t) => (
                <line
                  x1="0"
                  x2="100"
                  y1={n(yShare(t), 3)}
                  y2={n(yShare(t), 3)}
                  class="plot-grid"
                  vector-effect="non-scaling-stroke"
                />
              ))
            }
            <line x1="0" x2="100" y1="100" y2="100" class="plot-axis" vector-effect="non-scaling-stroke" />
            <path d={sharePath} class="plot-line" stroke="var(--c6)" vector-effect="non-scaling-stroke" />
          </svg>

          {
            spreadShare.map((v, i) => (
              <span
                class="plot-pt"
                style={`left:${n(xYear(years[i]), 3)}%;top:${n(yShare(v), 3)}%;color:var(--c6-ink)`}
                title={`${years[i]}: ${n(v * 100, 1)}%`}
              />
            ))
          }
        </div>

        <div class="plot-x" data-n={xTickYears.length} data-tw={xLabelBucket(xTickYears)}>
          {xTickYears.map((y) => <span style={`left:${n(xYear(y), 3)}%`}>{y}</span>)}
        </div>
      </div>
    </div>
    <Fragment slot="caption">
      基準選擇造成的範圍，除以估計值本身。從 {n(headline.first_share * 100, 0)}% 上升到
      {" "}{n(headline.last_share * 100, 0)}%。
    </Fragment>
  </EvidenceFigure>

  <div class="note caveat">
    <p>
      <strong>這是必然的，只是不直覺。</strong>
      可歸因的部分是「濃度超出基準的那一截」。濃度從 32 降到 13，那一截就跟基準本身
      越來越接近—於是「基準要放哪」佔掉的比重越來越大。
    </p>
    <p>
      也就是說：<strong>空氣越乾淨，健康負擔的數字就越取決於一個從未被明說的選擇。</strong>
      這跟「資料變好、估計就變準」的直覺剛好相反。
    </p>
  </div>

  <h2>採用的暴露反應函數</h2>

  {/*
    A table when there is something to compare, a definition block when there is
    not. This ships ONE function, and as a table that single row measured
    826 x 735px inside a 584px column: two cells holding 27 and 16 characters set
    `nowrap`, beside a 253-character citation folded into a 238px column 669px
    tall — and the whole thing scrolling sideways because the two short columns
    would not yield. A row of one is a definition, and a definition can use the
    full measure for its longest part instead of a third of it.
  */}
  {functions.length > 1 ? (
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>結果變數</th>
            <th class="num">每 10 μg/m³ 的相對風險</th>
            <th class="wrap">來源</th>
          </tr>
        </thead>
        <tbody>
          {functions.map((f) => (
            <tr>
              <td lang={langOf(f.outcome)}>{f.outcome}</td>
              <td class="num">
                {n(f.rr_per_10, 3)}
                <span class="dim">
                  {" "}
                  ({n(f.rr_per_10_low, 2)}–{n(f.rr_per_10_high, 2)})
                </span>
              </td>
              <td class="small wrap">
                <a href={f.source_url} target="_blank" rel="noopener">
                  {f.source}
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    functions.map((f) => (
      <dl class="erf">
        <dt>結果變數</dt>
        <dd lang={langOf(f.outcome)}>{f.outcome}</dd>
        <dt>每 10 μg/m³ 的相對風險</dt>
        <dd class="erf-rr">
          {n(f.rr_per_10, 3)}
          <span class="dim">
            {" "}
            ({n(f.rr_per_10_low, 2)}–{n(f.rr_per_10_high, 2)})
          </span>
        </dd>
        {/*
          The citation is text; the link is the DOI.
          
          The whole 253-character string used to be inside the anchor, including
          its last sentence — 「This is the pooled estimate the WHO 2021 global
          air quality guidelines cite…」 — which is this project's remark about
          the paper and not part of the reference. Four underlined lines, and the
          reader could not tell where the source stopped and the commentary
          started. A citation's link is its identifier, so the identifier is what
          carries it.
        */}
        <dt class="erf-src">來源</dt>
        <dd class="erf-src small" lang={langOf(f.source)}>
          {f.source}{" "}
          <a class="url" href={f.source_url} target="_blank" rel="noopener">
            {f.source_url.replace(/^https?:\/\//, "")}
          </a>
        </dd>
      </dl>
    ))
  )}

  <p class="small" lang={langOf(fn.caveat)}>{fn.caveat}</p>

  <div class="note caveat">
    <strong>{n(extrapolation.share_above * 100, 1)}%</strong> 的測站-年落在
    {" "}{n(extrapolation.ceiling_ugm3, 0)} μg/m³ 以上。<span lang={langOf(extrapolation.why)}>{extrapolation.why}</span>
  </div>

  <h2>固定測站樣本</h2>

  <p class="small" lang={langOf(panel.why)}>{panel.why}</p>

  <h2>兩項刻意不做的推論</h2>

  <div class="health-band health-inference-band" data-health-inference-boundaries>
    <section data-health-inference="deaths">
