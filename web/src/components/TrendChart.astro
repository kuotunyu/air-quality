---
import GuideAnnotationView from "./GuideAnnotation.astro";
import {
  axisNumber,
  gapPct,
  smoothPath,
  markInk,
  n,
  padded,
  spreadLabels,
  ticks,
  xLabelBucket,
  yearTicks,
  yGutter,
} from "../lib/chart";
import type { GuideAnnotation } from "../lib/chart";

type Guide = {
  value?: number;
  values?: (number | null)[];
  label: string;
  colour: string;
  annotation?: GuideAnnotation;
  levelColours?: Record<string, string>;
  levelInkColours?: Record<string, string>;
  strokeWidth?: number;
  riserStrokeWidth?: number;
  dash?: string;
  riserColour?: string;
  notePlacement?: "above" | "on-line" | "top-right" | "key";
  noteYear?: number;
  startMilestone?: {
    year: number;
    label: string;
    ariaLabel: string;
  };
};
type LevelPath = { value: number; colour: string; d: string };
type Emphasis = "primary" | "comparison";
type Series = {
  key: string;
  label: string;
  values: (number | null)[];
  colour: string;
  dash?: string;
  emphasis?: Emphasis;
};

interface Props {
  years: number[];
  series: Series[];
  primaryPlot?: boolean;
  /* Chapter 1 keeps the precomputed latest-value panel visible at rest. Other
   * chapters retain the existing disclose-on-focus behaviour. */
  showLatestReadout?: boolean;
  /*
   * A reference line. `value` draws it flat; `values` draws it per year, for a
   * limit that has a history — see the Taiwan PM2.5 standard in chapter 1,
   * which did not exist before 2012 and changed in 2024. A null year is drawn
   * as a gap, the same as any other null on this site: the limit did not exist,
   * so no line is the honest mark.
   */
  guides?: Guide[];
  unit: string;
  /*
   * The chart's shape, not its height.
   *
   * This was `height?: number` — one fixed pixel figure — and a chart with a
   * pinned height and a fluid width has no shape: the same figure measured
   * 1.44:1 at a 1000px viewport and 4.04:1 at 1920. `ar` is the height as a
   * percentage of the plot's own width, so the shape holds at every viewport;
   * `minH` and `maxH` stop it becoming a strip on a phone or a wall on a
   * display. All three go straight to the custom properties `.plot-area` reads.
   */
  ar?: number;
  minH?: number;
  maxH?: number;
  /*
   * What the end-of-line label says.
   *
   * "value" when a legend above already names the series — two or three lines,
   * where the name is cheap to carry and the number is what is being looked
   * for. "named" when there are too many series for a legend to be worth
   * walking: then the label IS the identification and the legend goes away, so
   * nothing on the chart has to be matched to anything beside it.
   */
  legend?: boolean;
  /*
   * Which side of the plot the reference-line labels sit on.
   *
   * They default right, which is where they have always been — and on a chart
   * whose lines END at the right, that is on top of the lines' own last points.
   * Measured on the zone figure when the names were still out there:
   * 「台灣年均標準 15」 landed directly across 「高屏 16.7」 and 「雲嘉南 15.7」.
   * The caller knows which half of its own plot is empty; this component
   * cannot.
   */
  notesAt?: "left" | "right";
  /*
   * Turns the key row into a filter over its own series.
   *
   * Passing this changes nothing about what is drawn — every series ships
   * checked, so the figure a reader arrives at is the figure that was there
   * before — and adds a switch per series. `id` has to be unique on the page
   * because the generated rules below are keyed on it; `label` names the group
   * for a screen reader.
   *
   * The mechanism is a checkbox and `:has()`, with no script anywhere in the
   * path, for the reason recorded on the chapter rail in `Base.astro`: a
   * control that needs JavaScript to work is a control that some readers get
   * as decoration. The one thing that does need script is the crosshair
   * readout, which is script already — see `PlotReadout.astro`.
   */
  pick?: { id: string; label: string };
}

const {
  years,
  series,
  guides = [],
  unit,
  ar = 42,
  minH = 244,
  maxH = 430,
  legend = true,
  notesAt = "right",
  primaryPlot = false,
  showLatestReadout = false,
  pick,
} = Astro.props;

// Everything below is in percent of the plot box, not pixels. The box has no
// width until the browser lays it out, so a percentage is the only coordinate
// that survives being fluid — and the labels, which are HTML, never inherit the
// stretch that gets applied to the marks.
const guideLevel = (g: Guide) => {
  if (g.values) {
    for (let i = g.values.length - 1; i >= 0; i -= 1) {
      const v = g.values[i];
      if (v != null) return v;
    }
    return null;
  }
  return g.value ?? null;
};
const allValues = series
  .flatMap((s) => s.values)
  .concat(guides.flatMap((g) => (g.values ? g.values : [g.value ?? null])));
const [lo, hi] = padded(allValues, { zero: true });

const x = (index: number) => (years.length < 2 ? 50 : (index / (years.length - 1)) * 100);
const y = (value: number) => (1 - (value - lo) / (hi - lo || 1)) * 100;

const yTicks = ticks(lo, hi, 5).filter((t) => t >= 0 && t >= lo && t <= hi);

// Where the axis rule goes: on zero if the scale covers it, otherwise the foot.
const baseline = lo <= 0 && hi >= 0 ? y(0) : 100;

// Astro's parser reads a `<=` in a JSX expression as the start of a fragment,
// so the comparison stays out here.
const visibleGuides = guides.filter((guide) => {
  const level = guideLevel(guide);
  return level != null && level >= lo && level <= hi;
});

/*
 * Years at a round interval — see `yearTicks`. Evenly spaced BY VALUE, which on
 * a consecutive run of years is also evenly spaced by index, so the container
 * query that halves the labels still leaves an even grid behind.
 */
const xTicks = yearTicks(years).map((year) => ({ year, index: years.indexOf(year) }));

/*
 * No end labels.
 *
 * They were the value at the end of each line, then the value plus the name,
 * and the owner is right that at the right-hand edge they were never anything
 * but a stack. The key above the plot carries both the name AND the latest
 * value, so the gutter was printing the same numbers a second time in the worst
 * available position. The whole mechanism — gutter, spread, leaders — is gone,
 * and the plot gets the width back.
 */
/*
 * A limit that changed on a date is a step, not a ramp. Drawn horizontal then
 * vertical, so the year the standard moved shows as the standard moving rather
 * than as twelve months of gradual tightening.
 */
function stepPath(values: (number | null)[]): string {
  const parts: string[] = [];
  let open = false;
  values.forEach((v, i) => {
    if (v == null || !Number.isFinite(v)) {
      open = false;
      return;
    }
    const px = n(x(i), 2);
    const py = n(y(v), 2);
    if (!open) {
      parts.push(`M${px} ${py}`);
    } else {
      parts.push(`H${px}`, `V${py}`);
    }
    open = true;
  });
  return parts.join(" ");
}

/*
 * The vertical connectors of a stepped guide, drawn solid and separately.
 *
 * A dash pattern applied to the whole step makes the drop at 2024 a THIRD dashed
 * mark rather than a transition between two dashed levels — and the run after it
 * is one interval of 27 on an 852.7px plot, about 31.6px, or three and a half
 * dashes sitting under the point where both series terminate. Zoomed in it reads
 * as a small detached box beside the line ends. A solid riser says "the limit
 * moved here"; the levels either side stay dashed because they are still guides.
 */
function stepRisers(values: (number | null)[]): string {
  const parts: string[] = [];
  let prev: { i: number; v: number } | null = null;
  values.forEach((v, i) => {
    if (v == null || !Number.isFinite(v)) {
      prev = null;
      return;
    }
    if (prev && prev.v !== v) {
      parts.push(`M${n(x(i), 2)} ${n(y(prev.v), 2)} V${n(y(v), 2)}`);
    }
    prev = { i, v };
  });
  return parts.join(" ");
}

/*
 * A stepped legal threshold can carry meaning in each horizontal level without
 * turning the vertical change itself into a third threshold. Each same-level
 * run is grouped into one SVG path, but every disconnected run starts with a
 * fresh `M`: a null still breaks the guide and is never bridged.
 */
function stepLevelPaths(
  values: (number | null)[],
  levelColours: Record<string, string>,
  fallbackColour: string,
): LevelPath[] {
  const paths = new Map<string, LevelPath>();
  let previous: { index: number; value: number } | null = null;

  values.forEach((value, index) => {
    if (value == null || !Number.isFinite(value)) {
      previous = null;
      return;
    }
    if (previous) {
      const colour = levelColours[String(previous.value)] ?? fallbackColour;
      const key = `${previous.value}\u0000${colour}`;
      const segment =
        `M${n(x(previous.index), 2)} ${n(y(previous.value), 2)} ` +
        `H${n(x(index), 2)}`;
      const path = paths.get(key);
      if (path) path.d += ` ${segment}`;
      else paths.set(key, { value: previous.value, colour, d: segment });
    }
    previous = { index, value };
  });

  return [...paths.values()];
}

/*
 * Reference-line labels get the same de-overlap the series labels used to.
 *
 * Two limits ten units apart on a 300px plot put two 36px pills 35px apart —
 * measured, a one-pixel collision. The line each one names is still drawn at
 * its true height; only the label moves, which is the same bargain every
 * annotated chart makes.
 */
/* Against the SHORTEST the box can be, not against a nominal height — see
   `gapPct`. A gap solved for a tall plot is no gap at all in a short one. */
const noteY = spreadLabels(
  visibleGuides.map((g) => y(guideLevel(g) as number)),
  gapPct(52),
  [gapPct(26), 100 - gapPct(26)],
);
/*
 * A top-right note is seated in the corner at 16px, matched to its right
 * inset — not floated 8% of the plot's height short of it.
 *
 * The 8% band was measured empty and stayed empty, checked twice on this exact
 * placement: the trend line spends 10.9% of its length in the top-right
 * quadrant and never rises above 45.9% of the right half's height, so nothing
 * the note could ever cover sits in the space it was leaving above itself.
 * Closing it to a flat 16px — the same margin the right side already used —
 * removes about 26px of that dead space on a ~520px plot without the note
 * growing, since the right inset is unchanged; 0 was tried first and read as
 * pinned to the frame's edge rather than seated inside it.
 *
 * This reopens a value `check_site_quality.mjs` had pinned as approved, so it
 * moves there too. No comment anywhere recorded why 8% and not a flat inset was
 * chosen the first time; the owner was asked directly whether the gap was worth
 * keeping and said no.
 */
const guideNoteTop = (guide: Guide, index: number): number =>
  guide.notePlacement === "top-right"
    ? 0
    : guide.notePlacement === "on-line"
      ? y(guideLevel(guide) as number)
      : noteY[index];
const noteX = (guide: Guide): number | null => {
  if (guide.noteYear == null) return null;
  const index = years.indexOf(guide.noteYear);
  return index === -1 ? null : x(index);
};
const milestoneFor = (guide: Guide) => {
  if (!guide.values || !guide.startMilestone) return null;
  const index = years.indexOf(guide.startMilestone.year);
  const value = index === -1 ? null : guide.values[index];
  return index === -1 || value == null
    ? null
    : { ...guide.startMilestone, index, value, left: x(index), top: y(value) };
};

/*
 * The key sits ABOVE the plot, in one row, and this is the fourth place it has
 * been. The three it left, and why:
 *
 *   1. Under the plot — reading it meant leaving the chart.
 *   2. Eight labels stacked at the right edge — but these lines CONVERGE, so
 *      the one place they are least separated is exactly where their names were
 *      piled, with leader lines fanning out of the stack.
 *   3. Inside the plot, in whichever corner scored emptiest. That worked at the
 *      width it was built at and nowhere else: the block's size does not shrink
 *      with the plot, so measured at a 1000px viewport the "corner" block was
 *      427x126 inside a 479x244 plot — 46% of the drawing area, over the 1998
 *      peak, on the figure whose subject is that peak. An emptiest corner is
 *      only a place to stand if something guarantees the block fits in it, and
 *      nothing did.
 *
 * Above the plot has the property the other three lack: it CANNOT collide,
 * at any width, with any data, because it is not over the data. It costs one
 * line of height, it is read on the way in rather than hunted for afterwards,
 * and it keeps the thing that was right about the corner version — each series
 * carries its own latest value, so the key answers "which line" and "how much"
 * in the same glance.
 */
/* The two comparison figures already distinguish their secondary series with
   a dash. That existing mark can supply the visual hierarchy without changing
   ChapterTrend or adding a field to the readout payload; crowded charts keep
   their established uniform weight unless a caller opts in explicitly. */
const emphasisFor = (s: Series): Emphasis | undefined =>
  s.emphasis ?? (series.length === 2 ? (s.dash ? "comparison" : "primary") : undefined);
const hasCustomGuideMark = (guide: Guide): boolean =>
  guide.levelColours != null ||
  guide.levelInkColours != null ||
  guide.strokeWidth != null ||
  guide.riserStrokeWidth != null ||
  guide.dash != null ||
  guide.riserColour != null ||
  guide.notePlacement != null;

const keyed = series.map((s) => {
  let last: number | null = null;
  for (let i = s.values.length - 1; i >= 0; i -= 1) {
    const v = s.values[i];
    if (v != null && Number.isFinite(v)) {
      last = v;
      break;
    }
  }
  return { ...s, last, emphasis: emphasisFor(s) };
});

/*
 * One rule per series, written here because CSS cannot ask "is the switch that
 * shares my index unchecked" and then address a path with that same index.
 *
 * `:has()` is anchored on `.chart` and not on `:root`: the switch ids are
 * unique, so a bare `:root:has(#id-3:not(:checked)) .plot-line` would hide the
 * fourth line of every chart on the page. Anchored on the ancestor both the
 * switch and the line share, only the chart that owns the switch matches.
 *
 * It emits `is:inline` so it stays next to the markup it was generated from
 * rather than being scoped and hoisted — and so `stylesheetText()` in
 * `FigureTools.astro` picks it up from `document.styleSheets`, which is what
 * keeps a filtered figure filtered in its PNG.
 */
const pickCss = pick
  ? series
      .map(
        (_, i) =>
          `.chart:has(#${pick.id}-${i}:not(:checked)) .plot-line[data-series-index="${i}"]` +
          `{display:none}`,
      )
      .join("\n")
  : "";
---

<div
  class:list={["chart", { crowded: series.length > 2, "chart-picked": Boolean(pick) }]}
  data-guide-count={visibleGuides.length}
>
  {/*
    Two rows now, because they are two different kinds of thing.

    The switches are controls and sit outside the frame; the reference line is
    part of the drawing and sits inside it, directly above the plot it is drawn
    on. They shared one row until they were separated, and the dashed entry sat
    between two switches with no box around it — which read as a switch that had
    failed to render rather than as a legend.

    A chart with no picker is unchanged: one row, inside the frame, exactly
    where it has always been.
  */}
  {
    legend && series.length > 1 && pick && (
      <form class="key-form" data-series-picker>
        <style is:inline set:html={pickCss} />
        {/*
          Above the control, not in the caption.

          The caption said this and the caption is under the figure — which is
          the wrong side of a chart to learn that the thing above it can be
          pressed. It states the checkbox's literal effect before the reader
          uses it.
        */}
        <div class="key-filter-bar">
          <div class="key-filter-badge" aria-hidden="true">
            <svg class="key-filter-icon" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1.5 3.5h13M3.5 8h9M6 12.5h4" />
            </svg>
            <span>互動篩選</span>
          </div>
          <p class="key-hint">勾選以顯示空品區；取消勾選會隱藏該線。</p>
        </div>
        <ul class="chart-key chart-key-picker" role="group" aria-label={pick.label}>
          {keyed.map((s, i) => (
            <li class="key-pick" style={`--mark:${s.colour};--mark-ink:${markInk(s.colour)}`}>
              {/*
                The input is moved off-screen, not `display: none`.

                A checkbox that is `display: none` is out of the accessibility
                tree and out of the tab order, so the pill would be a thing only
                a mouse could reach — and `:checked` would still drive the CSS,
                which makes it exactly the class of control this site's station
                picker has a paragraph about: one that looks like it works.
              */}
              <input
                type="checkbox"
                class="key-switch"
                id={`${pick.id}-${i}`}
                checked
                data-series-switch
                data-series-index={i}
              />
              <label class="key-pill" for={`${pick.id}-${i}`}>
                {/*
                  A drawn box, because a tinted chip is a convention and a
                  ticked box is not one — it is the thing itself.

                  It is `aria-hidden` and purely visual: the real checkbox is
                  one element away and already tells a screen reader everything
                  this draws. And it is neutral, never the series colour, so
                  the two marks on a chip answer two different questions —
                  the box says whether it is on, the rule says which line it is.
                */}
                <span class="key-box" aria-hidden="true" />
                <svg class="key-mark" viewBox="0 0 22 8" aria-hidden="true">
                  <line x1="1" y1="4" x2="21" y2="4" stroke={s.colour}
                    stroke-width={s.emphasis === "primary" ? "3" : s.emphasis === "comparison" ? "2.25" : "2.5"}
                    stroke-linecap="round" stroke-dasharray={s.dash} />
                </svg>
                <span class="key-name">{s.label}</span>
                <span class="key-value">{s.last == null ? "—" : n(s.last, 1)}</span>
              </label>
            </li>
          ))}
          {/*
            Only on screen once something is off after enhancement attaches.
            Without JavaScript it stays rendered so native reset never removes
            the focused control from the keyboard path.

            A permanent 「全部顯示」 in a row where everything is already shown
            is a control whose only honest state is "nothing to do", and it
            would cost the row a slot at every width for a reader who never
            touches the switches. `:has()` puts it there the moment it has work
            — which is also why the default figure, the one the gate measures
            and the one a PNG exports, is dimensionally unchanged.
          */}
          <li class="key-reset-item">
            <button type="reset" class="key-reset">
              <svg class="key-reset-icon" viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2.5 8a5.5 5.5 0 1 0 1.6-3.9L2 6.5M2 2.5v4h4" />
              </svg>
              <span>全部顯示</span>
            </button>
          </li>
        </ul>
        {/*
          Its own live region, for the same reason chapter 2's picker has one:
          a screen reader announces the checkbox that changed and nothing about
          what the change did to the chart. This says how many series are left.
        */}
        <p class="visually-hidden" role="status" aria-live="polite" data-pick-say />
      </form>
    )
  }

  {/*
    The frame is drawn around the PLOT, not around the whole chart.

    Only so that a chart whose key row is a control can put that row outside the
    frame — controls belong beside a figure, not inside its drawing surface, and
    a reader scanning for something to press does not look inside a picture.
    `.chart` still generates the box, still carries `container-type`, and is
    still the width everything is measured against; on a figure with no picker
    it also still carries the frame, so nothing else on the site moves.

    The frame moved here rather than onto `.plot` itself for one reason:
    `.plot` is the containing block for every `.plot-note`, and those resolve
    against its PADDING box. Giving it padding would have moved every annotation
    on every chart on the site.
  */}
  <div class="plot-card">
  {/*
    Inside the frame, because this row describes the drawing rather than acting
    on it. On a chart with no picker it is the whole key and this is where the
    key has always been; on one with a picker it is only the reference lines,
    the switches having moved out.
  */}
  {
    legend && series.length > 1 && (!pick || visibleGuides.length > 0) && (
      <ul class="chart-key">
        {!pick &&
          keyed.map((s) => (
            <li style={`--mark:${s.colour};--mark-ink:${markInk(s.colour)}`}>
              <svg class="key-mark" viewBox="0 0 22 8" aria-hidden="true">
                <line x1="1" y1="4" x2="21" y2="4" stroke={s.colour}
                  stroke-width={s.emphasis === "primary" ? "3" : s.emphasis === "comparison" ? "2.25" : "2.5"}
                  stroke-linecap="round" stroke-dasharray={s.dash} />
              </svg>
              <span class="key-name">{s.label}</span>
              <span class="key-value">{s.last == null ? "—" : n(s.last, 1)}</span>
            </li>
          ))}
        {/*
          The reference lines, for the width where their pills cannot be drawn.
          
          Hidden above that width, because there the pill already names the line
          in place and a second copy would be the same sentence twice — which is
          the duplication the pills were introduced to remove.
        */}
        {visibleGuides.map((g) => (
          <li
            class:list={[
              "key-guide",
              {
                "key-guide-on-line": g.notePlacement === "on-line",
                "key-guide-transition": g.annotation?.kind === "transition",
                "key-guide-force-key": g.notePlacement === "key",
              },
            ]}
            style={`--mark:${g.colour};--mark-ink:${markInk(g.colour)}`}
          >
            <svg class="key-mark" viewBox="0 0 22 8" aria-hidden="true">
              <line x1="1" y1="4" x2="21" y2="4" stroke={g.colour} stroke-width="1.5"
                stroke-linecap="round" stroke-dasharray="5 4" />
            </svg>
            {g.annotation ? (
              <GuideAnnotationView
                annotation={g.annotation}
                fallback={g.label}
                layout={
                  g.notePlacement === "key" && g.annotation.kind === "transition"
                    ? "timeline"
                    : "stacked"
                }
                fromMark={
                  g.annotation.kind === "transition"
                    ? g.levelColours?.[g.annotation.fromValue] ?? g.colour
                    : undefined
                }
                fromInk={
                  g.annotation.kind === "transition"
                    ? g.levelInkColours?.[g.annotation.fromValue] ??
                      markInk(g.levelColours?.[g.annotation.fromValue] ?? g.colour)
                    : undefined
                }
                toMark={
                  g.annotation.kind === "transition"
                    ? g.levelColours?.[g.annotation.toValue] ?? g.colour
                    : undefined
                }
                toInk={
                  g.annotation.kind === "transition"
                    ? g.levelInkColours?.[g.annotation.toValue] ??
                      markInk(g.levelColours?.[g.annotation.toValue] ?? g.colour)
                    : undefined
                }
              />
            ) : (
              <span class="key-name">{g.label}</span>
            )}
          </li>
        ))}
      </ul>
    )
  }
  <div
    class="plot"
    data-readout
    data-idle-readout={showLatestReadout || undefined}
    style={`--plot-ar:${ar};--plot-min:${minH}px;--plot-max:${maxH}px;--y-w:${yGutter(yTicks.map((t) => n(t, 0)))}px;--y-lo:${lo};--y-hi:${hi}`}
  >
    {/* The domain and the values, for the readout. Written from the same `lo`,
        `hi` and `series` the marks above were drawn from, so the crosshair
        cannot end up describing a different chart than the one it is over. */}
    <script
      type="application/json"
      class="plot-readout-data"
      is:inline
      set:html={JSON.stringify({
        x: years.map(String),
        unit,
        places: 1,
        series: series.map((s) => ({
          label: s.label,
          colour: s.colour,
          ink: markInk(s.colour),
          dash: s.dash,
          values: s.values,
        })),
      })}
    />
    <div class="plot-y">
      {/* On the axis it measures — always. It used to be the last entry of the
          legend, which put the units in a row of series names at the bottom of
          the figure, a long way from the numbers they belong to; then it moved
          into a legend floated inside the plot, which on a wide chart put it
          830px from its own axis. The unit belongs to the scale. */}
      <span class="y-unit">{unit}</span>
      {yTicks.map((tick) => <span style={`top:${n(y(tick), 3)}%`}>{axisNumber(n(tick, 0))}</span>)}
    </div>

    <div class="plot-area" data-primary-plot={primaryPlot || undefined}>
      <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {
          yTicks.map((tick) => (
            <line
              x1="0"
              x2="100"
              y1={n(y(tick), 3)}
              y2={n(y(tick), 3)}
              class="plot-grid"
              vector-effect="non-scaling-stroke"
            />
          ))
        }

        {/* Guides at 1.5, not 1. `--who` and `--taiwan` both clear 3:1 against
            the card as tokens — measured 3.00 and 6.90 in light, 3.73 and 8.94
            in dark — but a 1px dash antialiases into the ground and the RENDERED
            line does not. The fix is the weight, not the colour: the tokens were
            solved once and are still right. */}
        {/* Figure 1.1 opts into separate legal-level and WHO strokes so those
            three references remain distinct from its two data series. */}
        {
          visibleGuides.map((guide) =>
            hasCustomGuideMark(guide) ? (
              <>
                {guide.values ? (
                  stepLevelPaths(guide.values, guide.levelColours ?? {}, guide.colour).map((path) => (
                    <path
                      d={path.d}
                      fill="none"
                      stroke={path.colour}
                      stroke-width={guide.strokeWidth ?? 1.5}
                      stroke-dasharray={guide.dash ?? "5 4"}
                      stroke-linecap="round"
                      vector-effect="non-scaling-stroke"
                      data-guide-kind="level"
                      data-guide-level={path.value}
                    />
                  ))
                ) : (
                  <path
                    d={`M0 ${n(y(guide.value as number), 3)} L100 ${n(y(guide.value as number), 3)}`}
                    fill="none"
                    stroke={guide.levelColours?.[String(guide.value)] ?? guide.colour}
                    stroke-width={guide.strokeWidth ?? 1.5}
                    stroke-dasharray={guide.dash ?? "5 4"}
                    stroke-linecap="round"
                    vector-effect="non-scaling-stroke"
                    data-guide-kind="level"
                    data-guide-level={guide.value}
                  />
                )}
                {guide.values && (
                  <path
                    d={stepRisers(guide.values)}
                    fill="none"
                    stroke={guide.riserColour ?? guide.colour}
                    stroke-width={guide.riserStrokeWidth ?? guide.strokeWidth ?? 1.5}
                    vector-effect="non-scaling-stroke"
                    data-guide-kind="riser"
                  />
                )}
              </>
            ) : (
              <>
                <path
                  d={guide.values ? stepPath(guide.values) : `M0 ${n(y(guide.value as number), 3)} L100 ${n(y(guide.value as number), 3)}`}
                  fill="none"
                  stroke={guide.colour}
                  stroke-width="1.5"
                  stroke-dasharray="5 4"
                  vector-effect="non-scaling-stroke"
                />
                {guide.values && (
                  <path
                    d={stepRisers(guide.values)}
                    fill="none"
                    stroke={guide.colour}
                    stroke-width="1.5"
                    vector-effect="non-scaling-stroke"
                  />
                )}
              </>
            ),
          )
        }

        {/* On zero when zero is on the scale, at the foot of the box otherwise.
            Drawn at the foot unconditionally it was a rule at whatever value the
            padding happened to leave there — on chapter 1 that was −4.18 μg/m³,
            with the real 0 gridline floating above it. The line a reader takes
            as the origin has to be the origin. */}
        <line
          x1="0"
          x2="100"
          y1={n(baseline, 3)}
          y2={n(baseline, 3)}
          class="plot-axis"
          vector-effect="non-scaling-stroke"
        />

        {
          keyed.map((s, i) => (
            <path
              d={smoothPath(s.values, x, y)}
              data-series-index={i}
              class:list={[
                "plot-line",
                {
                  "emphasis-primary": s.emphasis === "primary",
                  "emphasis-comparison": s.emphasis === "comparison",
                },
              ]}
              stroke={s.colour}
              stroke-dasharray={s.dash}
              vector-effect="non-scaling-stroke"
            />
          ))
        }
      </svg>

      {
        visibleGuides.map((guide) => {
          const milestone = milestoneFor(guide);
          if (!milestone) return null;
          const levelColour = guide.levelColours?.[String(milestone.value)] ?? guide.colour;
          const levelInk = guide.levelInkColours?.[String(milestone.value)] ?? markInk(levelColour);
          return (
            <>
              <span
                class="guide-start-marker"
                data-guide-kind="start-marker"
                data-guide-year={milestone.year}
                aria-hidden="true"
                style={`left:${n(milestone.left, 3)}%;top:${n(milestone.top, 3)}%;--mark:${levelColour}`}
              />
              <span
                class="guide-start-leader"
                data-guide-kind="start-leader"
                aria-hidden="true"
                style={`left:${n(milestone.left, 3)}%;top:${n(milestone.top, 3)}%;--mark:${levelColour}`}
              />
              <span
                class="guide-start-note"
                data-guide-kind="start-note"
                aria-label={milestone.ariaLabel}
                style={`left:${n(milestone.left, 3)}%;top:${n(milestone.top, 3)}%;--mark-ink:${levelInk}`}
              >{milestone.label}</span>
            </>
          );
        })
      }

      {/*
        No data points.

        They were added a round ago on the argument that a line does not say
        where it was measured. The owner's own charts set `showSymbol: false`
        and are far easier to look at, and the reason is visible once counted:
        at 28 years times eight series this figure was drawing 224 dots, and
        every one of them is a corner for the eye to stop on. The measurement
        interval is in the x axis and in the caption, which is where it belongs.
      */}
      {
        visibleGuides.map((guide, gi) => {
          const noteYearX = noteX(guide);
          return (
            <span
              class:list={["plot-note", `note-${notesAt}`, {
                "plot-note-structured": guide.annotation,
                "plot-note-transition": guide.annotation?.kind === "transition",
                "plot-note-on-line": guide.notePlacement === "on-line",
                "plot-note-top-right": guide.notePlacement === "top-right",
                "plot-note-force-key": guide.notePlacement === "key",
                "plot-note-year": noteYearX != null,
              }]}
              style={`top:${n(guideNoteTop(guide, gi), 3)}%;--mark:${guide.colour};--mark-ink:${markInk(guide.colour)}${noteYearX == null ? "" : `;--note-x:${n(noteYearX, 3)}%`}`}
            >
              {guide.annotation ? (
                <GuideAnnotationView
                  annotation={guide.annotation}
                  fallback={guide.label}
                  fromMark={
                    guide.annotation.kind === "transition"
                      ? guide.levelColours?.[guide.annotation.fromValue] ?? guide.colour
                      : undefined
                  }
                  fromInk={
                    guide.annotation.kind === "transition"
                      ? guide.levelInkColours?.[guide.annotation.fromValue] ??
                        markInk(guide.levelColours?.[guide.annotation.fromValue] ?? guide.colour)
                      : undefined
                  }
                  toMark={
                    guide.annotation.kind === "transition"
                      ? guide.levelColours?.[guide.annotation.toValue] ?? guide.colour
                      : undefined
                  }
                  toInk={
                    guide.annotation.kind === "transition"
                      ? guide.levelInkColours?.[guide.annotation.toValue] ??
                        markInk(guide.levelColours?.[guide.annotation.toValue] ?? guide.colour)
                      : undefined
                  }
                />
              ) : (
                guide.label
              )}
            </span>
          );
        })
      }
    </div>

    <div class="plot-x" data-n={xTicks.length} data-tw={xLabelBucket(xTicks.map((t) => t.year))}>
      {xTicks.map(({ year, index }) => <span style={`left:${n(x(index), 3)}%`}>{year}</span>)}
    </div>
  </div>

  {/* Only guides the plot could NOT label in place. A visible one already
      carries its name on the line itself, and listing it again below was the
      same sentence twice — 「台灣年均標準 15」 appeared both across the plot
      and in the legend under it. */}
  {
    guides.filter((g) => !visibleGuides.includes(g)).length > 0 && (
      <div class="legend">
        {guides.filter((g) => !visibleGuides.includes(g)).map((g) => (
          <span class="legend-item">
            <span class="swatch dashed" style={`border-color:${g.colour}`} />
            {g.label}
          </span>
        ))}
      </div>
    )
  }
  </div>
</div>

<script>
  /*
   * Everything visible about this control is CSS — see the generated `:has()`
   * rules and the `.key-pill` block. What is left needs a script and could not
   * have been done without one, so it is all enhancement: a form that must
   * never navigate, a count for a screen reader, and somewhere for focus to go
   * when the button under it is taken away.
   */
  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-series-picker]")) {
    const say = form.querySelector<HTMLElement>("[data-pick-say]");
    const switches = Array.from(form.querySelectorAll<HTMLInputElement>(".key-switch"));
    if (switches.length === 0) continue;

    /*
     * A `<form>` with no `action` submits to the current URL and reloads the
     * page. Nothing in this row should ever navigate, and the row exists at
     * all because `type="reset"` is how a reader without JavaScript gets
     * everything back in one press.
     */
    form.addEventListener("submit", (event) => event.preventDefault());

    const nameOf = (input: HTMLInputElement) =>
      input.nextElementSibling?.querySelector(".key-name")?.textContent?.trim() ?? "";

    const announce = () => {
      if (!say) return;
      const on = switches.filter((input) => input.checked);
      say.textContent =
        on.length === switches.length
          ? `顯示全部 ${switches.length} 條`
          : on.length === 0
            ? "目前未顯示任何空品區"
            : `顯示 ${on.length} 條：${on.map(nameOf).filter(Boolean).join("、")}`;
    };

    form.addEventListener("change", announce);

    /*
     * `reset` fires before the controls are restored, and restoring them fires
     * no `change` of its own — so the count has to be taken on the next frame
     * or it reports the state the reader just left.
     *
     * Focus moves because the button is about to stop existing: the row hides
     * it again the moment nothing is switched off, and a reader who pressed it
     * with the keyboard would be returned to `<body>`, at the top of the
     * document, several screens above the chart they were reading.
     */
    form.addEventListener("reset", () => {
      const hadFocus = document.activeElement?.classList.contains("key-reset");
      requestAnimationFrame(() => {
        announce();
        if (hadFocus) switches[0].focus();
      });
    });

    /* Only hide an idle reset once the focus hand-off above is available. */
    form.classList.add("is-enhanced");
  }
</script>

<style>
  /* See `--plot-cap` on `.plot`: registered so the `em` in its value is resolved
     at the declaring element and inherited as a computed length. */
  @property --plot-cap {
    syntax: "<length>";
    inherits: true;
    initial-value: 0px;
  }

  .chart {
    container-name: trend-chart;
  }

  .plot-line.emphasis-primary {
    stroke-width: 3;
  }

  .plot-line.emphasis-comparison {
    stroke-width: 2.25;
  }

  /*
   * Reference-line labels.
   *
   * They were plain text sitting on the line, which put grey words across the
   * gridlines and the data at whatever height the limit happened to be — the
   * owner's words were "意義不明". Two changes, both taken from the annotation
   * style in their own project (`backgroundColor` + `padding` + `borderRadius`
   * on a markArea label):
   *
   *   1. A pill. The backing lifts the words off whatever is behind them, so
   *      the label reads as an annotation ON the chart rather than as a stray
   *      series that lost its line.
   *   2. It sits ABOVE its own line rather than across it, and carries the
   *      value in the text — a reference line is only worth drawing if the
   *      reader can see what it is worth without hunting for the axis.
   */
  .plot-note {
    padding: 0.12em 0.5em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-sunken) 88%, transparent);
    /* Above the line, not on it. `.plot-note` already translates -100%. */
    margin-top: -0.28em;
  }

  /* WHO is read as a value attached to one exact guide, so it is the explicit
     exception to the default-above rule. The opaque backing interrupts the
     dash before it can run through the glyphs. */
  .plot-note.plot-note-on-line {
    margin-top: 0;
    transform: translateY(-50%);
    background: var(--bg-sunken);
  }

  .plot-note.plot-note-structured {
    padding: 0.42em 0.58em;
    border-radius: 0.55rem;
  }

  /*
   * The bottom of its approved range, not the top.
   *
   * The card is a reference note: it names two dashed lines that are already
   * told apart by colour on the plot. It was `clamp(1.2rem, 1.08rem + 0.4vw,
   * 1.4rem)`, so on a desktop it reached 1.4rem and set its values at 34.5px
   * against a y axis of 24.2 — the note about the data larger than the data's
   * own labels. A flat 1.2rem keeps it inside the range
   * `check_site_quality.mjs` approves (rootSize x 1.2 to x 1.4) and stops it
   * growing past the chart it annotates.
   */
  .plot-note.plot-note-transition {
    font-size: 1.2rem;
  }

  .plot-note.note-left {
    right: auto;
    left: 0.35em;
    text-align: left;
  }

  /*
   * The top-right note is lifted out of the plot and into the band above it.
   *
   * That band is `--plot-cap`: room for the unit label and half the topmost
   * tick, and on this figure both of those live in the leftmost 107px. To the
   * right of them it is empty at every width, and the note was sitting a full
   * band below it with the plot's own top-right corner empty as well — two
   * stacked empty regions where the data has none, because the line falls.
   *
   * It cannot collide with the key row: that row ends at the plot's border box
   * and this starts 16px below it. It cannot collide with the unit either — the
   * note is never left of x=600 at any width where it renders here, and the unit
   * ends at 107.
   */
  .plot-note.plot-note-top-right {
    right: 16px;
    left: auto;
    margin-top: calc(16px - var(--plot-cap));
    transform: none;
    text-align: left;
  }

  .plot-note.plot-note-on-line.note-left {
    right: auto;
    left: clamp(32px, 5%, 48px);
  }

  .plot-note.plot-note-year {
    right: auto;
    left: var(--note-x);
    transform: translate(-50%, -50%);
  }

  .plot-note.plot-note-on-line.note-left.plot-note-year {
    left: var(--note-x);
  }

  .plot-note.plot-note-transition {
    padding-block: 0.12em;
  }

  .plot-note-transition :global(.guide-annotation) {
    gap: 0.06em;
    line-height: 1;
  }

  .plot-note-transition :global(.guide-row) {
    line-height: 1;
  }

  .plot-note-transition :global(.guide-change) {
    font-size: 0.78em;
  }

  .guide-start-marker {
    position: absolute;
    z-index: 1;
    width: 10px;
    height: 10px;
    border: 3px solid var(--mark);
    border-radius: 50%;
    background: var(--bg-sunken);
    transform: translate(-50%, -50%);
  }

  .guide-start-leader {
    position: absolute;
    z-index: 1;
    width: 2px;
    height: 8px;
    margin-top: -5px;
    background: var(--mark);
    transform: translate(-50%, -100%);
  }

  .guide-start-note {
    position: absolute;
    z-index: 1;
    margin-top: -13px;
    padding: 0.1em 0.35em;
    border-radius: 0.25em;
    background: var(--bg-sunken);
    color: var(--mark-ink);
    font-family: var(--font-numeric);
    font-size: var(--chart-label);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    transform: translate(-50%, -100%);
    white-space: nowrap;
  }

  /*
   * The band the unit hangs in.
   *
   * Without it the unit sat in the key row's margin and printed over
   * 「固定樣本（68 站，2006–）」. With a CONSTANT band it still collided, just with
   * something else: the topmost y tick is centred on its own gridline, so half of
   * it hangs above the plot box, and on the zone figure — whose top tick is 70,
   * drawn at the very top of the scale — the unit printed straight through it at
   * every width. The band has to clear half a tick as well as the unit itself,
   * and `--chart-tick` is the size of a tick, so it is the thing to measure
   * against rather than a number chosen once.
   */
  .plot {
    /*
     * Named, and registered as a length below, because two rules depend on it:
     * this padding, and the top-right note that is lifted back into the band it
     * reserves. A plain custom property would carry the `em` as a token and
     * resolve it against whichever element read it — the note's font is larger
     * than the plot's, so it would lift by more than the padding is. `@property`
     * with `syntax: "<length>"` computes it here and inherits the result.
     */
    --plot-cap: calc(1.05em + var(--chart-tick) * 0.95);
    padding-top: var(--plot-cap);
  }

  /* The unit. Anchored to the gutter's LEFT edge and allowed to run right into
     the empty band above the plot; anchored right it grew leftwards instead,
     and 67px of text in a 39px gutter had 15px of card padding to spare at 1920
     and none at 375. */
  .y-unit {
    top: auto;
    /* Above the topmost tick, not above the plot box: the tick is centred on the
       box's own top edge, so half of it is already in this band. */
    bottom: calc(100% + var(--chart-tick) * 0.9);
    left: 0;
    right: auto;
    transform: none;
    font-size: var(--chart-tick);
    color: var(--text-faint);
    white-space: nowrap;
  }

  /*
   * Below this width the pills cannot sit beside their own lines: measured at
   * 375px, both wrap to two lines at 66px tall while the two limits they name
   * are 54px apart on a 300px plot. No amount of nudging fixes an arithmetic
   * shortfall, so at that width the reference lines stay on the plot unlabelled
   * and the caption carries their values.
   *
   * 420px, and px rather than `26rem`, for the reason recorded on the thinning
   * tiers in global.css: `rem` in a container query resolves against this site's
   * fluid root, so the threshold was 601px at a 1000px viewport and this phone
   * rule was what a desktop reader got.
   */
  /*
   * The reference lines are named ON the plot at any width that can hold a pill,
   * and in the key row below it.
   *
   * The old rule just hid the pills under 420px, and its comment said 「the
   * caption carries their values」. No caption does. Measured at 390: all four
   * pills `display: none`, and none of chapter 1's three captions names 15, 12
   * or 5 — so on a phone the figure drew two unexplained dashed lines and the
   * standard they represent appeared nowhere on the page. The swap is a swap now.
   */
  .chart-key .key-guide {
    display: none;
  }

  /* Some plots use the same legal transition but have data in the top-right
     band. Placement is an explicit chart decision so the static page, no-JS
     rendering and PNG export all agree about where the legend lives. */
  .plot-note.plot-note-force-key {
    display: none;
  }

  /*
   * A transition card in the key row takes the row's right edge and a 23rem
   * register, whichever is narrower.
   *
   * This used to hang off `key-guide-force-key`, i.e. off one figure declaring
   * it would live in the key at every width. It belongs to the position, not to
   * the figure: any card that has swapped into the key row is the widest thing
   * in it, and left at its content width it sat mid-row with the series names
   * on one side and a gap on the other. Both figures reach this state now, at
   * the widths where the corner cannot hold the card.
   */
  .chart-key .key-guide-transition,
  .chart-key .key-guide-force-key {
    box-sizing: border-box;
    inline-size: min(23rem, 100%);
    margin-inline-start: auto;
    container-type: inline-size;
  }

  .chart-key .key-guide-force-key {
    display: list-item;
  }

  .chart-key .key-guide-transition {
    padding: 0.72em 0.85em;
    text-indent: 0;
  }

  .plot-note.plot-note-transition,
  .chart-key .key-guide-transition {
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: var(--bg-raised);
    box-shadow: none;
  }

  .plot-note.plot-note-transition {
    padding: 0.72em 0.82em;
  }

  .chart-key .key-guide-transition > .key-mark {
    display: none;
  }

  /*
   * 480 rather than 420, because the pill is a fixed 260px and the question is
   * what fraction of the plot it covers. Measured by walking each series at 200
   * points and testing them against the pill's box: at a 476px chart — a 540
   * viewport, the first width the old threshold let pills through — 11 and 17
   * points of a line were behind the label. At 535 and every width above it,
   * zero. The threshold now sits between those two.
   */
  @container trend-chart (max-width: 480px) {
    .plot-note {
      display: none;
    }
    .plot-note.plot-note-on-line {
      display: block;
    }
    .chart-key .key-guide {
      display: list-item;
    }
    .chart-key .key-guide-on-line {
      display: none;
    }
  }

  /* Figure 1.1's enlarged timeline and start label cannot share the
     intermediate plot without covering the series or each other. The start
     label hides first, then the complete timeline moves to the key at the next
     narrow tier; its 2012 marker remains on the plot. */
  @container (max-width: 720px) {
    .guide-start-leader,
    .guide-start-note {
      display: none;
    }
  }

  @container trend-chart (max-width: 888px) {
    .plot-note.plot-note-transition {
      display: none;
    }
    .chart-key .key-guide-transition {
      display: list-item;
    }
  }

  @container trend-chart (min-width: 888.01px) and (max-width: 40em) {
    .plot-note.plot-note-transition {
      display: none;
    }
    .chart-key .key-guide-transition {
      display: list-item;
    }
    .plot-note.plot-note-on-line {
      display: none;
    }
    .chart-key .key-guide-on-line {
      display: list-item;
    }
    .guide-start-leader,
    .guide-start-note {
      display: none;
    }
  }

  /*
   * A plot with more than two lines has no empty band to put a label in, at any
   * width, so it swaps whatever the container query says.
   *
   * Measured on chapter 1's eight-region figure by walking each series path at
   * 200 points and testing them against the pill's box: 86 of 200 points of one
   * line fell INSIDE 「台灣年均標準 15 → 12」 at 640, 82 at 1000 and 15 at 1440.
   * The pill is opaque, so that is not an overlap — it is the pill drawn on top
   * of half a series. The two single-line figures on the same page collide with
   * nothing at any width and keep their pills.
   *
   * Two, not one, because the standard sits at 15 and one line can be read
   * around; eight lines converging into the 8–17 band it names cannot.
   */
  .crowded .plot-note {
    display: none;
  }

  .crowded .chart-key .key-guide {
    display: list-item;
  }

  .swatch.dashed {
    background: transparent;
    border-bottom: 2px dashed;
    height: 0;
    border-radius: 0;
  }

  .unit {
    color: var(--text-faint);
    font-family: var(--font-numeric);
  }

  /*
   * ---------- the key row as a filter ----------
   *
   * The row was already eight names, eight colours and eight numbers. Adding a
   * separate strip of buttons underneath it would have printed those eight
   * names twice — the duplication the reference-line pills were introduced to
   * remove — so the legend IS the control. Nothing new is named; the thing that
   * already identified a line is now the thing that switches it.
   *
   * The generated inline rules above map each native checkbox directly to its
   * own SVG path. Unchecked means absent, matching the control's literal
   * semantics while leaving the axes and reference guide in place.
   */
  /*
   * ---------- the control steps outside the frame ----------
   *
   * Asked for, and right: a row of things to press does not belong on a
   * figure's drawing surface. Inside the card it read as part of the picture —
   * the same grey ground as the plot, inset by the card's own padding, sitting
   * where the data sits. Outside it, on the page's ground and flush with the
   * figure's left edge, it reads as what it is.
   *
   * Only charts that were given a picker move. `.chart` still generates the
   * box and still carries `container-type`, so every measurement and every
   * container query on this component is unchanged; the frame simply moved one
   * level in, onto `.plot-card`.
   */
  .chart-picked {
    border: 0;
    border-radius: 0;
    padding: 0;
    background-color: transparent;
  }

  .chart-picked > .plot-card {
    border: 1px solid var(--line);
