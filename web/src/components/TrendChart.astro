---
import {
  linePath,
  smoothPath,
  markInk,
  n,
  padded,
  points,
  spreadLabels,
  ticks,
  yGutter,
} from "../lib/chart";

type Guide = { value?: number; values?: (number | null)[]; label: string; colour: string };

interface Props {
  years: number[];
  series: { key: string; label: string; values: (number | null)[]; colour: string; dash?: string }[];
  /*
   * A reference line. `value` draws it flat; `values` draws it per year, for a
   * limit that has a history — see the Taiwan PM2.5 standard in chapter 1,
   * which did not exist before 2012 and changed in 2024. A null year is drawn
   * as a gap, the same as any other null on this site: the limit did not exist,
   * so no line is the honest mark.
   */
  guides?: Guide[];
  unit: string;
  height?: number;
  /*
   * What the end-of-line label says.
   *
   * "value" when a legend above already names the series — two or three lines,
   * where the name is cheap to carry and the number is what is being looked
   * for. "named" when there are too many series for a legend to be worth
   * walking: then the label IS the identification and the legend goes away, so
   * nothing on the chart has to be matched to anything beside it.
   */
  legend?: boolean;
  /*
   * Which side of the plot the reference-line labels sit on.
   *
   * They default right, which is where they have always been — and on a chart
   * whose lines END at the right, that is on top of the end labels. Measured on
   * the zone figure: 「台灣年均標準 15」 landed directly across 「高屏 16.7」 and
   * 「雲嘉南 15.7」. The caller knows which half of its own plot is empty; this
   * component cannot.
   */
  notesAt?: "left" | "right";
}

const {
  years,
  series,
  guides = [],
  unit,
  height = 300,
  legend = true,
  notesAt = "right",
} = Astro.props;

// Everything below is in percent of the plot box, not pixels. The box has no
// width until the browser lays it out, so a percentage is the only coordinate
// that survives being fluid — and the labels, which are HTML, never inherit the
// stretch that gets applied to the marks.
const guideLevel = (g: Guide) => {
  if (g.values) {
    for (let i = g.values.length - 1; i >= 0; i -= 1) {
      const v = g.values[i];
      if (v != null) return v;
    }
    return null;
  }
  return g.value ?? null;
};
const allValues = series
  .flatMap((s) => s.values)
  .concat(guides.flatMap((g) => (g.values ? g.values : [g.value ?? null])));
const [lo, hi] = padded(allValues, { zero: true });

const x = (index: number) => (years.length < 2 ? 50 : (index / (years.length - 1)) * 100);
const y = (value: number) => (1 - (value - lo) / (hi - lo || 1)) * 100;

const yTicks = ticks(lo, hi, 5).filter((t) => t >= 0 && t >= lo && t <= hi);

// Astro's parser reads a `<=` in a JSX expression as the start of a fragment,
// so the comparison stays out here.
const visibleGuides = guides.filter((guide) => {
  const level = guideLevel(guide);
  return level != null && level >= lo && level <= hi;
});

// Nine labels, evenly spaced, first and last included by construction rather
// than by a special case. The old rule kept every nth year and then forced the
// last one on the end, which put two labels a couple of pixels apart whenever
// the record length was not a multiple of the step. Odd counts also let the
// container query halve them without losing the ends — see `.plot-x`.
const labelCount = Math.min(9, years.length);
const xTicks = Array.from({ length: labelCount }, (_, k) => {
  const index = Math.round((k * (years.length - 1)) / Math.max(labelCount - 1, 1));
  return { year: years[index], index };
});

/*
 * No end labels.
 *
 * They were the value at the end of each line, then the value plus the name,
 * and the owner is right that at the right-hand edge they were never anything
 * but a stack. With the legend now inside the plot carrying both the name AND
 * the latest value, the gutter was printing the same numbers a second time in
 * the worst available position. The whole mechanism — gutter, spread, leaders
 * — is gone, and the plot gets the width back.
 */
/*
 * A limit that changed on a date is a step, not a ramp. Drawn horizontal then
 * vertical, so the year the standard moved shows as the standard moving rather
 * than as twelve months of gradual tightening.
 */
function stepPath(values: (number | null)[]): string {
  const parts: string[] = [];
  let open = false;
  values.forEach((v, i) => {
    if (v == null || !Number.isFinite(v)) {
      open = false;
      return;
    }
    const px = n(x(i), 2);
    const py = n(y(v), 2);
    if (!open) {
      parts.push(`M${px} ${py}`);
    } else {
      parts.push(`H${px}`, `V${py}`);
    }
    open = true;
  });
  return parts.join(" ");
}

/*
 * Reference-line labels get the same de-overlap the series labels used to.
 *
 * Two limits ten units apart on a 300px plot put two 36px pills 35px apart —
 * measured, a one-pixel collision. The line each one names is still drawn at
 * its true height; only the label moves, which is the same bargain every
 * annotated chart makes.
 */
const noteY = spreadLabels(
  visibleGuides.map((g) => y(guideLevel(g) as number)),
  (38 / height) * 100,
  [(19 / height) * 100, 100 - (19 / height) * 100],
);

/*
 * Where the legend goes, decided by looking at the data rather than by me.
 *
 * It has been in three wrong places. Under the plot, where reading it meant
 * leaving the chart. Then as eight labels stacked at the right edge — but these
 * lines CONVERGE, so the one place they are least separated is exactly where I
 * was piling their names, and the result was a wall of text with leaders fanning
 * out of it. Meanwhile the chart had a quarter of itself standing empty.
 *
 * So: score the four corners by how much data actually falls in them, and put
 * the block in the emptiest. A corner is scored on every drawn point plus the
 * reference lines, because a guide crossing the box is just as much in the way
 * as a series is.
 *
 * The box is deliberately generous (46% x 48%). Under-reserving would let the
 * legend sit "in an empty corner" while its last row overlapped a line, which
 * is the failure this is meant to end.
 */
const CORNERS = [
  { at: "tl", x0: 0, x1: 46, y0: 0, y1: 48 },
  { at: "tr", x0: 54, x1: 100, y0: 0, y1: 48 },
  { at: "bl", x0: 0, x1: 46, y0: 52, y1: 100 },
  { at: "br", x0: 54, x1: 100, y0: 52, y1: 100 },
] as const;

const occupancy = (box: (typeof CORNERS)[number]) => {
  let hits = 0;
  const inside = (px: number, py: number) =>
    px >= box.x0 && px <= box.x1 && py >= box.y0 && py <= box.y1;
  series.forEach((s) =>
    s.values.forEach((v, i) => {
      if (v != null && Number.isFinite(v) && inside(x(i), y(v))) hits += 1;
    }),
  );
  visibleGuides.forEach((g) => {
    const level = guideLevel(g);
    if (level == null) return;
    // A flat guide spans the whole width, so it is in the box whenever its
    // height is; a stepped one is checked year by year.
    if (g.values) {
      g.values.forEach((v, i) => {
        if (v != null && inside(x(i), y(v))) hits += 1;
      });
    } else if (y(level) >= box.y0 && y(level) <= box.y1) {
      hits += 4;
    }
  });
  return hits;
};

const legendAt = [...CORNERS].sort((a, b) => occupancy(a) - occupancy(b))[0].at;

---

<div class="chart">
  <div
    class="plot"
    style={`--plot-h:${height}px;--y-w:${yGutter(yTicks.map((t) => n(t, 0)))}px`}
  >
    <div class="plot-y">
      {/* On the axis it measures. It used to be the last entry of the legend,
          which put the units in a row of series names at the bottom of the
          figure — a long way from the numbers they belong to. */}
      {!(legend && series.length > 1) && <span class="y-unit">{unit}</span>}
      {yTicks.map((tick) => <span style={`top:${n(y(tick), 3)}%`}>{n(tick, 0)}</span>)}
    </div>

    <div class="plot-area">
      <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {
          yTicks.map((tick) => (
            <line
              x1="0"
              x2="100"
              y1={n(y(tick), 3)}
              y2={n(y(tick), 3)}
              class="plot-grid"
              vector-effect="non-scaling-stroke"
            />
          ))
        }

        {
          visibleGuides.map((guide) => (
            <path
              d={guide.values ? stepPath(guide.values) : `M0 ${n(y(guide.value as number), 3)} L100 ${n(y(guide.value as number), 3)}`}
              fill="none"
              stroke={guide.colour}
              stroke-width="1"
              stroke-dasharray="5 4"
              vector-effect="non-scaling-stroke"
            />
          ))
        }

        <line x1="0" x2="100" y1="100" y2="100" class="plot-axis" vector-effect="non-scaling-stroke" />

        {
          series.map((s) => (
            <path
              d={smoothPath(s.values, x, y)}
              class="plot-line"
              stroke={s.colour}
              stroke-dasharray={s.dash}
              vector-effect="non-scaling-stroke"
            />
          ))
        }
      </svg>

      {/*
        No data points.

        They were added a round ago on the argument that a line does not say
        where it was measured. The owner's own charts set `showSymbol: false`
        and are far easier to look at, and the reason is visible once counted:
        at 28 years times eight series this figure was drawing 224 dots, and
        every one of them is a corner for the eye to stop on. The measurement
        interval is in the x axis and in the caption, which is where it belongs.
      */}
      {
        visibleGuides.map((guide, gi) => (
          <span class={`plot-note note-${notesAt}`} style={`top:${n(noteY[gi], 3)}%;--mark:${guide.colour};--mark-ink:${markInk(guide.colour)}`}>
            {guide.label}
          </span>
        ))
      }
    </div>

    {/* The block the corner scoring chose. Name, its own colour, and the
        latest value — so the legend answers "which line" and "how much" in
        one place, inside the chart, where the chart is empty. */}
    {
      legend && series.length > 1 && (
        <div class={`plot-legend at-${legendAt}`} data-rows={series.length > 5 ? "many" : "few"}>
          <p class="plot-legend-unit">{unit}</p>
          <ul>
            {series.map((s) => {
              let last: number | null = null;
              for (let i = s.values.length - 1; i >= 0; i -= 1) {
                const v = s.values[i];
                if (v != null && Number.isFinite(v)) {
                  last = v;
                  break;
                }
              }
              return (
                <li style={`--mark:${s.colour};--mark-ink:${markInk(s.colour)}`}>
                  <span class="plot-legend-swatch" />
                  <span class="plot-legend-name">{s.label}</span>
                  <span class="plot-legend-value">{last == null ? "—" : n(last, 1)}</span>
                </li>
              );
            })}
            {visibleGuides.map((g) => (
              <li class="guide-row" style={`--mark:${g.colour};--mark-ink:${markInk(g.colour)}`}>
                <span class="plot-legend-swatch dashed" />
                <span class="plot-legend-name">{g.label}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="plot-x" data-n={xTicks.length}>
      {xTicks.map(({ year, index }) => <span style={`left:${n(x(index), 3)}%`}>{year}</span>)}
    </div>
  </div>

  <div class="legend">
    {/* Everything is named inside the plot now — series in the in-plot legend,
        reference lines on their own lines. This row only ever holds a guide the
        plot could not label, which on these charts means none. */}
    {/* Series are named inside the plot, in whichever corner the data left
        free, so nothing about them belongs down here any more. */}
    {/* Only guides the plot could NOT label in place. A visible one already
        carries its name on the line itself, and listing it again below was the
        same sentence twice — 「台灣年均標準 15」 appeared both across the plot
        and in the legend under it. */}
    {
      guides.filter((g) => !visibleGuides.includes(g)).map((g) => (
        <span class="legend-item">
          <span class="swatch dashed" style={`border-color:${g.colour}`} />
          {g.label}
        </span>
      ))
    }

  </div>
</div>

<style>
  /*
   * Reference-line labels.
   *
   * They were plain text sitting on the line, which put grey words across the
   * gridlines and the data at whatever height the limit happened to be — the
   * owner's words were "意義不明". Two changes, both taken from the annotation
   * style in their own project (`backgroundColor` + `padding` + `borderRadius`
   * on a markArea label):
   *
   *   1. A pill. The backing lifts the words off whatever is behind them, so
   *      the label reads as an annotation ON the chart rather than as a stray
   *      series that lost its line.
   *   2. It sits ABOVE its own line rather than across it, and carries the
   *      value in the text — a reference line is only worth drawing if the
   *      reader can see what it is worth without hunting for the axis.
   */
  .plot-note {
    padding: 0.12em 0.5em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-sunken) 88%, transparent);
    /* Above the line, not on it. `.plot-note` already translates -100%. */
    margin-top: -0.28em;
  }

  .plot-note.note-left {
    right: auto;
    left: 0.35em;
    text-align: left;
  }

  /* The unit, when there is no in-plot legend to carry it. Anchored to the
     gutter's LEFT edge and allowed to run right into the empty band above the
     plot; anchored right it grew leftwards instead, and 67px of text in a 39px
     gutter had 15px of card padding to spare at 1920 and none at 375. */
  .y-unit {
    top: auto;
    bottom: calc(100% + 0.35em);
    left: 0;
    right: auto;
    transform: none;
    font-size: var(--chart-tick);
    color: var(--text-faint);
    white-space: nowrap;
  }

  /*
   * The legend, inside the plot, in whichever corner the data left free — the
   * corner is scored in the frontmatter, not chosen here.
   *
   * Positioned against `.plot`, so the offsets step over the gutters that
   * `.plot-area` sits between: `--y-w` on the left, `--key-w` on the right, and
   * the x-axis row underneath. Both are inline custom properties set by this
   * component, so the arithmetic cannot drift from the grid it describes.
   */
  .plot-legend {
    position: absolute;
    z-index: 1;
    padding: 0.45rem 0.7rem;
    border-radius: calc(var(--radius) - 4px);
    background: color-mix(in srgb, var(--bg-sunken) 86%, transparent);
    line-height: 1.35;
  }

  .plot-legend.at-tl { top: 0; left: calc(var(--y-w, 0px) + var(--space-2)); }
  .plot-legend.at-tr { top: 0; right: calc(var(--key-w, 0px) + var(--space-2)); }
  .plot-legend.at-bl { bottom: calc(1.5em + var(--space-1)); left: calc(var(--y-w, 0px) + var(--space-2)); }
  .plot-legend.at-br { bottom: calc(1.5em + var(--space-1)); right: calc(var(--key-w, 0px) + var(--space-2)); }

  .plot-legend-unit {
    margin: 0 0 0.25rem;
    font-size: var(--text-sm);
    color: var(--text-faint);
    font-family: var(--font-numeric);
  }

  .plot-legend ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* Grid items stretch by default, so each row took the block's full width
       and the block took its widest possible row — 333px inside a 259px plot. */
    justify-items: start;
    gap: 0.1rem 1rem;
    grid-template-columns: auto;
  }

  /* Two columns once the list is long enough to read as a wall rather than a
     list. Eight in one column is a wall; two fours is a block. */
  .plot-legend[data-rows="many"] ul {
    grid-auto-flow: column;
    grid-template-rows: repeat(4, auto);
  }

  .plot-legend li {
    display: grid;
    grid-template-columns: 0.7em auto auto;
    align-items: baseline;
    gap: 0 0.45em;
    font-size: var(--chart-label);
    color: var(--mark-ink);
    white-space: nowrap;
  }

  .plot-legend-swatch {
    width: 0.7em;
    height: 0.7em;
    border-radius: 2px;
    background: var(--mark);
  }

  .plot-legend-swatch.dashed {
    background: none;
    border-bottom: 2px dashed var(--mark);
    height: 0;
    border-radius: 0;
    align-self: center;
  }

  /*
   * The reference lines are named on the plot at any width that can hold a
   * pill, so this row is the narrow fallback and nothing else.
   */
  /* `.plot-legend li` is class-plus-element and out-specifies a bare class, so
     this has to match at least as hard or the row never hides. */
  .plot-legend li.guide-row {
    display: none;
  }

  .plot-legend-value {
    font-family: var(--font-numeric);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    justify-self: end;
  }

  /*
   * A phone has no empty corner to give. Measured at 375px: the plot area is
   * 200px wide and an eight-row block is 338px, so "in the emptiest corner"
   * became "hanging out of both sides of the chart". Below the width the rest
   * of this chart reflows at, the legend stops floating and becomes a row —
   * the same move the other charts' `.plot-keys` makes, for the same reason.
   *
   * This block is LAST on purpose. An earlier version sat above the base rules
   * it was overriding, so at equal specificity the base won and only the
   * declarations with no base counterpart took effect.
   */
  @container (max-width: 26rem) {
    .plot-legend {
      position: static;
      grid-area: 4 / 1 / auto / -1;
      margin-top: var(--space-2);
      padding: 0;
      background: none;
    }

    .plot-legend ul,
    .plot-legend[data-rows="many"] ul {
      display: flex;
      flex-wrap: wrap;
      grid-auto-flow: row;
      gap: var(--space-1) var(--space-3);
    }

    /* `nowrap` is right beside a plot, where a wrapped label would step on the
       data. Down here the block is in the flow with nothing under it, and one
       label genuinely cannot fit: 「固定樣本（68 站，2006–）」 measures 294px
       against a 259px plot, which is what was pushing the page sideways. */
    .plot-legend li {
      white-space: normal;
    }

    .plot-legend-name {
      overflow-wrap: anywhere;
    }

    /*
     * Below this width the pills cannot sit beside their own lines: measured
     * at 375px, both wrap to two lines at 66px tall while the two limits they
     * name are 54px apart on a 300px plot. No amount of nudging fixes an
     * arithmetic shortfall, so the labels move into the legend, where a row
     * costs nothing, and the dashed lines stay on the plot unlabelled.
     */
    .plot-note {
      display: none;
    }

    .plot-legend li.guide-row {
      display: grid;
    }

  }

  .swatch.dashed {
    background: transparent;
    border-bottom: 2px dashed;
    height: 0;
    border-radius: 0;
  }

  .unit {
    color: var(--text-faint);
    font-family: var(--font-numeric);
  }
</style>
