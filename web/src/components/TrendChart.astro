---
import {
  labelGutter,
  linePath,
  markInk,
  n,
  padded,
  points,
  spreadLabels,
  ticks,
  yGutter,
} from "../lib/chart";

interface Props {
  years: number[];
  series: { key: string; label: string; values: (number | null)[]; colour: string; dash?: string }[];
  guides?: { value: number; label: string; colour: string }[];
  unit: string;
  height?: number;
}

const { years, series, guides = [], unit, height = 300 } = Astro.props;

// Everything below is in percent of the plot box, not pixels. The box has no
// width until the browser lays it out, so a percentage is the only coordinate
// that survives being fluid — and the labels, which are HTML, never inherit the
// stretch that gets applied to the marks.
const allValues = series.flatMap((s) => s.values).concat(guides.map((g) => g.value));
const [lo, hi] = padded(allValues, { zero: true });

const x = (index: number) => (years.length < 2 ? 50 : (index / (years.length - 1)) * 100);
const y = (value: number) => (1 - (value - lo) / (hi - lo || 1)) * 100;

const yTicks = ticks(lo, hi, 5).filter((t) => t >= 0 && t >= lo && t <= hi);

// Astro's parser reads a `<=` in a JSX expression as the start of a fragment,
// so the comparison stays out here.
const visibleGuides = guides.filter((guide) => guide.value >= lo && guide.value <= hi);

// Nine labels, evenly spaced, first and last included by construction rather
// than by a special case. The old rule kept every nth year and then forced the
// last one on the end, which put two labels a couple of pixels apart whenever
// the record length was not a multiple of the step. Odd counts also let the
// container query halve them without losing the ends — see `.plot-x`.
const labelCount = Math.min(9, years.length);
const xTicks = Array.from({ length: labelCount }, (_, k) => {
  const index = Math.round((k * (years.length - 1)) / Math.max(labelCount - 1, 1));
  return { year: years[index], index };
});

/*
 * Where each line ends, written at the end of the line.
 *
 * This component had no key gutter at all — its only identifier was the legend
 * under the plot, so knowing which line was which meant holding a colour in
 * your head and looking away from the chart to spend it. That is most of why
 * "the colours are too similar" hurt as much as it did: hue was carrying the
 * entire join between a name and a line, and the reader had to make that join
 * by memory. Four other components on this site already use `.plot-keys`; this
 * one, which draws the chapter's headline figures, never did.
 *
 * The label is the VALUE, not the name. The legend above already gives names,
 * and the number is the thing a reader is looking for anyway — so the two do
 * different jobs instead of saying the same word twice.
 *
 * Last reported rather than last in the array: a series that stops early ends
 * where its data ends, and putting its label at a null would silently move it.
 */
const keys = series
  .map((s) => {
    for (let i = s.values.length - 1; i >= 0; i -= 1) {
      const value = s.values[i];
      if (value != null && Number.isFinite(value)) return { series: s, value };
    }
    return null;
  })
  .filter((k): k is { series: Props["series"][number]; value: number } => k != null);

// `spreadLabels` works in the caller's units, and these are percentages of the
// plot box — so the 26px minimum gap has to be converted to one.
const keyY = spreadLabels(
  keys.map((k) => y(k.value)),
  (26 / height) * 100,
);
const keyWidth = labelGutter(keys.map((k) => n(k.value, 1)));
---

<div class="chart">
  <div
    class="plot"
    style={`--plot-h:${height}px;--y-w:${yGutter(yTicks.map((t) => n(t, 0)))}px;--key-w:${keyWidth}px`}
  >
    <div class="plot-y">
      {yTicks.map((tick) => <span style={`top:${n(y(tick), 3)}%`}>{n(tick, 0)}</span>)}
    </div>

    <div class="plot-area">
      <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {
          yTicks.map((tick) => (
            <line
              x1="0"
              x2="100"
              y1={n(y(tick), 3)}
              y2={n(y(tick), 3)}
              class="plot-grid"
              vector-effect="non-scaling-stroke"
            />
          ))
        }

        {
          visibleGuides.map((guide) => (
            <line
              x1="0"
              x2="100"
              y1={n(y(guide.value), 3)}
              y2={n(y(guide.value), 3)}
              stroke={guide.colour}
              stroke-width="1"
              stroke-dasharray="5 4"
              vector-effect="non-scaling-stroke"
            />
          ))
        }

        <line x1="0" x2="100" y1="100" y2="100" class="plot-axis" vector-effect="non-scaling-stroke" />

        {
          series.map((s) => (
            <path
              d={linePath(s.values, x, y)}
              class="plot-line"
              stroke={s.colour}
              stroke-dasharray={s.dash}
              vector-effect="non-scaling-stroke"
            />
          ))
        }
      </svg>

      {/*
        Data points, as HTML rather than `<circle>`. The marks layer is
        stretched by `preserveAspectRatio="none"`, which turns a circle into an
        ellipse; a span with `border-radius: 50%` stays round by construction —
        the same reason `.plot-pt` exists for the other charts.

        They matter more than they look: a line alone does not say where it was
        measured, so a reader cannot tell an annual series from a smooth curve
        drawn through it.
      */}
      {
        series.map((s) =>
          points(s.values, x, y).map((pt) => (
            <span
              class="plot-pt"
              style={`left:${n(pt.x, 3)}%;top:${n(pt.y, 3)}%;color:${s.colour}`}
            />
          )),
        )
      }

      {
        visibleGuides.map((guide) => (
          <span class="plot-note" style={`top:${n(y(guide.value), 3)}%;--mark:${guide.colour};--mark-ink:${markInk(guide.colour)}`}>
            {guide.label}
          </span>
        ))
      }
    </div>

    <div class="plot-keys">
      {
        keys.map((k, i) => (
          <span
            style={`top:${n(keyY[i], 3)}%;--mark:${k.series.colour};--mark-ink:${markInk(k.series.colour)}`}
          >
            {n(k.value, 1)}
          </span>
        ))
      }
    </div>

    <div class="plot-x" data-n={xTicks.length}>
      {xTicks.map(({ year, index }) => <span style={`left:${n(x(index), 3)}%`}>{year}</span>)}
    </div>
  </div>

  <div class="legend">
    {
      series.map((s) => (
        <span class="legend-item">
          <span class="swatch" style={`background:${s.colour}`} />
          {s.label}
        </span>
      ))
    }
    {
      guides.map((g) => (
        <span class="legend-item">
          <span class="swatch dashed" style={`border-color:${g.colour}`} />
          {g.label}
        </span>
      ))
    }
    <span class="legend-item unit">{unit}</span>
  </div>
</div>

<style>
  /*
   * The end labels are an annotation of where a line ENDS, so they only exist
   * while they can sit there.
   *
   * Below 26rem `global.css` turns `.plot-keys` from a column into a flow row
   * under the plot, which is right for the components that put series NAMES in
   * it — a name is still a name in a row. These are bare values, and a row of
   * bare numbers beside a legend that already names every series is two things
   * saying half a sentence each. The numbers are in the prose either way.
   */
  @container (max-width: 26rem) {
    .plot-keys {
      display: none;
    }
  }

  .swatch.dashed {
    background: transparent;
    border-bottom: 2px dashed;
    height: 0;
    border-radius: 0;
  }
  .unit {
    color: var(--text-faint);
    font-family: var(--font-numeric);
  }
</style>
