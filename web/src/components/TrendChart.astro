---
import {
  gapPct,
  smoothPath,
  markInk,
  n,
  padded,
  spreadLabels,
  ticks,
  xLabelBucket,
  yearTicks,
  yGutter,
} from "../lib/chart";

type Guide = { value?: number; values?: (number | null)[]; label: string; colour: string };

interface Props {
  years: number[];
  series: { key: string; label: string; values: (number | null)[]; colour: string; dash?: string }[];
  /*
   * A reference line. `value` draws it flat; `values` draws it per year, for a
   * limit that has a history — see the Taiwan PM2.5 standard in chapter 1,
   * which did not exist before 2012 and changed in 2024. A null year is drawn
   * as a gap, the same as any other null on this site: the limit did not exist,
   * so no line is the honest mark.
   */
  guides?: Guide[];
  unit: string;
  /*
   * The chart's shape, not its height.
   *
   * This was `height?: number` — one fixed pixel figure — and a chart with a
   * pinned height and a fluid width has no shape: the same figure measured
   * 1.44:1 at a 1000px viewport and 4.04:1 at 1920. `ar` is the height as a
   * percentage of the plot's own width, so the shape holds at every viewport;
   * `minH` and `maxH` stop it becoming a strip on a phone or a wall on a
   * display. All three go straight to the custom properties `.plot-area` reads.
   */
  ar?: number;
  minH?: number;
  maxH?: number;
  /*
   * What the end-of-line label says.
   *
   * "value" when a legend above already names the series — two or three lines,
   * where the name is cheap to carry and the number is what is being looked
   * for. "named" when there are too many series for a legend to be worth
   * walking: then the label IS the identification and the legend goes away, so
   * nothing on the chart has to be matched to anything beside it.
   */
  legend?: boolean;
  /*
   * Which side of the plot the reference-line labels sit on.
   *
   * They default right, which is where they have always been — and on a chart
   * whose lines END at the right, that is on top of the lines' own last points.
   * Measured on the zone figure when the names were still out there:
   * 「台灣年均標準 15」 landed directly across 「高屏 16.7」 and 「雲嘉南 15.7」.
   * The caller knows which half of its own plot is empty; this component
   * cannot.
   */
  notesAt?: "left" | "right";
}

const {
  years,
  series,
  guides = [],
  unit,
  ar = 42,
  minH = 244,
  maxH = 430,
  legend = true,
  notesAt = "right",
} = Astro.props;

// Everything below is in percent of the plot box, not pixels. The box has no
// width until the browser lays it out, so a percentage is the only coordinate
// that survives being fluid — and the labels, which are HTML, never inherit the
// stretch that gets applied to the marks.
const guideLevel = (g: Guide) => {
  if (g.values) {
    for (let i = g.values.length - 1; i >= 0; i -= 1) {
      const v = g.values[i];
      if (v != null) return v;
    }
    return null;
  }
  return g.value ?? null;
};
const allValues = series
  .flatMap((s) => s.values)
  .concat(guides.flatMap((g) => (g.values ? g.values : [g.value ?? null])));
const [lo, hi] = padded(allValues, { zero: true });

const x = (index: number) => (years.length < 2 ? 50 : (index / (years.length - 1)) * 100);
const y = (value: number) => (1 - (value - lo) / (hi - lo || 1)) * 100;

const yTicks = ticks(lo, hi, 5).filter((t) => t >= 0 && t >= lo && t <= hi);

// Where the axis rule goes: on zero if the scale covers it, otherwise the foot.
const baseline = lo <= 0 && hi >= 0 ? y(0) : 100;

// Astro's parser reads a `<=` in a JSX expression as the start of a fragment,
// so the comparison stays out here.
const visibleGuides = guides.filter((guide) => {
  const level = guideLevel(guide);
  return level != null && level >= lo && level <= hi;
});

/*
 * Years at a round interval — see `yearTicks`. Evenly spaced BY VALUE, which on
 * a consecutive run of years is also evenly spaced by index, so the container
 * query that halves the labels still leaves an even grid behind.
 */
const xTicks = yearTicks(years).map((year) => ({ year, index: years.indexOf(year) }));

/*
 * No end labels.
 *
 * They were the value at the end of each line, then the value plus the name,
 * and the owner is right that at the right-hand edge they were never anything
 * but a stack. The key above the plot carries both the name AND the latest
 * value, so the gutter was printing the same numbers a second time in the worst
 * available position. The whole mechanism — gutter, spread, leaders — is gone,
 * and the plot gets the width back.
 */
/*
 * A limit that changed on a date is a step, not a ramp. Drawn horizontal then
 * vertical, so the year the standard moved shows as the standard moving rather
 * than as twelve months of gradual tightening.
 */
function stepPath(values: (number | null)[]): string {
  const parts: string[] = [];
  let open = false;
  values.forEach((v, i) => {
    if (v == null || !Number.isFinite(v)) {
      open = false;
      return;
    }
    const px = n(x(i), 2);
    const py = n(y(v), 2);
    if (!open) {
      parts.push(`M${px} ${py}`);
    } else {
      parts.push(`H${px}`, `V${py}`);
    }
    open = true;
  });
  return parts.join(" ");
}

/*
 * The vertical connectors of a stepped guide, drawn solid and separately.
 *
 * A dash pattern applied to the whole step makes the drop at 2024 a THIRD dashed
 * mark rather than a transition between two dashed levels — and the run after it
 * is one interval of 27 on an 852.7px plot, about 31.6px, or three and a half
 * dashes sitting under the point where both series terminate. Zoomed in it reads
 * as a small detached box beside the line ends. A solid riser says "the limit
 * moved here"; the levels either side stay dashed because they are still guides.
 */
function stepRisers(values: (number | null)[]): string {
  const parts: string[] = [];
  let prev: { i: number; v: number } | null = null;
  values.forEach((v, i) => {
    if (v == null || !Number.isFinite(v)) {
      prev = null;
      return;
    }
    if (prev && prev.v !== v) {
      parts.push(`M${n(x(i), 2)} ${n(y(prev.v), 2)} V${n(y(v), 2)}`);
    }
    prev = { i, v };
  });
  return parts.join(" ");
}

/*
 * Reference-line labels get the same de-overlap the series labels used to.
 *
 * Two limits ten units apart on a 300px plot put two 36px pills 35px apart —
 * measured, a one-pixel collision. The line each one names is still drawn at
 * its true height; only the label moves, which is the same bargain every
 * annotated chart makes.
 */
/* Against the SHORTEST the box can be, not against a nominal height — see
   `gapPct`. A gap solved for a tall plot is no gap at all in a short one. */
const noteY = spreadLabels(
  visibleGuides.map((g) => y(guideLevel(g) as number)),
  gapPct(38),
  [gapPct(19), 100 - gapPct(19)],
);

/*
 * The key sits ABOVE the plot, in one row, and this is the fourth place it has
 * been. The three it left, and why:
 *
 *   1. Under the plot — reading it meant leaving the chart.
 *   2. Eight labels stacked at the right edge — but these lines CONVERGE, so
 *      the one place they are least separated is exactly where their names were
 *      piled, with leader lines fanning out of the stack.
 *   3. Inside the plot, in whichever corner scored emptiest. That worked at the
 *      width it was built at and nowhere else: the block's size does not shrink
 *      with the plot, so measured at a 1000px viewport the "corner" block was
 *      427x126 inside a 479x244 plot — 46% of the drawing area, over the 1998
 *      peak, on the figure whose subject is that peak. An emptiest corner is
 *      only a place to stand if something guarantees the block fits in it, and
 *      nothing did.
 *
 * Above the plot has the property the other three lack: it CANNOT collide,
 * at any width, with any data, because it is not over the data. It costs one
 * line of height, it is read on the way in rather than hunted for afterwards,
 * and it keeps the thing that was right about the corner version — each series
 * carries its own latest value, so the key answers "which line" and "how much"
 * in the same glance.
 */
const keyed = series.map((s) => {
  let last: number | null = null;
  for (let i = s.values.length - 1; i >= 0; i -= 1) {
    const v = s.values[i];
    if (v != null && Number.isFinite(v)) {
      last = v;
      break;
    }
  }
  return { ...s, last };
});
---

<div class:list={["chart", { crowded: series.length > 2 }]}>
  {/*
    The key row is a sibling of `.plot`, so it cannot read `.plot`'s container
    query — and it has to swap at the same width the pills do. `.chart` is the
    box both of them live in, so it is the one to ask.
  */}
  {
    legend && series.length > 1 && (
      <ul class="chart-key">
        {keyed.map((s) => (
          <li style={`--mark:${s.colour};--mark-ink:${markInk(s.colour)}`}>
            <svg class="key-mark" viewBox="0 0 22 8" aria-hidden="true">
              <line x1="1" y1="4" x2="21" y2="4" stroke={s.colour} stroke-width="2.5"
                stroke-linecap="round" stroke-dasharray={s.dash} />
            </svg>
            <span class="key-name">{s.label}</span>
            <span class="key-value">{s.last == null ? "—" : n(s.last, 1)}</span>
          </li>
        ))}
        {/*
          The reference lines, for the width where their pills cannot be drawn.
          
          Hidden above that width, because there the pill already names the line
          in place and a second copy would be the same sentence twice — which is
          the duplication the pills were introduced to remove.
        */}
        {visibleGuides.map((g) => (
          <li class="key-guide" style={`--mark:${g.colour};--mark-ink:${markInk(g.colour)}`}>
            <svg class="key-mark" viewBox="0 0 22 8" aria-hidden="true">
              <line x1="1" y1="4" x2="21" y2="4" stroke={g.colour} stroke-width="1.5"
                stroke-linecap="round" stroke-dasharray="5 4" />
            </svg>
            <span class="key-name">{g.label}</span>
          </li>
        ))}
      </ul>
    )
  }

  <div
    class="plot"
    data-readout
    style={`--plot-ar:${ar};--plot-min:${minH}px;--plot-max:${maxH}px;--y-w:${yGutter(yTicks.map((t) => n(t, 0)))}px;--y-lo:${lo};--y-hi:${hi}`}
  >
    {/* The domain and the values, for the readout. Written from the same `lo`,
        `hi` and `series` the marks above were drawn from, so the crosshair
        cannot end up describing a different chart than the one it is over. */}
    <script
      type="application/json"
      class="plot-readout-data"
      is:inline
      set:html={JSON.stringify({
        x: years.map(String),
        unit,
        places: 1,
        series: series.map((s) => ({
          label: s.label,
          colour: s.colour,
          ink: markInk(s.colour),
          dash: s.dash,
          values: s.values,
        })),
      })}
    />
    <div class="plot-y">
      {/* On the axis it measures — always. It used to be the last entry of the
          legend, which put the units in a row of series names at the bottom of
          the figure, a long way from the numbers they belong to; then it moved
          into a legend floated inside the plot, which on a wide chart put it
          830px from its own axis. The unit belongs to the scale. */}
      <span class="y-unit">{unit}</span>
      {yTicks.map((tick) => <span style={`top:${n(y(tick), 3)}%`}>{n(tick, 0)}</span>)}
    </div>

    <div class="plot-area">
      <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {
          yTicks.map((tick) => (
            <line
              x1="0"
              x2="100"
              y1={n(y(tick), 3)}
              y2={n(y(tick), 3)}
              class="plot-grid"
              vector-effect="non-scaling-stroke"
            />
          ))
        }

        {/* Guides at 1.5, not 1. `--who` and `--taiwan` both clear 3:1 against
            the card as tokens — measured 3.00 and 6.90 in light, 3.73 and 8.94
            in dark — but a 1px dash antialiases into the ground and the RENDERED
            line does not. The fix is the weight, not the colour: the tokens were
            solved once and are still right. */}
        {
          visibleGuides.map((guide) => (
            <>
              <path
                d={guide.values ? stepPath(guide.values) : `M0 ${n(y(guide.value as number), 3)} L100 ${n(y(guide.value as number), 3)}`}
                fill="none"
                stroke={guide.colour}
                stroke-width="1.5"
                stroke-dasharray="5 4"
                vector-effect="non-scaling-stroke"
              />
              {guide.values && (
                <path
                  d={stepRisers(guide.values)}
                  fill="none"
                  stroke={guide.colour}
                  stroke-width="1.5"
                  vector-effect="non-scaling-stroke"
                />
              )}
            </>
          ))
        }

        {/* On zero when zero is on the scale, at the foot of the box otherwise.
            Drawn at the foot unconditionally it was a rule at whatever value the
            padding happened to leave there — on chapter 1 that was −4.18 μg/m³,
            with the real 0 gridline floating above it. The line a reader takes
            as the origin has to be the origin. */}
        <line
          x1="0"
          x2="100"
          y1={n(baseline, 3)}
          y2={n(baseline, 3)}
          class="plot-axis"
          vector-effect="non-scaling-stroke"
        />

        {
          series.map((s) => (
            <path
              d={smoothPath(s.values, x, y)}
              class="plot-line"
              stroke={s.colour}
              stroke-dasharray={s.dash}
              vector-effect="non-scaling-stroke"
            />
          ))
        }
      </svg>

      {/*
        No data points.

        They were added a round ago on the argument that a line does not say
        where it was measured. The owner's own charts set `showSymbol: false`
        and are far easier to look at, and the reason is visible once counted:
        at 28 years times eight series this figure was drawing 224 dots, and
        every one of them is a corner for the eye to stop on. The measurement
        interval is in the x axis and in the caption, which is where it belongs.
      */}
      {
        visibleGuides.map((guide, gi) => (
          <span class={`plot-note note-${notesAt}`} style={`top:${n(noteY[gi], 3)}%;--mark:${guide.colour};--mark-ink:${markInk(guide.colour)}`}>
            {guide.label}
          </span>
        ))
      }
    </div>

    <div class="plot-x" data-n={xTicks.length} data-tw={xLabelBucket(xTicks.map((t) => t.year))}>
      {xTicks.map(({ year, index }) => <span style={`left:${n(x(index), 3)}%`}>{year}</span>)}
    </div>
  </div>

  {/* Only guides the plot could NOT label in place. A visible one already
      carries its name on the line itself, and listing it again below was the
      same sentence twice — 「台灣年均標準 15」 appeared both across the plot
      and in the legend under it. */}
  {
    guides.filter((g) => !visibleGuides.includes(g)).length > 0 && (
      <div class="legend">
        {guides.filter((g) => !visibleGuides.includes(g)).map((g) => (
          <span class="legend-item">
            <span class="swatch dashed" style={`border-color:${g.colour}`} />
            {g.label}
          </span>
        ))}
      </div>
    )
  }
</div>

<style>
  /*
   * Reference-line labels.
   *
   * They were plain text sitting on the line, which put grey words across the
   * gridlines and the data at whatever height the limit happened to be — the
   * owner's words were "意義不明". Two changes, both taken from the annotation
   * style in their own project (`backgroundColor` + `padding` + `borderRadius`
   * on a markArea label):
   *
   *   1. A pill. The backing lifts the words off whatever is behind them, so
   *      the label reads as an annotation ON the chart rather than as a stray
   *      series that lost its line.
   *   2. It sits ABOVE its own line rather than across it, and carries the
   *      value in the text — a reference line is only worth drawing if the
   *      reader can see what it is worth without hunting for the axis.
   */
  .plot-note {
    padding: 0.12em 0.5em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-sunken) 88%, transparent);
    /* Above the line, not on it. `.plot-note` already translates -100%. */
    margin-top: -0.28em;
  }

  .plot-note.note-left {
    right: auto;
    left: 0.35em;
    text-align: left;
  }

  /*
   * The band the unit hangs in.
   *
   * Without it the unit sat in the key row's margin and printed over
   * 「固定樣本（68 站，2006–）」. With a CONSTANT band it still collided, just with
   * something else: the topmost y tick is centred on its own gridline, so half of
   * it hangs above the plot box, and on the zone figure — whose top tick is 70,
   * drawn at the very top of the scale — the unit printed straight through it at
   * every width. The band has to clear half a tick as well as the unit itself,
   * and `--chart-tick` is the size of a tick, so it is the thing to measure
   * against rather than a number chosen once.
   */
  .plot {
    padding-top: calc(1.05em + var(--chart-tick) * 0.95);
  }

  /* The unit. Anchored to the gutter's LEFT edge and allowed to run right into
     the empty band above the plot; anchored right it grew leftwards instead,
     and 67px of text in a 39px gutter had 15px of card padding to spare at 1920
     and none at 375. */
  .y-unit {
    top: auto;
    /* Above the topmost tick, not above the plot box: the tick is centred on the
       box's own top edge, so half of it is already in this band. */
    bottom: calc(100% + var(--chart-tick) * 0.9);
    left: 0;
    right: auto;
    transform: none;
    font-size: var(--chart-tick);
    color: var(--text-faint);
    white-space: nowrap;
  }

  /*
   * Below this width the pills cannot sit beside their own lines: measured at
   * 375px, both wrap to two lines at 66px tall while the two limits they name
   * are 54px apart on a 300px plot. No amount of nudging fixes an arithmetic
   * shortfall, so at that width the reference lines stay on the plot unlabelled
   * and the caption carries their values.
   *
   * 420px, and px rather than `26rem`, for the reason recorded on the thinning
   * tiers in global.css: `rem` in a container query resolves against this site's
   * fluid root, so the threshold was 601px at a 1000px viewport and this phone
   * rule was what a desktop reader got.
   */
  /*
   * The reference lines are named ON the plot at any width that can hold a pill,
   * and in the key row below it.
   *
   * The old rule just hid the pills under 420px, and its comment said 「the
   * caption carries their values」. No caption does. Measured at 390: all four
   * pills `display: none`, and none of chapter 1's three captions names 15, 12
   * or 5 — so on a phone the figure drew two unexplained dashed lines and the
   * standard they represent appeared nowhere on the page. The swap is a swap now.
   */
  .chart-key .key-guide {
    display: none;
  }

  /*
   * 480 rather than 420, because the pill is a fixed 260px and the question is
   * what fraction of the plot it covers. Measured by walking each series at 200
   * points and testing them against the pill's box: at a 476px chart — a 540
   * viewport, the first width the old threshold let pills through — 11 and 17
   * points of a line were behind the label. At 535 and every width above it,
   * zero. The threshold now sits between those two.
   */
  @container (max-width: 480px) {
    .plot-note {
      display: none;
    }
    .chart-key .key-guide {
      display: list-item;
    }
  }

  /*
   * A plot with more than two lines has no empty band to put a label in, at any
   * width, so it swaps whatever the container query says.
   *
   * Measured on chapter 1's eight-region figure by walking each series path at
   * 200 points and testing them against the pill's box: 86 of 200 points of one
   * line fell INSIDE 「台灣年均標準 15 → 12」 at 640, 82 at 1000 and 15 at 1440.
   * The pill is opaque, so that is not an overlap — it is the pill drawn on top
   * of half a series. The two single-line figures on the same page collide with
   * nothing at any width and keep their pills.
   *
   * Two, not one, because the standard sits at 15 and one line can be read
   * around; eight lines converging into the 8–17 band it names cannot.
   */
  .crowded .plot-note {
    display: none;
  }

  .crowded .chart-key .key-guide {
    display: list-item;
  }

  .swatch.dashed {
    background: transparent;
    border-bottom: 2px dashed;
    height: 0;
    border-radius: 0;
  }

  .unit {
    color: var(--text-faint);
    font-family: var(--font-numeric);
  }
</style>
