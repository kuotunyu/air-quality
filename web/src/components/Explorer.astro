  /*
   * The frame hugs the table instead of the table stretching to the frame.
   *
   * Site tables are `width: 100%` because they sit in figures sized for them.
   * A query result is not: its shape is whatever the reader asked for. With
   * `width: 100%` plus `white-space: nowrap`, the browser hands the surplus out
   * in proportion to each column's widest content — so the column whose HEADER
   * NAME is longest gets the most empty space, and its values end up furthest
   * from the label above them. Measured on the reader's own three-column result:
   * column widths 186 / 484 / 211px, and `pm25_over_pm10` sitting 272px away
   * from its own numbers. That is most of the crookedness, and it was caused by
   * a column name rather than by any data.
   *
   * `fit-content` sizes every column to what is in it and lets the box end
   * there. A narrow result becomes a compact table at the reading edge; a wide
   * one still fills the measure and scrolls, which is what the wrapper is for.
   */
  .result :global(.table-wrap) {
    width: fit-content;
    max-width: 100%;
    /*
     * Generous, because the box was doing the opposite of using the space: a
     * 29-row result showed 10 rows in a 546px window and hid 19 behind a
     * scrollbar, on a page that scrolls perfectly well by itself. The cap exists
     * only so a 500-row answer cannot bury the notes underneath it.
     *
     * 85vh was still not generous enough — it is a fraction of the WINDOW, and
     * the window is the one measurement that has nothing to do with how many
     * rows were asked for. At 1000x1100 it clipped at 935px, which is about 23
     * rows, so every one of the shipped example queries that returns more than
     * that opened inside a scroller on a page that scrolls. The cap is now an
     * absolute height that only a runaway answer can reach.
     */
    max-height: min(220vh, 2200px);
    overflow: auto;
  }

  .result :global(table) {
    width: auto;
  }

  /*
   * A long narrow result flowed into side-by-side columns, and framed ONCE.
   *
   * Giving each chunk its own border would read as two or three unrelated
   * tables. The frame belongs to the group, the chunks are separated by a single
   * rule, and the whole thing is one object again.
   */
  .result :global(.result-flow) {
    display: grid;
    grid-template-columns: repeat(var(--chunks, 2), max-content);
    align-items: start;
    width: fit-content;
    max-width: 100%;
    /* Same cap and same reason as `.table-wrap` above. */
    max-height: min(220vh, 2200px);
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    margin: var(--space-4) 0;
    isolation: isolate;
  }

  .result :global(.result-flow) > :global(.table-wrap) {
    width: auto;
    max-width: none;
    max-height: none;
    overflow: visible;
    border: 0;
    border-radius: 0;
    margin: 0;
  }

  /* `--line` and not `--line-soft`: this rule separates two blocks of content,
     which is a heavier job than separating two rows. */
  .result :global(.result-flow) > :global(.table-wrap) + :global(.table-wrap) {
    border-left: 1px solid var(--line);
  }

  /*
   * One system for separating rows, not two.
   *
   * Every row carried a hairline AND a stripe, which is the table equivalent of
   * underlining bold text. The stripe now does it alone — it is the one that
   * follows the row all the way across a flowed table without drawing a line
   * through the vertical rule between chunks.
   */
  .result :global(td) {
    border-bottom: 0;
  }

  /* The header keeps a real rule, because that boundary is the one that matters:
     it separates the names from the data, and it has to stay put when the rows
     scroll under it. */
  .result :global(thead th) {
    box-shadow: inset 0 -1px 0 var(--rule);
  }

  /*
   * Tighter than prose, on purpose.
   *
   * Cells inherit the document's 1.7 line-height, which put these rows at 60px —
   * right for a paragraph, wrong for a grid whose job is to be read down. This
   * is not the published density-versus-legibility trade: that rule is
   * about prose, and a table is scanned rather than read.
   */
  .result :global(th),
  .result :global(td) {
    line-height: 1.45;
    padding: 0.42rem 0.85rem;
  }

  /*
   * The column names are SQL identifiers — the reader typed them — so they are
   * set in the terminal face rather than the text face. `pm25_over_pm10` in a
   * proportional face reads as damaged prose; in mono it reads as a name.
   */
  .result :global(thead th) {
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  /* Dates arrive as ISO strings: fixed width, so they align left without help,
