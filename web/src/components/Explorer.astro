---
/**
 * Chapter 8 — SQL over 44 years, in the reader's own browser.
 *
 * No query server. DuckDB compiled to WebAssembly reads the L1 Parquet files
 * over HTTP range requests, so a question about one station and one year
 * fetches kilobytes rather than the whole file. Nothing is logged, nothing is
 * sent anywhere, and the reader can ask questions this site's author never
 * anticipated — which is the difference between publishing findings and
 * publishing data.
 *
 * The table list is filled in after probing what is actually deployed, not
 * from what happened to exist on the machine that built the page.
 */
import { dataFiles, publishedL1Codes } from "../lib/data";
import { repoFile } from "../lib/repo";
import ChapterIntro from "./ChapterIntro.astro";
import ConceptFlow from "./ConceptFlow.astro";
import { explorePlate } from "../lib/concept-vignettes";
import { ENGINE_TRANSFER_MB } from "../lib/engine-transfer";

const EXAMPLES = [
  {
    // n_valid is in the SELECT on purpose. The worst day in the record is a
    // reading of exactly 1000, the top of this project's plausible range for
    // PM2.5 — a number that deserves scepticism, and the hour count is the
    // first thing to look at. Out-of-range values are flagged upstream, never
    // deleted, so they are still here to be argued with.
    // Rows are station-days, not days: the same date can appear more than once
    // if several stations were high together, so the label says so.
    label: "PM2.5 日均值最高的十個站日",
    sql: `SELECT station_name, date, mean AS pm25, n_valid AS hours
FROM "PM2.5"
WHERE mean IS NOT NULL
ORDER BY mean DESC
LIMIT 10;`,
  },
  {
    label: "各站年均，2024 年，由高至低",
    sql: `SELECT station_name,
       round(avg(mean), 2) AS annual_mean,
       count(*) AS days
FROM "PM2.5"
WHERE date >= '2024-01-01' AND date < '2025-01-01'
  AND mean IS NOT NULL
GROUP BY station_name
HAVING days >= 274          -- 至少 75% 的天數，否則不可比較
ORDER BY annual_mean DESC;`,
  },
  {
    // The threshold in the query is 35 μg/m³, Taiwan's 24-hour standard, so the
    // label names that rather than describing the air.
    label: "超過日均標準的天數，逐月分布",
    sql: `SELECT month(date) AS month,
       count(*) FILTER (WHERE mean > 35) AS days_over_standard,
       count(*) AS days_measured,
       round(100.0 * count(*) FILTER (WHERE mean > 35) / count(*), 1) AS pct
FROM "PM2.5"
WHERE mean IS NOT NULL
GROUP BY month
ORDER BY month;`,
  },
  {
    label: "PM2.5 佔 PM10 的比例，逐年",
    sql: `SELECT year(a.date) AS year,
       round(avg(a.mean / b.mean), 3) AS pm25_over_pm10,
       count(*) AS pairs
FROM "PM2.5" a
JOIN "PM10" b USING (station_name, date)
WHERE a.mean IS NOT NULL AND b.mean > 0
GROUP BY year
ORDER BY year;`,
  },
  {
    label: "PM2.5 大於 PM10 的比率（物理上不可能）",
    sql: `SELECT year(a.date) AS year,
       count(*) FILTER (WHERE a.mean > b.mean) AS impossible,
       count(*) AS pairs,
       round(100.0 * count(*) FILTER (WHERE a.mean > b.mean) / count(*), 2) AS pct
FROM "PM2.5" a
JOIN "PM10" b USING (station_name, date)
WHERE a.mean IS NOT NULL AND b.mean IS NOT NULL
GROUP BY year
ORDER BY year;`,
  },
  {
    label: "覆蓋率不足而被扣住的日均值",
    sql: `SELECT year(date) AS year,
       count(*) FILTER (WHERE mean IS NULL) AS withheld,
       count(*) AS station_days,
       round(100.0 * count(*) FILTER (WHERE mean IS NULL) / count(*), 2) AS pct
FROM "PM2.5"
GROUP BY year
ORDER BY year;`,
  },
];

// The committed register decides what Pages intends to expose. A runtime HEAD
// request still confirms that each selected file actually reached the host.
const candidates = dataFiles.flatMap((entry) => entry.l1 ? [{
  code: entry.pollutant,
  name: entry.name_zh,
  file: entry.l1.file,
}] : []);

/* Two wires in, one stopped return track, one file out. */
const exploreConcept = explorePlate();

---

<section id="explore" class="page" data-explorer-workspace data-explorer-state="initial">
  <ChapterIntro slug="explore">
  <p class="lede">
    這是一個在讀者瀏覽器內執行的資料庫。沒有查詢伺服器，沒有 API 金鑰，
    沒有任何東西被送到別的地方。按下執行才會開始下載查詢引擎（約 {ENGINE_TRANSFER_MB} MB 傳輸量）。
  </p>
  </ChapterIntro>

  <div class="primary-tool" data-primary-evidence>
    <h2>公開站日資料的瀏覽器內查詢</h2>

    <ol class="explorer-path" data-explorer-path aria-label="查詢步驟">
      <li data-explorer-step="choose">
        <span class="explorer-step-number">01</span>
        <strong>選一個問題</strong>
        <span>六個問題，每一個都問得出一張可以下載的表。</span>
      </li>
      <li data-explorer-step="execute">
        <span class="explorer-step-number">02</span>
        <strong>在瀏覽器內執行</strong>
        <span>按下按鈕後才載入查詢引擎與可用資料。</span>
      </li>
      <li data-explorer-step="read">
        <span class="explorer-step-number">03</span>
        <strong>讀結果與限制</strong>
        <span>把表格、空結果或錯誤，和下方限制一起讀。</span>
      </li>
    </ol>

    {/*
      A context diagram, not a flowchart: this figure's subject is the trust
      edge. The zone drawn around steps 2–4 is the reader's tab; the only
      arrow that crosses it is the download into step 2, and the label states
      the outbound half — nothing crosses back.

      2026-09-02 — the zone encloses steps 2–3, not 2–4. Step 4 is the CSV the
      reader saves to their own disk, which is the one thing that does leave
      the tab, and a boundary drawn over it said the opposite of what this
      chapter says. There are two crossings now — in from the host, out to the
      reader — and both connectors are drawn in ink rather than rule, while
      the one inside the zone stays light. The third step also drops its
      boundary tone: the zone IS the boundary, and a dashed card inside a
      dashed frame marked the same thing twice.

      The strip draws the wires. Two arrive, the query and its result stay
      inside, and the return track is dashed and stopped — an absence a
      sentence can assert and only a drawing can show.
    */}
    <ConceptFlow
      title="查詢在你的瀏覽器裡如何完成"
      summary="網站只提供公開檔案與查詢程式；查詢文字與結果都留在目前這個瀏覽器分頁。"
      variant="boundary"
      figureHeight="4.6rem"
      boundary={{
        label: "虛線內是你的瀏覽器分頁：查詢文字與結果不會離開；離開的只有存到你電腦的 CSV",
        from: 2,
        to: 3,
      }}
      steps={[
        {
          label: "公開資料",
          title: "讀取已發布的 L1 Parquet",
          detail: "只在執行查詢後，按需要取得目前網站公開的站日資料。",
          crossing: true,
          ...exploreConcept[0],
        },
        {
          label: "本機引擎",
          title: "載入 DuckDB-WASM",
          detail: "資料庫引擎在瀏覽器內執行，不需要查詢伺服器或 API 金鑰。",
          tone: "cool",
          ...exploreConcept[1],
        },
        {
          label: "執行位置",
          title: "查詢與資料都不離開瀏覽器",
          detail: "這裡沒有上傳步驟，也不把查詢內容送到另一台伺服器。",
          tone: "warm",
          crossing: true,
          ...exploreConcept[2],
        },
        {
          label: "輸出",
          title: "讀表格，必要時匯出 CSV",
          detail: "結果、空結果與錯誤都在本頁呈現，供讀者檢查後下載。",
          ...exploreConcept[3],
        },
      ]}
    />

    <p>資料是站-日層級。</p>

    <noscript>
      <style>
        #explore .explorer-controls,
        #explore .tables,
        #explore .result {
          display: none;
        }
        #explore .explorer-nojs {
          display: block;
        }
      </style>
    </noscript>

    <p class="note explorer-nojs" data-explorer-nojs>
      瀏覽器內查詢需要 JavaScript。六個問題仍可閱讀，但本頁不會下載查詢引擎或執行查詢；
      公開資料與重建方式見第十章。
    </p>

    <div class="controls explorer-controls" data-explorer-controls>
      <label class="control-field">
        <span class="control-label">範例</span>
        <select id="example-select">
          {EXAMPLES.map((example, i) => <option value={i}>{example.label}</option>)}
        </select>
      </label>
      <button id="run" class="primary-action" type="button">執行查詢</button>
      <span id="status" class="status" role="status" aria-live="polite"></span>
    </div>
  </div>

  <p>
    每個測項一張表，表名就是測項代碼；
    另有一張 <code>daily</code> 把全部測項疊成長表。欄位是{" "}
    <code>station_name</code>、<code>date</code>、<code>mean</code>、
    <code>n_valid</code>—最後一欄是這個日均值由幾個有效小時算出來的。
    <code>mean</code> 為 NULL 表示覆蓋率不足、平均值被扣住，不是零。
  </p>

  {/*
    The query is not shown at all, and that is the chapter's shape now.

    It was a `<details>` a click away, kept on the argument that an editable
    query is what makes this chapter a database rather than six fixed charts.
    The owner's call is that a reader has no need to meet SQL, so the box goes —
    and with it the share-a-query link and the `#sql=` hash that reopened one,
    because a link carrying a query nobody can read or edit is a link to
    nothing. What is left is the six questions, the answer and the CSV, which is
    what a reader came here for.
  */}

  {/*
    The schema, above the answer and above the query box.

    It was one justified run-on sentence in the faintest ink on the page, placed
    UNDER the result — so the one reference a reader needs in order to write a
    query was set as an afterthought to the query's output. A reader writing SQL
    needs the table names before they write, not after they have already run
    something; and a list of identifiers is a list, not a paragraph.
  */}
  <div id="tables" class="tables" data-explorer-tables>
    <p class="tables-hint">按下執行之後，這裡會列出實際可以查的表。</p>
  </div>

  {/* `tabindex="-1"` so `reveal()` can move focus here after a run — not
      reachable by Tab, only programmatically, which is what a landing target
      wants. */}
  <div id="result" class="result" tabindex="-1" data-explorer-result></div>

  <div class="note caveat" data-explorer-caveat>
    <strong>Pages 目前公開 {publishedL1Codes.join("、")} 兩張 L1 表。</strong>
    執行查詢時仍會逐檔確認主機回應；本機匯出可產生完整 21 個 L1 測項，共 54.6 MB，
    但那不是目前 GitHub Pages 的發布承諾。這個容量只計 L1，不含 L0。
    要在本機產生全部資料，執行專案的匯出管線即可。
    {/* Chapter 10 links this same document rather than printing its path;
        one of the two had to change and the link is the useful half. */}
    逐時原始資料另有授權問題待確認，見
    <a href={repoFile("docs/legal.md")}>授權說明</a>。
  </div>
</section>

<script
  type="application/json"
  id="explorer-candidates"
  is:inline
  set:html={JSON.stringify(candidates)}
/>
<script
  type="application/json"
  id="explorer-examples"
  is:inline
  set:html={JSON.stringify(EXAMPLES.map((example) => example.sql))}
/>

<script>
  import type { Candidate, ColumnKind } from "../lib/duck";

  const runButton = document.getElementById("run") as HTMLButtonElement;
  const statusEl = document.getElementById("status") as HTMLElement;
  const resultEl = document.getElementById("result") as HTMLElement;
  const tablesEl = document.getElementById("tables") as HTMLElement;
  const exampleSelect = document.getElementById("example-select") as HTMLSelectElement;
  const workspaceEl = document.querySelector("[data-explorer-workspace]") as HTMLElement;
  const controlsEl = document.querySelector("[data-explorer-controls]") as HTMLElement;

  type ExplorerState = "initial" | "loading" | "success" | "empty" | "failure";

  function setWorkspaceState(state: ExplorerState) {
    workspaceEl.dataset.explorerState = state;
  }

  function json<T>(id: string, fallback: T): T {
    const node = document.getElementById(id);
    return node?.textContent ? (JSON.parse(node.textContent) as T) : fallback;
  }

  const examples = json<string[]>("explorer-examples", []);
  const candidates = json<Candidate[]>("explorer-candidates", []);

  /*
   * Resolved against the SITE root, not against this document.
   *
   * This was `new URL("data/", document.baseURI)`, which was correct for exactly
   * as long as the explorer lived on the entry page. When the document became
   * ten routes it moved to `/explore/`, and a relative `data/` then resolved to
   * `<base>/explore/data/` — so every HEAD probe 404'd and the page reported
   * that the site ships no L1 files at all. It ships two.
   *
   * The failure was invisible because it looked like a legitimate empty state:
   * not all 21 pollutants are committed, so "no data files here" is a sentence
   * this page is genuinely allowed to say. The give-away was the probe URL
   * printed in the message itself, which had `/explore/` in the middle of it.
   *
   * `BASE_URL` is what Astro was configured with and is inlined at build time,
   * so this is right both locally (`/`) and on Pages (`/air-quality/`), and it
   * stays right if the explorer is ever moved to another route again.
   */
  const root = import.meta.env.BASE_URL.replace(/\/*$/, "/");
  const base = new URL(`${root}data/`, location.origin).href;

  /* The chosen example IS the query, now that no box holds one. */
  let query = examples[0] ?? "";

  exampleSelect.addEventListener("change", () => {
    const chosen = examples[Number(exampleSelect.value)];
    if (chosen) query = chosen;
  });

  /*
   * A test seam, and named as one.
   *
   * `check_site_quality.mjs` drives this page through loading, empty, failure
   * and retry, and it reached those states by typing into the query box. With
   * the box gone there is no other way in: all six examples succeed and return
   * rows, so nothing a reader can click produces an error to render. The
   * alternative was to stop checking the states the code still has, which is
   * worse than one labelled hook.
   *
   * It puts no SQL in the document and adds no control — a console can already
   * call DuckDB directly, so this grants nothing that was not already there.
   */
  (window as unknown as { __twairSetQuery?: (value: string) => void })
    .__twairSetQuery = (value: string) => {
      query = value;
    };

  function setStatus(text: string, busy = false) {
    statusEl.textContent = text;
    statusEl.dataset.busy = busy ? "true" : "false";
    if (busy) delete statusEl.dataset.failed;
  }

  /*
   * Put the answer where the reader is.
   *
   * Pressing 執行查詢 grows `#tables` from 38px to 183px — the schema list
   * arrives with the engine — which pushes `#result` from y=737 to y=944. On
   * every viewport at or under 900px tall the result table was then entirely
   * below the fold: measured 0% visible at 1280x720, 1280x800, 1280x900,
   * 1440x780 and 1024x700, with scrollY still 0 and focus still on `<body>`.
   * The reader saw a list of table names — which looks like an answer and is a
   * schema — and the rows they asked for were off screen. The error `<pre>` was
   * worse, landing at y=882 and invisible on four of them.
   *
   * `block: "nearest"` rather than `"start"`, so on the two commonest desktop
   * sizes — 1512x945 and 1920x1080, where the result is already visible — this
   * is a no-op and the page does not jump under someone who could already see
   * it. Focus moves with it so a keyboard reader is taken there too, and
   * `#result` carries `tabindex="-1"` for that; `preventScroll` keeps the focus
   * call from fighting the scroll that just happened.
   */
  function reveal() {
    resultEl.scrollIntoView({ block: "nearest", behavior: "auto" });
    resultEl.focus({ preventScroll: true });
  }

  // The whole DuckDB module tree is behind this dynamic import, so a reader
  // who never presses the button never downloads any of it.
  const duck = () => import("../lib/duck");

  type DuckModule = Awaited<ReturnType<typeof duck>>;
  type Prepared = { db: Awaited<ReturnType<DuckModule["getDb"]>> };
  let attached: Promise<Prepared> | null = null;

  function prepare(): Promise<Prepared> {
    attached ??= (async () => {
      const { getDb, attachTables } = await duck();
      const db = await getDb((message) => setStatus(message, true));

      setStatus("檢查有哪些資料檔在線上", true);
      const available = await attachTables(db, base, candidates);
      showTables(available);

      if (available.length === 0) {
        throw new Error(
          `這個站台沒有提供任何 L1 資料檔（找過 ${base}l1/）。\n` +
            "在本機執行專案的匯出管線可以產生它們。",
        );
      }
      return { db };
    })();
    return attached;
  }

  function showTables(available: Candidate[]) {
    tablesEl.replaceChildren();
    if (available.length === 0) {
      const none = document.createElement("p");
      none.className = "tables-hint";
      none.textContent = "沒有找到任何可查詢的資料檔。";
      tablesEl.append(none);
      return;
    }

    const head = document.createElement("p");
    head.className = "tables-head";
    head.textContent = `可以查的表（${available.length + 1}）`;

    const list = document.createElement("ul");
    list.className = "tables-list";
    // `daily` is not a measurement file, it is the stacked view of all of them,
    // so it is named last and named as itself rather than folded into the
    // sentence the way it used to be.
    for (const t of available.concat([{ code: "daily", name: "全部測項疊成長表" } as Candidate])) {
      const item = document.createElement("li");
      const code = document.createElement("code");
      code.textContent = t.code;
      const name = document.createElement("span");
      name.textContent = t.name;
      item.append(code, name);
      list.append(item);
    }
    tablesEl.append(head, list);
  }

  runButton.addEventListener("click", async () => {
    setWorkspaceState("loading");
    runButton.disabled = true;
    resultEl.innerHTML = "";
    shown = null;
    setStatus("準備查詢", true);
    try {
      const { db } = await prepare();
      const duckModule = await duck();
      const { runQuery } = duckModule;
      setStatus("查詢中", true);
      const { columns, kinds, rows, total, truncated, ms } = await runQuery(db, query);
      // Say the real count. A cap that reports the capped number as if it were
      // the answer is the one kind of wrong this page cannot afford.
      setStatus(
        truncated
          ? `顯示前 ${rows.length} 列，共 ${total.toLocaleString("en-US")} 列 · ${ms.toFixed(0)} ms`
          : `${rows.length} 列 · ${ms.toFixed(0)} ms`,
      );
      shown = { columns, kinds, rows, total, truncated, columnKind: duckModule.columnKind };
      paint();
      setWorkspaceState(rows.length === 0 ? "empty" : "success");
      reveal();
    } catch (error) {
      setWorkspaceState("failure");
      /*
       * The reason goes in the status, not only in the box below.
       *
       * This said 「查詢失敗」 and nothing else, and put the cause in a `<pre>`
       * inside `#result` — which is where a screen reader is not, and where a
       * ≤900px-tall window cannot see. So the one reader who most needs to know
       * WHY heard only that something had. Two sentences at most in the live
       * region; the full text, including any SQL position marker, stays in the
       * box where it can be read at leisure.
       */
      const detail = error instanceof Error ? error.message : String(error);
      setStatus(`查詢失敗：${detail.split("\n").slice(0, 2).join(" ")}`);
      statusEl.dataset.failed = "true";
      // A failed preparation must not be cached, or every later attempt
      // returns the same error without retrying.
      attached = null;
      const pre = document.createElement("pre");
      pre.className = "error";
      pre.textContent = detail;
      resultEl.appendChild(pre);
      reveal();
    } finally {
      runButton.disabled = false;
    }
    renderActions();
  });

  /*
   * Taking the answer away, and sending someone else to it.
   *
   * Until now a reader who ran a query could read the table and nothing else —
   * the numbers were on screen and the only way out was to select them. That is
   * a strange place for a chapter whose whole premise is that this is a database
   * rather than six fixed charts.
   *
   * Both controls are built here rather than in the markup, so a reader without
   * JavaScript never meets a button that cannot work. The `<noscript>` block
   * above hides the surrounding controls for the same reason.
   */
  const actionsEl = document.createElement("div");
  actionsEl.className = "explorer-actions";
  actionsEl.hidden = true;
  controlsEl.after(actionsEl);

  const csvButton = document.createElement("button");
  csvButton.type = "button";
  csvButton.className = "explorer-action";
  actionsEl.append(csvButton);

  /*
   * One field, escaped for CSV.
   *
   * NULL leaves the field empty, which is the CSV convention and the only
   * representation that is not a number. Writing 0 here would say the opposite
   * of what this page spends a paragraph explaining: a withheld mean is not a
   * measurement of zero.
   */
  function csvField(value: unknown): string {
    if (value === null || value === undefined) return "";
    const text = String(value);
    return /[",\n\r]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
  }

  function renderActions(): void {
    if (!shown || shown.rows.length === 0) {
      actionsEl.hidden = true;
      return;
    }
    /*
     * The label carries the row count when the result was capped.
     *
     * The status line already refuses to report a capped number as if it were
     * the answer. A download button is where that lie would be easiest to tell
     * and hardest to notice, because the file outlives the page that explained
     * it — so the button says which it is, and the file name repeats it.
     */
    csvButton.textContent = shown.truncated
      ? `下載 CSV（顯示的前 ${shown.rows.length} 列，非全部 ${shown.total.toLocaleString("en-US")} 列）`
      : `下載 CSV（${shown.rows.length} 列）`;
    actionsEl.hidden = false;
  }

  csvButton.addEventListener("click", () => {
    if (!shown) return;
    const lines = [
      shown.columns.map(csvField).join(","),
      ...shown.rows.map((row) => row.map(csvField).join(",")),
    ];
    /*
     * A BOM, because these tables carry station names.
     *
     * Excel on Windows reads a BOM-less UTF-8 CSV in the system code page, which
     * for the readers of this site turns 「西屯」 into mojibake on open. The BOM
     * costs three bytes and every other tool ignores it.
     */
    const blob = new Blob(["﻿" + lines.join("\r\n")], {
      type: "text/csv;charset=utf-8",
    });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = shown.truncated
      ? `twair-query-first-${shown.rows.length}-of-${shown.total}.csv`
      : `twair-query-${shown.rows.length}-rows.csv`;
    link.click();
    URL.revokeObjectURL(url);
  });

  /*
   * A `#sql=` link used to arrive here, land in the box and wait to be run.
   *
   * The care in it was about consent — a stranger's query would not execute
   * because someone clicked a URL; it appeared, visibly, and the reader pressed
   * the button. None of that is reachable now: with no box the query could not
   * be read before running, and a query that cannot be read must not be offered
   * at all. So the link, the hash and the button that made one are gone rather
   * than adapted, and a stale `#sql=` URL simply opens the page.
   */

  /*
   * The last result, kept so its LAYOUT can be recomputed without re-querying.
   *
   * How the result is arranged depends on how much room there is, and the room
   * changes when the window does. Re-running the query to re-lay it out would be
   * absurd; the rows are already here.
   */
  let shown: {
    columns: string[];
    kinds: string[];
    rows: unknown[][];
    total: number;
    truncated: boolean;
    columnKind: DuckModule["columnKind"];
  } | null = null;
  let laidOutAt = { width: 0, chunks: 0 };

  /*
   * The chunks butt against each other, separated by one rule.
   *
   * They do not need a gap: each cell already carries 0.85rem of horizontal
   * padding, so two adjacent chunks put ~36px of air either side of the rule
   * between them. This constant has to agree with the CSS or the arithmetic
   * budgets space that is not there — it was 26 against a grid with no gap, and
   * a two-column result came out at three chunks and 61% of the width when four
   * fit.
   */
  const CHUNK_GAP = 1;
  /*
   * Four, which is a newspaper's answer rather than a round number. A two-column
   * result measured 61% of the width at a cap of three where four chunks fit and
   * reach 90%; past four, a single column of numbers repeated across the page
   * stops being a table and becomes a wall, and knowing which chunk you are in
   * costs more than the height saved.
   */
  const MAX_CHUNKS = 4;
  const MIN_ROWS_PER_CHUNK = 8;

  /*
   * How many side-by-side columns to flow the rows into.
   *
   * A three-column, twenty-nine-row result measured 375px wide inside an 882px
   * reading column: 44% of the width used, 490px of it dead, and 19 of the 29
   * rows hidden behind a scrollbar in a 546px box. Two copies of that table fit
   * side by side with room to spare. A long narrow table set in columns is what
   * print has always done with this shape, and it spends the width that was
   * going to waste on the height that was in short supply.
   *
   * Guards, because this is only right for one shape:
   *   - a wide result has nothing to gain and would just start scrolling
   *     sideways, so anything past six columns stays whole;
   *   - a short result cut in half reads as a mistake, so there is a floor on
   *     rows per chunk rather than only a ceiling on chunk count. Flowing 15
   *     rows into three columns of five is a gimmick, not a layout.
   */
  function chunkCount(natural: number, rowCount: number, colCount: number): number {
    if (colCount > 6 || rowCount < MIN_ROWS_PER_CHUNK * 2) return 1;
    const room = resultEl.clientWidth;
    if (!room || !natural) return 1;
    const fits = Math.floor((room + CHUNK_GAP) / (natural + CHUNK_GAP));
    if (fits < 2) return 1;
    return Math.max(1, Math.min(fits, MAX_CHUNKS, Math.floor(rowCount / MIN_ROWS_PER_CHUNK)));
  }

  function paint() {
    if (!shown) return;
    const { columns, kinds, rows, total, truncated, columnKind } = shown;
    resultEl.replaceChildren();

    if (rows.length === 0) {
      // Zero rows used to render as a bordered strip of column names over
      // nothing, which reads as a broken table rather than as an answer.
      const none = document.createElement("p");
      none.className = "no-rows";
      none.textContent =
        columns.length > 0
          ? `查詢成立，但沒有任何一列符合條件（欄位：${columns.join("、")}）。`
          : "查詢成立，但沒有回傳任何資料。";
      resultEl.appendChild(none);
      laidOutAt = { width: resultEl.clientWidth, chunks: 0 };
      return;
    }

    const shape = shapeOf(columns, kinds, rows, columnKind);

    // Lay the whole thing out once, unchunked. That settles two numbers that
    // cannot be guessed: how wide the table wants to be, and how wide each
    // column has to be for its widest value anywhere in the result.
    const single = renderTable(columns, rows, shape);
    resultEl.appendChild(single);
    const table = single.querySelector("table") as HTMLTableElement;
    const natural = table.getBoundingClientRect().width;
    const widths = Array.from(
      table.tHead!.rows[0].cells,
      (cell) => cell.getBoundingClientRect().width,
    );

    const chunks = chunkCount(natural, rows.length, columns.length);
    if (chunks > 1) {
      const per = Math.ceil(rows.length / chunks);
      const flow = document.createElement("div");
      flow.className = "result-flow";
      flow.style.setProperty("--chunks", String(chunks));
      // One table split for layout is still one answer, so it is announced as
      // one group and each piece says which rows it holds.
      flow.setAttribute("role", "group");
      flow.setAttribute(
        "aria-label",
        `查詢結果，共 ${rows.length} 列，分 ${chunks} 段並排顯示`,
      );
      for (let c = 0; c < chunks; c += 1) {
        const slice = rows.slice(c * per, (c + 1) * per);
        if (slice.length === 0) continue;
        flow.appendChild(
          renderTable(columns, slice, shape, {
            widths,
            caption: `第 ${c * per + 1}–${c * per + slice.length} 列`,
          }),
        );
      }
      single.remove();
      resultEl.appendChild(flow);
    }

    if (truncated) {
      const cap = document.createElement("p");
      cap.className = "capped";
      cap.textContent =
        `這裡只畫得出前 ${rows.length} 列。全部 ${total.toLocaleString("en-US")} 列請加上 ` +
        `LIMIT 或先彙總，否則下面的數字是這一段而不是全部。`;
      resultEl.appendChild(cap);
    }
    laidOutAt = { width: resultEl.clientWidth, chunks };
  }

  /*
   * Re-flow on resize, but only when the arrangement would actually differ.
   *
   * Repainting on every resize event would rebuild a 500-row table dozens of
   * times while the window is being dragged, so the guard is the decision itself
   * rather than a timer: measure what the layout would be now, and only redraw
   * if that is not what is already on screen.
   */
  let reflow = 0;
  window.addEventListener("resize", () => {
    if (!shown || shown.rows.length === 0) return;
    clearTimeout(reflow);
    reflow = window.setTimeout(() => {
      if (resultEl.clientWidth === laidOutAt.width) return;
      paint();
    }, 160);
  });

  /*
   * Two spaces that are exactly as wide as what they stand in for, both
   * measured in the rendered face rather than assumed:
   *
   *   U+2007 FIGURE SPACE       10.875px — identical to every digit
   *   U+2008 PUNCTUATION SPACE   4.375px — identical to "."
   *
   * (`--font-numeric` resolves to Segoe UI here and `tabular-nums` is active, so
   * all ten digits measure the same. An ordinary space and NBSP are 5.531px and
   * would not have worked; neither is collapsed by HTML at the end of a cell,
   * but neither is a digit wide either.)
   *
   * They exist so a column of numbers can be aligned on its decimal point
   * WITHOUT padding the short values with zeros. Writing 0.6 as "0.600" would
   * invent two digits of precision, and duck.ts goes out of its way to avoid
   * exactly that when it truncates Float32 to seven significant figures. Padding
   * with a blank of digit width lines the points up and claims nothing.
   */
  const FIGURE_SPACE = " ";
  const PUNCT_SPACE = " ";

  const isPlainNumber = (v: unknown): v is number =>
    typeof v === "number" && Number.isFinite(v) && !String(v).includes("e");

  /** How many digits this value prints after the point. */
  function decimalsOf(v: unknown): number {
    if (!isPlainNumber(v)) return 0;
    const s = String(v);
    const dot = s.indexOf(".");
    return dot < 0 ? 0 : s.length - dot - 1;
  }

  function formatNumber(v: number, decimals: number, group: boolean): string {
    const s = String(v);
    const dot = s.indexOf(".");
    let head = dot < 0 ? s : s.slice(0, dot);
    const frac = dot < 0 ? "" : s.slice(dot + 1);

    const negative = head.startsWith("-");
    if (negative) head = head.slice(1);
    if (group) head = head.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    // U+2212 MINUS SIGN, not ASCII hyphen-minus: it is what the prose in the
    // other chapters uses, and in this tabular face it measures a full digit
    // where the hyphen measures 8.06px against a digit's 10.875.
    if (negative) head = `−${head}`;
    // Unpadded, but never truncated. `decimals` is 0 both for a column of whole
    // numbers AND for a column switched out of padding because something in it
    // is exponential — and in the second case the value can still have a
    // fraction. Returning `head` alone printed 0.5 as "0" and 2.25 as "2".
    if (decimals === 0) return frac ? `${head}.${frac}` : head;
    // `repeat` throws on a negative count, and this runs inside the click
    // handler's try — a padding slip would replace the entire result with an
    // error box. The count cannot go negative while `decimals` is the column
    // maximum, so the clamp is here to keep that true of any later edit.
    const pad = (n: number) => FIGURE_SPACE.repeat(Math.max(0, n));
    // No point of its own: stand in for the point as well, so the column's
    // points still form one line.
    if (!frac) return head + PUNCT_SPACE + pad(decimals);
    return head + "." + frac + pad(decimals - frac.length);
  }

  /** Everything about a column that is decided by looking at the whole of it. */
  interface Shape {
    kind: ColumnKind[];
    cls: string[];
    decimals: number[];
    group: boolean[];
  }

  /*
   * Computed once over ALL rows, and that is the point of separating it out.
   *
   * When the result is flowed into side-by-side chunks, each chunk renders a
   * slice — and if the padding and grouping were decided per slice, the same
   * column would print 0.6 in one half and 0.60 in the other, and the halves
   * would stop lining up with each other. A column's shape belongs to the
   * column, not to whichever piece of it is being drawn.
   */
  function shapeOf(
    columns: string[],
    kinds: string[],
    rows: unknown[][],
    classify: DuckModule["columnKind"],
  ): Shape {
    // Alignment comes from the column's declared type, not from sniffing the
    // first value. Sniffing is what left the header of every numeric column at
    // the left edge while its values sat at the right — measured at 106, 272 and
    // 125px of divergence on a three-column result.
    const kind = columns.map((_, i) => classify(kinds[i] ?? ""));
    const cls = kind.map((k) => (k === "number" ? "num" : k === "date" ? "iso" : ""));

    /*
     * A column with an exponential in it pads nothing.
     *
     * `1e-7` has no decimal point, so there is nothing to line the column up on,
     * and padding the neighbours would push their points out of line with a cell
     * that has none. One such value therefore turns padding off for the whole
     * column, which is the honest outcome: the column simply is not decimal.
     */
    const exponential = columns.map(
      (_, i) =>
        kind[i] === "number" &&
        rows.some((r) => typeof r[i] === "number" && !isPlainNumber(r[i])),
    );
    /*
     * `decimals` is the widest fractional part in the column, so every value in
     * it pads to the same point position.
     *
     * `group` is whether to write thousands separators, and the rule is that a
     * column groups only if something in it has five or more integer digits.
     * That is not arbitrary: a year is four digits, and 「1,997」 is wrong in a
     * way that 「340,371,384」 is right. Deciding per column rather than per value
     * also stops one column printing both 1213 and 34,125.
     */
    const decimals = columns.map((_, i) =>
      kind[i] === "number" && !exponential[i]
        ? rows.reduce((most, r) => Math.max(most, decimalsOf(r[i])), 0)
        : 0,
    );
    const group = columns.map(
      (_, i) =>
        kind[i] === "number" &&
        rows.some((r) => {
          const v = r[i];
          return isPlainNumber(v) && Math.abs(Math.trunc(v)).toString().length >= 5;
        }),
    );
    return { kind, cls, decimals, group };
  }

  function renderTable(
    columns: string[],
    rows: unknown[][],
    shape: Shape,
    opts: { widths?: number[]; caption?: string } = {},
  ): HTMLElement {
    const wrap = document.createElement("div");
    wrap.className = "table-wrap";
    const table = document.createElement("table");
    const { kind, cls, decimals, group } = shape;

    if (opts.caption) {
      // Each chunk of a flowed table says which rows it holds, for a reader who
      // cannot see that the three blocks are one table.
      const caption = document.createElement("caption");
      caption.className = "visually-hidden";
      caption.textContent = opts.caption;
      table.appendChild(caption);
    }

    /*
     * Pinned column widths, measured from the unchunked table.
     *
     * The chunks must agree about their columns or the flow reads as three
     * unrelated tables. The widths come from laying the WHOLE result out once,
     * so they already accommodate the widest value anywhere in the column and no
     * chunk can overflow its own share.
     */
    if (opts.widths) {
      table.style.tableLayout = "fixed";
      const colgroup = document.createElement("colgroup");
      for (const w of opts.widths) {
        const col = document.createElement("col");
        col.style.width = `${w}px`;
        colgroup.appendChild(col);
      }
      table.appendChild(colgroup);
    }

    const head = table.createTHead().insertRow();
    columns.forEach((name, i) => {
      const th = document.createElement("th");
      th.textContent = name;
      th.scope = "col";
      if (cls[i]) th.className = cls[i];
      head.appendChild(th);
    });

    const body = table.createTBody();
    for (const row of rows) {
      const tr = body.insertRow();
      row.forEach((value, i) => {
        const td = tr.insertCell();
        if (cls[i]) td.className = cls[i];

        if (value == null) {
          // A null here means what it means everywhere else on this site: no
          // measurement, or one withheld. It is never zero — so it keeps the
          // column's alignment (a left-aligned dash in a right-aligned column
          // was a third source of the crookedness, 398px out of line) and says
          // so to a screen reader instead of being read as an em dash.
          td.classList.add("nil");
          const mark = document.createElement("span");
          mark.setAttribute("aria-hidden", "true");
          mark.textContent = "—";
          const said = document.createElement("span");
          said.className = "visually-hidden";
          said.textContent = "無值";
          td.append(mark, said);
        } else if (kind[i] === "number" && isPlainNumber(value)) {
          td.textContent = formatNumber(value, decimals[i], group[i]);
        } else {
          td.textContent = String(value);
        }
      });
    }

    wrap.appendChild(table);
    return wrap;
  }
</script>

<style>
  .explorer-nojs {
    display: none;
  }

  .explorer-path {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0;
    padding: var(--space-3) 0;
    border-block: 1px solid var(--line);
    list-style: none;
  }

  .explorer-path li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0 var(--space-2);
    align-items: baseline;
    min-width: 0;
  }

  .explorer-step-number {
    grid-row: 1 / span 2;
    color: var(--text-faint);
    font-family: var(--font-numeric);
    font-variant-numeric: tabular-nums;
  }

  .explorer-path strong {
    font-weight: 600;
  }

  .explorer-path span {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .explorer-controls .status {
    min-height: 1.7em;
  }

  /* Built by script and hidden until a query has rows, so this never occupies
     space for a reader who has not run anything — and never at all without
     JavaScript, where neither control could work. Wrapping rather than a fixed
     row: the CSV label carries its own row count and grows when a result is
     capped, which is exactly when it must not push the page sideways. */
  .explorer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .explorer-actions[hidden] {
    display: none;
  }

  @media (min-width: 40rem) {
    .explorer-path {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .explorer-controls {
      grid-template-columns: minmax(12rem, 1fr) auto;
    }

    .explorer-controls .status {
      grid-column: 1 / -1;
    }
  }

  @media print {
    .explorer-path {
      grid-template-columns: 1fr;
    }

    .explorer-controls,
    .explorer-actions,
    .tables,
