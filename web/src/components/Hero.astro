---
/**
 * The entry fold: what the record says, and where the stations are.
 *
 * Lifted out of `pages/index.astro` unchanged when the document became ten
 * routes. It is the one block that is not a chapter — it states the finding and
 * shows the network, and the chapter index below it does the rest.
 */
import StationMap from "./StationMap.astro";
import StartHere from "./StartHere.astro";
import {
  cards,
  hourlyObservationsFull,
  recordSpan,
  stations,
  stationsWithoutCoordinates,
  trend,
} from "../lib/data";
import { concentrationInk, n } from "../lib/chart";
import { stationType } from "../lib/labels";

const latestYear = Math.max(...cards.map((c) => c.year));
const latest = cards.filter((c) => c.year >= latestYear - 1);
const overWho = latest.filter((c) => c.annual_mean > 5).length;
/*
 * 12, not 15. PM2.5 entered 空氣品質標準 on 2012-05-14 at an annual 15, and the
 * annual value was tightened to 12 on 2024-09-30 (民國113年9月30日). This
 * sentence is in the present tense, so it answers to the present standard —
 * against 15 it was quietly reporting a limit that had been superseded.
 */
const TAIWAN_PM25_ANNUAL = 12;
const overTaiwan = latest.filter((c) => c.annual_mean > TAIWAN_PM25_ANNUAL).length;

const sorted = [...latest].sort((a, b) => b.annual_mean - a.annual_mean);
const dirtiest = sorted[0];
const cleanest = sorted[sorted.length - 1];
const extremaRatio = dirtiest.annual_mean / cleanest.annual_mean;
/*
 * Whether the two extreme stations are the same category, because the
 * disclosure below turns on it.
 *
 * The paragraph used to assert 「來自不同監測類型」 unconditionally, which the
 * data does not guarantee: these two are recomputed from the latest cards on
 * every export, and nothing stops both ends landing in the same category. The
 * reason the ratio cannot be read as a spatial difference is different in the
 * two cases, so the sentence — and the gate that pins it — branches.
 */
const sameStationType = dirtiest.station_type === cleanest.station_type;

const lastValue = trend.all_stations[trend.all_stations.length - 1] as number;
const balancedSince = trend.panel.balanced_since as number;

// The headline decline is quoted from the balanced window, not from the whole
// record: before 2006 the PM2.5 network was five experimental sites, and a
// percentage anchored there would be a statement about those five places.
const balancedStart = trend.years.indexOf(balancedSince);
const declineFrom = trend.all_stations[balancedStart] as number;
const declinePct = ((declineFrom - lastValue) / declineFrom) * 100;

/*
 * The opening line, assembled from measurements.
 *
 * It read 「1982 – 2025 · 82 個測站 · 341,442,552 筆逐時觀測」 as literal text. The
 * span and the station count are derivable from data the site already ships, so
 * they are; the observation count is not derivable here at all — it counts L2
 * station-hours and L2 is deliberately not published — so the clause appears only
 * when the export has recorded it, and stays out otherwise.
 *
 * The clauses are joined rather than written as one string so that a missing
 * figure removes its own clause and its own separator, instead of leaving a
 * stranded 「 · 」 in the most prominent line on the site.
 */
const opening = [
  `${recordSpan.first} – ${recordSpan.last}`,
  `${stations.length} 個測站`,
  `${hourlyObservationsFull} 筆逐時觀測`,
]
  .filter(Boolean)
  .join(" · ");
---
<section id="hero" class="page enter">
  {/*
    The container is the WRAPPER, not the grid.

    `container-type` sat on `.hero-grid` while the `@container` block below
    styled `.hero-grid` — and an element cannot query the container it is itself
    establishing. The result was not that nothing happened, which is why it
    survived: the block also styles the grid's CHILDREN, and those DO sit inside
    the container, so their `grid-area` placements applied while the
    `grid-template-columns` that was supposed to size those columns did not.
    Measured at 1440: two auto-sized columns of 446px and 499px instead of the
    clamp, and `.map-notes` — which asks to span both — stuck at 446px inside a
    983px figure.
  */}
  <div class="hero-figure">
  <div class="hero-grid" data-homepage-atlas style="--enter:3">
    <StationMap stations={stations} cards={cards} unplaced={stationsWithoutCoordinates}>
      <div slot="before-map" class="hero-opening" data-homepage-opening>
        <p class="eyebrow" style="--enter:0">{opening}</p>
        <h1 style="--enter:1">台灣空氣品質的長期重新分析</h1>
        <p class="lede hero-finding" style="--enter:2">
          {balancedSince} 年以來，全台 PM2.5 年均值從 {n(declineFrom)} 降到
          {" "}{n(lastValue)} μg/m³，少了 {n(declinePct, 0)}%。
        </p>
        <div class="hero-routes" data-homepage-routes>
          <StartHere />
        </div>
      </div>

      <div slot="after-map" class="hero-after" data-homepage-post-map>

    {/*
      Three figures, not three cards.

      They were three bordered boxes with a big number in each, which is the
      hero-metric template — and worse, they were three IDENTICAL boxes, so the
      chrome repeated three times while saying nothing the numbers were not
      already saying. Boxes around figures also make the figure look like a
      widget rather than a reading.

      Now it is a description list: the number is the term, its identification is
      the description, and a hairline separates the rows. That gives the numbers
      more presence at a smaller size (nothing competes with them), lets the
      station names run at a readable width, and removes three frames from a fold
      that already has a map in it.
    */}
    <div class="hero-stats" data-homepage-atlas-left>
      <dl class="figures">
        <div class="figure">
          <dt style={`color:${concentrationInk(dirtiest.annual_mean)}`}>{n(dirtiest.annual_mean)}</dt>
          <dd>
            {dirtiest.station_name}（{dirtiest.county}）年均最高
            <span class="figure-note">{dirtiest.year} 年 · μg/m³</span>
          </dd>
        </div>
        <div class="figure">
          <dt style={`color:${concentrationInk(cleanest.annual_mean)}`}>{n(cleanest.annual_mean)}</dt>
          <dd>
            {cleanest.station_name}（{cleanest.county}）年均最低
            <span class="figure-note">{cleanest.year} 年 · μg/m³</span>
          </dd>
        </div>
        <div class="figure">
          <dt>{n(extremaRatio, 1)}×</dt>
          <dd>
            島內最高與最低的倍數
            <span class="figure-note">直線距離不到 300 公里</span>
          </dd>
        </div>
      </dl>

      {/*
        Why the ratio is not comparable, not only that it is not.

        This listed three things the number was not — 「不是純空間、土地使用或
        因果效果」 — and left the reader to work out why. The reason is the
        classification itself: `conf/stations.yaml` records that this project
        treats station type as a model variable precisely because 「交通站與背景
        站的 PM2.5 驅動因子本來就應該不同」. Saying that is what makes the three
        disclaimers land, and it is the project's own position rather than a
        siting rule invented here.
      */}
      <p class="aside" data-homepage-station-type-boundary>
        {sameStationType ? (
          <>
            最高與最低同屬{stationType(dirtiest.station_type)}（{dirtiest.station_name}、
            {cleanest.station_name}），差別在<strong>地點不同</strong>。
            {n(extremaRatio, 1)}× 是測站觀測值對比，兩地的排放、地形與土地使用都混在裡面，
            不是純空間差距，也不是任何因果效果。
          </>
        ) : (
          <>
            最高與最低不是同一類測站：{dirtiest.station_name}屬{stationType(dirtiest.station_type)}，
            {cleanest.station_name}屬{stationType(cleanest.station_type)}—
            <strong>不同類別的測站，PM2.5 的驅動因子本來就不同</strong>。
            {n(extremaRatio, 1)}× 是測站觀測值對比，站型與地點的差距混在一起，
            不是純空間差距，也不是任何因果效果。
          </>
        )}
      </p>

      {/*
        In the column beside the figure rather than below the whole grid.

        The three cards came to 550px against the figure's 653px, so this
        column ended in a 500px hole while the same paragraph, sitting in the
        flow underneath, left another one to its right. Moving it up fills the
        first and removes the second: the headline numbers and what the project
        is now read as one block.
      */}
      {/*
        Trimmed to what only this block says.
        
        It used to carry the method comparison in full — a monthly-mean panel
        against 44 years of hourly observations — and so does the note
        under the chapter index, forty lines further down the same page. A reader
        met the same sentence twice within two screens. The pointer to chapter 8
        belongs next to the chapter list, which is where it stays; what is left
        here is the claim this fold alone makes.
      */}
      {/*
        2026-08-03 — supersedes the chapter-8 pointer clause above. That pointer
        no longer sits in a note beside the chapter index; Task 4's four-intent
        StartHere carries the method entry before the map instead.
      */}
      {/*
        2026-08-03 — supersedes the placement sentence above. The map-first
        composition now puts StartHere after the complete map, following the
        derived figures and longer interpretation.
      */}
      {/* 2026-09-02 — a paragraph, not a box: the third frame under the map
          was saying 「this is one region」 to one sentence. Seating the three
          figures beside the map was built and measured the same day and
          undone: at 1440×900 the map is 683px tall and the opening column
          651px, so a 548px figures block under the routes ran 551px below the
          map and left that much empty beside itself. */}
      <p class="aside">
        品管規則與資料管線全部開源，本頁每個數字都可獨立重算—
        包含上面那三個，它們是從同一份資料算出來的，不是寫進版面的。
      </p>
    </div>

        {/* 2026-09-02 — the sentence that stood here as a lede of its own opens
            the level summary's paragraph instead: it is that paragraph's
            thesis, and it was saying so twice, one block apart. */}
        <section class="hero-level-summary" data-homepage-level-summary aria-labelledby="level-summary-heading">
          <p class="eyebrow" id="level-summary-heading">2025 年的水準</p>
          <p class="lede">
            長期趨勢已改善，但這不等於空氣品質已達健康指引。有可比較資料的 {latest.length} 個測站中，<strong>{overWho} 個超過
            世界衛生組織的年均指引值</strong>（5 μg/m³），{overTaiwan} 個超過台灣自身的
            標準（{TAIWAN_PM25_ANNUAL} μg/m³）。趨勢與水準是兩個不同的量，這兩項結果
            並不衝突。
          </p>
        </section>

      </div>
    </StationMap>
  </div>
  </div>
</section>

<style>
/*
 * A figure and what it is. The number carries the weight; the hairline carries
 * the separation that three borders used to.
 */
/*
 * One grid for the list, not one per row.
 *
 * `.figure` was its own grid with an `auto` first track, so each row sized that
 * track to its OWN number: scanning ink on the 1440 render, the descriptions
 * started at x = 920, 885 and 930 — three left edges on three lines that are
 * meant to read as one list. `display: contents` hands the rows' cells to this
 * grid, so one `auto` track serves all three and the numbers set it together.
 */
.figures {
  margin: 0;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: baseline;
  column-gap: var(--space-3);
}

.figure {
  display: contents;
}

/* The rule and the padding move onto the cells, because the row itself is no
   longer a box that can carry them. Three of these, so the padding is paid six
   times: 21px each side came to 126px of the list height. */
.figures dt,
.figures dd {
  padding: var(--space-2) 0;
  border-top: 1px solid var(--line-soft);
}

.figure:first-child dt,
.figure:first-child dd {
  border-top: 0;
  padding-top: 0;
}

.figures dt {
  font-family: var(--font-numeric);
  /*
   * Capped at the title's own size, not above it.
   *
   * `clamp(2rem, 4.6vw, 2.7rem)` renders 63.5px at 1440 against a hero `h1` of
   * 48.2px, so the three numbers under the map were the largest type on the
   * entry page — larger than 「台灣空氣品質的長期重新分析」, which is the one
   * thing on that page that has to be read first.
   *
   * This is `#hero h1`'s own `clamp(1.55rem, 3.4vw, 2.05rem)` scaled by 0.9,
   * term for term, rather than a second expression that happens to agree at one
   * width. Capping only the ceiling was not enough: the two clamps had different
   * floors and different `vw` terms, so the numbers still came out larger than
   * the title at 320 through 1000 — 46px against 35.8px at a 1000 viewport.
   * Measured after: 28.7 / 30.4 / 32.3 / 43.5px against a title of 31.8 / 33.7 /
   * 35.8 / 48.2 at 320 / 640 / 1000 / 1440.
   */
  font-size: clamp(1.4rem, 3.06vw, 1.85rem);
  font-weight: 650;
  line-height: 1;
  /* Floor is -0.04em; this is nowhere near it, and digits need less negative
     tracking than letters do anyway. */
  letter-spacing: -0.015em;
  font-variant-numeric: tabular-nums;
  color: var(--text);
}

.figures dd {
  margin: 0;
  color: var(--text-muted);
  text-wrap: pretty;
  /* Never justified. These are two- and three-phrase labels in a column narrower
     than any prose on the site, and justification at that width spaces single
     characters apart rather than closing a line up. */
  text-align: start;
}

.figure-note {
  display: block;
  font-size: var(--text-sm);
  color: var(--text-faint);
  font-variant-numeric: tabular-nums;
  margin-top: 0.1rem;
}

.qualified {
  color: var(--text-muted);
}
.hero-grid {
  display: grid;
  gap: var(--space-4);
  margin: var(--space-4) 0 var(--space-5);
  align-items: start;
}

/*
 * Reading order when the row stacks: map, then the three figures, then the
 * boundary licence.
 *
 * DOM order is map-wrap, map-notes, hero-stats, because the map and its own
 * source note come out of one component. Two columns place all three
 * explicitly, so that order never shows — but in every stacked state it did,
 * and the three headline numbers of the entry page landed underneath two
 * paragraphs of 1:5000-scale licence text. The provenance note is the kind of
 * thing a reader goes looking for; the figures are the kind of thing the page
 * is for. `order` is ignored by the explicitly placed two-column state, so this
 * only ever applies where it is needed.
 */
.hero-grid > :global(.map-wrap) {
  order: 1;
}
.hero-grid > .hero-stats {
  order: 2;
}
.hero-grid > :global(.map-notes) {
  order: 3;
}

/*
 * The query container, and the only reason this element exists.
 *
 * `container-type` used to sit on `.hero-grid` itself while the `@container`
 * block queried `.hero-grid` — see the note in the markup. A wrapper is the
 * whole fix: the grid is now a descendant of the container, so it can be asked
 * how wide its own room is.
 */
.hero-figure {
  /*
   * Queried on the CONTAINER, not the viewport, and that distinction was
   * expensive to learn. The old rule was `@media (min-width: 52rem)`, written
   * when this figure sat in a 1,145px column and the viewport was a fair proxy
   * for the room available. It is not one any more: the rail takes a fixed share
   * and the reading column is capped at the measure, so a wide viewport no
   * longer means a wide figure. Measured before this change — at a 1,440px
   * viewport the stats column resolved to 357px and grew to 863px tall against a
   * 655px map, leaving 271px of nothing under the map; at 1,100px it resolved to
   * 201px, 1,604px tall, and 1,012px of nothing. The breakpoint was reading a
   * number that had stopped describing the box.
   */
  container-type: inline-size;
}

/*
 * px, not `34rem`: `rem` in a container query resolves against this site's fluid
 * root font size, so the threshold grew with the viewport — 785px at 1440 and
 * 706px at 1000 for a rule written as 544px.
 *
 * 640 and not 544, and that number is the sum of what the row actually needs:
 * the map may not go below 260px (below that the county-label collision test
 * loses its guarantee) and the figures need about 340 before their descriptions
 * start breaking mid-phrase. At 544 the row formed at a 1000px viewport with a
 * 664px container, the map took its full 370px, and 「鳳山（高雄市）年均最高」 set
 * one character to a line down a 250px column. A two-column layout that has to
 * squeeze one of its columns is worse than the stack it replaced.
 */
@container (min-width: 640px) {
  .hero-grid {
    /*
     * The map column is sized to the map, not to a share of the row. The map box
     * is height-budgeted (see StationMap) and may not go below 260px wide or the
     * county-label collision test loses its guarantee — so it takes what it needs
     * and the figures take the rest, which is the opposite of the old split.
     */
    /* px for the same reason the query above is: `16rem` resolves to 370px on
       this site, so the map claimed 110px more than the 260px it needs and took
       them from the column beside it. */
    grid-template-columns: clamp(260px, 34%, 330px) minmax(0, 1fr);
    gap: var(--space-5);
  }

  /*
   * Explicit placement, because the figure ships two regions: the map and the
   * prose about it. The map takes the narrow column; its notes drop to a
   * full-width row underneath and pick up the page measure there, instead of
   * wrapping at 20 characters inside the column.
   *
   * `:global` on the two the figure owns, and not on `.hero-stats`. Astro scopes
   * a component styles by stamping its own id on both the selector and its own
   * elements, so a rule written here silently fails to match anything rendered by
   * StationMap — which is what happened: the notes row stayed in column one at
   * 462px and kept the ragged measure this change exists to remove.
   */
  /*
   * The map is intrinsically a tall narrow object — about 700px by 307 — because
   * its height is budgeted and its aspect ratio is the island. Whatever sits
   * beside it therefore has to be about that tall or the row leaves slack, and
   * the figures come to a little more, so the slack lands under the map: 137px
   * of it, measured.
   *
   * Centring the map in the row turns that into 68px above and below, which the
   * eye reads as a figure aligned against a list rather than as a column that
   * stopped early. The alternative — growing the map to match — makes it wider,
   * which takes width from the figures, which makes them taller again.
   */
  .hero-grid > :global(.map-wrap) {
    grid-area: 1 / 1;
    align-self: stretch;
    display: grid;
    align-content: center;
  }
  .hero-grid > .hero-stats {
    grid-area: 1 / 2;
  }
  .hero-grid > :global(.map-notes) {
    grid-area: 2 / 1 / auto / -1;
  }
}

/*
 * 2026-08-03 — supersedes the map/figures split above. The opening finding and
 * complete map now share the first row; interpretation, routes and provenance
 * follow the map in the same order in the rendered and no-JavaScript document.
 */
.hero-grid {
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-3);
  margin: 0 0 var(--space-5);
}
.hero-finding {
  /* The one display sentence outside a heading: the serif, like the title
     above it, so the claim and its statement read as one voice. */
  font-family: var(--font-display);
  margin-bottom: 0;
}
.hero-grid > .hero-opening {
  order: 1;
}
.hero-grid > :global(.map-wrap) {
  order: 2;
  grid-area: auto;
  align-self: start;
  display: flex;
  align-content: normal;
}
.hero-grid > .hero-after {
  order: 3;
}
.hero-grid > :global(.map-apparatus) {
  order: 4;
  grid-area: auto;
}

.hero-after {
  display: grid;
  gap: var(--space-3);
}

.hero-level-summary {
  border-top: 1px solid var(--line-soft);
  padding-top: var(--space-3);
}

.hero-level-summary .eyebrow {
  margin-bottom: var(--space-1);
}

.hero-level-summary .lede {
  margin: 0;
}

@container (max-width: 39.999rem) {
  .hero-grid {
    gap: var(--space-1);
  }
  .hero-opening h1 {
    margin-bottom: var(--space-1);
  }
}

@container (min-width: 40rem) {
  .hero-grid {
    grid-template-columns: minmax(0, 1fr) clamp(260px, 34%, 330px);
    column-gap: var(--space-5);
  }
  .hero-grid > .hero-opening {
    grid-area: 1 / 1;
  }
  .hero-grid > :global(.map-wrap) {
    grid-area: 1 / 2;
    align-self: start;
  }
  .hero-grid > .hero-after {
    grid-area: 2 / 1 / auto / -1;
  }
  .hero-grid > :global(.map-notes) {
    grid-area: 3 / 1 / auto / -1;
  }
}
/* The `grid` utility and its gap went with the cards; the column now holds a
   figure list and one note, and the note brings its own margin. */
.hero-stats {
  display: grid;
  align-content: start;
  gap: var(--space-3);
}

/*
 * The gap does the separating; the children's own margins were doing it again.
 *
 * Margins do not collapse inside a grid — they add to the row gap — and the
 * note and the aside were both written when this column was ordinary flow. So
 * every seam here was paid for twice: measured at 1800, 35.2px of gap plus
 * 22px from `.aside` and 44px from `.note` between three blocks, and 35.2px
 * again from `.lede` in `.hero-after`. 101px across the two stacks, none of it
 * doing anything the gap was not already doing.
 *
 * A whole-page sweep found exactly these two containers and no others, so this
 * is the defect and not a house style.
 */
.hero-stats > *,
.hero-after > * {
  margin-block: 0;
}

/*
 * The approved atlas keeps one graphic and spends its side tracks on reading.
 * Equal flexible tracks put the island on the hero's actual centre axis; the
 * fixed middle range protects county labels without letting the map consume
 * the opening. `display: contents` changes visual placement only, so the map
 * remains before its interpretation in the document and without JavaScript.
 */
.hero-grid {
  --atlas-columns: 1;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-4);
}

.hero-grid > .hero-opening {
  order: 1;
}

.hero-grid > :global(.map-wrap) {
  order: 2;
}

.hero-grid > .hero-after {
  order: 3;
}

/* 2026-09-02 — the notes and the tools are one strip now, one grid child. */
.hero-grid > :global(.map-apparatus) {
  order: 4;
}

/* The handle already marks the page boundary. Measured at 375px, the generic
 * first-section inset consumed the last 14px needed to keep the complete scale
 * in view, so the opening uses the same compact inset as short landscape. */
#hero {
  padding-top: 0.3rem;
}

/* This is a reading breakpoint, so it deliberately follows the root type
 * scale. At 200% text a fixed 760px threshold kept three columns inside an
 * 845px atlas; `rem` lets the same document return to its linear source order.
 */
@container (min-width: 40rem) {
  .hero-grid {
    --atlas-columns: 2;
    grid-template-columns: minmax(0, 1.25fr) clamp(280px, 31cqi, 360px);
    column-gap: clamp(var(--space-4), 4cqi, var(--space-6));
    align-items: start;
  }
  .hero-grid > .hero-opening {
    grid-area: 1 / 1;
  }
  .hero-grid > :global(.map-wrap) {
    grid-area: 1 / 2;
    justify-self: stretch;
  }
  .hero-grid > .hero-after {
    grid-area: 2 / 1 / auto / -1;
  }
  .hero-grid > :global(.map-apparatus) {
    grid-column: 1 / -1;
  }

  .hero-stats .figures {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-block: 1px solid var(--line-soft);
  }

  .hero-stats .figure {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--space-1);
  }

  .hero-stats .figures dt,
  .hero-stats .figures dd {
    padding: 0;
    border: 0;
  }
}

/* The 1280×720 audit left only 2.4px beneath the complete tick strip. In this
