---
/**
 * Ask a chart what a year is worth.
 *
 * Every cartesian figure on this site is a picture of a series and, until now,
 * only a picture: the key carries the latest value and the axis carries the
 * scale, so a reader who wants 2013 has to measure it off a gridline by eye. The
 * map has had hover since it shipped and the CBPF cells have carried titles, so
 * the two figures that are *not* the argument were the two you could interrogate.
 *
 * Injected by script and driven by a JSON payload, for the same two reasons
 * `FigureTools` is: a crosshair that cannot move is worse than no crosshair, so
 * nothing renders without JavaScript; and a rule that finds plots by shape
 * cannot be forgotten when an eleventh chart is written.
 *
 * ## What it does not do
 *
 * It does not interpolate. The crosshair snaps to a measured index and reports
 * that index's values — a reader is never shown a number between two readings.
 * A null is printed as 「無資料」 rather than skipped, because the single most
 * important rule on this site is that a hole looks like a hole; a readout that
 * silently omitted the missing series would say the same thing a bridged line
 * says.
 *
 * It also does not animate anything but opacity, and it never moves the page:
 * the crosshair is positioned inside the plot area and the value panel keeps a
 * stable dock below it, so nothing below a figure shifts when a pointer enters
 * one.
 */
/**
 * 2026-08-30 — chapter 1 keeps the dock's precomputed latest value visible at
 * rest. Hiding the populated panel left 110–180px of unexplained blank space
 * at a 610px viewport; collapsing it instead made the page jump on first
 * focus. Other chapters retain disclose-on-focus through an opt-in attribute.
 */
---

<script>
  interface Series {
    label: string;
    colour: string;
    ink: string;
    dash?: string;
    values: (number | null)[];
  }
  interface Payload {
    x: string[];
    unit: string;
    places: number;
    /*
     * Two optional shapes for the value, because not every chart on this site
     * stores what it prints. Chapter 7 holds attributable fraction as 0.207 and
     * prints 20.7%; chapter 6 holds skill as a bare ratio. `scale` multiplies
     * before rounding and `suffix` is appended after, so the readout says the
     * same thing the axis beside it says rather than the number in the JSON.
     */
    scale?: number;
    suffix?: string;
    series: Series[];
  }

  /*
   * Every live readout, and one listener to put them away.
   *
   * A pointer that leaves fires `pointerleave`; a FINGER does not. Measured at
   * 390px: tapping a chart opened the readout, lifting left it open, and tapping
   * anywhere else on the page left it open too — so on a phone the first chart
   * you touched kept a panel over it for the rest of the visit. One document
   * listener closes any readout whose plot the new press is not inside. It is
   * registered once rather than per chart, so ten plots cost one listener.
   */
  const openReadouts = new Map<HTMLElement, () => void>();
  document.addEventListener(
    "pointerdown",
    (event) => {
      const target = event.target as Node | null;
      for (const [plot, close] of openReadouts) {
        if (!target || !plot.contains(target)) close();
      }
    },
    { capture: true },
  );

  const plots = Array.from(
    document.querySelectorAll<HTMLElement>(".plot[data-readout]"),
  );

  for (const plot of plots) {
    const holder = plot.querySelector<HTMLElement>(".plot-readout-data");
    const area = plot.querySelector<HTMLElement>(".plot-area");
    if (!holder?.textContent || !area) continue;

    let data: Payload;
    try {
      data = JSON.parse(holder.textContent) as Payload;
    } catch {
      continue;
    }
    if (!data.x?.length || !data.series?.length) continue;

    equip(plot, area, data);
  }

  function equip(plot: HTMLElement, area: HTMLElement, data: Payload) {
    const last = data.x.length - 1;

    const rule = document.createElement("span");
    rule.className = "readout-rule";
    rule.setAttribute("aria-hidden", "true");

    const dots = data.series.map((s) => {
      const dot = document.createElement("span");
      dot.className = "readout-dot";
      dot.style.setProperty("--mark", s.colour);
      dot.setAttribute("aria-hidden", "true");
      return dot;
    });

    const panel = document.createElement("div");
    panel.className = "readout-panel";
    panel.setAttribute("aria-hidden", "true");

    const dock = document.createElement("div");
    dock.className = "readout-dock";
    dock.setAttribute("aria-hidden", "true");

    /*
     * The live region is separate from the panel and carries text only.
     *
     * The panel is a grid of coloured marks and numbers positioned over the
     * plot; read aloud it would be a stream of unlabelled fragments. A screen
     * reader gets one sentence per index instead, and the panel is hidden from
     * the tree entirely.
     */
    const say = document.createElement("p");
    say.className = "readout-say visually-hidden";
    say.setAttribute("role", "status");
    say.setAttribute("aria-live", "polite");

    plot.insertAdjacentElement("afterend", dock);
    dock.append(panel);
    area.append(rule, ...dots);
    plot.append(say);

    /*
     * The plot becomes focusable so this works without a pointer.
     *
     * `role="application"` is deliberately NOT used: arrow keys are the only
     * binding and the page's own scrolling still matters more than they do, so
     * the element stays a plain focusable group and the keys are only taken
     * when the chart actually has focus.
     */
    plot.tabIndex = 0;
    plot.setAttribute("role", "group");
    plot.setAttribute(
      "aria-label",
      `${data.series.map((s) => s.label).join("、")}。用左右方向鍵逐點讀值，Home 與 End 跳到兩端。`,
    );

    let at: number | null = null;

    /*
     * Which series the reader has left on, read off the switches rather than
     * held here.
     *
     * The picker is CSS — see the `pick` prop in `TrendChart.astro` — so there
     * is no state for this to subscribe to and nothing to keep in step; the
     * checkboxes ARE the state, and asking them at read time is the only
     * version that cannot drift from what is drawn.
     *
     * A chart with no picker answers `true` for every index, which is what the
     * other ten figures on this site need.
     *
     * It matters more than it looks. The crosshair lists every series at the
     * year under the pointer, and left alone it would go on listing all eight
     * zones over a chart showing two — a panel confidently describing a figure
     * that is not on the screen, which is the failure chapter 2's picker has a
     * paragraph about.
     */
    const switches = Array.from(
      plot.closest(".chart")?.querySelectorAll<HTMLInputElement>("[data-series-switch]") ?? [],
    );
    const shown = (k: number) => {
      const box = switches.find((input) => Number(input.dataset.seriesIndex) === k);
      return box == null || box.checked;
    };

    const fmt = (v: number | null) =>
      v == null || !Number.isFinite(v)
        ? "無資料"
        : `${Number((v * (data.scale ?? 1)).toFixed(data.places))}${data.suffix ?? ""}`;

    function show(index: number) {
      const i = Math.max(0, Math.min(last, index));
      if (i === at) return;
      at = i;

      const pct = last === 0 ? 50 : (i / last) * 100;
      rule.style.left = `${pct}%`;

      data.series.forEach((s, k) => {
        const v = s.values[i];
        const dot = dots[k];
        if (v == null || !Number.isFinite(v) || !shown(k)) {
          dot.hidden = true;
          return;
        }
        dot.hidden = false;
        dot.style.left = `${pct}%`;
        dot.style.top = `${topFor(v)}%`;
      });

      panel.replaceChildren(head(data.x[i]), ...rows(i));
      /*
       * Placed in px and clamped, not flipped by a threshold.
       *
       * Two earlier versions were wrong in the same direction. A fixed
       * "flip past the midpoint" is only right when the panel is narrow, and
       * this one is as wide as its longest series name — on the zone figure that
       * is 427px against an 850px plot at 1440. Choosing the side by measurement
       * fixed the right edge and left the left one: `translateX(-100%)` from 55%
       * of an 850px plot puts a 427px panel at −60px, i.e. out of the plot and
       * over the y-axis labels, which is where it was measured sitting.
       *
       * So the offset is computed: prefer the right of the crosshair, fall back
       * to its left, and clamp inside the plot either way. The clamp can be
       * trusted now because the panel is capped at the plot's width in CSS; it
       * used to say a too-wide panel "ends up flush left, which is still inside
       * the figure", and measured at 320 that panel was 449px in a 231px plot
       * and put 237px of horizontal scroll on the document.
       */
      /*
       * 2026-08-03 — supersedes the clamping strategy above. The panel no
       * longer has a horizontal coordinate because its dock is outside the
       * drawing box; only the rule and dots follow the selected x position.
       */

      plot.dataset.reading = "true";
      say.textContent =
        `${data.x[i]}：` +
        data.series
          .filter((_, k) => shown(k))
          .map((s) => `${s.label} ${fmt(s.values[i])}`)
          .join("，") +
        (data.unit ? `（${data.unit}）` : "");
    }

    function head(label: string) {
      const p = document.createElement("p");
      p.className = "readout-when";
      p.textContent = data.unit ? `${label}・${data.unit}` : label;
      return p;
    }

    function rows(i: number) {
      return data.series.filter((_, k) => shown(k)).map((s) => {
        const row = document.createElement("p");
        row.className = "readout-row";
        row.style.setProperty("--mark", s.colour);
        row.style.setProperty("--mark-ink", s.ink);

        /*
         * An SVG line, the same as the key's mark and for the same reason:
         * `border-top-style: dashed` has two settings and this site ships four
         * dash patterns, so a CSS border cannot draw 「10 3 2 3」. Measured on
         * the probe page, the CSS version rendered chapter 1's dashed series as
         * a solid rule — the readout was disagreeing with the line it described.
         */
        const mark = document.createElementNS("http://www.w3.org/2000/svg", "svg");
        mark.setAttribute("class", "readout-mark");
        mark.setAttribute("viewBox", "0 0 22 8");
        const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
        line.setAttribute("x1", "1");
        line.setAttribute("y1", "4");
        line.setAttribute("x2", "21");
        line.setAttribute("y2", "4");
        line.setAttribute("stroke", s.colour);
        line.setAttribute("stroke-width", "2.5");
        line.setAttribute("stroke-linecap", "round");
        if (s.dash) line.setAttribute("stroke-dasharray", s.dash);
        mark.append(line);

        const name = document.createElement("span");
        name.className = "readout-name";
        name.textContent = s.label;

        const value = document.createElement("span");
        const v = s.values[i];
        const missing = v == null || !Number.isFinite(v);
        value.className = `readout-value${missing ? " missing" : ""}`;
        value.textContent = fmt(v);

        row.append(mark, name, value);
        return row;
      });
    }

    /*
     * Where a value sits, as a percentage of the plot box.
     *
     * The scale is not published to the client — the marks were drawn at build
     * time and the y positions are already in the SVG — so it is recovered from
     * the extremes the payload carries. `--y-lo` and `--y-hi` are written onto
     * the plot by whichever component emitted the payload, which keeps one
     * source for the domain instead of two that can drift.
     */
    const lo = Number(getComputedStyle(plot).getPropertyValue("--y-lo"));
    const hi = Number(getComputedStyle(plot).getPropertyValue("--y-hi"));
    function topFor(v: number) {
      if (!Number.isFinite(lo) || !Number.isFinite(hi) || hi === lo) return 50;
      return (1 - (v - lo) / (hi - lo)) * 100;
    }

    function indexAt(clientX: number) {
      const box = area.getBoundingClientRect();
      if (box.width <= 0) return 0;
      const frac = (clientX - box.left) / box.width;
      return Math.round(Math.max(0, Math.min(1, frac)) * last);
    }

    /* The panel is populated with the latest value before first focus. A chart
       may opt to keep that value visible at rest; either way pointer and
       keyboard interaction update the stable dock without moving the page. */
    panel.replaceChildren(head(data.x[last]), ...rows(last));
    plot.dataset.reading = "false";

    /*
     * A switch thrown under a live crosshair has to take the panel with it.
     *
     * `at` is cleared first because `show` returns early on the index it is
     * already at — the year has not changed, only the list of series has, and
     * without that the panel would keep the row it was just told to drop.
     *
     * The `reset` listener is not redundant: restoring a form's controls fires
     * no `change` on any of them, so 全部顯示 would put six lines back on the
     * plot and leave the panel listing two. It runs on the next frame for the
     * same reason the count in `TrendChart.astro` does — at `reset` time the
     * checkboxes still hold the state the reader is leaving.
     */
    const repaint = () => {
      const held = at;
      at = null;
      if (held == null) panel.replaceChildren(head(data.x[last]), ...rows(last));
      else show(held);
    };
    for (const box of switches) box.addEventListener("change", repaint);
    switches[0]
      ?.closest("form")
      ?.addEventListener("reset", () => requestAnimationFrame(repaint));

    function clear() {
      at = null;
      plot.dataset.reading = "false";
      say.textContent = "";
      openReadouts.delete(plot);
    }

    plot.addEventListener("pointermove", (event) => {
      show(indexAt(event.clientX));
      openReadouts.set(plot, clear);
    });
    plot.addEventListener("pointerleave", clear);
    plot.addEventListener("pointercancel", clear);
    plot.addEventListener("blur", clear);
    plot.addEventListener("focus", () => {
      show(at ?? last);
      openReadouts.set(plot, clear);
    });

    plot.addEventListener("keydown", (event) => {
      /*
       * Home and End, because a series has ends and 28 presses is not a way to
       * reach one. They are what every other list on a keyboard answers to, and
       * this plot is a list: `show()` already clamps, so they are the same call
       * with the two extremes.
       */
      if (event.key === "Home" || event.key === "End") {
        event.preventDefault();
        show(event.key === "Home" ? 0 : last);
        return;
      }
      const step =
        event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
      if (step === 0) {
        if (event.key === "Escape") clear();
        return;
      }
      event.preventDefault();
      show((at ?? last) + step);
    });
  }
</script>

<style is:global>
  /*
   * Nothing here is visible until a pointer or the keyboard asks for it, and the
   * marks are `opacity` only — the crosshair is already in the right place when
   * it appears, so a reader who has switched motion off loses a fade and not a
   * position. The whole layer is inert to the pointer so it can never intercept
   * the events that drive it.
   */
  /* The payload is data, not content. A browser's UA stylesheet already hides
     `<script>`, but the PNG export renders into a document that has none — see
     the note in FigureTools — and this site's own rule is that a figure exports
     as what it looks like. Belt as well as braces. */
  .plot-readout-data {
    display: none;
  }

  .readout-rule,
  .readout-dot {
    position: absolute;
  }

  .readout-rule,
  .readout-dot,
  .readout-panel {
    opacity: 0;
    pointer-events: none;
    transition: opacity 90ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .plot[data-reading="true"] .readout-rule,
  .plot[data-reading="true"] .readout-dot:not([hidden]),
  .plot[data-idle-readout] + .readout-dock .readout-panel,
  .plot[data-reading="true"] + .readout-dock .readout-panel {
    opacity: 1;
  }

  .readout-rule {
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--rule);
  }

  .readout-dot {
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    background: var(--mark);
    /* A ring of the card, so a dot that lands on its own line still reads as a
       dot and two coincident series still read as two. */
    box-shadow: 0 0 0 2px var(--bg-sunken);
  }

  .readout-dock {
    display: grid;
    min-block-size: 3.25rem;
    margin-block-start: 0.55rem;
    pointer-events: none;
  }

  .readout-panel {
    /*
     * As wide as it needs and never wider than the plot.
     *
     * It was `min-width: max-content`, which is a floor with no ceiling, so on a
     * phone the panel was bigger than the figure it belongs to and took the page
     * with it: measured at a 320 viewport, a 449px panel inside a 231px plot,
     * 273px past the plot's right edge, and 237px of horizontal scroll added to
     * the whole document the moment a finger touched a chart. Three of the three
     * chapter-1 figures did it, at every width up to 640.
     */
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) - 4px);
    background: var(--bg-raised);
    box-shadow: 0 2px 8px oklch(0 0 0 / 0.08);
    line-height: 1.35;
  }

  @container (min-width: 560px) {
    .readout-panel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.1rem 1rem;
    }

    .readout-when {
      grid-column: 1 / -1;
    }
  }

  @container (min-width: 44em) {
    .readout-dock {
      min-block-size: 1px;
    }

    .readout-panel {
      grid-template-columns: max-content repeat(2, minmax(0, 1fr));
      align-items: baseline;
    }

    .readout-when {
      grid-column: auto;
      margin-bottom: 0;
    }
  }

  .readout-when {
    margin: 0 0 0.15rem;
    font-size: var(--chart-micro);
    font-family: var(--font-numeric);
    font-variant-numeric: tabular-nums;
    color: var(--text-faint);
    text-align: start;
  }

  .readout-row {
    display: grid;
    /* `1fr` and not `auto` on the name. The ceiling above is only a ceiling if
       something inside is willing to give, and the name is the only thing that
       can — but `minmax(0, auto)` lets it give EVERYTHING: measured at 320, it
       collapsed toward its min-content and set 「固定樣本（68 站，2006–）」 over
       eleven lines in a panel 534px tall inside a 326px plot. `1fr` hands the
       name whatever is left after the swatch and the number instead. The value
       keeps `nowrap` of its own — a number split across two lines is a
       different number. */
    grid-template-columns: 1.35em minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0 0.5em;
    margin: 0;
    font-size: var(--chart-label);
    color: var(--mark-ink);
    text-align: start;
  }

  .readout-mark {
    align-self: center;
    width: 1.35em;
    height: 0.5em;
    overflow: visible;
  }

  /*
   * On a narrow plot the panel drops the series names and keeps the marks.
   *
   * The panel's containing block is `.plot-area`, which is the drawing box
   * WITHOUT the y-axis gutter: 172px at a 320 viewport. Take the swatch, two
   * gaps, the number and the panel's own padding out of that and the name is
   * left with 43px — two characters — so 「固定樣本（68 站，2006–）」 set over
   * eleven lines and the panel stood 534px tall inside a 326px plot.
   *
   * The names are already on the page, in the key row directly above the plot,
   * in the same order and with the same marks; the panel's rows are built from
   * the same array. So the swatch is not a hint here, it is an index. The live
   * region a screen reader hears is untouched and still names every series.
   */
  /* 2026-08-03 — the dock now uses the chart container rather than the drawing
     box. The narrow swap remains because it preserves one readable value column
     when the full series names would compete with the numbers. */
  /* Chromium measured the health chart's 655.4375px dock growing by 25.703px
     at its first year: four two-digit percentage values widened from 52.797px
     to 66.031px and made two longer series names wrap. The key immediately
     above already carries those names, so the compact indexed form is the
     honest tablet layout too; clipping a name or reserving a blank third line
     on every desktop chart would both be worse readings. */
  @container (max-width: 36rem) {
    .readout-row {
      grid-template-columns: 1.35em auto;
    }
    .readout-name {
      display: none;
    }
  }

  .readout-value {
    justify-self: end;
    white-space: nowrap;
    font-family: var(--font-numeric);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  /* A withheld value is not a small number. It is set as words, in the ink the
     rest of the page uses for "nothing here", so it cannot be misread as one. */
  .readout-value.missing {
    font-weight: 400;
    font-family: var(--font-sans);
    color: var(--text-faint);
  }

  /*
   * The one affordance. A chart that answers a pointer should say so before the
   * pointer arrives, and a crosshair cursor is the convention for "this surface
   * has coordinates" — it costs no ink, no layout and no text. The attribute
   * only exists on plots that actually carry a payload, so a chart without a
   * readout does not promise one.
   */
  .plot[data-readout] {
    cursor: crosshair;
  }

  /* The focus ring goes on the plot, which is now a focusable group. */
  .plot:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }
</style>
