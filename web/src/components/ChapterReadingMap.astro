---
interface ReadingMapItem {
  href: `#${string}`;
  question: string;
}

interface Props {
  items: readonly ReadingMapItem[];
}

const { items } = Astro.props;
if (items.length !== 3) {
  throw new Error(`ChapterReadingMap requires exactly three items; received ${items.length}`);
}

/**
 * A question, split where it is allowed to break.
 *
 * CJK breaks between any two characters, so a question one character too wide
 * for its column breaks wherever the line runs out — measured at 1440, 「固定測站
 * 後，下降是否仍成立？」 broke after 「下」 and put 「降是否仍成立？」 on the second
 * line, cutting 下降 in half. The reading break a person would make is the comma.
 *
 * Each clause is rendered as an atomic inline box, so the browser can only break
 * between them. A clause that is somehow wider than the column still wraps
 * inside itself rather than overflowing, which is why this is `inline-block` and
 * not `white-space: nowrap`.
 */
const clauses = (question: string): string[] =>
  question.split(/(?<=[，、；])/u).filter((part) => part.length > 0);
---

<nav class="chapter-reading-map" aria-label="本章閱讀地圖" data-chapter-reading-map>
  <p class="chapter-reading-label">本章的三個問題</p>
  <ol>
    {
      items.map((item) => (
        <li>
          <a href={item.href} data-chapter-reading-link>
            <span>
              {clauses(item.question).map((part) => <b>{part}</b>)}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .chapter-reading-map {
    border-block-start: 1px solid var(--line);
    padding-block-start: var(--space-2);
  }

  /*
   * The label is an eyebrow, not a sentence.
   *
   * At `--text-sm` in `--text-muted` it was within a whisker of the questions
   * below it — 20.9px against 22px, both at weight 400 — so the block read as
   * four items of equal rank, the first of which happened not to be a link.
   * `--text-xs` at 700 with the letter-spacing `.evidence-number` already uses
   * says 「this names what follows」 in the vocabulary this site has for exactly
   * that, and the same treatment carries the 01/02/03 below.
   */
  .chapter-reading-label {
    margin: 0 0 var(--space-1);
    color: var(--text-faint);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .chapter-reading-map ol {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: chapter-question;
  }

  .chapter-reading-map li {
    counter-increment: chapter-question;
    border-block-start: 1px solid var(--line);
  }

  .chapter-reading-map a {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    align-items: center;
    min-block-size: 44px;
    color: inherit;
    text-decoration: none;
  }

  /*
   * The clauses, and why they are boxes rather than text.
   *
   * `text-wrap: balance` was here and balanced the wrong thing: it made the two
   * lines equal widths — 154px and 154px — by breaking after 「下」 and carrying
   * 「降是否仍成立？」 down, which splits 下降 across lines. Even lines are not the
   * goal; breaking where a reader would pause is.
   *
   * An `inline-block` is an atomic inline box, so a line can end between two of
   * them and not inside one. The clauses come from `clauses()` above, split
   * after each 「，」. `<b>` because it is the shortest element that carries no
   * meaning of its own here — the weight comes from the rule below.
   */
  .chapter-reading-map a b {
    display: inline-block;
    font-weight: inherit;
  }

  /* The number is the same eyebrow as the label above it, one step quieter than
     the question it belongs to rather than the same size as it. */
  .chapter-reading-map a::before {
    content: "0" counter(chapter-question);
    align-self: center;
    color: var(--text-faint);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }

  .chapter-reading-map a:hover,
  .chapter-reading-map a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  /* These values belong to the short-landscape chapter opening above, where
     the ordinary reading size wrapped two questions and made the map taller
     than the argument it annotates. The links never fall below 44px. */
  @media (min-width: 64rem) and (max-width: 99.999rem) and (max-height: 45rem) {
    .chapter-reading-map {
      padding-block-start: 0;
    }

    .chapter-reading-label {
      margin-bottom: 0;
      font-size: var(--text-xs);
      line-height: 1.2;
    }

    .chapter-reading-map a {
      font-size: var(--text-xs);
    }
  }
</style>
