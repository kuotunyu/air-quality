---
/**
 * Chapter 3 — spatial structure, and what 「分區各跑一次」 bought.
 *
 * D7 recorded the defect as 「78 個測站的空間維度沒用」, and measuring it
 * corrected the record: the baseline *stratified* by zone, and that
 * stratification removed most of the spatial dependence. The chapter therefore
 * runs on two questions that can each come out either way — was the
 * stratification an adequate control (mostly yes), and are its standard errors
 * still standing (no) — rather than on a verdict picked in advance.
 *
 * Order of material mirrors the module's own printing rule: the network first,
 * the correlogram before any single number, the controls after both.
 */
import spatial from "../../public/data/story/spatial-structure.json";
import { n, nFixed, ticks } from "../lib/chart";
import { repoFile } from "../lib/repo";
import ChapterIntro from "./ChapterIntro.astro";
import ChapterReadingMap from "./ChapterReadingMap.astro";
import EvidenceFigure from "./EvidenceFigure.astro";

const network = spatial.network as {
  stations: number;
  months: number;
  placed: number;
  complete: number;
  unplaced: string[];
  // Stations placed on an authority other than the current MOENV register.
  // Separate from `unplaced`: one says "we found this elsewhere", the other
  // "no official source places this at all", and the page says each.
  historical: string[];
  weights: string;
  null_draws: number;
};

const correlogram = spatial.correlogram as {
  lo_km: number;
  hi_km: number;
  pairs: number;
  i: number;
  z: number;
  significant: boolean;
}[];

const controls = spatial.controls as {
  control: string;
  params: number;
  r_squared: number;
  mean_i: number;
  mean_i_lo: number;
  mean_i_hi: number;
  months_significant_bh: number;
  months_scored: number;
}[];

const partition = spatial.partition_test as {
  groups: number;
  separation_r: number;
  silhouette: number;
  pct_separation: number;
  pct_silhouette: number;
  ensemble_draws: number;
  best_k: number;
  best_k_silhouette: number;
  ari_at_official_k: number | null;
};

const lisa = spatial.lisa as {
  stations: number;
  significant_bh: number;
  significant_raw: number;
  quadrants: Record<string, number>;
};

const inference = spatial.inference as {
  rows: { cov_type: string; meaning: string; t: number; se_inflation: number }[];
  flips_two_way: string[];
};

const field = spatial.field as {
  summary: { method: string; buffer_km: number; mae: number; rmse: number; n: number }[];
  failed_folds: number;
};

const scopeLimits = spatial.scope_limits as string[];
const refusals = spatial.refusals as string[];

const CONTROL_LABELS: Record<string, string> = {
  pooled: "合併式（未分層）",
  zone_era_dummies: "七區截距",
  zone_official_today: "今日分區截距（時代錯置對照）",
  within_zone_separate_fits: "字面上的「分區各跑一次」",
  station_dummies: "測站固定效果（天花板）",
};

const pooled = controls.find((c) => c.control === "pooled");
const literal = controls.find((c) => c.control === "within_zone_separate_fits");

/*
 * Both figures are bar charts, so both need one scale and one zero.
 *
 * They had neither. `.corr-row` and `.ctrl-row` each declared their OWN
 * `grid-template-columns: 7.5em minmax(0,1fr) auto`, and the third track is
 * sized to that row's own value string — so the plot column was whatever width
 * was left over after 「I = +0.348 ＊」 or 「0.157（55/96 月顯著）」. Measured at
 * 1440: correlogram bands came out 657.2 / 657.2 / 686.2 / 657.2 / 692.0 /
 * 679.8 / 663.6 / 663.6 px, with the zero midline landing at five different
 * page positions. The rank inverted twice as a result — 20–30 km at |I| 0.206
 * drew 176.5px while 30–50 km at |I| 0.2122 drew 174.2px, the larger magnitude
 * shorter; and in the controls the 0.1403 estimate plotted 8.1px to the RIGHT
 * of the 0.1405 one. The grid now lives on the figure and the rows are
 * `display: contents`, so one set of tracks serves every row by construction.
 *
 * They also had no axis at all: a filled track with a dot on it and no tick
 * anywhere, which is the shape of a progress bar, not of an estimate. Both now
 * carry ticks and gridlines on their own scale.
 */
const CTRL_HEAD = 1.12;
const maxI = Math.max(...controls.map((c) => c.mean_i_hi)) * CTRL_HEAD;
const pct = (v: number) => (v / maxI) * 100;
/*
 * Three intervals, not four: the plot column is the narrow one on this page and
 * four steps put 「0 0.05 0.1 0.15」 into a 120px band, where they touched.
 *
 * And the last tick has to reach the data. `ticks()` returns round values inside
 * the domain, so with a domain of 0–0.176 it stopped at 0.15 and the axis ran
 * out 89px before the widest interval did — a reader measuring the top bar was
 * extrapolating past the end of the scale. The domain's own upper bound is added
 * as an unlabelled end mark, so the band is closed without inventing a round
 * number that is not one.
 */
const ctrlTicks = ticks(0, maxI, 3).filter((t) => t >= 0 && t <= maxI);

// Correlogram bars are signed, so its scale is symmetric about zero and the
// midline of the shared band is that zero.
const maxAbs = Math.max(...correlogram.map((b) => Math.abs(b.i))) * 1.15;
const half = (v: number) => (Math.abs(v) / maxAbs) * 50;
const corrTicks = ticks(-maxAbs, maxAbs, 4).filter((t) => t >= -maxAbs && t <= maxAbs);
const corrX = (v: number) => ((v + maxAbs) / (2 * maxAbs)) * 100;
const far = correlogram.find((b) => b.lo_km === 100);

const iidRow = inference.rows.find((r) => r.cov_type === "iid");
const twoWayRow = inference.rows.find((r) => r.cov_type === "cluster_twoway");

const buffers = [...new Set(field.summary.map((r) => r.buffer_km))].sort((a, b) => a - b);
const methodOrder = ["kriging_spherical", "kriging_hole-effect", "idw2", "nearest", "station_mean"];
const METHOD_LABELS: Record<string, string> = {
  "kriging_spherical": "Kriging（球型變異圖）",
  "kriging_hole-effect": "Kriging（hole-effect）",
  idw2: "反距離平方加權",
  nearest: "最近測站",
  station_mean: "全網平均",
};
const fieldMethods = methodOrder.filter((m) => field.summary.some((r) => r.method === m));
const cellFor = (method: string, buffer: number) =>
  field.summary.find((r) => r.method === method && r.buffer_km === buffer);
const readingMap = [
  { href: "#space-distance", question: "距離增加後，殘差相依如何改變？" },
  { href: "#space-controls", question: "哪一種分層真正移除了大部分相依？" },
  { href: "#space-inference", question: "剩餘相依對推論與空白區預測有什麼代價？" },
] as const satisfies readonly { href: `#${string}`; question: string }[];
---

<section id="space" class="page">
  <ChapterIntro slug="space">
  <p class="lede">
    常見的批評是「有這麼多測站，空間維度卻沒用上」。
    動手量了之後，這句話需要修正：按空品區分層、每區各跑一次本來就用了空間——所以誠實的問題不是「有沒有用空間」，而是<strong>那個分層是不是足夠的空間控制</strong>。
  </p>
  <ChapterReadingMap slot="reading-map" items={readingMap} />
  </ChapterIntro>

  <h2 id="space-distance" data-space-field-question>距離增加後，殘差相依如何改變？</h2>

  <EvidenceFigure number="3.1" title="官方分區移除了多少空間相依？" primary>
    {/*
      No `role="img"`.

      It was on this figure and I put it on the one below, and it is the wrong
      role for both: `img` collapses a subtree to its label, so a screen reader
      got 「殘差 Moran's I 按站間距離分帶」 and nothing else. Measured, that hid 146
      characters here and 128 below — every distance band with its own I, every
      control with its estimate and its month count. The numbers are already in
      the DOM as text and they are the figure's content; only the bars are
      decoration, and the bars are empty elements. Read as text, a row says
      「0–10 km, I = +0.348 ＊」, which is the row. The `figcaption` names the
      figure, which is the job `aria-label` was doing badly.
    */}
    <div
      class="correlogram"
      data-primary-plot
      style={`grid-template-rows: repeat(${correlogram.length}, var(--row-h)) auto`}
    >
      {/* Rules and zero, once, spanning every row — so the reference a reader
          measures against cannot be assembled out of eight separate pieces. */}
      <span class="rules" aria-hidden="true" style={`grid-row:1/${correlogram.length + 1}`}>
        {corrTicks.map((t) => (
          <span class={t === 0 ? "rule zero" : "rule"} style={`left:${n(corrX(t), 3)}%`} />
        ))}
      </span>

      {correlogram.map((b, i) => (
        <div class="corr-row">
          <span class="corr-label" style={`grid-row:${i + 1};grid-column:1`}>{n(b.lo_km, 0)}–{n(b.hi_km, 0)} km</span>
          <span class="corr-band" style={`grid-row:${i + 1};grid-column:2`}>
            <span
              class={"corr-bar " + (b.i >= 0 ? "pos" : "neg") + (b.significant ? " sig" : "")}
              style={`--w:${n(half(b.i), 2)}%`}></span>
          </span>
          {/* Fixed to three decimals so the column of numbers is a column.
              `n()` drops trailing zeroes, so 「+0.06」 and 「+0.348」 set to
              different widths and the tabular figures they were set in had
              nothing to align — a value column that is ragged on both edges is
              the one thing tabular numerals exist to prevent. */}
          {/* The number alone. 「I = 」 was printed on all eight rows of one
              column, and the caption directly under the figure already opens
              「站均殘差的 Moran's I 按距離分帶」 — a column does not need to name
              its own quantity once per row. */}
          <span class="corr-value" style={`grid-row:${i + 1};grid-column:3`}>
            {b.i >= 0 ? "+" : "−"}{Math.abs(b.i).toFixed(3)}
            <i class="mark">{b.significant ? "＊" : ""}</i>
          </span>
        </div>
      ))}

      {/*
        The axis prints its own sign, so its minus is a minus and not a hyphen.
        
        The value column two lines up already writes 「−0.241」 with U+2212. The
        axis under the same bars wrote 「+0.2」 against 「-0.2」 — a full-width plus
        against a glyph half its width, on the one axis on the site where the two
        appear at the same distance either side of a zero.
      */}
      <span class="axis" aria-hidden="true" style={`grid-row:${correlogram.length + 1}`}>
        {corrTicks.map((t) => (
          <span class={t === 0 ? "zero-label" : undefined} style={`left:${n(corrX(t), 3)}%`}>
            {t > 0 ? `+${n(t, 2)}` : t < 0 ? `−${n(Math.abs(t), 2)}` : n(t, 2)}
          </span>
        ))}
      </span>
    </div>
    <Fragment slot="caption">
      {/* Three decimals, matching the figure. The caption rounded to two while
          the column beside it printed three, so the same quantity appeared twice
          on one screen at two precisions. And `I =` followed by a newline
          collapsed against a negative value: the caption read 「I =-0.241」. */}
      站均殘差的 Moran's I 按距離分帶（＊為 BH 校正後顯著）。
      殘差是扣掉模型已經解釋掉的部分之後、每站每月還差多少。10 公里內同號相聚
      （I = +{correlogram[0].i.toFixed(3)}），100 公里外反號
      （I = −{Math.abs(far?.i ?? 0).toFixed(3)}，z = {n(far?.z ?? 0, 1)}）——
      北部與南部的殘差反向共變，是偶極結構，不是一團模糊的正相關。
    </Fragment>
  </EvidenceFigure>

  <p>
    這個問題有數字可答，而且答案比那句批評公平。
  </p>

  <p>
    量測對象是第八章那個基準模型的殘差，不是 PM2.5 本身——
    濃度有空間結構是人盡皆知的事，不算發現。要緊的是模型「解釋完」之後剩下的部分
    還會不會沿著地圖聚集：會，就表示它把 {n(network.stations * network.months / 1000, 1)}{" "}
    千筆站月當獨立樣本的推論是錯的。網路是 {network.stations} 站 × {network.months} 個月，
    {network.placed} 站有座標、{network.complete} 站每月都有值；
    {network.historical.length > 0 && (
      <>
        其中 {network.historical.join("、")} 的座標不是來自環境部現行測站清冊——
        該站已停用而從清冊消失，位置改依審閱過的環境部歷史測站紀錄補上，
        來源與查證日期記在 <code>conf/station_geo_historical.yaml</code>。
        本章結果是在納入之後重算的；
      </>
    )}
    {network.unplaced.length > 0 && (
      <>
        {network.unplaced.join("、")}仍無任何官方來源可定位，照實排除；
      </>
    )}
    虛無分布——「如果空間上其實沒有結構，這個統計量會長成什麼樣」——
    一律在配適模型下模擬 {network.null_draws} 次（殘差滿足 X'e = 0，
    不可交換，所以不能用排列檢定），權重 {network.weights}。
  </p>

  <p>
    Moran's I 的大小是「場 × 權重矩陣」的共同性質。按距離分帶算，符號自己會變——
    這就是為什麼本章不發表單一的「空間自相關係數」：
  </p>

  <h2 id="space-controls" data-space-field-question>哪一種分層真正移除了大部分相依？</h2>

  <p>
    同一個設計矩陣、同一批資料，只換空間控制的強度。報告的是每月殘差 I 的平均
    與塊狀 bootstrap 區間——寫成差值、不寫成比例，因為 I 是正規化的相關係數，
    沒有可加分解的性質：
  </p>

  <EvidenceFigure number="3.2" title="純地理分群會得到不同結論嗎？">
    <div
      class="controls-fig"
      style={`grid-template-rows: repeat(${controls.length}, var(--row-h)) auto`}
    >
      <span class="rules" aria-hidden="true" style={`grid-row:1/${controls.length + 1}`}>
        {ctrlTicks.map((t) => (
          <span class={t === 0 ? "rule zero" : "rule"} style={`left:${n(pct(t), 3)}%`} />
        ))}
        <span class="rule end" style="left:100%" />
      </span>

      {controls.map((c, i) => (
        <div class="ctrl-row">
          <span class="ctrl-label" style={`grid-row:${i + 1};grid-column:1`}>{CONTROL_LABELS[c.control] ?? c.control}</span>
          <span class="ctrl-band" style={`grid-row:${i + 1};grid-column:2`}>
            <span class="ctrl-ci" style={`--lo:${n(pct(c.mean_i_lo), 2)}%;--hi:${n(pct(c.mean_i_hi), 2)}%`}></span>
            <span class="ctrl-dot" style={`--at:${n(pct(c.mean_i), 2)}%`}></span>
          </span>
          {/* The estimate on its own line and the month count under it. As one
              string it made the value column 214px against a 172px plot — the
              number describing the bar was wider than the bar. */}
          <span class="ctrl-value" style={`grid-row:${i + 1};grid-column:3`}>
            {/* `nFixed`, so the column is a column: `n()` drops a trailing zero
                and 「今日分區截距」 printed 0.14 between neighbours printing 0.157
                and 0.063, under right-aligned tabular figures. */}
            <b>{nFixed(c.mean_i, 3)}</b>
            <small>{c.months_significant_bh}/{c.months_scored} 月顯著</small>
          </span>
        </div>
      ))}

      <span class="axis" aria-hidden="true" style={`grid-row:${controls.length + 1}`}>
        {ctrlTicks.map((t) => (
          <span class={t === 0 ? "zero-label" : undefined} style={`left:${n(pct(t), 3)}%`}>{n(t, 2)}</span>
        ))}
      </span>
    </div>
    <Fragment slot="caption">
      每月殘差 Moran's I 的平均（點）與 95% 塊狀 bootstrap 區間（線）。
      <strong>刻度與上圖不同</strong>：上圖是 ±{n(maxAbs, 2)} 的距離分帶，
      這裡是 0 到 {n(maxI, 2)} 的五種控制，同一個統計量、兩張圖、兩個尺度，長度不能跨圖比。
      「顯著月數」為 BH 校正後計數。
    </Fragment>
  </EvidenceFigure>

  {pooled && literal && (
    <div class="note">
      <p>
        <strong>
          字面上的「分區各跑一次」把平均 I 從 +{n(pooled.mean_i, 3)} 壓到
          +{n(literal.mean_i, 3)}，顯著月數從 {pooled.months_significant_bh} 降到
          {" "}{literal.months_significant_bh}。
        </strong>
        它比測站固定效果還有效——因為它讓每個係數都隨區改變，不只截距。
        那個被指控「沒用空間」的做法，其實移除了大部分的空間相依。
      </p>
      <p>
        但「大部分」不是全部：站均殘差場的 I 仍是
        +{n(spatial.station_mean_i.i as number, 3)}（z = {n(spatial.station_mean_i.z as number, 2)}，
        p = {n(spatial.station_mean_i.p as number, 3)}）。更要緊的是——
        但要注意 t 統計量通常報自合併式模型，
        也就是上圖最上面那一列，而不是分層之後的那個版本。
      </p>
    </div>
  )}

  <h3>官方分區比純地理多知道什麼？</h3>

  <p>
    這個檢定的虛無不是隨機重貼標籤——任何連續的分割都會勝過它，勝出並不具鑑別力。
    對照組是 {n(partition.ensemble_draws, 0)} 個只知道地理、別的什麼都不知道的隨機
    Voronoi 分割：官方分區必須攜帶「超出鄰接性」的資訊才能勝出。
  </p>

  <p>
    結果兩面都有。時代的 {partition.groups} 組分區在「區內−區間相關差」上得
    +{n(partition.separation_r, 2)}，落在地理 ensemble 的{" "}
    {n(partition.pct_separation * 100, 1)} 百分位——分區確實載有
    超出地理的資訊，不是任意劃定的。但它的 silhouette——每個測站
    離自己這一區、比離最近的另一區近多少——只有 +{n(partition.silhouette, 2)}，
    而資料自己偏好的分群數是 k = {partition.best_k}
    （silhouette +{n(partition.best_k_silhouette, 2)}）：北部一群、南部一群，
    彼此反向共變——正是上面 correlogram 的偶極。官方分區數下的資料分群與官方劃法
    的一致性只有 ARI {n(partition.ari_at_official_k ?? 0, 2)}。
    一句話：<strong>分區不是任意劃定、但比資料支持的粒度細</strong>。
  </p>

  <div class="note">
    <p>
      <strong>相關算在距全島均值的異常量上，這一步是檢定成立的前提。</strong>
      生料月均值在全島高度相關——那是共用的冬季高峰，不是分區的性質；用它來測，
      任何分區方式都會看起來同樣有效。減掉逐月島均之後平均相關趨近於零，剩下的才是
      「這一站如何偏離全國」，分區的資訊到這裡才量得出來。兩個值每次執行重算，
      現值印在 <a href={repoFile("reports/03-spatial.md")}>reports/03-spatial.md</a>；
      這裡不轉述，因為先前寫死在這裡的那個數字已經漂掉了。
    </p>
  </div>

  <h3>相依散在整個場，不在少數熱點</h3>

  <p>
    LISA（局部 Moran，同一套模擬虛無）逐站檢查殘差相依的所在位置：{lisa.stations} 站中
    raw 顯著 {lisa.significant_raw} 站，BH 校正後 {lisa.significant_bh} 站。
    象限分布 HH {lisa.quadrants.HH}、HL {lisa.quadrants.HL}、LH {lisa.quadrants.LH}、
    LL {lisa.quadrants.LL}——<strong>沒有任何單站足以擔負「熱點」之名</strong>，
    相依是整個場的性質。這也是為什麼上面的修正必須動整個共變異矩陣，
    而不是排除幾個「異常站」即可。
  </p>

  <h2 id="space-inference" data-space-field-question>剩餘相依對推論與空白區預測有什麼代價？</h2>

  <h3>把 t 統計量重新標價</h3>

  <p>
    係數完全不動、設計完全不動，只換共變異估計量——這樣前後對照才只反映相依性
    這一個變因。聚類月允許同月內任意站間相依（空間的修正）；聚類站允許
    同站內任意月間相依（時間的修正）；two-way 兩者皆允許：
  </p>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>共變異假設</th>
          <th class="num">t（PM10）</th>
          <th class="num">標準誤膨脹</th>
        </tr>
      </thead>
      <tbody>
        {inference.rows.map((r) => (
          <tr>
            <td>
              {r.cov_type === "iid" && "iid——基準模型的假設"}
              {r.cov_type === "cluster_month" && "聚類月（空間）"}
              {r.cov_type === "cluster_station" && "聚類站（時間）"}
              {r.cov_type === "cluster_twoway" && "two-way（CGM）"}
            </td>
            <td class="num">{n(r.t, 2)}</td>
            <td class="num">×{n(r.se_inflation, 2)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="note caveat">
    <p>
      <strong>
        假設誤差互相獨立時 t(PM10) = {n(iidRow?.t ?? 0, 2)}；
        two-way 之下是 {n(twoWayRow?.t ?? 0, 2)}。
      </strong>
      係數沒有變，變的只有標準誤——同一個估計值，換一個關於相依性的假設，
      顯著性就差了數倍。
    </p>
    <p>
      two-way 下失去顯著的有四項：{inference.flips_two_way.join("、")}。
      其中 <strong>WD_HR 就是第八章的錯誤三</strong>——風向被當成線性連續變數。
      「風向顯著」於是錯了兩次：編碼錯了，而顯著性本身也是相依性造出來的。
      兩個問題疊在同一個係數上。
    </p>
  </div>

  {fieldMethods.length > 0 && (
    <>
      <h3>測站之間的空白能不能誠實地補？</h3>

      <p>
        全台 1 公里濃度場是計畫書上的目標，但測站最近鄰距離從 0.6 到 67 公里，
        1 公里的格子宣稱了網路給不起的解析度。所以先量「補值的技巧」本身：
        留一站交叉驗證，並加上 20 與 40 公里的緩衝——把目標站周圍整圈都藏起來，
        因為那才是「地圖上兩站之間那片空白」真正的問題。變異圖在每個 fold 內重配，
        兩種變異圖家族並列（correlogram 會變號，球型不一定是對的模型）。
      </p>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>方法</th>
              {buffers.map((b) => (
                <th class="num">{b === 0 ? "留一站" : `緩衝 ${n(b, 0)} km`}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {fieldMethods.map((m) => (
              <tr>
                <td>{METHOD_LABELS[m] ?? m}</td>
                {buffers.map((b) => {
                  const cell = cellFor(m, b);
                  return <td class="num">{cell ? n(cell.mae, 2) : "—"}</td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="small">
        每格為 MAE（μg/m³），月×站逐一預測後彙整；<strong>留一站是樂觀上界</strong>
        ——600 公尺外就有鄰站時，它量到的是近重複點之間的內插。
        {field.failed_folds > 0 && (
          <>
            {" "}緩衝把西部網路挖掉大半時 fold 會失敗，共 {n(field.failed_folds, 0)}
            次，以空值連同原因記錄、不計入平均。
          </>
        )}
      </p>
    </>
  )}

  <div class="note">
    {scopeLimits.map((s) => <p>{s}</p>)}
  </div>

  <p class="small">
    兩件事刻意不做：{refusals.join("；")}。缺的輸入（人口網格）與其來源要求
    記錄在 conf/spatial.yaml，補上與否是資料層的決定，不是本章能替它決定的。
  </p>
</section>

<style>
  #space-distance,
  #space-controls,
  #space-inference {
    scroll-margin-top: 5rem;
  }

  @media (max-width: 35rem) {
    #space > :global(.chapter-intro.has-reading-map) {
      margin-bottom: 0;
    }

    #space > :global(.chapter-intro.has-reading-map [data-chapter-reading-map]) {
      padding-block-start: 0;
    }

    #space > :global(.chapter-intro.has-reading-map .chapter-reading-label) {
      display: none;
    }

    #space > :global(.chapter-intro.has-reading-map [data-chapter-reading-link]) {
      font-size: var(--text-xs);
      line-height: 1.35;
    }

    #space-distance {
      margin-block: 0;
    }

    #space-distance + :global(.evidence-figure[data-primary-evidence]) {
      margin-block-start: 0;
      padding-block-start: 0;
    }

    #space-distance + :global(.evidence-figure[data-primary-evidence] > figure) {
      margin-block-start: 0;
    }
  }

  @media (min-width: 64rem) and (max-width: 99.999rem) and (max-height: 45rem) {
    #space > :global(.chapter-intro.has-reading-map) {
      grid-template-columns: minmax(0, 1.7fr) minmax(14rem, 0.55fr);
    }

    #space-distance {
      margin-block: 0;
    }

    #space-distance + :global(.evidence-figure[data-primary-evidence]) {
      margin-block-start: 0;
      padding-block-start: 0;
    }

    #space-distance + :global(.evidence-figure[data-primary-evidence] > figure) {
      margin-block-start: 0;
    }
  }

  /*
   * ONE grid for the whole figure, not one per row.
   *
   * The tracks used to be declared on `.corr-row` / `.ctrl-row`, so the `auto`
   * value column was sized per row and the plot column was the leftovers — eight
   * bars on eight different scales, above eight different zeros. See the note in
   * the frontmatter for the measurements. Rows are `display: contents` so their
   * three spans become items of this grid and share its tracks.
   */
  .correlogram,
  .controls-fig {
    position: relative;
    display: grid;
    /*
     * One row height for every row, so the categorical axis has a rhythm.
     *
     * The rows were `auto`, so each one was as tall as whatever its label
     * wrapped to. Measured on the forest plot at 1440, the five dot centres sat
     * at y 1699 / 1775 / 1869 / 1976 / 2063 — gaps of 76, 94, 107 and 87px, a
     * 41% spread, because row 2's label is one line and row 3's is three. A
     * categorical axis whose spacing varies is telling the eye about the labels
     * and not about the data, and the column of bold values beside it marches
     * down at four different pitches.
     *
     * The axis row underneath stays `auto`: it is 32.9px at 1440 and 29.1px at
     * 390, and a uniform track would stretch it to a data row's height for no
     * reason. `grid-auto-rows` would have done exactly that, which is why the
     * track list is explicit and sized from the row count.
     *
     * The floor is two lines of label plus its own leading. One line would leave
     * the controls figure uneven — measured, its longest label
     * 「今日分區截距（時代錯置對照）」 wraps to two in a 7.5em column while
     * 「七區截距」 does not.
     *
     * `1fr` and not `auto` for the ceiling. A floor alone only equalises the
     * rows that are SHORTER than it: on a phone the labels take a third and a
     * fourth line, and the forest plot came out 136 / 98 / 136 / 102 / 102px —
     * a 16% spread that is still the label talking rather than the data. In a
     * grid whose own height is indefinite, `1fr` rows all resolve to the tallest
     * one, so the pitch is uniform by construction at any width and for any
     * label anyone writes later, rather than by a number tuned to today's text.
     */
    --row-h: minmax(4.7rem, 1fr);

    /* The plot column carries a floor. Without one the two `content` columns
       took what their longest string wanted and the drawing area was the
       leftovers — measured, 172px of plot beside a 214px number. The floor is
       small enough that a 390px screen can still honour it; a larger one turned
       into horizontal overflow there rather than into a wider plot. */
    /* `minmax(0, …)` on the outer two, so the row can be narrower than its own
       label and its own number want. Both are `em`- or content-sized, and a
       reader who asks the browser for large type moves both: measured at a 24px
       preference, the tracks solved to 134.6 + 64 + 81.2 = 279.8px inside a
       234.6px grid and the significance mark hung 49px past the page. Text
       shrinks by wrapping, which is the right answer here; the bar keeps its
       floor. */
    grid-template-columns: minmax(0, 7.5em) minmax(84px, 1fr) minmax(0, auto);
    align-items: center;
    column-gap: var(--space-2);
    row-gap: 0.45rem;
    max-width: var(--measure);
    /* Centred like every other capped block, so these two figures sit under the
       prose they belong to rather than starting flush left of it. */
    margin-inline: auto;
  }

  .corr-row,
  .ctrl-row {
    display: contents;
  }

  /*
   * The scale, drawn once, behind every bar in the plot column — so the zero is
   * a single unbroken line rather than eight fragments that only line up if
   * every row happens to agree.
   *
   * `position: absolute` is load-bearing, not decoration. As an ordinary grid
   * item spanning the plot column it OCCUPIED those cells, and auto-placement
   * pushed every band one track to the right: the figure rendered as label, then
   * the next row's value, then a label again. An absolutely positioned child of
   * a grid container takes its grid area as its containing block and takes part
   * in no placement at all, which is exactly the layer this needs to be.
   * `bottom` clears the axis row underneath.
   */
  /*
   * Placement is explicit on EVERY item in these two figures, and that is what
   * lets this one exist.
   *
   * Auto-placed, a rules layer spanning the plot column occupies those cells and
   * pushes each band one track right — the figure rendered as label, next row's
   * value, label. Absolutely positioned, it escapes placement but also escapes
   * track sizing: with `left`/`right` auto it shrink-to-fits to 0px, and pinning
   * both edges resolved it to 397px against a 260px band. Explicitly placed
   * items are ALLOWED to overlap, so every span now names its own row and this
   * layer names all of them at once. It is first in the DOM, so the bars paint
   * over it.
   */
  .rules {
    grid-column: 2;
    position: relative;
    align-self: stretch;
    pointer-events: none;
  }

  /*
   * EVERY span names its own row AND its own column, and the second half is
   * what makes the first half safe.
   *
   * With only the row named, the column was still auto-placed — and this layer
   * occupies column 2 in every row, so auto-placement skipped past it and put
   * each band in column 3 and each value in an implicit column 4. Measured: the
   * grid resolved to `176.25px 648.234px 0px 116.406px`, the bands came out 0px
   * wide, and the estimates rendered on top of their own labels. Explicitly
   * placed items are allowed to overlap; auto-placed ones are not allowed to
   * overlap, which is exactly why they moved.
   */
  /*
   * `--line`, not `--line-soft`. Measured against these figures' own ground:
   * `--line-soft` is 1.17:1 on `--bg` in the light theme and 1.25:1 in dark,
   * which is a gridline a reader has to take on faith — and unlike the cartesian
   * charts, these two have no card behind them to lift it off. `--line` measures
   * 1.41 and 1.66. A gridline should be recessive, not absent.
   */
  .rules .rule {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--plot-grid);
  }
  /* The one line that carries an argument: whether an estimate is on the other
     side of it. `--rule` is the token solved for the 3:1 non-text threshold. */
  .rules .rule.zero {
    background: var(--rule);
  }
  /* Closes the band at the domain's own edge. It carries no label because it is
     not a round number; it is there so the scale has two ends. */
  .rules .rule.end {
    background: var(--line-soft);
  }

  /*
   * The axis, and a container so it can thin itself.
   *
   * These labels are absolutely positioned by value with no collision handling
   * at all, and the plot column is the narrow one on this page. Measured at
   * 390px they overprinted into 「-0.0.2 0 +00.24」 on the correlogram and
   * 「0 0.05 00.15」 on the controls — five numbers rendered as three strings
   * that are not numbers.
   *
   * The cartesian charts solve this with tiers on `.plot-x`; these two are not
   * `.plot`, so they carry their own. Same idea, same unit, and it counts from
   * the END so whatever survives stays evenly spaced — see the note on the
   * thinning tiers in global.css.
   */
  .axis {
    grid-column: 2;
    position: relative;
    height: 1.4em;
    align-self: start;
    container-type: inline-size;
  }
  /* Zero is exempt from every tier. On the controls figure its ticks are
     0 / 0.05 / 0.1 / 0.15, so zero is fourth from the end — an even position,
     which the halving hides. Combined with the rule below that left the axis
     with no labels at all under 130px. The one tick that is an argument is not
     something a thinning rule gets to drop. */
  @container (max-width: 240px) {
    .axis span:not(:nth-last-child(odd)):not(.zero-label) {
      display: none;
    }
  }
  /*
   * Under about 130px the band cannot carry a scale at all, so it carries the
   * one tick that is an argument.
   *
   * Measured at a 320px viewport — below this site's stated 375px floor, but it
   * renders — the three-column grid leaves the plot band 64px, and two labels of
   * 34 and 40px overlapped by 9.6px whatever the thinning did. Nothing arranges
   * five numbers in 64px. Every row already prints its own value beside its bar,
   * so what the axis has left to say is where zero is.
   */
  @container (max-width: 130px) {
    .axis span:not(.zero-label) {
      display: none;
    }
  }
  .axis span {
    position: absolute;
    top: 0.1em;
    transform: translateX(-50%);
    font-size: var(--chart-micro);
    font-family: var(--font-numeric);
    font-variant-numeric: tabular-nums;
    color: var(--text-faint);
    white-space: nowrap;
  }
  /*
   * The end labels stay centred on their own gridlines.
   *
   * They used to be pulled fully inside the band — `transform: none` on the
   * first and `-100%` on the last — which is right for `.plot-x`, where a
   * centred end label hangs off the figure. It is wrong here, because this
   * figure has a value column to the right and a label column to the left, so
   * an end label has somewhere to go. Measured at 1440: 「−0.4」 sat 20px right
   * of the rule it names and 「+0.4」 20px left of its own, on a chart where
   * horizontal position IS the value, while every interior label was exact.
   *
   * `overflow: visible` on the band is what lets the two ends reach out; there
   * is a `column-gap` either side of them and nothing to collide with — checked
   * against the value column at every width from 320 up.
   */
  .axis {
    overflow: visible;
  }

  .corr-label,
  /*
   * One rule, not two. This was written twice in a row, the first asking for
   * `tabular-nums` and the second immediately setting it back to `normal`, so
   * the first declaration never did anything. These labels are prose — 「合併式
   * （未分層）」 — and have no figures to line up.
   *
   * `balance`, because the column is 176px at 1440 and every one of these names
   * carries a parenthetical. Greedy breaking put 「論所依據）」 on the second line
   * of one and 「照）」 alone on the third line of another.
   *
   * All three settings were measured, taking every break position and asking
   * `Intl.Segmenter` whether it fell inside a word:
   *
   *              breaks inside a word   shortest last line   total lines
   *     auto              2                    26%               10
   *     balance           2                    64%               10
   *     pretty            1                    38%               10
   *
   * `balance` splits no more words than the default does and sets the ends of
   * the lines twice as full; `pretty` saves one split and leaves a third of a
   * line. The orphan is the thing being fixed, so `balance` wins.
   */
  .ctrl-label {
    font-size: var(--chart-micro);
    color: var(--text-muted);
    font-family: var(--font-numeric);
    text-wrap: balance;
  }

  /*
   * A signed band: the midline is zero, positive grows right, negative left.
   * Widths arrive as a custom property so the markup stays data-only.
   *
   * No filled track. A full-width grey rectangle with a mark inside it is the
   * shape of a progress bar, and both figures were read as UI controls rather
   * than as estimates. The scale is carried by `.rules` behind the bars now,
   * which is what a gridline is for.
   */
  .corr-band {
    position: relative;
    height: 15px;
  }

  /*
   * A bar that is not significant is still a measurement.
   *
   * It was painted `--line` — the same token as the gridlines behind it, 1.41:1
   * on this ground — so the 20–30 km band, 168px of bar and the longest negative
   * one in the figure, read as furniture rather than as the −0.206 it is. The
   * figure's argument is that the SIGN flips with distance, and it flips on a
   * band that was drawn as background. Significance is carried by the ＊ in the
   * value column and by hue; magnitude is carried by length, and length has to
   * be visible for every bar or the axis is lying about half of them.
   *
   * `--text-faint` measures 5.00:1 here, so a non-significant bar is now clearly
   * a bar; it stays neutral, so it is still clearly not one of the coloured ones.
   */
  .corr-bar {
    position: absolute;
    top: 1px;
    bottom: 1px;
    width: var(--w);
    background: var(--text-faint);
    border-radius: 1px;
  }

  .corr-bar.pos {
    left: 50%;
  }

  .corr-bar.neg {
    right: 50%;
  }

  /*
   * Sign is a diverging encoding, so it gets a diverging pair — not two members
   * of the concentration ramp. `--c1` and `--c5` were doing this job, on a page
   * that contains no concentrations at all: the site teaches in chapter 1 that
   * hue is a μg/m³ bin, and then spent two of those bins on "positive" and
   * "negative". `--sign-pos` / `--sign-neg` are the ramp's own two poles
   * promoted to their own tokens, so the hue still belongs to this palette
   * while naming something the ramp never claimed.
   */
  .corr-bar.sig.pos {
    background: var(--sign-pos);
  }

  .corr-bar.sig.neg {
    background: var(--sign-neg);
  }

  .corr-value,
  .ctrl-value {
    font-size: var(--chart-micro);
    color: var(--text-muted);
    font-family: var(--font-numeric);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* The significance mark takes the same room whether it is there or not, so
     the numbers above and below it stay in one column. */
  .corr-value .mark {
    display: inline-block;
    width: 1em;
    font-style: normal;
    font-weight: 700;
  }

  .ctrl-value {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .ctrl-value b {
    font-weight: 600;
    color: var(--text);
  }
  .ctrl-value small {
    font-size: var(--chart-micro);
    color: var(--text-faint);
  }

  .ctrl-band {
    position: relative;
    height: 16px;
  }

  /* The interval is the mark that carries the uncertainty, so it is drawn as a
     rule with end caps rather than as a fill inside a track. */
  .ctrl-ci {
    position: absolute;
    top: 7px;
    height: 2px;
    left: var(--lo);
    width: calc(var(--hi) - var(--lo));
    background: var(--text-faint);
  }
  .ctrl-ci::before,
  .ctrl-ci::after {
    content: "";
    position: absolute;
    top: -4px;
    width: 1.5px;
    height: 10px;
    background: var(--text-faint);
  }
  .ctrl-ci::before {
    left: 0;
  }
  .ctrl-ci::after {
    right: 0;
  }

  .ctrl-dot {
    position: absolute;
    top: 3px;
    width: 10px;
    height: 10px;
    left: calc(var(--at) - 5px);
    border-radius: 50%;
    background: var(--sign-pos);
    /* A ring in the surface colour so the dot stays a dot where it sits on its
       own interval line. */
    box-shadow: 0 0 0 2px var(--bg);
  }

  /*
   * Narrow: the same three columns, smaller.
   *
   * The value used to drop onto its own row below the bar. That cannot work now
   * that every span names its own `grid-row` — the value would either sit on top
   * of its own bar or spill into an implicit fourth column, which is what it did:
   * measured at 390px, 「I = +0.348 ＊」 rendered off the right edge of the
   * document. Three narrow columns fit; a reflow does not.
   */
  @media (max-width: 560px) {
    .correlogram,
    .controls-fig {
      /* Still three tracks: the spans name their columns, so dropping to two
         here would put the value in an implicit third one anyway. */
      grid-template-columns: minmax(0, 4.4em) minmax(64px, 1fr) minmax(0, auto);
      column-gap: var(--space-1);
    }

    .corr-label,
    .ctrl-label,
    .corr-value,
    .ctrl-value {
      font-size: var(--chart-micro, 16px);
    }

    .ctrl-value small {
      font-size: 0.85em;
    }
  }
</style>
