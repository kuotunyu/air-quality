---
/**
 * Chapter 2: pick a station, get its record.
 *
 * Every card ships in the HTML and the client script only toggles which is
 * visible. With 79 stations that is a few kilobytes, and it means the page
 * works without JavaScript, is fully searchable, and has no loading state.
 */
import { n } from "../lib/chart";
import { stationType } from "../lib/labels";
import { groupByCountyNorthToSouth } from "../lib/data";
import type { Guidelines, StationCard } from "../lib/data";
import { TW_PM25_ADDED, TW_PM25_DAILY_BEFORE, TW_PM25_TIGHTENED } from "../lib/standards";
import StationLocator from "./StationLocator.astro";

interface Props {
  cards: StationCard[];
  guidelines: Guidelines;
}

const { cards, guidelines } = Astro.props;

// Grouped by county already, but the counties came out in stroke order, which
// is no more findable than the station names were. Same helper as chapter 3's
// picker, so the two lists cannot drift into different orders.
const counties = groupByCountyNorthToSouth(cards, (card) => card.station_name);

/*
 * The station the chapter opens on.
 *
 * Named rather than taken from position, because `cards[0]` is whatever the
 * export happened to sort first and would silently change under the reader when
 * the pipeline reruns. The fallback still exists so a missing station degrades
 * to a working page rather than an empty one.
 */
const OPENS_ON = "西屯";
const initial = cards.find((c) => c.station_name === OPENS_ON) ?? cards[0];

// Rank 1 is the lowest annual mean, so it belongs at 0% and the last rank at
// 100%. One function rather than the expression written twice, because the
// gate solves the same arithmetic from `data-rank` and `data-rank-total` and
// compares: two copies that drifted would fail rather than mislead, but they
// would still fail.
const rankPosition = (rank: number, total: number) =>
  total > 1 ? ((rank - 1) / (total - 1)) * 100 : 0;
---

{/*
  With no script, the control is taken away and all 79 cards are given instead.

  What shipped was worse than a dead control: the `<select>` is server-rendered
  with 79 options and the 78 non-default cards carry `hidden`, so a reader
  without JavaScript picked 彰化, the control CONFIRMED the choice, and the card
  underneath still said 西屯 — 13.7 μg/m³, 139 days, rank 43. A control that
  does nothing is a nuisance; a control that agrees with you and then shows you
  another station's numbers is a lie, and this chapter is nothing but that card.

  `<noscript>` carrying a `<style>` rather than a script rendering the select.
  It costs no layout shift, because the rule is in the parser's hands before
  first paint rather than applied after hydration; it needs no second copy of
  the station list in JavaScript; and it leaves the reader MORE than the
  scripted page has, not less — all 79 stations, in county order, which is the
  only way to reach the other 78 without a script. Same shape as the chapter
  rail, which is a checkbox for the same reason.
*/}
{/*
  Anchored on `#stations`, which is specificity arithmetic and not decoration.

  A `<style>` inside `<noscript>` is raw HTML and Astro does not scope it, while
  this component's own `.controls` compiles to `.controls[data-astro-cid-…]`.
  `.picker .controls` ties that at (0,2,0) and wins only because a body rule
  comes after a hoisted head rule — true today, and not a thing to build two
  chapters on. Chapter 4's equivalent lost the same comparison outright and
  silently did nothing. The chapter's `id` is guaranteed by `chapters.ts`, being
  the anchor other chapters link to, so (1,2,0) settles it.
*/}
<noscript>
  <style>
    /* The control cannot act, so it is not offered. */
    #stations .picker .controls {
      display: none;
    }
    /* `hidden` is what the script toggles; overriding its presentation is what
       turns one card into the whole register. */
    #stations .picker .report[hidden] {
      display: block;
    }
    /* The no-script register exposes every report. Separate stations once,
       between reports, instead of restoring an outer frame around each one. */
    #stations .picker .report + .report {
      margin-block-start: var(--space-4);
      border-block-start: 1px solid var(--line);
    }
    #stations .picker .nojs {
      display: block;
    }
    /* One locator cannot mark 79 stations, and a mark on the wrong one is
       worse than no mark at all — the same reasoning that takes the control
       away above. */
    #stations .picker .station-locator {
      display: none;
    }
  </style>
</noscript>

<div class="picker" data-primary-evidence data-station-picker>
  <p class="note nojs">
    這一章的測站搜尋需要 JavaScript。下面直接列出全部 {cards.length} 個測站，
    依縣市由北到南排序。
  </p>

  {/*
    Its own live region, not FigureTools' `.fig-say`.

    Changing station replaces the whole of this chapter — the h2, the four
    figures, the ranking, the caveat — and the only live region on the page was
    `.fig-say`, which stayed `""` before and after. Measured on both /stations
    and /sources: a screen reader heard the option's own name and then silence,
    and had to walk back down the card to find out what it now said. Once per
    station tried.

    A dedicated node rather than borrowing `.fig-say` for two reasons: that one
    is injected by FigureTools, so this chapter would start depending on another
    component's script having run first; and PNG-export messages would share a
    polite queue with station changes, which is two unrelated things taking
    turns to interrupt each other.
  */}
  <p id="station-say" class="visually-hidden" role="status" aria-live="polite"></p>

  {/*
    One control, because two of them were one too many.

    It was a search box beside a menu: typing narrowed the menu and nothing
    else, so the reader typed 「新竹」, read 「3 個測站符合」 off to the right, and
    still had a closed menu in front of them. A control that answers a question
    nobody can see the result of reads as broken, and the owner reported it as
    exactly that.

    What the search was solving is still real and still measured — a native
    `<select>` types-to-jump on the first character, which for 中文 needs an IME
    to have committed before the keystroke arrives, so 「西屯」 never found 西屯
    and 79 stations in 23 county groups had to be scrolled. So the box stays and
    the menu becomes its own results: typing filters the list in place, and the
    list is what chooses.

    Closed until it is asked for, and grouped by county when it opens, because
    the groups are how someone finds a station they cannot name — the reason the
    menu existed at all.
  */}
  <div class="controls station-controls" data-station-controls>
    <div class="control-field station-search-field">
      <label class="control-label" for="station-filter">測站</label>
      <div class="combo-shell">
        <input
          id="station-filter"
          type="text"
          role="combobox"
          autocomplete="off"
          placeholder="輸入測站或縣市名稱"
          aria-expanded="false"
          aria-controls="station-listbox"
          aria-autocomplete="list"
          aria-describedby="station-filter-help station-filter-count"
        />
        {/*
          `role="listbox"` on a <ul> and `role="option"` on its items, so the
          county headings can stay as `role="group"` labels rather than being
          flattened into the option list. Hidden rather than absent when closed:
          `aria-activedescendant` needs its target in the document, and a list
          rebuilt on every keystroke would lose the element the input is
          pointing at mid-announcement.
        */}
        <ul id="station-listbox" role="listbox" aria-label="測站" hidden>
          {
            counties.map((group) => (
              <li role="group" aria-label={group.label} data-county-group>
                <span class="combo-county" aria-hidden="true">{group.label}</span>
                <ul role="none">
                  {group.items.map((card) => (
                    <li
                      role="option"
                      id={`station-option-${card.station_name}`}
                      data-station-option={card.station_name}
                      aria-selected={card.station_name === initial.station_name ? "true" : "false"}
                    >
                      {card.station_name}
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <p id="station-filter-help" class="control-note">
      輸入以縮小清單，或直接從清單選一站。
    </p>
    <p id="station-filter-count" class="control-note" role="status" aria-live="polite"></p>
  </div>

  {/*
    Emitted in the SELECT's order, not the export's.

    With a script this is invisible — one card is shown and the rest are
    `hidden`, so their order never surfaces. Without one, all 79 are the page,
    and the export's order is whatever the pipeline sorted by. Reusing
    `counties` makes the document read the way the control reads: 基隆 at the
    top, 恆春 at the bottom, and the two can no more disagree about order than
    they can about which stations exist.
  */}
  {
    counties.flatMap((group) => group.items).map((card) => (
      <article
        class="report"
        data-station={card.station_name}
        data-station-report
        data-lon={card.lon}
        data-lat={card.lat}
        hidden={card.station_name !== initial.station_name}
      >
        <header data-station-identity>
          <h2>
            <span data-station-name>{card.station_name}</span>
            <span class="place">
              {card.county}
              {card.township ? ` ${card.township}` : ""}
              {card.station_type ? ` · ${stationType(card.station_type)}` : ""}
            </span>
          </h2>
          <span class="year num" data-station-year>{card.year} 年</span>
        </header>

        <div class="station-stats" data-station-stats>
          <div class="stat" data-station-stat="annual-mean">
            <span class="stat-value">{n(card.annual_mean)}</span>
            <span class="stat-label">年均 PM2.5</span>
            <span class="stat-note">μg/m³</span>
          </div>
          <div class="stat" data-station-stat="who-annual">
            <span class="stat-value">{card.times_who_annual}×</span>
            <span class="stat-label">WHO 年均指引的倍數</span>
            <span class="stat-note">指引值 5 μg/m³</span>
          </div>
          {/*
            Both thresholds are read from the payload the counts came in, not
            written here.
            
            They were written here, and they drifted: the standard was tightened
            from 35 to 30 μg/m³ on 2024-09-30, the pipeline constant was updated,
            and this markup went on printing 「35 μg/m³」 under a count that had
            been re-made against 30. A label that names a threshold has to come
            from the same place the threshold came from, or it is a caption for a
            number it is not attached to.
          */}
          <div class="stat" data-station-stat="who-days">
            <span class="stat-value">{card.days_over_who ?? "—"}</span>
            <span class="stat-label">超過 WHO 日均指引的天數</span>
            <span class="stat-note">
              {n(guidelines.who_2021_daily)} μg/m³ · 共 {card.days_with_data} 天有資料
            </span>
          </div>
          <div class="stat" data-station-stat="taiwan-days">
            <span class="stat-value">{card.days_over_taiwan ?? "—"}</span>
            <span class="stat-label">超過台灣日均標準的天數</span>
            <span class="stat-note">
              現行 {n(guidelines.taiwan_daily)} μg/m³
            </span>
          </div>
        </div>

        <div class="row" data-station-comparisons>
          {
            card.rank != null && card.stations_ranked != null && (
              <p class="line" data-station-comparison="rank">
                全台排名 <span class="num big">{card.rank}</span>
                <span class="dim">／{card.stations_ranked} 站（1 = 年均最低）</span>
                {/*
                  The same fact as a position. Two integers say where the
                  station ranks; they do not say whether that is near the clean
                  end or the dirty one without the reader doing the division.

                  A span, and inside this paragraph rather than beside it, for
                  two separate reasons: a <p> may only contain phrasing content,
                  and `check_site_quality.mjs` counts [data-station-comparison]
                  and expects exactly two, so a sibling carrying that attribute
                  would make it three.

                  aria-hidden, because it restates the two numbers read out
                  immediately before it. A screen reader gains nothing and
                  spends time.
                */}
                <span
                  class="rank-strip"
                  data-station-rank-strip
                  data-rank={card.rank}
                  data-rank-total={card.stations_ranked}
                  data-rank-position={rankPosition(card.rank, card.stations_ranked)}
                  style={`--rank-fraction: ${
                    rankPosition(card.rank, card.stations_ranked) / 100
                  }`}
                  aria-hidden="true"
                />
              </p>
            )
          }
          <p class="line" data-station-comparison="worst-day">
            當年日均最高的一天 <span class="num big">{n(card.worst_day)}</span>{" "}
            <span class="dim">μg/m³</span>
          </p>
        </div>
      </article>
    ))
  }

  {/*
    One locator for 79 cards, not one per card.

    The chapter ships every card in the HTML — that is what makes it work
    without a script — and 79 island outlines would be a different order of
    page weight for a figure only one of which is ever visible. So the mark is
    a thing the change handler has to move, and therefore a thing the gate has
    to watch: `check_site_quality.mjs` fails if the mark's station and the
    visible report disagree, before and after a change.

    Placed AFTER the reports rather than above them. `.picker` is this
    chapter's `data-primary-evidence`, and content added above the card eats
    the 55vh clearance the chapter-opening rule measures — which has broken
    three chapters once already.
  */}
  <StationLocator
    stationName={initial.station_name}
    lon={initial.lon}
    lat={initial.lat}
  />

  {/*
    Which limit, and the fact that it moved.
    
    Every card counts against the CURRENT standard, including the cards whose
    most recent complete year predates the revision — see the note above
    `GUIDELINES` in `viz/story.py` for why a snapshot gets one yardstick while
    chapter 1's time series gets the limit in force each year. A reader who
    knows the number changed has to be able to see which one this is.
  */}
  <p class="note" data-station-standard-note>
    這一欄用的是現行標準（{n(guidelines.taiwan_daily)} μg/m³），
    每一站、每一年都用同一把尺：{TW_PM25_TIGHTENED} 年 9 月 30 日之前，日均標準是
    {" "}{TW_PM25_DAILY_BEFORE} μg/m³，而 {TW_PM25_ADDED} 年之前 PM2.5 根本不在
    空氣品質標準裡。卡片顯示的是各站最近一個完整年份，而各站的「最近」不同年
    （已停用的測站有停在 {TW_PM25_ADDED} 年以前的），照當年的標準各算各的，
    這一欄就會變成一個分母會變、卻不說的數字。
    所以它問的是暴露，也就是有幾天的空氣超過我們現在認為可接受的線，而不是那一年有沒有違規。
    第一章的年均標準則是逐年畫的：
    那裡的橫軸就是時間，法規改了本來就該看得見，{TW_PM25_ADDED} 年以前也就沒有線。
  </p>
</div>

<script>
  import { mapFrame } from "../lib/taiwan";

  const input = document.getElementById("station-filter") as HTMLInputElement | null;
  const listbox = document.getElementById("station-listbox");
  const options = Array.from(document.querySelectorAll<HTMLElement>("[data-station-option]"));
  const countyGroups = Array.from(document.querySelectorAll<HTMLElement>("[data-county-group]"));
  const count = document.getElementById("station-filter-count");
  const reports = Array.from(document.querySelectorAll<HTMLElement>(".report[data-station]"));

  const say = document.getElementById("station-say");

  /*
   * The locator is one figure serving 79 cards, so it has to be told.
   *
   * The same projection the figure was drawn with, imported rather than
   * re-derived: a second copy of the arithmetic would agree until the frame
   * moved, and then the mark would land somewhere the outline says is the sea.
   *
   * A mark left on the previous station is this chapter's own documented
   * defect in map form — a control that confirms a choice and then shows
   * another station's numbers.
   */
  const locatorMark = document.querySelector<SVGCircleElement>(
    "[data-station-locator-mark]",
  );
  const locatorCaption = document.querySelector<HTMLElement>("[data-locator-caption]");
  const locatorOffshore = document.querySelector<HTMLElement>(
    "[data-locator-offshore-note]",
  );
  const locatorUnplaced = document.querySelector<HTMLElement>(
    "[data-locator-unplaced-note]",
  );
  const moveLocator = (shown: HTMLElement | undefined) => {
    if (!locatorMark || !shown) return;
    const lon = Number(shown.dataset.lon);
    const lat = Number(shown.dataset.lat);
    const { bounds, project } = mapFrame();
    const hasCoordinate = Number.isFinite(lon) && Number.isFinite(lat);
    const inFrame =
      hasCoordinate &&
      lon >= bounds.lonMin && lon <= bounds.lonMax &&
      lat >= bounds.latMin && lat <= bounds.latMax;
    /*
     * Three states, and neither of the two that cannot draw a mark may return
     * early without clearing it first.
     *
     * A card with no coordinate at all, and a card on an offshore island that
     * projects outside the main-island frame, both leave the PREVIOUS station's
     * mark on the map if this function simply returns. Measured at this size:
     * the offshore stations land at cx -432, -103 and -1 against a 0-550
     * viewBox, so SVG clips them and the mark does not disappear, it stays
     * where it was. Emptying `data-station` hides the mark, via the component's
     * own CSS, and tells the gate which of the three cases this is.
     */
    locatorMark.setAttribute("data-station", inFrame ? shown.dataset.station ?? "" : "");
    if (locatorCaption) locatorCaption.hidden = !inFrame;
    if (locatorOffshore) locatorOffshore.hidden = !hasCoordinate || inFrame;
    if (locatorUnplaced) locatorUnplaced.hidden = hasCoordinate;
    if (!inFrame) return;
    const at = project(lon, lat);
    locatorMark.setAttribute("cx", String(at.x));
    locatorMark.setAttribute("cy", String(at.y));
  };

  /*
   * The filter narrows the menu and never moves the card.
   *
   * `option.hidden` rather than removing options, measured rather than assumed:
   * hiding the selected option leaves `value`, `selectedIndex` and the option's
   * own text intact, so the control still reports the station whose card is on
   * screen. That is the property this chapter's `<noscript>` block was written
   * about — a control that agrees with you and then shows another station's
   * numbers — and it would be no better for having been caused by a search box.
   *
   * A first version exempted the selected option from filtering, and its own
   * comment was untrue: the option stayed visible while the county group around
   * it was hidden, so it did not appear anyway. Filtering everything uniformly
   * is both simpler and what the code actually does.
   *
   * Groups are hidden when they empty out. A county heading over nothing reads
   * as a station that vanished rather than as one that did not match.
   */
  /*
   * Selecting a station: the card, the announcement and the map move together.
   *
   * Read off the card that is now on screen rather than from a second copy of
   * the data, so the announcement cannot drift from what is displayed and stays
   * correct if the card's contents ever change.
   *
   * It deliberately does NOT repeat the h2. A reader who hears 「基隆」 and then
   * arrows down into the card would otherwise be told the station's name twice
   * in a row; what they need is the headline the card leads with, which the h2
   * does not carry. So: the name once, then the year and the two figures a
   * reader would ask for first.
   */
  const showStation = (name: string) => {
    for (const report of reports) report.hidden = report.dataset.station !== name;
    for (const option of options) {
      option.setAttribute("aria-selected", option.dataset.stationOption === name ? "true" : "false");
    }

    const shown = reports.find((r) => !r.hidden);
    // Before the early return below: the map must follow the card even on a
    // page where the live region is missing.
    moveLocator(shown);
    if (!say || !shown) return;
    const text = (sel: string) => shown.querySelector(sel)?.textContent?.trim() ?? "";
    const stats = Array.from(shown.querySelectorAll<HTMLElement>(".stat"));
    const figure = (i: number) => {
      const st = stats[i];
      if (!st) return "";
      const value = st.querySelector(".stat-value")?.textContent?.trim() ?? "";
      const label = st.querySelector(".stat-label")?.textContent?.trim() ?? "";
      return value && label ? `${label} ${value}` : "";
    };
    say.textContent = [
      `${shown.dataset.station}，${text(".year")}`,
      figure(0),
      figure(2),
    ]
      .filter(Boolean)
      .join("；");
  };

  /*
   * 臺 and 台 are the same word and only one of them is in the data.
   *
   * The register writes the official form — 臺北市, 臺中市, 臺南市, 臺東縣 —
   * and readers type the everyday one. Measured against the 22 county groups:
   * 「臺中」 matched, 「台中」 matched nothing, and the same held for 台北, 台南
   * and 台東. The search worked for eighteen counties and failed silently on
   * the four that most people would try first, answering 「沒有測站符合」 to a
   * county it holds five stations in.
   *
   * Folded on both sides so it does not matter which form is typed or which
   * form the next register update ships.
   */
  const fold = (value: string) => value.toLowerCase().replace(/臺/g, "台");

  const visibleOptions = () =>
    options.filter((o) => !o.hidden && !o.closest<HTMLElement>("[data-county-group]")?.hidden);

  let active: HTMLElement | null = null;

  const setActive = (option: HTMLElement | null) => {
    if (active) active.classList.remove("is-active");
    active = option;
    if (!input) return;
    if (!option) {
      input.removeAttribute("aria-activedescendant");
      return;
    }
    option.classList.add("is-active");
    input.setAttribute("aria-activedescendant", option.id);
    option.scrollIntoView({ block: "nearest" });
  };

  const openList = () => {
    if (!listbox || !input) return;
    listbox.hidden = false;
    input.setAttribute("aria-expanded", "true");
  };

  const closeList = () => {
    if (!listbox || !input) return;
    listbox.hidden = true;
    input.setAttribute("aria-expanded", "false");
    setActive(null);
  };

  /*
   * Filtering narrows the list the reader is looking at, so the answer is on
   * screen rather than in a number beside a closed menu. The county match is
   * kept: a reader who knows 高雄 but not 前金 is exactly the one this is for,
   * and the county names are already here as the group labels.
   */
  const applyFilter = () => {
    if (!input) return;
    const needle = fold(input.value.trim());
    let matched = 0;
    for (const group of countyGroups) {
      const county = fold(group.getAttribute("aria-label") ?? "");
      const countyHit = Boolean(needle) && county.includes(needle);
      let groupMatched = 0;
      for (const option of Array.from(group.querySelectorAll<HTMLElement>("[data-station-option]"))) {
        const hit = !needle || countyHit || fold(option.textContent ?? "").includes(needle);
        option.hidden = !hit;
        if (hit) groupMatched += 1;
      }
      group.hidden = groupMatched === 0;
      matched += groupMatched;
    }

    // Nothing matched, so nothing was narrowed: leave the reader the whole
    // register rather than a list that looks broken.
    if (matched === 0) {
      for (const group of countyGroups) {
        group.hidden = false;
        for (const option of Array.from(group.querySelectorAll<HTMLElement>("[data-station-option]"))) {
          option.hidden = false;
        }
      }
    }

    if (count) {
      count.textContent = !needle
        ? ""
        : matched === 0
          ? "沒有測站符合，清單維持完整"
          : `${matched} 個測站符合`;
    }

    if (active?.hidden) setActive(null);
  };

  input?.addEventListener("input", () => {
    openList();
    applyFilter();
  });

  input?.addEventListener("focus", () => {
    openList();
  });

  input?.addEventListener("keydown", (event) => {
    const list = visibleOptions();
    if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      event.preventDefault();
      openList();
      if (!list.length) return;
      const at = active ? list.indexOf(active) : -1;
      const next = event.key === "ArrowDown"
        ? list[Math.min(at + 1, list.length - 1)] ?? list[0]
        : list[Math.max(at - 1, 0)] ?? list[list.length - 1];
      setActive(next);
      return;
    }
    if (event.key === "Enter" && active) {
      event.preventDefault();
      commit(active);
      return;
    }
    if (event.key === "Escape") {
      closeList();
    }
  });

  /*
   * Committing empties the box rather than filling it with the chosen name.
   *
   * The card underneath already says which station this is, in type several
   * times the size; leaving the query in the field would say it again and leave
   * the reader to clear it before the next search. An empty field with a
   * placeholder reads as ready.
   */
  const commit = (option: HTMLElement) => {
    const name = option.dataset.stationOption;
    if (!name || !input) return;
    showStation(name);
    input.value = "";
    applyFilter();
    closeList();
    input.focus();
  };

  listbox?.addEventListener("mousedown", (event) => {
    const option = (event.target as HTMLElement | null)?.closest<HTMLElement>("[data-station-option]");
    if (!option) return;
    // `mousedown` rather than `click`: the input's blur would close the list
    // before a click could land on it.
    event.preventDefault();
    commit(option);
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Node | null;
    if (!target || !input || !listbox) return;
    if (input.contains(target) || listbox.contains(target)) return;
    closeList();
  });

</script>

