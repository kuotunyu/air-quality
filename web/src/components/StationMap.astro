---
/**
 * Stations on the island, and the counties they are administered by.
 *
 * This map used to be points on nothing, on the argument that the network is
 * dense enough along the western plain that the island's shape emerges from the
 * stations themselves. It does — but only to a reader who already knows what
 * Taiwan looks like, which is the wrong assumption for a locator. Without a
 * shore, a dense cluster reads as a data artefact rather than as a coastline,
 * and the empty eastern half reads as missing data rather than as mountains.
 *
 * The boundaries are the official ones (see `lib/taiwan.ts` for the source and
 * the licence) rather than anything drawn by hand, and they carry county lines
 * because "which county is that" is the first question a reader asks of a dot.
 *
 * Counties fill `evenodd`, and that is load-bearing rather than tidy. 臺北市 is
 * a landlocked enclave of 新北市 and 嘉義市 of 嘉義縣, so the surrounding
 * county's ring list carries a hole. Filled `nonzero` the hole depends on
 * winding and the enclave gets painted over: 嘉義市 was invisible on this map
 * for exactly that reason, saved from being obvious only because 臺北市 happens
 * to sort after 新北市 and so survived by paint order.
 *
 * The basemap is deliberately almost invisible: one fill, hairline borders, no
 * hue. It is context, not measurement, and colour on this site is reserved for
 * concentration. The only saturated things here remain the dots.
 *
 * The stations MOENV's register cannot place are listed beneath the map instead
 * of being dropped. They have decades of measurements; what is missing is a
 * coordinate, and hiding them would misrepresent the record.
 */
import { concentrationColour, concentrationLegend, PM25_LEGEND_BREAKS } from "../lib/chart";
import { COUNTIES, TAIWAN_BOUNDS } from "../lib/taiwan";
import { href } from "../lib/chapters";
import type { Station, StationCard } from "../lib/data";

interface Props {
  stations: Station[];
  cards: StationCard[];
  unplaced: string[];
}

const { stations, cards, unplaced } = Astro.props;

const cardByStation = new Map(cards.map((c) => [c.station_name, c]));
const placed = stations.filter((s) => s.lat != null && s.lon != null);
const wanliHistorical = stations.find(
  (s) =>
    s.station_name === "萬里" &&
    (s as Station & { geo_source?: string | null }).geo_source === "reviewed_historical",
) as
  | (Station & {
      geo_source_record_namespace?: string | null;
      geo_source_record_id?: string | null;
    })
  | undefined;

// The frame is the boundary data's own bounding box plus a hairline of margin,
// so no part of the figure is empty by construction.
const [lonMin, lonMax, latMin, latMax] = TAIWAN_BOUNDS;
const MARGIN = 0.04;
const MAIN = {
  lonMin: lonMin - MARGIN,
  lonMax: lonMax + MARGIN,
  latMin: latMin - MARGIN,
  latMax: latMax + MARGIN,
};
const isMain = (s: Station) =>
  (s.lon as number) >= MAIN.lonMin &&
  (s.lon as number) <= MAIN.lonMax &&
  (s.lat as number) >= MAIN.latMin &&
  (s.lat as number) <= MAIN.latMax;

const main = placed.filter(isMain);
const offshore = placed.filter((s) => !isMain(s));

// Named from the data rather than typed into the caption. A hand-written
// "連江、金門、澎湖" would be correct today and silently wrong the day the
// register or the frame changes, on a page whose whole claim is that its numbers
// can be checked. These are the counties whose stations fall outside the frame,
// which is exactly the fact the caption needs to state.
const offshoreCounties = [
  ...new Set(offshore.map((s) => s.county).filter((c): c is string => Boolean(c))),
];

// Equirectangular with a cos(latitude) correction, which over three degrees of
// latitude is visually indistinguishable from a proper projection and needs no
// library. The source is EPSG:3824, whose coordinates are TWD97 lon/lat.
const midLat = ((MAIN.latMin + MAIN.latMax) / 2) * (Math.PI / 180);
const lonSpan = (MAIN.lonMax - MAIN.lonMin) * Math.cos(midLat);
const latSpan = MAIN.latMax - MAIN.latMin;

const height = 1000;
const width = Math.round((height * lonSpan) / latSpan);
const scale = height / latSpan;

const project = (lon: number, lat: number) => ({
  x: width / 2 + (lon - (MAIN.lonMin + MAIN.lonMax) / 2) * Math.cos(midLat) * scale,
  y: height / 2 - (lat - (MAIN.latMin + MAIN.latMax) / 2) * scale,
});

/*
 * This is a station overview, not a cadastral map. The official Yunlin county
 * geometry carries four detached rings for 外傘頂洲 and its neighbouring
 * sandbars. At the map's 260–360px rendered width those moving, unmonitored
 * landforms read as a broken chunk beside Chiayi rather than useful context.
 *
 * Keep the generated source complete — `build_taiwan_geo.py` orders exterior
 * rings largest first, so ring 0 is Yunlin's mainland — and simplify only this
 * presentation. A global area threshold would also erase familiar islands in
 * other counties, which is outside the reported defect.
 */
const overviewRingLimits = new Map([["雲林縣", 1]]);

const counties = COUNTIES.map((county) => {
  const ringLimit = overviewRingLimits.get(county.name);
  const overviewRings = ringLimit == null ? county.rings : county.rings.slice(0, ringLimit);
  return {
    name: county.name,
    area: county.area,
    anchors: county.anchors.map(([lon, lat]) => project(lon, lat)),
    d: overviewRings
      .map(
        (ring) =>
          ring
            .map(([lon, lat], i) => {
              const { x, y } = project(lon, lat);
              return `${i ? "L" : "M"}${x.toFixed(1)} ${y.toFixed(1)}`;
            })
            .join(" ") + " Z",
      )
      .join(" "),
  };
});

/*
 * Which counties get a name printed on them.
 *
 * Labels are HTML over the map rather than text inside it, for the same reason
 * the charts do it: the map scales and the type must not. But that means a
 * label's footprint in map coordinates *grows* as the map shrinks, so placement
 * has to be decided for the smallest size the map is ever drawn at — about
 * 260px across — or the labels would collide on a phone.
 *
 * Largest county first, and for each one try its roomiest spot, then its next
 * roomiest, and so on — Kaohsiung and Pingtung are neighbours that both open
 * onto the same southern plain, so a single anchor each meant whichever was
 * placed first took the space and the other went unnamed. Nothing is lost by a
 * county being skipped entirely: every one of them carries a `<title>`.
 */
// 2026-08-04 — the map still reaches 260px, but its container rule hides
// visual county labels there. The acceptance matrix first shows all 15 names
// in the measured 330px map state, so enlarged labels are solved at that state.
const MIN_RENDER_PX = 330;
const unitsPerPx = width / MIN_RENDER_PX;
// A CJK glyph is one em wide, so the width follows the font size directly. The
// height has to match what the CSS below actually produces: the label sets its
// own `line-height`, because inheriting the body's 1.7 made every box 27px tall
// against an estimate of 17 and let two labels overlap on a map that had been
// checked and declared clear.
// Must equal the rendered `--chart-micro` that `.county-label` sets below. It
// is repeated here rather than read, because this maths runs at build time and
// the CSS variable does not exist until the browser has the stylesheet — so the
// two can only be kept in step by being changed together. They have already
// drifted once: the label inherited the body's 1.7 line-height while this
// assumed 1.15, every box came out 27px against an estimate of 17, and two
// labels overlapped on a map that had been checked and declared clear.
// 24px conservatively covers --chart-micro's measured 23.1px desktop ceiling.
const LABEL_PX = 24;
const charWidth = LABEL_PX * unitsPerPx;
const labelHeight = LABEL_PX * 1.15 * unitsPerPx + 4 * unitsPerPx;

/*
 * Where the stations are, in map units — needed BEFORE the labels are placed.
 *
 * The collision test used to consider labels against other labels and nothing
 * else, so a name could be declared clear while sitting directly on top of the
 * readings. Measured: 33 of the 73 dots were drawn over a county name, and 13
 * of the 15 printed names had a dot punched through them. A county name is
 * context and a reading is the measurement — the measurement paints on top, so
 * the name is the thing that has to move.
 *
 * Half the dot's own size plus its ring, converted from px the same way the
 * label box is, so this stays right at the smallest size the map is drawn at.
 */
const DOT_PX = 9;
const dotRadius = ((DOT_PX / 2) + 1.5) * unitsPerPx;
const stationPoints = main.map((st) => project(st.lon as number, st.lat as number));

/*
 * Which year the dots are.
 *
 * The map had no caption and never said. Every dot is that station's most
 * recent year complete enough to compare, which is 2025 for most of them and
 * earlier for a station that stopped reporting — so the honest label is the
 * range, not a single year, and it is derived rather than written down.
 */
const shownYearValues = [...new Set(
  cards.map((c) => c.year).filter((y): y is number => y != null),
)].sort((a, b) => a - b);
const shownYears =
  shownYearValues.length === 0
    ? null
    : shownYearValues.length === 1
      ? `${shownYearValues[0]} 年`
      : `${shownYearValues[0]}–${shownYearValues[shownYearValues.length - 1]} 年，各站最近一個完整年`;

const labelled: { name: string; x: number; y: number }[] = [];
const boxes: [number, number, number, number][] = [];
const order = [...counties].sort((a, b) => b.area - a.area);

const boxAt = (county: (typeof order)[number], anchor: { x: number; y: number }) => {
  const half = (county.name.length * charWidth) / 2;
  return [
    anchor.x - half,
    anchor.y - labelHeight / 2,
    anchor.x + half,
    anchor.y + labelHeight / 2,
  ] as [number, number, number, number];
};
const overlapsLabel = (box: [number, number, number, number]) =>
  boxes.some((b) => box[0] < b[2] && box[2] > b[0] && box[1] < b[3] && box[3] > b[1]);
/*
 * How much of a label box the readings would cover, 0 to 1.
 *
 * A count is the wrong measure: one dot on a three-character name is a smudge,
 * and twelve is a name a reader cannot read. Area answers the question the eye
 * is asking. Each dot is treated as its own square — same approximation the
 * old overlap test made, and it errs toward caution at the corners.
 */
const coverage = (box: [number, number, number, number]) => {
  const area = (box[2] - box[0]) * (box[3] - box[1]);
  if (area <= 0) return 1;
  let covered = 0;
  for (const pt of stationPoints) {
    const dx = Math.min(pt.x + dotRadius, box[2]) - Math.max(pt.x - dotRadius, box[0]);
    const dy = Math.min(pt.y + dotRadius, box[3]) - Math.max(pt.y - dotRadius, box[1]);
    if (dx > 0 && dy > 0) covered += dx * dy;
  }
  return covered / area;
};

/*
 * Past this much of the box behind readings, the name is not printed.
 *
 * The number is in THIS coordinate space, not in rendered pixels: placement is
 * solved at the smallest size the map is drawn at, where a 9px dot is a larger
 * share of a label than it will be at 1440, so the fraction here runs higher
 * than what a reader sees. It was calibrated by walking it — 0.35 and 0.45 both
 * printed 14 names, 0.55 prints 15, 0.7 prints 16 and the sixteenth is 基隆市
 * sitting under the north coast cluster.
 *
 * At 0.55, measured on the rendered page: 15 names, the same count as before
 * any of this, and the worst-covered one is 「新北市」 at 20.5% of its box at a
 * 900 viewport and 14.2% at 1440 — against 58.4% and 35.8% when the second pass
 * took the first legal anchor instead of the best one. 「臺北市」 is the name
 * this refuses; it has no anchor in its own county that the Taipei basin
 * cluster does not sit on, and a name with a dot through its middle character
 * is worse than a county the reader can find anyway.
 */
const MAX_COVERED = 0.55;
const inFrame = (box: [number, number, number, number]) =>
  box[0] > 0 && box[2] < width && box[1] > 0 && box[3] < height;

/*
 * Two passes, and the second one is what keeps this from costing names.
 *
 * Avoiding the dots outright dropped the count from 15 counties to 9 —
 * 彰化, 雲林, 嘉義, 高雄 and their neighbours are exactly where the stations
 * cluster, so "no anchor clear of data" and "no name at all" became the same
 * answer for the west coast, which is the half of the island the page is about.
 * So the first pass takes only anchors clear of every reading, and the second
 * lets whatever is still unnamed fall back to the old rule. The result is at
 * least as many names as before, as many of them as possible off the data.
 */
for (const pass of [0, 1]) {
  for (const county of order) {
    if (labelled.some((l) => l.name === county.name)) continue;
    /*
     * The second pass takes the LEAST covered anchor, not the first legal one.
     *
     * It used to take the first, and 新北市 is what that costs: 13 of the 73
     * dots sat inside its box at a 900 viewport, 58.4% of the label's area, and
     * the first character was unreadable under the Taipei basin cluster. Four
     * anchors is not many to choose between, but choosing is free and the county
     * with the worst crowding is exactly the one with the most to gain. A name
     * whose best anchor is still worse than `MAX_COVERED` is not printed.
     */
    let best: { anchor: { x: number; y: number }; box: [number, number, number, number]; cost: number } | null = null;
    for (const anchor of county.anchors) {
      const box = boxAt(county, anchor);
      if (!inFrame(box) || overlapsLabel(box)) continue;
      const cost = coverage(box);
      if (cost > (pass === 0 ? 0 : MAX_COVERED)) continue;
      if (best === null || cost < best.cost) best = { anchor, box, cost };
      if (cost === 0) break;
    }
    if (!best) continue;
    boxes.push(best.box);
    labelled.push({ name: county.name, x: best.anchor.x, y: best.anchor.y });
  }
}

const dots = main.map((s) => {
  const card = cardByStation.get(s.station_name);
  const { x, y } = project(s.lon as number, s.lat as number);
  return {
    name: s.station_name,
    county: s.county ?? "",
    x,
    y,
    value: card?.annual_mean ?? null,
    year: card?.year ?? null,
    colour: concentrationColour(card?.annual_mean),
  };
});
---

<slot name="before-map" />

<div
  class="map-wrap"
  data-homepage-map-frame
  data-figure-tools-mount="homepage-map-tools"
  style={`--map-ratio:${width} / ${height};--map-wide:${(width / height).toFixed(4)}`}
>
  <div class="map-box" data-homepage-map>
    <p
      id="homepage-map-county-description"
      class="visually-hidden"
      data-homepage-map-county-description
    >
      圖中的縣市包括：{
        counties.map((county, index) => (
          <>
            <span data-homepage-map-county>{county.name}</span>
            {index < counties.length - 1 ? "、" : "。"}
          </>
        ))
      }
    </p>
    <svg
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-label={`台灣本島 ${counties.length} 個縣市的界線；${dots.length} 個測站的 PM2.5 年均值以色點標示，逐站數字見第二章的測站統計`}
      aria-describedby="homepage-map-county-description"
    >
      {
        counties.map((county) => (
          <path
            d={county.d}
            class="county"
            fill-rule="evenodd"
            vector-effect="non-scaling-stroke"
          >
            <title>{county.name}</title>
          </path>
        ))
      }
    </svg>

    {
      labelled.map((label) => (
        <span
          class="county-label"
          aria-hidden="true"
          style={`left:${((label.x / width) * 100).toFixed(2)}%;top:${((label.y / height) * 100).toFixed(2)}%`}
        >
          {label.name}
        </span>
      ))
    }

    {
      dots.map((d) => (
        <span
          class="dot"
          data-station={d.name}
          style={`left:${((d.x / width) * 100).toFixed(3)}%;top:${((d.y / height) * 100).toFixed(3)}%;background:${d.colour}`}
          title={
            `${d.name}${d.county ? `（${d.county}）` : ""}` +
            (d.value != null ? ` ${d.value} μg/m³（${d.year}）` : " 無可比較的年份")
          }
        />
      ))
    }
  </div>

  {/*
    The concentration scale, drawn as a scale.

    Seven detached chips plus an eighth that was the unit wearing a missing
    swatch. The chips wrapped to three rows under the map, and they said "seven
    kinds" about the one encoding on this site that is explicitly ordered — the
    ramp's whole argument is that lightness runs monotonically from low to high.
    A bar with its breaks under it says that; a row of tiles does not. The unit
    goes beside the scale it belongs to instead of pretending to be a bin.
  */}
  <div class="scale" data-homepage-map-legend>
    <p class="scale-title">
      PM2.5 年均 μg/m³
      {shownYears && <span class="scale-when">・{shownYears}</span>}
    </p>
    <div class="scale-bar" role="img" aria-label={`濃度色階，分界 ${PM25_LEGEND_BREAKS.join("、")}`}>
      {concentrationLegend.map((entry) => <span style={`background:${entry.colour}`} />)}
    </div>
    <div class="scale-ticks" aria-hidden="true">
      {PM25_LEGEND_BREAKS.map((b, i) => (
        <span style={`left:${(((i + 1) / concentrationLegend.length) * 100).toFixed(3)}%`}>{b}</span>
      ))}
    </div>
  </div>
  <p class="map-station-route">
    地圖是全台概覽，不在圖上選站。<a href={href("stations")} data-homepage-map-station-route>前往第二章查一個測站 →</a>
  </p>
</div>

<slot name="after-map" />

{/*
  A sibling region rather than part of the figure.

  These two paragraphs are prose, and inside the hero's 22rem figure column they
  wrapped at 20-24 Chinese characters a line while every other paragraph on the
  page ran at 40 — three different measures stacked vertically, which is most of
  why the page read as untidy. They were also what made the figure column 1,060px
  tall against the 550px of statistics beside it, leaving a 510x620px hole.

  The parent places this at the page measure; see `.hero-grid` in index.astro.
*/}
<div class="map-notes">
  {/*
    What these notes, and the two buttons below them, act on.

    Measured at 1280: the map is 330px wide in the top-right corner, and this
    block sits 908px below it at full page width, with the toolbar 1,276px
    below. The distance is not the defect — the comment above records why the
    notes are here rather than under the map, and why they run two columns —
    but nothing in the block said which figure it belonged to, so a reader who
    reaches it two screens later has no way to connect it to anything.
  */}
  <p class="apparatus-label" data-map-apparatus-label>
    以上地圖：全台測站概覽 · 資料來源與下載
  </p>
  <p class="aside">
    縣市界為內政部國土測繪中心「直轄市、縣市界線（TWD97 經緯度）」1140318 版，
    原始比例尺 1:5000，依政府資料開放授權條款第 1 版使用。
    此圖為簡化後的衍生成果：輪廓簡化至約 165 公尺，
    並<strong>移除面積小於 1.2 平方公里的離岸島礁</strong>；
    作為測站概覽，另省略無測站的雲林離岸沙洲（外傘頂洲及相鄰沙洲）。
    {
      offshoreCounties.length > 0 && (
        <>
          {offshoreCounties.join("、")}不在本島圖框內，其測站（
          {offshore.map((s) => s.station_name).join("、")}）因此未繪出。
        </>
      )
    }
    界線僅供定位，非量測依據。
  </p>

  {
    (wanliHistorical || unplaced.length > 0) && (
      <p class="aside">
        {wanliHistorical && (
          <>
            <strong>萬里測站不在環境部現行測站清冊</strong>；圖上位置來自
            <a href="https://airtw.moenv.gov.tw/CHT/EnvMonitoring/Central/article_station.aspx?SiteID=61">
              環境部歷史測站紀錄
            </a>
            （{wanliHistorical.geo_source_record_namespace} SiteID {wanliHistorical.geo_source_record_id}），
            並未與其他測站合併。
          </>
        )}
        {unplaced.length > 0 && (
          <>
            另有 <strong>{unplaced.length} 個測站未繪出</strong>：{unplaced.join("、")}。
            目前設定的現行清冊與審閱過的歷史紀錄都沒有可直接對應的座標，
            因此本專案尚未能定位；這不表示其現實位置不存在，也不能據此判定這些測站均已停用。
          </>
        )}
      </p>
    )
  }
</div>

<div id="homepage-map-tools" class="map-tools"></div>

<style>
  /*
   * The wrapper is sized to the map, so everything under it is too.
   *
   * The scale and the source note were as wide as the column while the map was
   * as wide as the map: measured on the stacked layout at 1000, the ramp spanned
   * 596px — the whole content column — under an inked map 331px across, so a
   * legend 1.8x the width of the thing it explains was centred over nothing in
   * particular. The sizing moves up one element and `.map-box` fills it, which
   * makes the ramp and the map share an edge by construction rather than by two
   * numbers agreeing.
   */
  .map-wrap {
    display: flex;
    flex-direction: column;
    container-type: inline-size;
    container-name: map-frame;
    width: min(100%, clamp(26rem, 62vh, 36rem) * var(--map-wide));
    margin-inline: auto;
  }

  /* A short desktop still has the rail beside the figure, so width alone does
   * not activate the stacked map budget. At 1280×720 the 26rem floor kept the
   * island visible but put its complete scale below the initial viewport; the
   * height-relative budget preserves the whole graphic in that use case.
   */
  @media (min-width: 901px) and (max-height: 799px) {
    .map-wrap {
      width: min(100%, 50vh * var(--map-wide));
    }
  }

  /*
   * 2026-08-03 — the opening-copy stack leaves less vertical room than the old
   * map/figures row. Measured before: the 62vh budget put the legend bottom at
   * 1122.12px in a 768x1024 viewport and 1078.06px in a 390x844 viewport.
   */
  @media (max-width: 900px) {
    .map-wrap {
      /* 2026-08-03 — at 900×500 with text at 200%, the viewport-only
         budget let the fixed 9px 富貴角 mark leave the frame by 1.281px.
         This rem floor grows with text, but stays below the normal-size map. */
      width: min(100%, max(52vh * var(--map-wide), 5.5rem));
    }
  }

  @media (max-width: 420px) {
    .map-wrap {
      width: min(100%, 38vh * var(--map-wide));
    }
  }

  .map-tools {
    order: 5;
    grid-column: 1 / -1;
  }

  /*
   * Placed by the parent. Two columns, because one 819px column of footnotes
   * inside a 1,145px page left 326px of nothing beside it — and unlike body
   * prose, a source note is read once and reads fine at half the measure.
   * `auto-fit` drops to one column as soon as two no longer fit, so this needs
   * no breakpoint; the row gap only ever applies in that collapsed state.
   */
  .map-notes {
    display: grid;
    /* `min(…, 100%)` and not a bare `19rem`: a minmax floor is a floor even when
       there is only one column, so at 375px the single track measured 351px in a
       333px container and the notes sat 18px past the right edge every other
       block on the page lines up with. */
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
    gap: var(--space-3) var(--space-5);
    align-items: start;
  }

  /* Spans the notes grid. A track of its own would seat the label beside the
     note it introduces rather than above it, and at 375px — where `auto-fit`
     has already collapsed to one column — it would look correct while being
     wrong at every other width. */
  .map-notes .apparatus-label {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  /* The grid gap does the spacing; the paragraph margin would double it. */
  .map-notes .aside {
    margin: 0;
  }

  /*
   * Sized from a height budget, but driven through `width`.
