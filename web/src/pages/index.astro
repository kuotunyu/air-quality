---
/**
 * The way in.
 *
 * This page used to be the entire document: ten chapters in one scroll, 38,291px
 * of it, 42 screens at a laptop height. That is not long-form, it is a page with
 * no structure — the scrollbar thumb was four pixels tall, and PRODUCT.md's
 * third reader ("wants to judge in thirty seconds whether this work is
 * rigorous") had nothing to judge but the first fold.
 *
 * So the chapters are routes now and this page does the job an entry page should
 * do: state the finding, show the network, and then lay out what the ten
 * chapters actually settle — one line each, so the whole argument is legible
 * before any of it is opened. The index is the substance of this page, not
 * furniture attached to the top of it.
 */
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import { CHAPTERS, chapterLabel, href } from "../lib/chapters";
import { cards, hourlyObservationsShort, trend } from "../lib/data";
import { n } from "../lib/chart";

const latestYear = Math.max(...cards.map((c) => c.year));
const comparable = cards.filter((c) => c.year >= latestYear - 1);
const lastValue = trend.all_stations[trend.all_stations.length - 1] as number;
const balancedSince = trend.panel.balanced_since as number;
const balancedStart = trend.years.indexOf(balancedSince);
const declineFrom = trend.all_stations[balancedStart] as number;
const declinePct = ((declineFrom - lastValue) / declineFrom) * 100;
---

<Base
  title="air-quality — 台灣空氣品質再分析（1982–2025）"
  description={`1982–2025 年、${hourlyObservationsShort}筆環境部逐時觀測的開放重新分析：完整品管、逐時解析度，以及一章方法學對照。`}
>
  <Hero />

  <section id="chapters" class="page">
    <p class="eyebrow">十章</p>
    <h2>這份重新分析說了什麼</h2>

    <p class="lede">
      每一章各自成頁，可以單獨讀完，也可以按順序讀下去。下面一行一章，
      寫的是那一章<strong>解決掉什麼</strong>——不是它的標題，是它的結論。
    </p>

    <ol class="toc">
      {
        CHAPTERS.map((c) => (
          <li>
            <a href={href(c.slug)}>
              <span class="toc-n">{chapterLabel(c.n)}</span>
              <span class="toc-body">
                <span class="toc-title">{c.title}</span>
                <span class="toc-claim">{c.claim}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="note">
      <p>
        <strong>先證明能重現，再說它錯。</strong>
        <a href={href("methods")}>第八章</a>以一份 2018 年的大學畢業專題作為方法學對照組：
        該研究使用 8 年月平均、N = 7,286；本專案使用 44 年逐時觀測、N = {hourlyObservationsShort}。
        復刻先跑一遍原方法，證明數字對得上，才逐項量化每個方法選擇造成的差異。
      </p>
      <p>
        {balancedSince} 年以來全台 PM2.5 年均值從 {n(declineFrom)} 降到 {n(lastValue)} μg/m³
        （少了 {n(declinePct, 0)}%），而 {latestYear} 年有可比較資料的 {comparable.length} 個測站裡
        仍有 {comparable.filter((c) => c.annual_mean > 5).length} 個高於 WHO 的年均指引值。
        趨勢與水準是兩個量，兩者並不衝突——第一章處理前者，第二章處理後者。
      </p>
    </div>
  </section>
</Base>

<style>
  /*
   * The index is a numbered list because the document is a sequence — the
   * numbers carry the reading order, which is information the reader needs.
   * (Numbered markers as decoration on unordered sections would be scaffolding;
   * these are an actual ordinal.)
   *
   * Rows rather than cards. Ten cards in a grid would give every chapter the
   * same weight and the same shape, and would put each claim in a column about
   * fourteen Chinese characters wide. A row lets the claim have the page's own
   * measure, which is the width it was written for.
   */
  .toc {
    list-style: none;
    margin: var(--space-5) 0 var(--space-4);
    padding: 0;
    counter-reset: none;
  }

  .toc li {
    border-top: 1px solid var(--line-soft);
  }

  .toc li:last-child {
    border-bottom: 1px solid var(--line-soft);
  }

  .toc a {
    display: grid;
    gap: 0.1rem var(--space-4);
    padding: var(--space-3) 0;
    text-decoration: none;
    color: var(--text);
  }

  /* The chapter number sizes to its own content and the title column takes the
     rest, so every title starts on one vertical line down the list. */
  @media (min-width: 34rem) {
    .toc a {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .toc-n {
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--text-faint);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .toc-body {
    display: grid;
    gap: 0.2rem;
    max-width: var(--measure);
  }

  .toc-title {
    font-size: var(--text-lg);
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .toc-claim {
    color: var(--text-muted);
    text-align: justify;
    line-break: strict;
  }

  /* The whole row is the target, so the hover has to be on the row: an underline
     under the title alone would suggest only the title is clickable. */
  .toc a:hover .toc-title,
  .toc a:focus-visible .toc-title {
    color: var(--accent);
  }

  .toc a:hover .toc-n {
    color: var(--accent);
  }
</style>
